// 页面的一条竖线：页头的大标题、每个小节的开头、第一本书的封面都从这条线
// 起。系统状态栏在上方，于是页头、内容、状态栏三者的左边缘对齐。
//
// 这是全应用的页面边距，不由某一页声明：首页和书架都读它，书架量一行的宽
// 也用它。iOS 与 macOS 读得宽一点：20 在手机上显得贴边。

pub let pageKeyline: float = if @platform == .iOS || @platform == .macOS { 24 } else { 20 }

/// A sheet's padding: its own, plus the landscape side insets. A sheet isn't
/// a screen, so nothing pads its content for the notch; without this its rows
/// run into the side edges when the phone is turned.
pub fn sheetPad(top: float, bottom: float, side: float) -> Edges {
  let env = environment()
  return Edges(top: top, right: side + env.safeRight, bottom: bottom, left: side + env.safeLeft)
}
