// The page turn's arithmetic across chapter boundaries: where a turn lands,
// and what the chapter's page count does to it.

test "a turn inside a chapter moves one page" {
  let next = forward(1, 3, 10, 5)
  expect(next.spine == 1)
  expect(next.page == 4)

  let prev = backward(1, 3, 5)
  expect(prev.spine == 1)
  expect(prev.page == 2)
}

test "the last page of a chapter turns into the next chapter's first" {
  let next = forward(1, 9, 10, 5)
  expect(next.spine == 2)
  expect(next.page == 0)
}

test "the first page of a chapter turns back to the last page of the one before" {
  let prev = backward(2, 0, 5)
  expect(prev.spine == 1)
  // -1: the last page, known once that chapter is laid out — not page 0,
  // which would be the beginning of a chapter the reader already read.
  expect(prev.page == -1)
  expect(resolve(prev.page, 12) == 11)
}

test "a turn back inside a chapter never resolves to the end" {
  expect(resolve(3, 12) == 3)
}

test "the ends of the book stay put" {
  let first = backward(0, 0, 5)
  expect(first.spine == 0)
  expect(first.page == 0)

  let last = forward(4, 9, 10, 5)
  expect(last.spine == 4)
  expect(last.page == 9)
}

test "a place past the end resolves to the last page" {
  expect(resolve(30, 12) == 11)
  expect(resolve(0, 0) == 0)
  expect(resolve(-1, 0) == 0)
}
