// What a book is once it is open: chapters, and each chapter's paragraphs.
// Ported from Quire's internal/book (Go); this file has no UI and no I/O.

pub struct Chapter {
  title: string
  paragraphs: [string]

  pub fn chars() -> int = paragraphs.reduce(0, (n, p) => n + p.count())
}

pub struct Book {
  id: string
  title: string
  author: string
  chapters: [Chapter]
  /// The file the engine reads: the import, or one written from `raw`.
  path: string = ""
  /// The cover image the engine wrote, when the book has one; "" for a
  /// text book or an EPUB without a cover (the shelf draws a spine instead).
  cover: string = ""
  /// The original text, for a book imported as text.
  raw: string = ""

  pub fn empty() -> bool = chapters.isEmpty() || chapters.all(c => c.paragraphs.isEmpty())

  /// All the text of the book, for a shelf's word count.
  pub fn chars() -> int = chapters.reduce(0, (n, c) => n + c.chars())

  pub fn firstChapter() -> string = chapters.first()?.title ?? ""
}

/// A book as the shelf keeps it between launches: the file it's read from,
/// and what the shelf shows. Its text isn't kept — the file has that, and the
/// engine reads the file — so a .txt of ten megabytes costs a row. The path
/// and the cover are kept relative to the app's own directory (`books/x.txt`,
/// `covers/x.img`): an iOS update may give that directory another name, and a
/// row is meant to outlive it.
pub struct Shelf {
  id: string
  title: string
  author: string
  /// The file under the app's directory; "" for a book that came with the app.
  path: string
  /// The cover image under the app's directory; "" when there is none.
  cover: string = ""
  /// When the book came onto the shelf, in unix seconds: 0 for a row
  /// written before it was kept. A book put back after being taken off
  /// outranks the note that took it off.
  added: int = 0

  pub fn book() -> Book = Book(id: id, title: title, author: author, chapters: [], path: path, cover: cover)
}

/// The shelf's row for a book.
pub fn shelfOf(book: Book) -> Shelf = Shelf(id: book.id, title: book.title, author: book.author, path: book.path, cover: book.cover)

/// Where a book was left: the chapter, and how far into it (0…1).
pub struct Reading {
  id: string
  chapter: int = 0
  percent: float = 0
  /// When the place was last kept, in unix seconds: 0 for a row written
  /// before the home page kept the time. It's what "recent" sorts by.
  updated: int = 0

  pub fn label() -> string {
    if chapter <= 0 && percent <= 0 { return "未开始" }
    if percent >= 0.999 { return "已读完" }
    return "第 {chapter + 1} 章 · {(percent * 100).int()}%"
  }
}

/// A bookmark: a place the reader kept in a book, as how far into its
/// chapter it was made.
pub struct Bookmark {
  id: string
  book: string
  chapter: int
  percent: float
}

/// The colors a page is drawn in: Quire's paper and ink.
pub struct Palette {
  paper: Color
  ink: Color
  muted: Color
  rule: Color
}

pub fn paletteFor(theme: string) -> Palette {
  if theme == "sepia" {
    return Palette(paper: #f6ecd9, ink: #3d3324, muted: #8a7a5e, rule: #e0d2b8)
  }
  if theme == "night" {
    return Palette(paper: #16161a, ink: #d8d6cf, muted: #8b8a86, rule: #2a2a31)
  }
  return Palette(paper: #fbfaf7, ink: #23211c, muted: #86817a, rule: #e6e2da)
}

/// The body face: a serif the platform actually has. On Apple's platforms
/// that's Songti SC for Chinese; elsewhere the generic serif.
pub fn bodyFamily() -> string {
  if @platform == .iOS || @platform == .macOS { return "Songti SC" }
  return "serif"
}

/// A color as the engine takes it: 0xRRGGBBAA.
pub fn rgbaOf(c: Color) -> u32 {
  let hex = c.hex()
  if !hex.hasPrefix("#") { return 0xffffffff }
  let digits = hex.slice(1, hex.count())
  let value = digits.toInt(radix: 16) ?? 0xffffffff
  if digits.count() >= 8 { return u32(clamping: value) }
  return (u32(clamping: value) << 8) | 0xff
}
