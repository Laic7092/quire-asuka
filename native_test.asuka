// 原生书源引擎：链接了它，规则和 JavaScript 就由 legado-engine 跑；没有它
// 的平台（模拟器、Windows、Android、网页）这几条测试什么都不做。

import std/json

import ./sources

let nativeSample = r#"{"bookSourceUrl":"https://x.test","bookSourceName":"测试"}"#

test "the native engine runs a CSS rule" {
  if !sources.nativeAvailable() { return }
  let text = try sources.nativeEvalRule(nativeSample, ".row@text", "<div class='row'>Hello</div>", "https://x.test/")
  expect(text == "Hello")
}

test "the native engine runs a JavaScript rule" {
  if !sources.nativeAvailable() { return }
  let text = try sources.nativeEvalRule(nativeSample, "@js:result.trim().toUpperCase()", "hello", "https://x.test/")
  expect(text == "HELLO")
}

test "a source keeps the JSON it was imported from" {
  let one = r#"{"bookSourceName":"一个","bookSourceUrl":"x.test","searchUrl":"/s?q={{key}}","loginUrl":"/login"}"#
  let def = try sources.decodeSource(try json.parse(one))
  expect(def.raw.contains("\"loginUrl\""))
  expect(sources.sourceJSON(def) == def.raw)
}

test "the native engine turns chapter HTML into text" {
  if !sources.nativeAvailable() { return }
  let text = try sources.nativeEvalRule(nativeSample, "body", "<p>第一段</p><p>第二&amp;段</p>", "https://x.test/")
  expect(text.contains("第一段"))
  expect(text.contains("第二&段"))
  expect(!text.contains("<p>"))
}

test "a source's variables are what the engine stores, not the JSON's field" {
  if !sources.nativeAvailable() { return }
  let one = r#"{"bookSourceName":"变量","bookSourceUrl":"https://vars.test","variable":"{\"user\":\"from-json\"}"}"#
  let def = try sources.decodeSource(try sources.parseList(one)[0])
  // 引擎不读 JSON 里的 variable：导入时由 seedVariables 写，这里直接存一次。
  try await sources.saveVariables(def, r#"{"user":"a\"b","pass":"密码"}"#)
  let user = try await sources.nativeEval(sources.sourceJSON(def), script: "source.get('user')")
  let stored = try await sources.storedVariables(def)
  expect(user == "a\"b")
  expect(stored.contains("密码"))
}

test "a cookie the host sets is the source's session" {
  if !sources.nativeAvailable() { return }
  let one = r#"{"bookSourceUrl":"https://cookie.test"}"#
  let def = try sources.decodeSource(try sources.parseList(one)[0])
  try await sources.setCookieOf(def, url: "https://cookie.test/", cookie: "sid=abc; theme=dark")
  let header = try await sources.cookieHeaderOf(def, url: "https://cookie.test/page")
  expect(header.contains("sid=abc"))
  expect(header.contains("theme=dark"))
}

test "a source's cookie can be cleared for another account" {
  if !sources.nativeAvailable() { return }
  let one = r#"{"bookSourceUrl":"https://clear-cookie.test"}"#
  let def = try sources.decodeSource(try sources.parseList(one)[0])
  try await sources.setCookieOf(def, url: "https://clear-cookie.test/", cookie: "sid=abc")
  try await sources.clearCookiesOf(def, url: "https://clear-cookie.test/")
  let header = try await sources.cookieHeaderOf(def, url: "https://clear-cookie.test/page")
  expect(!header.contains("sid=abc"))
}

test "pasting a cookie replaces the source's whole session" {
  if !sources.nativeAvailable() { return }
  let one = r#"{"bookSourceUrl":"https://replace-cookie.test"}"#
  let def = try sources.decodeSource(try sources.parseList(one)[0])
  try await sources.setCookieOf(def, url: "https://replace-cookie.test/", cookie: "sid=old; theme=dark")
  try await sources.replaceCookiesOf(def, url: "https://replace-cookie.test/", cookie: "sid=new; theme=light")
  let header = try await sources.cookieHeaderOf(def, url: "https://replace-cookie.test/page")
  expect(header.contains("sid=new"))
  expect(header.contains("theme=light"))
  expect(!header.contains("sid=old"))
  expect(!header.contains("theme=dark"))
}

test "a share payload becomes book sources, RSS sources and replace rules" {
  if !sources.nativeAvailable() { return }
  let payload = r##"[{"bookSourceName":"书","bookSourceUrl":"https://import.test"},{"sourceName":"订阅","sourceUrl":"https://rss.test/feed"},{"name":"净化","pattern":"a","replacement":"b"}]"##
  let imported = try await sources.nativeImport(payload)
  expect(imported.bookSources.count() == 1)
  expect(imported.rssSources.count() == 1)
  expect(imported.replaceRules.count() == 1)
  expect(imported.unknown == 0)
}

test "the native engine applies replace rules" {
  if !sources.nativeAvailable() { return }
  let rules = r##"[{"pattern":"猫","replacement":"猫猫","isEnabled":true}]"##
  let out = try await sources.nativeReplace(rules, "小猫", context: "", target: "content")
  expect(out.text == "小猫猫")
  expect(out.applied.count() == 1)
  expect(out.applied[0].changed)
}

test "RSS sources are parsed without a handle" {
  if !sources.nativeAvailable() { return }
  let list = try sources.nativeRssSources(r##"{"sourceName":"订阅","sourceUrl":"https://rss.test/feed"}"##)
  expect(list.count() == 1)
  expect(list[0].get("name")?.asString() == "订阅")
}

test "a mixed import lands in the book, RSS and replace stores" {
  if !sources.nativeAvailable() { return }
  let all = sources.Sources()
  let wasEntries = all.entries
  let wasRemoved = all.removed
  let wasRss = sources.rssSources.entries
  let wasRules = sources.replaceRules.entries
  all.entries = []
  all.removed = [:]
  sources.rssSources.entries = []
  sources.replaceRules.entries = []
  let payload = r##"[{"bookSourceName":"书","bookSourceUrl":"https://mixed-import.test"},{"sourceName":"订阅","sourceUrl":"https://rss.mixed.test/feed"},{"name":"净化","pattern":"a","replacement":"b"}]"##
  let report = try await all.importAny(payload)
  expect(report.added == 1)
  expect(report.rssAdded == 1)
  expect(report.replaceAdded == 1)
  expect(all.entryOf("https://mixed-import.test") != none)
  expect(sources.rssSources.has("https://rss.mixed.test/feed"))
  expect(sources.replaceRules.entries.count() == 1)
  all.entries = wasEntries
  all.removed = wasRemoved
  sources.rssSources.entries = wasRss
  sources.replaceRules.entries = wasRules
}
