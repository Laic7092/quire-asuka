// JSONPath, as JSON book sources are written with it.
//
// The subset sources use: member access, array indexes (counting from zero,
// negative from the end), the [*] wildcard, the .. descent, quoted member
// names, and a filter ([?(@.type=='x')]) with the comparisons Legado writes.
// A path this can't read answers nothing.

import std/json
import std/regex

struct Op {
  /// "member", "index", "all" or "filter".
  kind: string = ""
  name: string = ""
  index: int = 0
  deep: bool = false
  /// A filter's condition: the field path under @, its comparison, and the
  /// value it compares with ("string", "number", "bool", "null" or "path").
  path: [string] = []
  op: string = ""
  value: string = ""
  valueKind: string = ""
}

/// Every value `path` names in `root`.
pub fn query(root: json.Value, path: string) -> [json.Value] {
  let ops = parsePath(path)
  if ops.isEmpty() { return [] }
  var vals: [json.Value] = [root]
  for op in ops {
    vals = applyOp(vals, op)
  }
  return vals
}

fn applyOp(vals: [json.Value], op: Op) -> [json.Value] {
  var out: [json.Value] = []
  for v in vals {
    if op.deep {
      out = out + deepValues(v, op)
    } else {
      for x in one(v, op) {
        out.push(x)
      }
    }
  }
  return out
}

fn one(v: json.Value, op: Op) -> [json.Value] {
  if op.kind == "member" {
    if let o = v.asObject() {
      if let m = o.get(op.name) { return [m] }
    }
    return []
  }
  if op.kind == "index" {
    if let a = v.asArray() {
      var at = op.index
      if at < 0 { at = a.count() + at }
      if at >= 0 && at < a.count() { return [a[at]] }
    }
    return []
  }
  if op.kind == "all" {
    if let a = v.asArray() { return a }
    if let o = v.asObject() { return o.values() }
    return []
  }
  if op.kind == "filter" {
    var items: [json.Value] = []
    if let a = v.asArray() {
      items = a
    } else if let o = v.asObject() {
      items = o.values()
    }
    var out: [json.Value] = []
    for it in items {
      if condMatch(it, op) { out.push(it) }
    }
    return out
  }
  return []
}

fn deepValues(v: json.Value, op: Op) -> [json.Value] {
  var out: [json.Value] = []
  if op.kind == "member" {
    if let o = v.asObject() {
      if let m = o.get(op.name) { out.push(m) }
    }
  } else if op.kind == "all" {
    if let a = v.asArray() {
      for e in a { out.push(e) }
    } else if let o = v.asObject() {
      for (_, e) in o { out.push(e) }
    }
  }
  if let a = v.asArray() {
    for e in a {
      out = out + deepValues(e, op)
    }
  } else if let o = v.asObject() {
    for (_, e) in o {
      out = out + deepValues(e, op)
    }
  }
  return out
}

// ── Filters ─────────────────────────────────────────────────────────

fn condMatch(v: json.Value, op: Op) -> bool {
  var cur = v
  for name in op.path {
    if let o = cur.asObject() {
      if let m = o.get(name) {
        cur = m
      } else {
        return false
      }
    } else if let a = cur.asArray() {
      // A numeric step into an array, as @.list.0.
      if let at = name.toInt() {
        if at >= 0 && at < a.count() {
          cur = a[at]
        } else {
          return false
        }
      } else {
        return false
      }
    } else {
      return false
    }
  }
  if op.op.isEmpty() { return truthy(cur) }
  if op.op == "=~" {
    var pattern = op.value
    if pattern.hasPrefix("/") && pattern.hasSuffix("/") {
      pattern = pattern.slice(1, pattern.count() - 1)
    }
    if let re = try? regex.compile(pattern) {
      return re.matches(asText(cur))
    }
    return false
  }
  let right = op.value
  if op.valueKind == "number" {
    let a = cur.asFloat()
    let b = right.toFloat()
    if let x = a, let y = b {
      if op.op == "==" { return x == y }
      if op.op == "!=" { return x != y }
      if op.op == ">" { return x > y }
      if op.op == "<" { return x < y }
      if op.op == ">=" { return x >= y }
      if op.op == "<=" { return x <= y }
    }
    return false
  }
  if op.valueKind == "bool" {
    let a = cur.asBool() ?? false
    let b = right == "true"
    if op.op == "==" { return a == b }
    if op.op == "!=" { return a != b }
    return false
  }
  let a = asText(cur)
  if op.op == "==" { return a == right }
  if op.op == "!=" { return a != right }
  if op.op == ">" { return a > right }
  if op.op == "<" { return a < right }
  if op.op == ">=" { return a >= right }
  if op.op == "<=" { return a <= right }
  return false
}

fn truthy(v: json.Value) -> bool = match v {
  .null => false
  .bool(b) => b
  .int(n) => n != 0
  .float(f) => f != 0.0
  .string(s) => !s.isEmpty()
  .array(a) => !a.isEmpty()
  .object(o) => !o.isEmpty()
}

/// A JSON value as the string a rule answers with: a string is itself, a
/// number loses its trailing zeros, and an object or an array is written
/// back out as JSON so a following step can read it.
pub fn asText(v: json.Value) -> string = match v {
  .null => ""
  .string(s) => s
  .bool(b) => if b { "true" } else { "false" }
  .int(n) => "{n}"
  .float(f) => floatText(f)
  .array(_) => "{v}"
  .object(_) => "{v}"
}

fn floatText(f: float) -> string {
  if f == f.floor() && abs(f) < 1e15 {
    return "{f.int()}"
  }
  return "{f}"
}

// ── Reading a path ──────────────────────────────────────────────────

fn parsePath(path: string) -> [Op] {
  let s = path.trim()
  let cs = s.chars()
  let n = cs.count()
  var ops: [Op] = []
  var i = 0
  if i < n && cs[i] == '$' { i += 1 }
  while i < n {
    if cs[i] == '.' {
      var deep = false
      if i + 1 < n && cs[i + 1] == '.' {
        deep = true
        i += 2
      } else {
        i += 1
      }
      if i < n && cs[i] == '*' {
        ops.push(Op(kind: "all", deep: deep))
        i += 1
        continue
      }
      var name = ""
      while i < n && cs[i] != '.' && cs[i] != '[' {
        name += cs[i]
        i += 1
      }
      if !name.isEmpty() {
        ops.push(Op(kind: "member", name: name, deep: deep))
      }
      continue
    }
    if cs[i] == '[' {
      var depth = 1
      var j = i + 1
      var quote = ""
      var inner = ""
      while j < n {
        let ch = cs[j]
        if !quote.isEmpty() {
          if "{ch}" == quote { quote = "" }
          inner += ch
          j += 1
          continue
        }
        if ch == '"' || ch == '\'' {
          quote = "{ch}"
          inner += ch
          j += 1
          continue
        }
        if ch == '[' { depth += 1 }
        if ch == ']' {
          depth -= 1
          if depth == 0 { break }
        }
        inner += ch
        j += 1
      }
      i = j + 1
      let x = inner.trim()
      if x == "*" {
        ops.push(Op(kind: "all"))
      } else if x.hasPrefix("?") {
        ops.push(parseFilter(x))
      } else if x.count() >= 2 && (x.hasPrefix("'") || x.hasPrefix("\"")) {
        ops.push(Op(kind: "member", name: x.slice(1, x.count() - 1)))
      } else if let at = x.toInt() {
        ops.push(Op(kind: "index", index: at))
      }
      continue
    }
    // A path written without its root marker: data.list.
    var name = ""
    while i < n && cs[i] != '.' && cs[i] != '[' {
      name += cs[i]
      i += 1
    }
    if !name.isEmpty() {
      ops.push(Op(kind: "member", name: name))
    }
  }
  return ops
}

fn parseFilter(inner: string) -> Op {
  var f = inner.trim()
  if f.hasPrefix("?") { f = f.slice(1, f.count()).trim() }
  while f.hasPrefix("(") && f.hasSuffix(")") {
    f = f.slice(1, f.count() - 1).trim()
  }
  let (parts, sep) = splitAny(f, ["=~", "==", "!=", ">=", "<=", ">", "<"])
  var cond = Op(kind: "filter")
  let left = parts[0].trim()
  cond.path = fieldPath(left)
  if parts.count() < 2 || sep.isEmpty() {
    return cond
  }
  cond.op = sep
  var right = parts[1].trim()
  if right.hasPrefix("'") || right.hasPrefix("\"") {
    cond.value = utilUnquote(right)
    cond.valueKind = "string"
  } else if right == "true" || right == "false" {
    cond.value = right
    cond.valueKind = "bool"
  } else if right == "null" {
    cond.valueKind = "null"
  } else if right.hasPrefix("/") && right.hasSuffix("/") {
    cond.value = right
    cond.valueKind = "string"
  } else if right.toFloat().isSome() {
    cond.value = right
    cond.valueKind = "number"
  } else if right.hasPrefix("@") {
    cond.value = right
    cond.valueKind = "path"
  } else {
    cond.value = right
    cond.valueKind = "string"
  }
  return cond
}

/// The fields after a filter's @: "@.a.b" -> ["a", "b"].
fn fieldPath(text: string) -> [string] {
  var t = text.trim()
  if t.hasPrefix("@") { t = t.slice(1, t.count()) }
  t = t.trimPrefix(".").trim()
  if t.isEmpty() { return [] }
  return t.split(".").map(p => p.trim()).filter(p => !p.isEmpty())
}

fn utilUnquote(text: string) -> string {
  let t = text.trim()
  if t.count() >= 2 { return t.slice(1, t.count() - 1) }
  return t
}

/// Split on whichever comparison appears first, top level.
fn splitAny(text: string, seps: [string]) -> ([string], string) {
  let cs = text.chars()
  let n = cs.count()
  var best = -1
  var which = ""
  for sep in seps {
    let at = topIndex(cs, sep)
    if at >= 0 && (best < 0 || at < best) {
      best = at
      which = sep
    }
  }
  if which.isEmpty() { return ([text], "") }
  var parts: [string] = []
  var start = 0
  var i = 0
  while i < n {
    if depthZero(cs, i) && startsChars(cs, i, which) {
      parts.push(charsText(cs, start, i))
      i += which.count()
      start = i
      continue
    }
    i += 1
  }
  parts.push(charsText(cs, start, n))
  return (parts, which)
}

fn topIndex(cs: [char], sep: string) -> int {
  var i = 0
  while i < cs.count() {
    if depthZero(cs, i) && startsChars(cs, i, sep) { return i }
    i += 1
  }
  return -1
}

fn depthZero(cs: [char], at: int) -> bool {
  var depth = 0
  var quote = ""
  var i = 0
  while i < at {
    let c = cs[i]
    if !quote.isEmpty() {
      if "{c}" == quote { quote = "" }
    } else if c == '"' || c == '\'' {
      quote = "{c}"
    } else if c == '(' || c == '[' {
      depth += 1
    } else if c == ')' || c == ']' {
      if depth > 0 { depth -= 1 }
    }
    i += 1
  }
  return depth == 0 && quote.isEmpty()
}

fn startsChars(cs: [char], i: int, prefix: string) -> bool {
  let ps = prefix.chars()
  if i + ps.count() > cs.count() { return false }
  var k = 0
  while k < ps.count() {
    if cs[i + k] != ps[k] { return false }
    k += 1
  }
  return true
}

fn charsText(cs: [char], from: int, to: int) -> string {
  var out = ""
  var i = max(0, from)
  while i < min(to, cs.count()) {
    out += cs[i]
    i += 1
  }
  return out
}
