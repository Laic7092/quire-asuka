// 导入的书源，以及它们开关的保存。
//
// 一本书源按它原来的 JSON 存下来：这里不认识的那些字段（登录、评论、
// 发现页）因此一个也不丢，读的时候才按 legado.asuka 的结构解释。同一个
// 地址只存一份，重复导入算「跳过」。

import std/crypto
import std/json
import std/store
import std/time

pub struct Entry {
  id: string
  name: string
  group: string = ""
  url: string
  enabled: bool = true
  /// 导入时那段书源 JSON，原样保存。
  json: string
  added: int = 0
  /// 最后一次改开关、分组或重新导入的时间（unix 秒）。同步时同 id
  /// 的三份数据按它取新的；旧版本留下的条目是 0。
  updated: int = 0
}

/// 书源和本机记下的删除。同步一次带走两样：还在的条目，和删掉的 id
/// 与时间。删除要留下墓碑，否则另一台设备（或云端旧快照）会把它补回来。
pub struct SyncState {
  entries: [Entry] = []
  removed: [string: int] = [:]
}

/// 一条书源的组：Legado 的 group 可以是逗号分隔的多个组。
pub fn entryGroups(e: Entry) -> [string] = e.group.split(",").map(g => g.trim()).filter(g => !g.isEmpty())

pub struct ImportReport {
  added: int = 0
  skipped: int = 0
  failed: int = 0
  names: [string] = []
  /// 新进来的那几条的 id：导入后只给它们播种变量。
  ids: [string] = []

  pub fn text() -> string {
    var parts: [string] = []
    if added > 0 { parts.push("导入 {added} 个书源") }
    if skipped > 0 { parts.push("已有 {skipped} 个") }
    if failed > 0 { parts.push("{failed} 个读不出来") }
    if parts.isEmpty() { return "没有可导入的书源" }
    return parts.joined(separator: " · ")
  }
}

/// 一次改动的版本：通常就是现在；同一秒里改过的，至少比上一次大 1。
fn touch(was: int) -> int {
  let now = time.now().unix()
  return if now > was { now } else { was + 1 }
}

/// 删除墓碑：比这本书源最后一次改动晚一点，免得同一秒里删了又算它还在。
fn tombstone(was: int) -> int = touch(was)

pub store Sources {
  pub state entries: [Entry] = store.read("sources.entries", [])
  /// 删掉的书源：id -> 删除时间。它跟着 catalog 走，别的设备据此也删。
  pub state removed: [string: int] = store.read("sources.removed", [:])

  effect { store.write("sources.entries", entries) }
  effect { store.write("sources.removed", removed) }

  pub fn list() -> [Entry] = entries

  /// 一条书源，按 id。
  pub fn find(id: string) -> Entry? = entries.find(e => e.id == id)

  /// 一条书源，按 id 或书源地址。书架上的在线书记的是地址（同一份书源
  /// 重新导入时 id 不变，但地址才是书自己认得的东西）。
  pub fn entryOf(key: string) -> Entry? = entries.find(e => e.id == key || e.url == key)

  /// 一个 id（或地址）的书源规则；书源不在了、或者那段 JSON 读不出来时没有。
  pub fn definitionOf(key: string) -> BookSource? {
    if let e = entryOf(key) { return definition(e) }
    return none
  }

  /// 同步回来的一批：同 id 的按 updated 取新的，墓碑里的不收。返回补了
  /// 几条。主要给同步库用；完整的合并见 sync.asuka 的 syncSources。
  pub fn merge(remote: [Entry]) -> int {
    var added = 0
    var changed = false
    var next = entries
    for e in remote {
      if let at = removed.get(e.id) {
        if e.updated <= at { continue }
      }
      if let at = next.index(k => k.id == e.id) {
        if e.updated > next[at].updated {
          next[at] = e
          changed = true
        }
      } else {
        next.push(e)
        added += 1
        changed = true
      }
    }
    if changed { entries = next }
    return added
  }

  pub fn enabled() -> [Entry] = entries.filter(e => e.enabled)

  pub fn count() -> int = entries.count()

  pub fn isEmpty() -> bool = entries.isEmpty()

  pub fn enabledCount() -> int = entries.count(where: e => e.enabled)

  pub fn has(url: string) -> bool = entries.any(e => e.url == url)

  /// 一次改一条或一批：批量是同一个写回，列表不会每行都写一次。
  pub fn setEnabled(id: string, on: bool) {
    setEnabledMany([id], on)
  }

  pub fn setEnabledMany(ids: [string], on: bool) {
    var next: [Entry] = []
    for e in entries {
      if ids.contains(e.id) && e.enabled != on {
        var row = e
        row.enabled = on
        row.updated = touch(row.updated)
        next.push(row)
      } else {
        next.push(e)
      }
    }
    entries = next
  }

  pub fn setGroup(id: string, group: string) {
    setGroupMany([id], group)
  }

  pub fn setGroupMany(ids: [string], group: string) {
    var next: [Entry] = []
    for e in entries {
      if ids.contains(e.id) && e.group != group {
        var row = e
        row.group = group
        row.updated = touch(row.updated)
        next.push(row)
      } else {
        next.push(e)
      }
    }
    entries = next
  }

  pub fn remove(id: string) {
    removeMany([id])
  }

  pub fn removeMany(ids: [string]) {
    var next: [Entry] = []
    for e in entries {
      if ids.contains(e.id) {
        removed[e.id] = tombstone(e.updated)
      } else {
        next.push(e)
      }
    }
    entries = next
  }

  pub fn clear() {
    for e in entries {
      removed[e.id] = tombstone(e.updated)
    }
    entries = []
  }

  /// 同步用的快照：现在还在的书源，和本机记下的删除。
  pub fn syncState() -> SyncState = SyncState(entries: entries, removed: removed)

  /// 同步合并后的结果写回本机。
  pub fn applySync(state: SyncState) {
    entries = state.entries
    removed = state.removed
  }

  /// 一段书源 JSON（单个或一份合集）导进来。读不出来的条目只计数，不停
  /// 下整份导入。
  pub fn importText(text: string) throws -> ImportReport {
    let values = try parseList(text)
    var report = ImportReport()
    for v in values {
      let url = urlOf(v)
      if url.isEmpty() {
        report.failed += 1
        continue
      }
      if entries.any(e => e.url == url) {
        report.skipped += 1
        continue
      }
      let name = nameOf(v)
      let def = try? decodeSource(v)
      let id = crypto.sha256(url.bytes()).hex()
      // 刚删掉的源又导进来：它比墓碑新，下一次同步不该再把它删掉。
      var stamp = time.now().unix()
      if let at = removed.get(id) {
        if stamp <= at { stamp = at + 1 }
      }
      removed.remove(id)
      entries.push(Entry(
        id: id,
        name: name,
        group: def?.bookSourceGroup ?? "",
        url: url,
        enabled: def?.enabled ?? true,
        json: "{v}",
        added: stamp,
        updated: stamp,
      ))
      report.added += 1
      report.names.push(name)
      report.ids.push(id)
    }
    return report
  }

  /// 从一段地址导入：书源合集常放在一个 raw 链接里。
  pub async fn importUrl(address: string) throws -> ImportReport {
    let page = try await get(address.trim(), [:])
    return try importText(page.text)
  }

  /// 一条书源的结构；读不出来时没有。
  pub fn definition(e: Entry) -> BookSource? {
    if let v = try? json.parse(e.json) {
      return try? decodeSource(v)
    }
    return none
  }

  /// 书源变量：引擎 0.3.0 不读导入 JSON 里的 `variable`，只读它自己
  /// 存储目录下的那份。所以导入（或从同步里拿回来）时，把书源自带的
  /// 变量写一遍；已经有值的不动，用户改过的不会被盖掉。
  /// `only` 为空时看所有书源（开机时补一次）。
  pub async fn seedVariables(only: [string] = []) -> int {
    if !nativeAvailable() { return 0 }
    var seeded = 0
    for e in entries {
      if !only.isEmpty() && !only.contains(e.id) { continue }
      let def = definition(e)
      if def == none { continue }
      let d = def!
      let raw = d.variable.trim()
      if raw.isEmpty() { continue }
      let current = (try? await storedVariables(d)) ?? ""
      if !current.trim().isEmpty() { continue }
      do {
        try await saveVariables(d, raw)
        seeded += 1
      } catch {}
    }
    return seeded
  }
}
