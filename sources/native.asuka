// 原生书源引擎（legado-engine，Rust，经 C ABI）：完整的 Legado 规则、
// QuickJS、cookie 与书源变量。C 一侧（c/legado.c）拿着唯一的 handle；
// 0.2.0 起同一个 handle 可以并发调用，这里只把字符串递过去，再在
// `spawn` 的线程上等它。0.3.0 加了 `legado_download`（书源的文件）和
// `legado_eval`（书源变量，以及书源自己的登录脚本）。
//
// 没有这个库的平台（iOS 模拟器、Windows、Android、网页）由 C 一侧编译成
// “不可用”，engine.asuka 于是直接说这个平台暂时不能搜索书源。

import std/json

/// 搜索结果的一行，字段名是 Legado 的 `SearchBook`。
struct NativeSearchBook {
  name: string = ""
  author: string = ""
  bookUrl: string = ""
  coverUrl: string? = none
  intro: string? = none
  kind: string? = none
  lastChapter: string? = none
  wordCount: string? = none
}

/// 详情页的一本书（`Book`），也用来把书递回原生引擎：目录和正文的规则
/// 会读 `{{book.name}}` 这类字段。
struct NativeBook {
  name: string = ""
  author: string = ""
  bookUrl: string = ""
  tocUrl: string? = none
  coverUrl: string? = none
  intro: string? = none
  kind: string? = none
  wordCount: string? = none
  latestChapterTitle: string? = none
  downloadUrls: string? = none
}

/// 目录的一章（`BookChapter`）。
struct NativeChapter {
  title: string = ""
  url: string = ""
  index: int = 0
  isVip: bool = false
  isPay: bool = false
  isVolume: bool = false
}

extern fn quire_legado_available() -> Int32
extern fn quire_legado_open(storage: CString) -> Int32
extern fn quire_legado_close()
extern fn quire_legado_version() -> CString

extern fn quire_legado_search(source: CString, key: CString, page: Int32) -> CString?
extern fn quire_legado_explore(source: CString, url: CString) -> CString?
extern fn quire_legado_info(source: CString, bookUrl: CString) -> CString?
extern fn quire_legado_toc(source: CString, bookJson: CString) -> CString?
extern fn quire_legado_content(source: CString, bookJson: CString, chapterJson: CString) -> CString?
extern fn quire_legado_download(source: CString, url: CString, dest: CString) -> CString?
extern fn quire_legado_eval(source: CString, script: CString, input: CString, baseUrl: CString) -> CString?
extern fn quire_legado_set_cookie(source: CString, url: CString, cookie: CString) -> CString?
extern fn quire_legado_cookie_header(source: CString, url: CString) -> CString?
extern fn quire_legado_eval_rule(source: CString, rule: CString, body: CString, baseUrl: CString) -> CString?
extern fn quire_legado_error() -> CString

pub fn nativeAvailable() -> bool = quire_legado_available() != 0

pub fn nativeVersion() -> string = quire_legado_version()

/// 书源原样的 JSON：原生引擎要那些这个应用不解释的字段（登录、发现、
/// 变量）。结构和它的字段对不上时，退回结构自己的 JSON。
pub fn sourceJSON(s: BookSource) -> string {
  if !s.raw.trim().isEmpty() { return s.raw }
  return json.encode(s)
}

/// 打开一次，之后一直用这个 handle；存储目录保存书源的 cookie 和变量。
/// 已经打开时什么都不做，返回 true。
pub fn nativeOpen(storage: string) -> bool = quire_legado_open(storage) != 0

/// 一次原生调用失败时，C 一侧把这个线程的错误留在 quire_legado_error。
pub async fn nativeSearch(source: string, key: string, page: int) throws -> string {
  let at = i32(page)
  return try await spawn {
    if let text = quire_legado_search(source, key, at) { return text }
    throw Error(quire_legado_error())
  }
}

pub async fn nativeExplore(source: string, url: string) throws -> string {
  return try await spawn {
    if let text = quire_legado_explore(source, url) { return text }
    throw Error(quire_legado_error())
  }
}

pub async fn nativeInfo(source: string, bookUrl: string) throws -> string {
  return try await spawn {
    if let text = quire_legado_info(source, bookUrl) { return text }
    throw Error(quire_legado_error())
  }
}

pub async fn nativeToc(source: string, bookJson: string) throws -> string {
  return try await spawn {
    if let text = quire_legado_toc(source, bookJson) { return text }
    throw Error(quire_legado_error())
  }
}

pub async fn nativeContent(source: string, bookJson: string, chapterJson: string) throws -> string {
  return try await spawn {
    if let text = quire_legado_content(source, bookJson, chapterJson) { return text }
    throw Error(quire_legado_error())
  }
}

/// 书源的一个文件写到 `dest`（父目录由引擎建）。下载是长请求，放在
/// `spawn` 的线程上。
pub async fn nativeDownload(source: string, url: string, dest: string) throws -> string {
  return try await spawn {
    if let text = quire_legado_download(source, url, dest) { return text }
    throw Error(quire_legado_error())
  }
}

/// 一段脚本带着书源的绑定跑一次：`source.put` / `source.putVariable`
/// 写下的东西由引擎持久化在存储目录里。
pub async fn nativeEval(source: string, script: string, input: string = "", baseUrl: string = "") throws -> string {
  return try await spawn {
    if let text = quire_legado_eval(source, script, input, baseUrl) { return text }
    throw Error(quire_legado_error())
  }
}

/// 从外面（网页登录）拿到的 Cookie 头，放进书源自己的 jar。
pub async fn nativeSetCookie(source: string, url: string, cookie: string) throws {
  try await spawn {
    if quire_legado_set_cookie(source, url, cookie) == none {
      throw Error(quire_legado_error())
    }
  }
}

/// 书源现在会送出的 Cookie 头（本机 jar 里的）。
pub async fn nativeCookieHeader(source: string, url: string) throws -> string {
  return try await spawn {
    if let text = quire_legado_cookie_header(source, url) { return text }
    throw Error(quire_legado_error())
  }
}

/// 一条规则跑在一段已经在手里的文字上：不发请求，也不需要书源状态。
/// 引擎没链接时抛错（available() 是 false）。
pub fn nativeEvalRule(source: string, rule: string, body: string, baseUrl: string = "") throws -> string {
  if let text = quire_legado_eval_rule(source, rule, body, baseUrl) { return text }
  throw Error(quire_legado_error())
}

/// 同一条规则，但在别的线程上跑：正文里的 HTML 要交给引擎的解析器
/// 变成文字，不能卡住界面。
pub async fn nativeEvalRuleAsync(source: string, rule: string, body: string, baseUrl: string = "") throws -> string {
  return try await spawn {
    if let text = quire_legado_eval_rule(source, rule, body, baseUrl) { return text }
    throw Error(quire_legado_error())
  }
}
