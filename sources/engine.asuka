// 一个书源能做的事：搜索、详情、目录、正文，以及文件型书源的下载。
// 全部交给 legado-engine：
// Legado 的规则、QuickJS、cookie 和书源变量都在它那里。这个应用只把书源的
// JSON、书和章节的字段递过去，再把回来的 JSON 变成界面用的结构。
//
// 没有这个库的平台（iOS 模拟器、Windows、Android、网页）由 c/legado.c
// 编译成“不可用”；下面每个入口说清楚，而不是偷偷换成另一套规则实现。

import std/json

pub struct Book {
  name: string
  author: string = ""
  kind: string = ""
  wordCount: string = ""
  lastChapter: string = ""
  intro: string = ""
  coverUrl: string = ""
  bookUrl: string
  /// 目录所在的那一页，详情页说过的话：目录和正文的规则要它。
  tocUrl: string = ""
  /// 详情页给的下载链接（一行一个 `名称::地址`）：文件型书源只有这个。
  downloadUrls: string = ""
}

pub struct Info {
  book: Book
  /// 目录所在的地址：详情页说别处时是别处，否则就是详情页自己。
  tocUrl: string
}

pub struct Chapter {
  title: string
  url: string
  /// 全书里的章号：正文规则里的 `chapter.index` 用它。
  index: int = 0
  isVip: bool = false
  isPay: bool = false
  isVolume: bool = false
}

/// A book's own page and its chapters, as the detail screen loads them.
pub struct Detail {
  info: Info
  chapters: [Chapter]
  /// 文件型书源（`bookSourceType: 3`）的下载选项：它有文件，没有章节。
  files: [DownloadOption] = []
}

/// A file the engine wrote: the bytes at `path`, and how to read them
/// (`charset` is `utf-8`, `gb18030`, …).
pub struct Download {
  path: string = ""
  size: int = 0
  contentType: string? = none
  charset: string = ""
  url: string = ""
}

/// 这个平台有没有可以工作的书源引擎。
pub fn bookSourcesAvailable() -> bool = nativeAvailable()

fn unavailable() -> Error = Error("这个平台还没有书源引擎（legado-engine），暂时不能搜索书源")

/// 原生引擎的空值是一个空字符串；规则没写时它给 null。
fn maybe(v: string) -> string? = if v.isEmpty() { none } else { v }

/// 原生引擎返回的一本书，补进搜索已经有的那本：引擎没给的字段不丢。
fn mergeBook(from: Book, parsed: NativeBook) -> Book {
  var book = from
  if !parsed.name.trim().isEmpty() { book.name = parsed.name }
  if !parsed.author.trim().isEmpty() { book.author = parsed.author }
  if !parsed.bookUrl.trim().isEmpty() { book.bookUrl = parsed.bookUrl }
  if let kind = parsed.kind {
    if !kind.trim().isEmpty() { book.kind = kind }
  }
  if let words = parsed.wordCount {
    if !words.trim().isEmpty() { book.wordCount = words }
  }
  if let intro = parsed.intro {
    if !intro.trim().isEmpty() { book.intro = intro }
  }
  if let cover = parsed.coverUrl {
    if !cover.trim().isEmpty() { book.coverUrl = cover }
  }
  if let last = parsed.latestChapterTitle {
    if !last.trim().isEmpty() { book.lastChapter = last }
  }
  if let toc = parsed.tocUrl {
    if !toc.trim().isEmpty() { book.tocUrl = toc }
  }
  if let files = parsed.downloadUrls {
    if !files.trim().isEmpty() { book.downloadUrls = files }
  }
  return book
}

fn fromSearch(r: NativeSearchBook) -> Book = Book(
  name: r.name,
  author: r.author,
  kind: r.kind ?? "",
  wordCount: r.wordCount ?? "",
  lastChapter: r.lastChapter ?? "",
  intro: r.intro ?? "",
  coverUrl: r.coverUrl ?? "",
  bookUrl: r.bookUrl,
)

fn bookJSON(book: Book) -> string = json.encode(NativeBook(
  name: book.name,
  author: book.author,
  bookUrl: book.bookUrl,
  tocUrl: maybe(book.tocUrl),
  coverUrl: maybe(book.coverUrl),
  intro: maybe(book.intro),
  kind: maybe(book.kind),
  wordCount: maybe(book.wordCount),
  latestChapterTitle: maybe(book.lastChapter),
  downloadUrls: maybe(book.downloadUrls),
))

fn chapterJSON(chapter: Chapter) -> string = json.encode(NativeChapter(
  title: chapter.title,
  url: chapter.url,
  index: chapter.index,
  isVip: chapter.isVip,
  isPay: chapter.isPay,
  isVolume: chapter.isVolume,
))

/// 正文有时是 HTML（`@html`、`all`，或脚本直接返回一段 HTML）。阅读器
/// 只画文字，所以交给引擎自己的 HTML 解析器取文本：`body` 的 textNodes
/// 会保留段落之间的换行，实体也会解码。规则本身仍然全在引擎里。
fn looksLikeMarkup(text: string) -> bool {
  let cs = text.chars()
  var i = 0
  while i + 1 < cs.count() {
    if cs[i] == '<' {
      var j = i + 1
      if cs[j] == '/' { j += 1 }
      if j < cs.count() && (cs[j].isLetter() || cs[j] == '!') {
        var k = j
        while k < cs.count() && k - i < 120 {
          if cs[k] == '>' { return true }
          k += 1
        }
      }
    }
    i += 1
  }
  return false
}

async fn plainText(s: BookSource, text: string) -> string {
  if !looksLikeMarkup(text) { return text }
  if let plain = try? await nativeEvalRuleAsync(sourceJSON(s), rule: "body", body: text) {
    let trimmed = plain.trim()
    if !trimmed.isEmpty() { return trimmed }
  }
  return text
}

async fn searchNative(s: BookSource, key: string, page: int) throws -> [Book] {
  let text = try await nativeSearch(sourceJSON(s), key: key, page: page)
  let rows: [NativeSearchBook] = try json.decode(text)
  var out: [Book] = []
  for row in rows {
    if row.name.trim().isEmpty() || row.bookUrl.trim().isEmpty() { continue }
    out.push(fromSearch(row))
  }
  return out
}

async fn exploreNative(s: BookSource, url: string) throws -> [Book] {
  let text = try await nativeExplore(sourceJSON(s), url: url)
  let rows: [NativeSearchBook] = try json.decode(text)
  var out: [Book] = []
  for row in rows {
    if row.name.trim().isEmpty() || row.bookUrl.trim().isEmpty() { continue }
    out.push(fromSearch(row))
  }
  return out
}

/// 搜索：一页结果，每条一本书。没有规则、或者什么都没找到，都是空的。
pub async fn search(s: BookSource, key: string, page: int) throws -> [Book] {
  if !bookSourcesAvailable() { throw unavailable() }
  return try await searchNative(s, key, page)
}

/// 发现页的一个分类：和搜索一样，一条一本书。
pub async fn explore(s: BookSource, url: string) throws -> [Book] {
  if !bookSourcesAvailable() { throw unavailable() }
  return try await exploreNative(s, url)
}

/// 发现页的下一页。引擎的 `legado_explore` 只取第 1 页（ABI 没有页参数），
/// 页号由 `explorePageUrl` 写进分类地址。
pub async fn explorePage(s: BookSource, url: string, page: int) throws -> [Book] {
  if !bookSourcesAvailable() { throw unavailable() }
  return try await exploreNative(s, explorePageUrl(url, page))
}

async fn infoNative(s: BookSource, bookUrl: string, from: Book) throws -> Info {
  let text = try await nativeInfo(sourceJSON(s), bookUrl: bookUrl)
  let parsed: NativeBook = try json.decode(text)
  var book = mergeBook(from, parsed)
  if book.bookUrl.trim().isEmpty() { book.bookUrl = bookUrl }
  if book.tocUrl.trim().isEmpty() { book.tocUrl = book.bookUrl }
  return Info(book: book, tocUrl: book.tocUrl)
}

/// 详情：详情页上有的字段补进来，搜索已经给的不再丢。
pub async fn info(s: BookSource, bookUrl: string, from: Book) throws -> Info {
  if !bookSourcesAvailable() { throw unavailable() }
  return try await infoNative(s, bookUrl, from)
}

/// 详情页和目录一起取：一本书点开后要的东西。文件型书源没有目录，
/// 就不去要，直接把它给出的文件带回来。
pub async fn detailOf(s: BookSource, book: Book) throws -> Detail {
  let own = try await info(s, book.bookUrl, book)
  let files = downloadOptions(own.book.downloadUrls)
  if isDownloadSource(s) {
    return Detail(info: own, chapters: [], files: files)
  }
  let chapters = try await tocOf(s, own.book)
  return Detail(info: own, chapters: chapters, files: files)
}

async fn tocNative(s: BookSource, book: Book) throws -> [Chapter] {
  let text = try await nativeToc(sourceJSON(s), bookJson: bookJSON(book))
  let rows: [NativeChapter] = try json.decode(text)
  var out: [Chapter] = []
  for row in rows {
    if row.url.trim().isEmpty() { continue }
    out.push(Chapter(
      title: if row.title.isEmpty() { "第 {out.count() + 1} 章" } else { row.title },
      url: row.url,
      index: row.index,
      isVip: row.isVip,
      isPay: row.isPay,
      isVolume: row.isVolume,
    ))
  }
  if out.isEmpty() { throw Error("这个书源没有目录") }
  return out
}

/// 目录：一章一项，跟着 nextTocUrl 翻页。
pub async fn tocOf(s: BookSource, book: Book) throws -> [Chapter] {
  if !bookSourcesAvailable() { throw unavailable() }
  return try await tocNative(s, book)
}

async fn contentNative(s: BookSource, book: Book, chapter: Chapter) throws -> string {
  let raw = try await nativeContent(
    sourceJSON(s),
    bookJson: bookJSON(book),
    chapterJson: chapterJSON(chapter),
  )
  let text = await plainText(s, raw)
  if text.trim().isEmpty() { throw Error("这一章没有读到正文") }
  return text
}

/// 正文：一章的文字。规则能读这本书（`book.name` 之类）和这一章。
pub async fn contentOf(s: BookSource, book: Book, chapter: Chapter) throws -> string {
  if !bookSourcesAvailable() { throw unavailable() }
  return try await contentNative(s, book, chapter)
}

/// 一本书的所有章节连成的一段文字，给「加入书架」写成的 .txt 用：每章
/// 一个标题、空行、正文。
pub async fn wholeText(s: BookSource, tocUrl: string, limit: int = 0) throws -> string {
  let book = Book(name: "", bookUrl: tocUrl, tocUrl: tocUrl)
  let chapters = try await tocOf(s, book)
  var out: [string] = []
  var count = 0
  for chapter in chapters {
    if limit > 0 && count >= limit { break }
    let body = try? await contentOf(s, book, chapter)
    if let text = body {
      out.push(chapter.title)
      out.push("")
      out.push(text)
      out.push("")
    }
    count += 1
  }
  if out.isEmpty() { throw Error("没有读到任何章节") }
  return out.joined(separator: "\n")
}

/// 一个文件：书源用自己的请求头、cookie 和代理把它取下来，原样写到
/// `into`（引擎建父目录，先写 `.part` 再改名）。`charset` 是引擎嗅出
/// 的读法，TXT 导入时按它读。
pub async fn downloadOf(s: BookSource, url: string, into: string) throws -> Download {
  if !bookSourcesAvailable() { throw unavailable() }
  let text = try await nativeDownload(sourceJSON(s), url: url, dest: into)
  return try json.decode(text)
}

/// 书源现在存着的变量（引擎里那份，不是书源 JSON 里的 `variable`：
/// 引擎 0.3.0 不读那个字段，导入时的值由 `seedVariables` 写进来）。
pub async fn storedVariables(s: BookSource) throws -> string {
  if !bookSourcesAvailable() { throw unavailable() }
  return try await nativeEval(sourceJSON(s), script: "source.getVariable()")
}

/// 存一段变量 JSON：整段给 `getVariable()`，每个键也给 `get()`。
pub async fn saveVariables(s: BookSource, text: string) throws {
  if !bookSourcesAvailable() { throw unavailable() }
  let t = text.trim()
  if !t.isEmpty() {
    let parsed = try? json.parse(t)
    if parsed == none { throw Error(r#"变量要写成一段 JSON 对象，如 {"user":"…","pass":"…"}"#) }
    if let v = parsed {
      if v.asObject() == none {
        throw Error(r#"变量要写成一段 JSON 对象，如 {"user":"…","pass":"…"}"#)
      }
    }
  }
  try await nativeEval(sourceJSON(s), script: variablesScript(t))
}

/// 书源的 Cookie 头（从网页登录里拿回来，或看本机现在的登录态）。
pub async fn cookieHeaderOf(s: BookSource, url: string) throws -> string {
  if !bookSourcesAvailable() { throw unavailable() }
  return try await nativeCookieHeader(sourceJSON(s), url: url)
}

pub async fn setCookieOf(s: BookSource, url: string, cookie: string) throws {
  if !bookSourcesAvailable() { throw unavailable() }
  try await nativeSetCookie(sourceJSON(s), url: url, cookie: cookie)
}

/// 清掉这个书源在 url 下的 Cookie（引擎的 `cookie.removeCookie`）。
/// 网页登录换了账号，或者登录态坏了时用。
pub async fn clearCookiesOf(s: BookSource, url: string) throws {
  if !bookSourcesAvailable() { throw unavailable() }
  let at = if url.trim().isEmpty() { baseUrlOf(s) } else { url.trim() }
  if at.isEmpty() { throw Error("这条书源没有地址，清不了 Cookie") }
  try await nativeEval(sourceJSON(s), script: "cookie.removeCookie({json.encode(at)});")
}

/// 把一段 Cookie 头当成这个书源在那个地址下的整套会话：先清掉旧的，再写新的。
///
/// `legado_set_cookie` 只是**往 jar 里加**：从浏览器粘来的是 host-only
/// （`www.wenku8.net`），登录脚本下发的 `Set-Cookie` 是域级（`.wenku8.net`），
/// 同名两条会一起发出去（`jieqiUserInfo=new; …; jieqiUserInfo=old`）。
/// 旧的那条一旦在 jar 里，jsLib 的 `loggedIn()` 只看 Cookie 在不在，登录
/// 脚本就不再 POST，账号密码填对了也换不上会话。所以粘一份 = 换一套。
pub async fn replaceCookiesOf(s: BookSource, url: string, cookie: string) throws {
  if !bookSourcesAvailable() { throw unavailable() }
  try await clearCookiesOf(s, url: url)
  try await setCookieOf(s, url: url, cookie: cookie)
}
