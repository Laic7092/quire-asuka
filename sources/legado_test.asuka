// 书源 JSON 的读法：合集、单个、请求头、变量和地址。

let sample = r##"[{"bookSourceName":"示例","bookSourceUrl":"https://x.test","bookSourceGroup":"小说, 完本","header":"{\"User-Agent\":\"UA\"}","variable":"{\"host\":\"h\"}","enabled":true,"searchUrl":"/search?q={{key}}&p={{page}}","ruleSearch":{"bookList":".row","name":".name@text","bookUrl":"a@href"},"ruleToc":{"chapterList":"#list a","chapterName":"text","chapterUrl":"href"},"ruleContent":{"content":"#content"}},{"bookSourceUrl":""}]"##

test "a collection reads its sources and skips what has no address" {
  let list = try parseList(sample)
  expect(list.count() == 1)
  let def = try decodeSource(list[0])
  expect(def.bookSourceName == "示例")
  expect(def.bookSourceUrl == "https://x.test")
  expect(groupsOf(def) == ["小说", "完本"])
  expect(def.tocRules().chapterList == "#list a")
}

test "a single source reads too" {
  let one = r#"{"bookSourceName":"一个","bookSourceUrl":"x.test","searchUrl":"/s?q={{key}}"}"#
  let list = try parseList(one)
  expect(list.count() == 1)
  let def = try decodeSource(list[0])
  expect(baseUrlOf(def) == "http://x.test")
}

test "headers and variables are JSON in a string" {
  let list = try parseList(sample)
  let def = try decodeSource(list[0])
  expect(headersOf(def).get("User-Agent") == "UA")
  expect(varsOf(def).get("host") == "h")
}

test "a source keeps the JSON the app doesn't interpret" {
  let one = r#"{"bookSourceName":"一个","bookSourceUrl":"x.test","searchUrl":"/s?q={{key}}","loginUrl":"/login"}"#
  let def = try decodeSource(try parseList(one)[0])
  expect(def.raw.contains("\"loginUrl\""))
  expect(def.raw.contains("x.test"))
}

test "exploreUrl reads its categories" {
  let one = r#"{"bookSourceName":"一个","bookSourceUrl":"x.test","exploreUrl":"[{\"title\":\"玄幻\",\"url\":\"/list?p={{page}}\"},{\"title\":\"\",\"url\":\"/all\"}]"}"#
  let def = try decodeSource(try parseList(one)[0])
  let categories = exploreCategories(def)
  expect(categories.count() == 2)
  expect(categories[0].title == "玄幻")
  expect(categories[0].url.contains("/list"))
  expect(categories[1].title == "分类 2")
}

test "a plain exploreUrl is one category" {
  let one = r#"{"bookSourceName":"一个","bookSourceUrl":"x.test","exploreUrl":"/all?p={{page}}"}"#
  let def = try decodeSource(try parseList(one)[0])
  let categories = exploreCategories(def)
  expect(categories.count() == 1)
  expect(categories[0].title == "发现")
  expect(categories[0].url.contains("/all"))
}

test "exploreUrl also accepts a plain list of addresses" {
  let one = r#"{"bookSourceName":"一个","bookSourceUrl":"x.test","exploreUrl":"[\"/a\",\"/b\"]"}"#
  let def = try decodeSource(try parseList(one)[0])
  let categories = exploreCategories(def)
  expect(categories.count() == 2)
  expect(categories[0].url == "/a")
  expect(categories[1].url == "/b")
}

test "a download source keeps its file links" {
  let one = r#"{"bookSourceName":"下载","bookSourceUrl":"https://d.test","bookSourceType":3,"ruleBookInfo":{"downloadUrls":"TXT::https://d.test/1.txt\nEPUB::https://d.test/1.epub\nhttps://d.test/2.txt\n\n# 注释\nhttps://d.test/2.txt"}}"#
  let def = try decodeSource(try parseList(one)[0])
  expect(isDownloadSource(def))
  expect(def.infoRules().downloadUrls.contains("1.epub"))
  let files = downloadOptions(def.infoRules().downloadUrls)
  expect(files.count() == 3)
  expect(files[0].name == "TXT")
  expect(files[0].url == "https://d.test/1.txt")
  expect(files[1].name == "EPUB")
  // 没有名字的，按地址给一个；重复的地址只留一份。
  expect(files[2].name == "TXT 3")
  expect(files[2].url == "https://d.test/2.txt")
}

test "a text source can have download links too" {
  let one = r#"{"bookSourceName":"在线","bookSourceUrl":"https://o.test","bookSourceType":0,"ruleBookInfo":{"downloadUrls":"简体::https://dl.test/down.php?type=utf8&id=1"}}"#
  let def = try decodeSource(try parseList(one)[0])
  expect(!isDownloadSource(def))
  let files = downloadOptions(def.infoRules().downloadUrls)
  expect(files.count() == 1)
  expect(files[0].name == "简体")
}

test "login and variable comments are read" {
  let one = r#"{"bookSourceName":"登录","bookSourceUrl":"https://l.test","loginUrl":"https://l.test/login","variableComment":"先填账号密码"}"#
  let def = try decodeSource(try parseList(one)[0])
  expect(def.loginUrl == "https://l.test/login")
  expect(def.variableComment == "先填账号密码")
}

test "a variable is stored for getVariable and for each key" {
  let script = variablesScript(r#"{"user":"a","pass":"b"}"#)
  expect(script.contains("source.putVariable("))
  expect(script.contains("source.put(\"user\", \"a\")"))
  expect(script.contains("source.put(\"pass\", \"b\")"))
}

test "variable keys come from the variable field and the source's scripts" {
  let one = r#"{"bookSourceName":"登录","bookSourceUrl":"https://w.test","variable":"{\"user\":\"\",\"pass\":\"\"}","jsLib":"var a=source.get('wenku8_user'); source.put(\"wenku8_pass\", 'x');"}"#
  let def = try decodeSource(try parseList(one)[0])
  let keys = variableKeys(def)
  expect(keys.contains("user"))
  expect(keys.contains("pass"))
  expect(keys.contains("wenku8_user"))
  expect(keys.contains("wenku8_pass"))
}

test "a variable value reads and writes without losing the others" {
  let text = r#"{"user":"a","keep":"x","n":3}"#
  expect(variableValueOf(text, "user") == "a")
  expect(variableValueOf(text, "n") == "3")
  let next = withVariableValue(text, "pass", "b")
  expect(variableValueOf(next, "user") == "a")
  expect(variableValueOf(next, "keep") == "x")
  expect(variableValueOf(next, "pass") == "b")
}

test "a source with no variable still shows the keys its login script asks for" {
  let one = r#"{"bookSourceName":"轻小说文库","bookSourceUrl":"https://www.wenku8.net","jsLib":"var u=source.get('wenku8_user');var p=source.get('wenku8_pass');"}"#
  let def = try decodeSource(try parseList(one)[0])
  let keys = variableKeys(def)
  expect(keys == ["wenku8_user", "wenku8_pass"])
}
