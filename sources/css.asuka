// CSS selectors, as book sources are written with them.
//
// Legado's selectors are Jsoup's: the CSS a browser knows, plus a few
// pseudo-classes Jsoup adds (:contains, :matches, :eq, :has). This is the
// subset sources actually use: tag, *, .class, #id, [attr], [attr=value] and
// its *= ^= $= ~= |= forms, the descendant, child and sibling combinators,
// and the pseudo-classes below. A selector this can't read matches nothing
// rather than failing the rule.

import std/regex

pub struct AttrTest {
  name: string
  /// "", "=", "*=", "^=", "$=", "~=", "|="
  op: string = ""
  value: string = ""
}

pub struct Pseudo {
  name: string
  arg: string = ""
}

pub struct Part {
  /// How this part relates to the one before it: " " (inside), ">", "+", "~".
  combinator: string = ""
  tag: string = ""
  id: string = ""
  classes: [string] = []
  attrs: [AttrTest] = []
  pseudos: [Pseudo] = []
  /// A position over the group's matches: "first", "last", "eq", "lt", "gt".
  indexOp: string = ""
  index: int = 0

  mut fn addPseudo(name: string, arg: string) {
    if name == "first" || name == "last" {
      indexOp = name
      return
    }
    if name == "eq" || name == "lt" || name == "gt" {
      indexOp = name
      index = arg.toInt() ?? 0
      return
    }
    pseudos.push(Pseudo(name: name, arg: arg))
  }
}

fn isIdentChar(c: char) -> bool = c.isLetter() || c.isDigit() || c == '-' || c == '_'

/// The elements `selector` matches under `within`, in document order.
pub fn select(tree: Tree, within: int, selector: string) -> [int] {
  var out: [int] = []
  var seen: Set<int> = Set<int>()
  for group in splitTop(selector, ",") {
    let parts = parseGroup(group)
    if parts.isEmpty() { continue }
    var found: [int] = []
    for i in descendants(tree, within) {
      if matchesChain(tree, within, i, parts, parts.count() - 1) {
        found.push(i)
      }
    }
    found = applyIndex(found, parts[parts.count() - 1])
    for i in found {
      if seen.insert(i) { out.push(i) }
    }
  }
  out.sort()
  return out
}

fn matchesChain(tree: Tree, within: int, i: int, parts: [Part], k: int) -> bool {
  if !matchesPart(tree, i, parts[k]) { return false }
  if k == 0 { return true }
  let comb = parts[k].combinator
  if comb == ">" {
    let p = tree.nodes[i].parent
    if p <= 0 { return false }
    return matchesChain(tree, within, p, parts, k - 1)
  }
  if comb == "+" {
    let s = prevElement(tree, i)
    return s > 0 && matchesChain(tree, within, s, parts, k - 1)
  }
  if comb == "~" {
    var s = prevElement(tree, i)
    while s > 0 {
      if matchesChain(tree, within, s, parts, k - 1) { return true }
      s = prevElement(tree, s)
    }
    return false
  }
  var p = tree.nodes[i].parent
  while p > 0 {
    if p != within && !isInside(tree, p, within) { break }
    if matchesChain(tree, within, p, parts, k - 1) { return true }
    p = tree.nodes[p].parent
  }
  return false
}

fn matchesPart(tree: Tree, i: int, p: Part) -> bool {
  if i <= 0 || i >= tree.nodes.count() { return false }
  let node = tree.nodes[i]
  if node.name.isEmpty() { return false }
  if !p.tag.isEmpty() && p.tag != "*" && node.name != p.tag { return false }
  if !p.id.isEmpty() && attr(tree, i, "id") != p.id { return false }
  if !p.classes.isEmpty() {
    let classes = attr(tree, i, "class").fields()
    for c in p.classes {
      if !classes.contains(c) { return false }
    }
  }
  for a in p.attrs {
    let v = attr(tree, i, a.name)
    if a.op.isEmpty() {
      if !node.attrs.has(a.name) { return false }
    } else if a.op == "=" {
      if v != a.value { return false }
    } else if a.op == "*=" {
      if !v.contains(a.value) { return false }
    } else if a.op == "^=" {
      if !v.hasPrefix(a.value) { return false }
    } else if a.op == "$=" {
      if !v.hasSuffix(a.value) { return false }
    } else if a.op == "~=" {
      if !v.fields().contains(a.value) { return false }
    } else if a.op == "|=" {
      if v != a.value && !v.hasPrefix("{a.value}-") { return false }
    } else if a.op == "!=" {
      if v == a.value { return false }
    }
  }
  for ps in p.pseudos {
    if !matchesPseudo(tree, i, ps) { return false }
  }
  return true
}

fn matchesPseudo(tree: Tree, i: int, ps: Pseudo) -> bool {
  let name = ps.name
  if name == "contains" {
    return textOf(tree, i).lower().contains(ps.arg.lower())
  }
  if name == "containsown" {
    return ownText(tree, i).lower().contains(ps.arg.lower())
  }
  if name == "matches" {
    if let re = try? regex.compile(ps.arg) {
      return re.matches(textOf(tree, i))
    }
    return false
  }
  if name == "not" {
    let parts = parseGroup(ps.arg)
    if parts.isEmpty() { return true }
    return !matchesChain(tree, i, i, parts, parts.count() - 1)
  }
  if name == "has" {
    return !select(tree, i, ps.arg).isEmpty()
  }
  if name == "first-child" {
    return position(tree, i) == 1
  }
  if name == "last-child" {
    return nextElement(tree, i) < 0
  }
  if name == "only-child" {
    return prevElement(tree, i) < 0 && nextElement(tree, i) < 0
  }
  if name == "nth-child" {
    return nthMatches(position(tree, i), ps.arg)
  }
  if name == "nth-of-type" {
    return nthMatches(typePosition(tree, i), ps.arg)
  }
  if name == "first-of-type" {
    return typePosition(tree, i) == 1
  }
  if name == "last-of-type" {
    return isLastOfType(tree, i)
  }
  if name == "nth-last-of-type" {
    return nthMatches(typePositionFromEnd(tree, i), ps.arg)
  }
  if name == "nth-last-child" {
    let parent = tree.nodes[i].parent
    return nthMatches(positionFromEnd(tree, i, parent), ps.arg)
  }
  if name == "empty" {
    for c in tree.nodes[i].children {
      let child = tree.nodes[c]
      if !child.name.isEmpty() { return false }
      if !child.text.trim().isEmpty() { return false }
    }
    return true
  }
  if name == "root" {
    return tree.nodes[i].parent == 0
  }
  // An unknown pseudo-class accepts what reached it rather than dropping the
  // rule: a source written for a newer Jsoup still answers its other parts.
  return true
}

/// An element's place among its siblings of the same tag, from one.
fn typePosition(tree: Tree, i: int) -> int {
  let parent = tree.nodes[i].parent
  if parent < 0 { return 1 }
  let name = tree.nodes[i].name
  var n = 0
  for s in tree.nodes[parent].children {
    if tree.nodes[s].name == name { n += 1 }
    if s == i { return n }
  }
  return n
}

fn isLastOfType(tree: Tree, i: int) -> bool {
  let parent = tree.nodes[i].parent
  if parent < 0 { return true }
  let name = tree.nodes[i].name
  var seen = false
  for s in tree.nodes[parent].children {
    if seen && tree.nodes[s].name == name { return false }
    if s == i { seen = true }
  }
  return true
}

fn typePositionFromEnd(tree: Tree, i: int) -> int {
  let parent = tree.nodes[i].parent
  if parent < 0 { return 1 }
  let name = tree.nodes[i].name
  var n = 0
  let children = tree.nodes[parent].children
  var k = children.count() - 1
  while k >= 0 {
    let s = children[k]
    if tree.nodes[s].name == name { n += 1 }
    if s == i { return n }
    k -= 1
  }
  return n
}

fn positionFromEnd(tree: Tree, i: int, parent: int) -> int {
  if parent < 0 { return 1 }
  var n = 0
  var seen = false
  let children = tree.nodes[parent].children
  var k = children.count() - 1
  while k >= 0 {
    let s = children[k]
    if !tree.nodes[s].name.isEmpty() { n += 1 }
    if s == i { return n }
    k -= 1
  }
  return n
}

/// Whether a 1-based sibling position is one `an+b` names ("3", "odd",
/// "2n+1", "-n+3"): what :nth-child carries.
fn nthMatches(pos: int, arg: string) -> bool {
  let a = arg.trim().lower()
  if a == "odd" { return pos % 2 == 1 }
  if a == "even" { return pos % 2 == 0 }
  if a.contains("n") {
    let at = a.chars().index(c => c == 'n') ?? 0
    let head = a.slice(0, at)
    let tail = a.slice(at + 1, a.count()).trim()
    var step = 1
    if head == "-" {
      step = -1
    } else if !head.isEmpty() && head != "+" {
      step = head.toInt() ?? 1
    }
    var offset = 0
    if !tail.isEmpty() {
      offset = tail.toInt() ?? 0
    }
    if step == 0 { return pos == offset }
    let diff = pos - offset
    if diff % step != 0 { return false }
    return diff / step >= 0
  }
  return pos == (a.toInt() ?? -1)
}

fn applyIndex(found: [int], last: Part) -> [int] {
  if last.indexOp == "first" { return found.prefix(1) }
  if last.indexOp == "last" {
    if found.isEmpty() { return [] }
    return [found[found.count() - 1]]
  }
  if last.indexOp == "eq" {
    if last.index < 0 || last.index >= found.count() { return [] }
    return [found[last.index]]
  }
  if last.indexOp == "lt" {
    return found.prefix(max(0, last.index))
  }
  if last.indexOp == "gt" {
    if last.index + 1 >= found.count() { return [] }
    return found.slice(last.index + 1, found.count())
  }
  return found
}

// ── Reading a selector ──────────────────────────────────────────────

fn parseGroup(group: string) -> [Part] {
  let cs = group.chars()
  let n = cs.count()
  var parts: [Part] = []
  var comb = ""
  var i = 0
  while i < n {
    let c = cs[i]
    if c.isWhitespace() {
      i += 1
      if !parts.isEmpty() && comb.isEmpty() { comb = " " }
      continue
    }
    if c == '>' || c == '+' || c == '~' {
      comb = "{c}"
      i += 1
      continue
    }

    var part = Part()
    part.combinator = if parts.isEmpty() { "" } else if comb.isEmpty() { " " } else { comb }
    comb = ""

    // The tag name, if the compound starts with one. Legado also writes
    // Jsoup's shorthands: class.item is .item, id.sitebox is #sitebox,
    // tag.a is a (tag.a.1 the second one among its siblings), and
    // text.点击阅读 is the element holding that text.
    if c == '*' {
      part.tag = "*"
      i += 1
    } else if c.isLetter() {
      var name = ""
      while i < n && isIdentChar(cs[i]) {
        name += cs[i]
        i += 1
      }
      let lower = name.lower()
      if (lower == "class" || lower == "id" || lower == "tag" || lower == "text") && i < n && cs[i] == '.' {
        i += 1
        if lower == "text" {
          var value = ""
          while i < n && !cs[i].isWhitespace() && cs[i] != '>' && cs[i] != '+' && cs[i] != '~' && cs[i] != '[' && cs[i] != ':' {
            value += cs[i]
            i += 1
          }
          part.tag = "*"
          // The element holding the words itself: the link a source points
          // at, not the container around it.
          part.pseudos.push(Pseudo(name: "containsown", arg: value))
        } else {
          var value = ""
          while i < n && isIdentChar(cs[i]) {
            value += cs[i]
            i += 1
          }
          if lower == "class" {
            part.classes.push(value)
          } else if lower == "id" {
            part.id = value
          } else {
            part.tag = value.lower()
            if i + 1 < n && cs[i] == '.' && cs[i + 1].isDigit() {
              i += 1
              var num = ""
              while i < n && cs[i].isDigit() {
                num += cs[i]
                i += 1
              }
              part.pseudos.push(Pseudo(name: "nth-of-type", arg: "{(num.toInt() ?? 0) + 1}"))
            }
          }
        }
      } else {
        part.tag = lower
      }
    }

    // The rest of the compound: classes, ids, attributes, pseudo-classes.
    while i < n && !cs[i].isWhitespace() && cs[i] != '>' && cs[i] != '+' && cs[i] != '~' {
      let q = cs[i]
      if q == '.' {
        i += 1
        var name = ""
        while i < n && isIdentChar(cs[i]) {
          name += cs[i]
          i += 1
        }
        part.classes.push(name)
      } else if q == '#' {
        i += 1
        var name = ""
        while i < n && isIdentChar(cs[i]) {
          name += cs[i]
          i += 1
        }
        part.id = name
      } else if q == '[' {
        i += 1
        var inner = ""
        var quote = ""
        while i < n {
          let ch = cs[i]
          if !quote.isEmpty() {
            if ch == '\\' && i + 1 < n {
              inner += ch
              i += 1
              inner += cs[i]
              i += 1
              continue
            }
            if "{ch}" == quote { quote = "" }
            inner += ch
            i += 1
            continue
          }
          if ch == '"' || ch == '\'' {
            quote = "{ch}"
            inner += ch
            i += 1
            continue
          }
          if ch == ']' {
            i += 1
            break
          }
          inner += ch
          i += 1
        }
        part.attrs.push(parseAttr(inner))
      } else if q == ':' {
        i += 1
        var name = ""
        while i < n && (cs[i].isLetter() || cs[i].isDigit() || cs[i] == '-') {
          name += cs[i]
          i += 1
        }
        var arg = ""
        if i < n && cs[i] == '(' {
          i += 1
          var depth = 1
          var quote = ""
          while i < n {
            let ch = cs[i]
            if !quote.isEmpty() {
              if ch == '\\' && i + 1 < n {
                arg += ch
                i += 1
                arg += cs[i]
                i += 1
                continue
              }
              if "{ch}" == quote { quote = "" }
              arg += ch
              i += 1
              continue
            }
            if ch == '"' || ch == '\'' {
              quote = "{ch}"
              arg += ch
              i += 1
              continue
            }
            if ch == '(' { depth += 1 }
            if ch == ')' {
              depth -= 1
              if depth == 0 {
                i += 1
                break
              }
            }
            arg += ch
            i += 1
          }
        }
        part.addPseudo(name.lower(), unquote(arg))
      } else {
        // An escape or a character this subset doesn't use.
        i += 1
      }
    }
    parts.push(part)
  }
  return parts
}

fn parseAttr(inner: string) -> AttrTest {
  let cs = inner.chars()
  let n = cs.count()
  var i = 0
  while i < n && cs[i].isWhitespace() { i += 1 }
  var name = ""
  while i < n && !cs[i].isWhitespace() && cs[i] != '=' && cs[i] != '~' && cs[i] != '^' && cs[i] != '$' && cs[i] != '*' && cs[i] != '|' && cs[i] != '!' {
    name += cs[i]
    i += 1
  }
  while i < n && cs[i].isWhitespace() { i += 1 }
  var op = ""
  if i < n {
    let c = cs[i]
    if c == '=' {
      op = "="
      i += 1
    } else if (c == '~' || c == '^' || c == '$' || c == '*' || c == '|' || c == '!') && i + 1 < n && cs[i + 1] == '=' {
      op = "{c}="
      i += 2
    }
  }
  while i < n && cs[i].isWhitespace() { i += 1 }
  var value = ""
  if i < n && (cs[i] == '"' || cs[i] == '\'') {
    let quote = cs[i]
    i += 1
    while i < n && cs[i] != quote {
      value += cs[i]
      i += 1
    }
  } else {
    while i < n && !cs[i].isWhitespace() {
      value += cs[i]
      i += 1
    }
  }
  return AttrTest(name: name.lower(), op: op, value: value)
}
