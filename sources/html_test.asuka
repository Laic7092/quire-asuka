// The reader and the selectors, against the kind of markup a source's pages
// are written in.

test "a page is a tree of elements and text" {
  let tree = parse("<div id=x class='a b'><p>one</p><p>two <b>bold</b></p></div>")
  expect(tree.nodes.count() > 1)
  let div = select(tree, 0, "div#x.a")
  expect(div.count() == 1)
  expect(textOf(tree, div[0]) == "one two bold")
  expect(attr(tree, div[0], "class") == "a b")
  expect(select(tree, 0, "p").count() == 2)
  expect(select(tree, 0, "p:contains(two)").count() == 1)
}

test "unclosed rows still name one another" {
  let tree = parse("<ul><li><a href=/1>one</a><li><a href=/2>two</a></ul>")
  let links = select(tree, 0, "li a")
  expect(links.count() == 2)
  expect(attr(tree, links[0], "href") == "/1")
  expect(attr(tree, links[1], "href") == "/2")
  expect(textOf(tree, links[1]) == "two")
}

test "combinators and attributes" {
  let tree = parse("<div class=list><div class=row data-id=7><span>x</span></div><div class=row><span>y</span></div></div>")
  expect(select(tree, 0, "div.list > div.row").count() == 2)
  expect(select(tree, 0, "div.row[data-id]").count() == 1)
  expect(select(tree, 0, "div.row[data-id='7'] span").count() == 1)
  expect(select(tree, 0, "div.row span").count() == 2)
  expect(select(tree, 0, "div.row:nth-child(2) span").count() == 1)
  expect(select(tree, 0, "div.row:first-child span").count() == 1)
}

test "a script is not the book" {
  let tree = parse("<div><script>var x = 1 < 2;</script><p>text</p></div>")
  let div = select(tree, 0, "div")
  expect(textOf(tree, div[0]) == "text")
  expect(plain(tree, div[0]) == "text")
}

test "paragraphs keep their lines" {
  let tree = parse("<div>one<br>two<p>three</p></div>")
  let div = select(tree, 0, "div")
  expect(plain(tree, div[0]) == "one\ntwo\nthree")
}

test "suffixes read an element" {
  let tree = parse("<a href='/b' title='t'>go <b>now</b></a>")
  let a = select(tree, 0, "a")
  expect(suffixValue(tree, a[0], "href", false) == "/b")
  expect(suffixValue(tree, a[0], "text", false) == "go now")
  expect(suffixValue(tree, a[0], "ownText", false) == "go")
  expect(suffixValue(tree, a[0], "html", false).contains("<b>now</b>"))
}

test "legado's shorthand selectors" {
  let tree = parse("<div id=sitebox class=box><dl><dd><a href=/1>one</a><a href=/2>two</a></dd></dl></div>")
  expect(select(tree, 0, "id.sitebox dl").count() == 1)
  expect(select(tree, 0, "class.box").count() == 1)
  expect(select(tree, 0, "tag.a").count() == 2)
  expect(select(tree, 0, "tag.a.1").count() == 1)
  expect(attr(tree, select(tree, 0, "tag.a.1")[0], "href") == "/2")
  expect(select(tree, 0, "text.two").count() == 1)
}

test "entities are read as their characters" {
  let tree = parse("<p>a&nbsp;&nbsp;b &amp; c &#x4e00;</p>")
  let p = select(tree, 0, "p")
  expect(textOf(tree, p[0]) == "a b & c 一")
}

test "nth-of-type counts the tag" {
  let tree = parse("<div><p>a</p><span>x</span><p>b</p></div>")
  let ps = select(tree, 0, "p:nth-of-type(2)")
  expect(ps.count() == 1)
  expect(textOf(tree, ps[0]) == "b")
  expect(select(tree, 0, "span:first-of-type").count() == 1)
  expect(select(tree, 0, "p:last-of-type").count() == 1)
}
