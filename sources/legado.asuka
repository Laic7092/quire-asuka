// 阅读3.0（Legado）的书源格式：一段 JSON 描述一个站点的搜索、详情、
// 目录和正文，每个字段一条规则。这里只读应用会用到的字段，名字与导出的
// JSON 一致；其余字段（登录、评论、回调）随原来的 JSON 一起保存，读的
// 时候不解释。
//
// 规则本身由 legado-engine 执行（sources/native.asuka）；这个文件只把
// JSON 读成结构，并回答书源的地址、请求头和它自己的变量。

import std/json
import std/regex

pub struct SearchRule {
  bookList: string = ""
  name: string = ""
  author: string = ""
  kind: string = ""
  wordCount: string = ""
  lastChapter: string = ""
  intro: string = ""
  coverUrl: string = ""
  bookUrl: string = ""
}

pub struct BookInfoRule {
  init: string = ""
  name: string = ""
  author: string = ""
  kind: string = ""
  wordCount: string = ""
  lastChapter: string = ""
  intro: string = ""
  coverUrl: string = ""
  tocUrl: string = ""
  /// 文件型书源的下载链接，一行一个 `名称::地址`（也可以只是地址）。
  downloadUrls: string = ""
}

pub struct TocRule {
  chapterList: string = ""
  chapterName: string = ""
  chapterUrl: string = ""
  isVip: string = ""
  updateTime: string = ""
  nextTocUrl: string = ""
}

pub struct ContentRule {
  content: string = ""
  nextContentUrl: string = ""
  /// 正文的逐行替换：每行 `正则##替换`。
  replaceRegex: string = ""
  sourceRegex: string = ""
  webJs: string = ""
}

pub struct BookSource {
  bookSourceName: string = ""
  bookSourceUrl: string = ""
  bookSourceGroup: string = ""
  bookSourceComment: string = ""
  bookSourceType: int = 0
  enabled: bool = true
  header: string = ""
  jsLib: string = ""
  searchUrl: string = ""
  exploreUrl: string = ""
  variable: string = ""
  /// 变量的说明，显示在变量编辑器里。
  variableComment: string = ""
  /// 网页登录的地址。引擎自己不打开浏览器，留着给宿主用。
  loginUrl: string = ""
  concurrentRate: string = ""
  /// 有些书源没有某一组规则（没有详情页、没有目录）：缺的那组是空的，
  /// 不是读不出来。
  ruleSearch: SearchRule? = none
  ruleBookInfo: BookInfoRule? = none
  ruleToc: TocRule? = none
  ruleContent: ContentRule? = none
  /// 导入时那段 JSON 的原文：原生引擎要它不认识的字段（登录、发现、
  /// 变量等）一个也不丢。手工构造的书源是空的。
  raw: string = ""

  pub fn searchRules() -> SearchRule = ruleSearch ?? SearchRule()

  pub fn infoRules() -> BookInfoRule = ruleBookInfo ?? BookInfoRule()

  pub fn tocRules() -> TocRule = ruleToc ?? TocRule()

  pub fn contentRules() -> ContentRule = ruleContent ?? ContentRule()
}

/// 一段书源 JSON 里的每一个书源：数组是导出的合集，对象是单个书源。
/// 没有地址的条目（不是书源）会被跳过；一个都不剩时抛错。
pub fn parseList(text: string) throws -> [json.Value] {
  let t = text.trim()
  if t.isEmpty() { throw Error("书源是空的") }
  let v = try json.parse(t)
  var out: [json.Value] = []
  if let arr = v.asArray() {
    for item in arr {
      if !urlOf(item).isEmpty() { out.push(item) }
    }
  } else if v.asObject() != none {
    if !urlOf(v).isEmpty() { out.push(v) }
  }
  if out.isEmpty() { throw Error("这里面没有书源") }
  return out
}

pub fn urlOf(v: json.Value) -> string = v.get("bookSourceUrl")?.asString()?.trim() ?? ""

pub fn nameOf(v: json.Value) -> string {
  let name = v.get("bookSourceName")?.asString()?.trim() ?? ""
  if !name.isEmpty() { return name }
  let url = urlOf(v)
  if url.isEmpty() { return "未命名书源" }
  return url
}

/// 一段书源 JSON 读成结构。读不出来时抛错，说哪个字段不对。
pub fn decodeSource(v: json.Value) throws -> BookSource {
  var source = try json.decode<BookSource>("{v}")
  source.raw = "{v}"
  return source
}

pub fn groupsOf(s: BookSource) -> [string] = s.bookSourceGroup.split(",").map(g => g.trim()).filter(g => !g.isEmpty())

/// 发现页的一栏：Legado 的 `exploreUrl` 要么是一段 JSON 数组，要么是一个
/// 地址。数组里每一项的 `url` 可以带 `{{page}}`，交给引擎展开。
pub struct ExploreCategory {
  title: string
  url: string
}

/// 书源里有几种写法：JSON 数组、单个对象，或者一行一个
/// `标题::地址`。有些导出的 JSON 还留着最后一个逗号，也要认。
let categoryTrailingComma = regex.must(r",\s*([\]\}])")

/// 书源脚本里的 `source.get('…')` / `source.put('…')`：这些就是它要的
/// 变量名。wenku8 的 jsLib 用 `wenku8_user` / `wenku8_pass` 登录，书源
/// JSON 里却没有 `variable` 字段，读者只能从这里看出要填什么。
let sourceVariableKey = regex.must(r#"source\.(?:get|put)\(\s*['"]([^'"]+)['"]"#)

fn parseCategoryJSON(t: string) -> [ExploreCategory] {
  var out: [ExploreCategory] = []
  if let v = try? json.parse(t) {
    if let arr = v.asArray() {
      for item in arr {
        // 常见的是 {"title","url"}；也有书源只给一串地址。
        if let plain = item.asString() {
          let url = plain.trim()
          if !url.isEmpty() {
            out.push(ExploreCategory(title: "分类 {out.count() + 1}", url: url))
          }
          continue
        }
        let url = item.get("url")?.asString()?.trim() ?? ""
        if url.isEmpty() { continue }
        let name = item.get("title")?.asString()?.trim() ?? ""
        out.push(ExploreCategory(
          title: if name.isEmpty() { "分类 {out.count() + 1}" } else { name },
          url: url,
        ))
      }
    } else if v.asObject() != none {
      let url = v.get("url")?.asString()?.trim() ?? ""
      if !url.isEmpty() {
        let name = v.get("title")?.asString()?.trim() ?? ""
        out.push(ExploreCategory(
          title: if name.isEmpty() { "发现" } else { name },
          url: url,
        ))
      }
    }
  }
  return out
}

/// 一行一个分类：`玄幻::/category/xuanhuan/`。没有 `::` 的行也接受，
/// 标题按顺序编号。
fn parseCategoryLines(t: string) -> [ExploreCategory] {
  let lines = t.lines().map(l => l.trim()).filter(l => !l.isEmpty() && !l.hasPrefix("#"))
  // 单行、又没有 `标题::地址` 的，是一个书的列表地址，不是分类表；
  // 交给调用方去取，取回来再看它是不是分类 JSON。
  if lines.count() < 2 && !lines.any(l => l.contains("::")) { return [] }
  var out: [ExploreCategory] = []
  for row in lines {
    if let at = row.find("::") {
      let title = row.byteSlice(0, at).trim()
      let url = row.byteSlice(at + 2, row.byteCount()).trim()
      if url.isEmpty() { continue }
      out.push(ExploreCategory(
        title: if title.isEmpty() { "分类 {out.count() + 1}" } else { title },
        url: url,
      ))
    } else if row.contains("://") || row.hasPrefix("/") {
      out.push(ExploreCategory(title: "分类 {out.count() + 1}", url: row))
    }
  }
  return out
}

/// 一段分类文本读成分类：JSON 数组、单个对象，或一串 `标题::地址`。
/// 不是分类文本时返回空，由调用方决定这是不是一个书的列表地址。
fn parseCategoryText(raw: string) -> [ExploreCategory] {
  let t = raw.trim()
  if t.isEmpty() { return [] }
  let direct = parseCategoryJSON(t)
  if !direct.isEmpty() { return direct }
  // 导出的 JSON 偶尔有一个多余的尾逗号：去掉它再读一次。
  let loose = categoryTrailingComma.replace(t, with: "$1")
  if loose != t {
    let fixed = parseCategoryJSON(loose)
    if !fixed.isEmpty() { return fixed }
  }
  return parseCategoryLines(t)
}

pub fn exploreCategories(s: BookSource) -> [ExploreCategory] {
  let raw = s.exploreUrl.trim()
  if raw.isEmpty() { return [] }
  let out = parseCategoryText(raw)
  if !out.isEmpty() { return out }
  // 不是 JSON：整个 exploreUrl 就是一个分类的地址。调用方若要用网络
  // 解析它，走 exploreCategoriesOf。
  return [ExploreCategory(title: "发现", url: raw)]
}

/// 发现页地址里的页号：`{{page}}`（JS 插值）和 `{page}`（Legado 的占位符）
/// 是模板，`<js>` / `@js:` 里的 `page` 则在脚本开头赋值。引擎的
/// `legado_explore` 只取第 1 页（ABI 没有页参数），所以页号在这边写进地址。
pub fn explorePageUrl(url: string, page: int) -> string {
  var out = url.replace(r"{{page}}", "{page}")
  out = out.replace(r"{page}", "{page}")
  out = out.replace("searchPage", "{page}")
  out = jsTag.replace(out, with: "<js>page={page};")
  out = jsPrefix.replace(out, with: "@js:page={page};")
  if out != url { return out }
  // 没有模板、但地址里已经写着页号（`?page=1`、`?pageno=2`）：把那个数字
  // 换掉。不然「加载更多」每次都取回第一页，同一批书被当成已经到头。
  return withPageParam(out, page)
}

/// 页号在查询串里可能的名字：书源写死的第一页常常是 `?page=1` 或 `?pageno=1`。
/// 单个 `p` 不算：那常常是帖子或分类的编号。
let pageKeys = ["page", "pagenum", "pageno", "page_no", "pageindex", "page_index"]

/// 查询串里写死的页号，没有（或不是数字）时是空。
fn pageParamOf(url: string) -> string {
  let at = url.find("?") ?? -1
  if at < 0 { return "" }
  var query = url.byteSlice(at + 1, url.byteCount())
  if let hash = query.find("#") { query = query.byteSlice(0, hash) }
  for part in query.split("&") {
    if let eq = part.find("=") {
      if pageKeys.contains(part.byteSlice(0, eq).trim().lower()) {
        return part.byteSlice(eq + 1, part.byteCount()).trim()
      }
    }
  }
  return ""
}

/// 把查询串里的页号换成 page：别的参数、它们的顺序和地址的其余部分都
/// 原样留着。
fn withPageParam(url: string, page: int) -> string {
  let at = url.find("?") ?? -1
  if at < 0 { return url }
  let head = url.byteSlice(0, at)
  var rest = url.byteSlice(at + 1, url.byteCount())
  var tail = ""
  if let hash = rest.find("#") {
    tail = rest.byteSlice(hash, rest.byteCount())
    rest = rest.byteSlice(0, hash)
  }
  var parts: [string] = []
  var hit = false
  for part in rest.split("&") {
    var kept = part
    if let eq = part.find("=") {
      let key = part.byteSlice(0, eq).trim().lower()
      if !hit && pageKeys.contains(key) && part.byteSlice(eq + 1, part.byteCount()).trim().toInt() != none {
        kept = "{part.byteSlice(0, eq)}={page}"
        hit = true
      }
    }
    parts.push(kept)
  }
  if !hit { return url }
  return "{head}?{parts.joined(separator: "&")}{tail}"
}

/// 这个分类能不能看下一页：地址里有页号模板，脚本自己在拼 `page`，有
/// `<1,2,3>` 的页码选项，或者查询串里已经写着页号。静态的分类地址
/// （`/category/xuanhuan/`）只有第一页。
pub fn canExplorePages(url: string) -> bool {
  if engineFillsPage(url) { return true }
  return pageParamOf(url).toInt() != none
}

/// 引擎自己会填页号的地址：`{{page}}` / `{page}` 模板、`searchPage`、
/// `<js>` / `@js:` 脚本里的 `page`，以及 `<1,2,3>` 这种页码选项。
/// 0.4.0 的 `legado_explore_page(url, key, page)` 认得这些，所以第一页和
/// 下一页都把原址交给它：App 再改写一遍，会把脚本里自己声明的 `page`
/// （`let page = …`）改坏。
pub fn engineFillsPage(url: string) -> bool {
  let u = url.lower()
  if u.contains(r"{page}") || u.contains("searchpage") { return true }
  if u.contains("<js>") || u.contains("@js:") { return u.contains("page") }
  return pageChoices.find(url) != none
}

/// `<1,2,3>`：引擎按页号从选项里挑一个。
let pageChoices = regex.must(r"<\s*\d+\s*(?:,\s*\d+\s*)*>")

/// 转圈时给人看的地址：模板和写死的页号换成这一页；`<1,2,3>` 和没有
/// 模板的脚本原样——那些的页号是引擎放进脚本里的，地点本身不变。
pub fn pagePreview(url: string, page: int) -> string {
  if !engineFillsPage(url) { return explorePageUrl(url, page) }
  let u = url.lower()
  if !u.contains(r"{page}") && !u.contains("searchpage") { return url }
  var out = url.replace(r"{{page}}", "{page}")
  out = out.replace(r"{page}", "{page}")
  return out.replace("searchPage", "{page}")
}

let jsTag = regex.must(r"(?is)<js>")
let jsPrefix = regex.must(r"(?is)@js:")

/// `exploreUrl` 是一个地址时，它常常返回一份分类 JSON。先把这段 JSON
/// 取回来再列分类；否则会把「分类定义」当成一个书的列表，发现页于是
/// 多出一层「发现」，点进去也打不开。取不到、或者取回来的不是分类
/// JSON 时，退回「这个地址就是一个分类」。
pub async fn exploreCategoriesOf(s: BookSource) -> [ExploreCategory] {
  let raw = s.exploreUrl.trim()
  if raw.isEmpty() { return [] }
  let direct = parseCategoryText(raw)
  if !direct.isEmpty() { return direct }
  let url = absoluteUrl(baseUrlOf(s), raw)
  do {
    let page = try await withTimeout(8s) {
      return try await get(url, headersOf(s), timeout: 8s)
    }
    let fetched = parseCategoryText(page.text)
    if !fetched.isEmpty() { return fetched }
  } catch {
    // 网络失败也退回一个分类：至少读者能看到是哪个地址打不开。
  }
  return [ExploreCategory(title: "发现", url: raw)]
}

/// 相对地址按书源的地址补全。只处理发现页会遇到的几种：绝对地址、
/// 协议相对的地址、站内绝对路径和相对路径。
fn absoluteUrl(base: string, href: string) -> string {
  let p = href.trim()
  if p.isEmpty() { return base }
  if p.contains("://") { return p }
  var b = base.trim()
  if b.isEmpty() { return p }
  if !b.contains("://") { b = "http://" + b }
  let scheme = b.find("://") ?? 0
  if p.hasPrefix("//") {
    return b.byteSlice(0, scheme + 1) + p
  }
  if p.hasPrefix("/") {
    let after = scheme + 3
    let rest = b.byteSlice(after, b.byteCount())
    let slash = rest.find("/")
    let host = if let at = slash { rest.byteSlice(0, at) } else { rest }
    return b.byteSlice(0, after) + host + p
  }
  if b.hasSuffix("/") { return b + p }
  let slash = b.findLast("/") ?? -1
  if slash > scheme + 2 {
    return b.byteSlice(0, slash + 1) + p
  }
  return b + "/" + p
}

/// 请求头写在 header 字段里，是一段 JSON 字符串。proxy 是连接设置，不是
/// 一个请求头，不带上。
pub fn headersOf(s: BookSource) -> [string: string] {
  let raw = s.header.trim()
  if !raw.hasPrefix(r"{") { return [:] }
  var out: [string: string] = [:]
  if let v = try? json.parse(raw) {
    if let o = v.asObject() {
      for (k, val) in o {
        if k.lower() == "proxy" { continue }
        out[k] = stringOf(val)
      }
    }
  }
  return out
}

/// 书源自己的变量（variable 字段）：规则里的 @get:{key} 读它们。
pub fn varsOf(s: BookSource) -> [string: string] {
  let raw = s.variable.trim()
  if !raw.hasPrefix(r"{") { return [:] }
  var out: [string: string] = [:]
  if let v = try? json.parse(raw) {
    if let o = v.asObject() {
      for (k, val) in o {
        out[k] = stringOf(val)
      }
    }
  }
  return out
}

/// 变量的键：书源 `variable` 里写下的，加上 jsLib / 规则里
/// `source.get('…')` / `source.put('…')` 提到的。编辑器按这个逐项画
/// 输入框，读者不必猜 JSON 里要写什么。
pub fn variableKeys(s: BookSource) -> [string] {
  var out: [string] = []
  for (k, _) in varsOf(s) {
    let key = k.trim()
    if !key.isEmpty() && !out.contains(key) { out.push(key) }
  }
  let scripts = [
    s.jsLib,
    s.loginUrl,
    s.searchUrl,
    s.exploreUrl,
    s.variableComment,
    s.bookSourceComment,
    s.searchRules().bookList,
    s.searchRules().name,
    s.searchRules().author,
    s.searchRules().bookUrl,
    s.infoRules().init,
    s.infoRules().name,
    s.infoRules().author,
    s.infoRules().downloadUrls,
    s.tocRules().chapterList,
    s.tocRules().chapterName,
    s.tocRules().chapterUrl,
    s.contentRules().content,
    s.contentRules().webJs,
  ].joined(separator: "\n")
  for found in sourceVariableKey.findAllSubmatches(scripts) {
    if found.count() < 2 { continue }
    let key = found[1].trim()
    if !key.isEmpty() && !out.contains(key) { out.push(key) }
  }
  return out
}

/// 一段变量 JSON 里一个键现在的值；不是对象、或者没有这个键时是空。
pub fn variableValueOf(text: string, key: string) -> string {
  if let v = try? json.parse(text.trim()) {
    if let o = v.asObject() {
      if let val = o[key] { return stringOf(val) }
    }
  }
  return ""
}

/// 改一段变量 JSON 里的一个键，别的键和值原样留着。不是 JSON 对象时
/// 从空对象开始。
pub fn withVariableValue(text: string, key: string, value: string) -> string {
  var o: [string: json.Value] = [:]
  if let v = try? json.parse(text.trim()) {
    if let existing = v.asObject() { o = existing }
  }
  o[key] = value
  return json.encode(o)
}

/// 文件型书源（`bookSourceType: 3`）：没有章节，只有 `downloadUrls`。
pub fn isDownloadSource(s: BookSource) -> bool = s.bookSourceType == 3

/// 一个可下载的文件。`name` 是书源给的名字（`TXT`、`简体(G)` 之类）。
pub struct DownloadOption {
  name: string
  url: string
}

fn downloadKindOf(url: string) -> string {
  let lower = url.lower()
  if lower.contains(".epub") { return "EPUB" }
  if lower.contains(".txt") || lower.contains("type=txt") || lower.contains("type=utf8") {
    return "TXT"
  }
  return "文件"
}

/// `ruleBookInfo.downloadUrls`：一行一个 `名称::地址`，或者只是一个地址。
/// 空行、`#` 开头的注释和重复的地址都不算。
pub fn downloadOptions(raw: string) -> [DownloadOption] {
  var out: [DownloadOption] = []
  for line in raw.lines() {
    let row = line.trim()
    if row.isEmpty() || row.hasPrefix("#") { continue }
    var name = ""
    var url = row
    if let at = row.find("::") {
      name = row.byteSlice(0, at).trim()
      url = row.byteSlice(at + 2, row.byteCount()).trim()
    }
    if url.isEmpty() { continue }
    if out.any(o => o.url == url) { continue }
    out.push(DownloadOption(
      name: if name.isEmpty() { "{downloadKindOf(url)} {out.count() + 1}" } else { name },
      url: url,
    ))
  }
  return out
}

/// 把一段变量 JSON 写成引擎能存的脚本：整段进 `source.getVariable()`，
/// 每个键再进 `source.get()`。两种写法书源都有用到（wenku8 的 jsLib 读
/// `getVariable()` 解析 JSON，另一类直接读 `get('user')`）。
pub fn variablesScript(text: string) -> string {
  let t = text.trim()
  var script = "source.putVariable({json.encode(t)});"
  if let v = try? json.parse(t) {
    if let o = v.asObject() {
      for (k, val) in o {
        script += "\nsource.put({json.encode(k)}, {json.encode(stringOf(val))});"
      }
    }
  }
  return script
}

/// 书源自己的地址：相对链接按它解析，{{baseUrl}} 是它。
pub fn baseUrlOf(s: BookSource) -> string {
  var u = s.bookSourceUrl.trim()
  if u.isEmpty() { return "" }
  if !u.contains("://") { u = "http://{u}" }
  while u.hasSuffix("/") {
    u = u.slice(0, u.count() - 1)
  }
  return u
}

/// 登录要图形验证码的站点（`checkcode.php`）：目前是轻小说文库。
/// 它的 jsLib 只 POST 账号密码，宿主得把验证码图给读者看，再带上
/// `checkcode` 一起 POST；这里返回那张图的地址，别的书源是空。
pub fn captchaLoginOf(s: BookSource) -> string {
  let base = baseUrlOf(s)
  if base.isEmpty() { return "" }
  let host = base.lower()
  if host.contains("://www.wenku8.net") || host.contains("://wenku8.net") {
    return "{base}/checkcode.php"
  }
  return ""
}

/// 验证码登录 POST 的地址（和登录页同一个 `do=submit`）。
pub fn captchaSubmitOf(s: BookSource) -> string {
  let base = baseUrlOf(s)
  if base.isEmpty() { return "" }
  return "{base}/login.php?do=submit"
}

fn stringOf(v: json.Value) -> string = match v {
  .null => ""
  .string(s) => s
  .bool(b) => if b { "true" } else { "false" }
  .int(n) => "{n}"
  .float(f) => "{f}"
  _ => "{v}"
}
