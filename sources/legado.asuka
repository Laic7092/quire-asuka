// 阅读3.0（Legado）的书源格式：一段 JSON 描述一个站点的搜索、详情、
// 目录和正文，每个字段一条规则。这里只读应用会用到的字段，名字与导出的
// JSON 一致；其余字段（登录、评论、回调）随原来的 JSON 一起保存，读的
// 时候不解释。
//
// 规则本身由 legado-engine 执行（sources/native.asuka）；这个文件只把
// JSON 读成结构，并回答书源的地址、请求头和它自己的变量。

import std/json
import std/regex

pub struct SearchRule {
  bookList: string = ""
  name: string = ""
  author: string = ""
  kind: string = ""
  wordCount: string = ""
  lastChapter: string = ""
  intro: string = ""
  coverUrl: string = ""
  bookUrl: string = ""
}

pub struct BookInfoRule {
  init: string = ""
  name: string = ""
  author: string = ""
  kind: string = ""
  wordCount: string = ""
  lastChapter: string = ""
  intro: string = ""
  coverUrl: string = ""
  tocUrl: string = ""
}

pub struct TocRule {
  chapterList: string = ""
  chapterName: string = ""
  chapterUrl: string = ""
  isVip: string = ""
  updateTime: string = ""
  nextTocUrl: string = ""
}

pub struct ContentRule {
  content: string = ""
  nextContentUrl: string = ""
  /// 正文的逐行替换：每行 `正则##替换`。
  replaceRegex: string = ""
  sourceRegex: string = ""
  webJs: string = ""
}

pub struct BookSource {
  bookSourceName: string = ""
  bookSourceUrl: string = ""
  bookSourceGroup: string = ""
  bookSourceComment: string = ""
  bookSourceType: int = 0
  enabled: bool = true
  header: string = ""
  jsLib: string = ""
  searchUrl: string = ""
  exploreUrl: string = ""
  variable: string = ""
  concurrentRate: string = ""
  /// 有些书源没有某一组规则（没有详情页、没有目录）：缺的那组是空的，
  /// 不是读不出来。
  ruleSearch: SearchRule? = none
  ruleBookInfo: BookInfoRule? = none
  ruleToc: TocRule? = none
  ruleContent: ContentRule? = none
  /// 导入时那段 JSON 的原文：原生引擎要它不认识的字段（登录、发现、
  /// 变量等）一个也不丢。手工构造的书源是空的。
  raw: string = ""

  pub fn searchRules() -> SearchRule = ruleSearch ?? SearchRule()

  pub fn infoRules() -> BookInfoRule = ruleBookInfo ?? BookInfoRule()

  pub fn tocRules() -> TocRule = ruleToc ?? TocRule()

  pub fn contentRules() -> ContentRule = ruleContent ?? ContentRule()
}

/// 一段书源 JSON 里的每一个书源：数组是导出的合集，对象是单个书源。
/// 没有地址的条目（不是书源）会被跳过；一个都不剩时抛错。
pub fn parseList(text: string) throws -> [json.Value] {
  let t = text.trim()
  if t.isEmpty() { throw Error("书源是空的") }
  let v = try json.parse(t)
  var out: [json.Value] = []
  if let arr = v.asArray() {
    for item in arr {
      if !urlOf(item).isEmpty() { out.push(item) }
    }
  } else if v.asObject() != none {
    if !urlOf(v).isEmpty() { out.push(v) }
  }
  if out.isEmpty() { throw Error("这里面没有书源") }
  return out
}

pub fn urlOf(v: json.Value) -> string = v.get("bookSourceUrl")?.asString()?.trim() ?? ""

pub fn nameOf(v: json.Value) -> string {
  let name = v.get("bookSourceName")?.asString()?.trim() ?? ""
  if !name.isEmpty() { return name }
  let url = urlOf(v)
  if url.isEmpty() { return "未命名书源" }
  return url
}

/// 一段书源 JSON 读成结构。读不出来时抛错，说哪个字段不对。
pub fn decodeSource(v: json.Value) throws -> BookSource {
  var source = try json.decode<BookSource>("{v}")
  source.raw = "{v}"
  return source
}

pub fn groupsOf(s: BookSource) -> [string] = s.bookSourceGroup.split(",").map(g => g.trim()).filter(g => !g.isEmpty())

/// 发现页的一栏：Legado 的 `exploreUrl` 要么是一段 JSON 数组，要么是一个
/// 地址。数组里每一项的 `url` 可以带 `{{page}}`，交给引擎展开。
pub struct ExploreCategory {
  title: string
  url: string
}

/// 书源里有几种写法：JSON 数组、单个对象，或者一行一个
/// `标题::地址`。有些导出的 JSON 还留着最后一个逗号，也要认。
let categoryTrailingComma = regex.must(r",\s*([\]\}])")

fn parseCategoryJSON(t: string) -> [ExploreCategory] {
  var out: [ExploreCategory] = []
  if let v = try? json.parse(t) {
    if let arr = v.asArray() {
      for item in arr {
        // 常见的是 {"title","url"}；也有书源只给一串地址。
        if let plain = item.asString() {
          let url = plain.trim()
          if !url.isEmpty() {
            out.push(ExploreCategory(title: "分类 {out.count() + 1}", url: url))
          }
          continue
        }
        let url = item.get("url")?.asString()?.trim() ?? ""
        if url.isEmpty() { continue }
        let name = item.get("title")?.asString()?.trim() ?? ""
        out.push(ExploreCategory(
          title: if name.isEmpty() { "分类 {out.count() + 1}" } else { name },
          url: url,
        ))
      }
    } else if v.asObject() != none {
      let url = v.get("url")?.asString()?.trim() ?? ""
      if !url.isEmpty() {
        let name = v.get("title")?.asString()?.trim() ?? ""
        out.push(ExploreCategory(
          title: if name.isEmpty() { "发现" } else { name },
          url: url,
        ))
      }
    }
  }
  return out
}

/// 一行一个分类：`玄幻::/category/xuanhuan/`。没有 `::` 的行也接受，
/// 标题按顺序编号。
fn parseCategoryLines(t: string) -> [ExploreCategory] {
  let lines = t.lines().map(l => l.trim()).filter(l => !l.isEmpty() && !l.hasPrefix("#"))
  // 单行、又没有 `标题::地址` 的，是一个书的列表地址，不是分类表；
  // 交给调用方去取，取回来再看它是不是分类 JSON。
  if lines.count() < 2 && !lines.any(l => l.contains("::")) { return [] }
  var out: [ExploreCategory] = []
  for row in lines {
    if let at = row.find("::") {
      let title = row.byteSlice(0, at).trim()
      let url = row.byteSlice(at + 2, row.byteCount()).trim()
      if url.isEmpty() { continue }
      out.push(ExploreCategory(
        title: if title.isEmpty() { "分类 {out.count() + 1}" } else { title },
        url: url,
      ))
    } else if row.contains("://") || row.hasPrefix("/") {
      out.push(ExploreCategory(title: "分类 {out.count() + 1}", url: row))
    }
  }
  return out
}

/// 一段分类文本读成分类：JSON 数组、单个对象，或一串 `标题::地址`。
/// 不是分类文本时返回空，由调用方决定这是不是一个书的列表地址。
fn parseCategoryText(raw: string) -> [ExploreCategory] {
  let t = raw.trim()
  if t.isEmpty() { return [] }
  let direct = parseCategoryJSON(t)
  if !direct.isEmpty() { return direct }
  // 导出的 JSON 偶尔有一个多余的尾逗号：去掉它再读一次。
  let loose = categoryTrailingComma.replace(t, with: "$1")
  if loose != t {
    let fixed = parseCategoryJSON(loose)
    if !fixed.isEmpty() { return fixed }
  }
  return parseCategoryLines(t)
}

pub fn exploreCategories(s: BookSource) -> [ExploreCategory] {
  let raw = s.exploreUrl.trim()
  if raw.isEmpty() { return [] }
  let out = parseCategoryText(raw)
  if !out.isEmpty() { return out }
  // 不是 JSON：整个 exploreUrl 就是一个分类的地址。调用方若要用网络
  // 解析它，走 exploreCategoriesOf。
  return [ExploreCategory(title: "发现", url: raw)]
}

/// `exploreUrl` 是一个地址时，它常常返回一份分类 JSON。先把这段 JSON
/// 取回来再列分类；否则会把「分类定义」当成一个书的列表，发现页于是
/// 多出一层「发现」，点进去也打不开。取不到、或者取回来的不是分类
/// JSON 时，退回「这个地址就是一个分类」。
pub async fn exploreCategoriesOf(s: BookSource) -> [ExploreCategory] {
  let raw = s.exploreUrl.trim()
  if raw.isEmpty() { return [] }
  let direct = parseCategoryText(raw)
  if !direct.isEmpty() { return direct }
  let url = absoluteUrl(baseUrlOf(s), raw)
  do {
    let page = try await withTimeout(8s) {
      return try await get(url, headersOf(s), timeout: 8s)
    }
    let fetched = parseCategoryText(page.text)
    if !fetched.isEmpty() { return fetched }
  } catch {
    // 网络失败也退回一个分类：至少读者能看到是哪个地址打不开。
  }
  return [ExploreCategory(title: "发现", url: raw)]
}

/// 相对地址按书源的地址补全。只处理发现页会遇到的几种：绝对地址、
/// 协议相对的地址、站内绝对路径和相对路径。
fn absoluteUrl(base: string, href: string) -> string {
  let p = href.trim()
  if p.isEmpty() { return base }
  if p.contains("://") { return p }
  var b = base.trim()
  if b.isEmpty() { return p }
  if !b.contains("://") { b = "http://" + b }
  let scheme = b.find("://") ?? 0
  if p.hasPrefix("//") {
    return b.byteSlice(0, scheme + 1) + p
  }
  if p.hasPrefix("/") {
    let after = scheme + 3
    let rest = b.byteSlice(after, b.byteCount())
    let slash = rest.find("/")
    let host = if let at = slash { rest.byteSlice(0, at) } else { rest }
    return b.byteSlice(0, after) + host + p
  }
  if b.hasSuffix("/") { return b + p }
  let slash = b.findLast("/") ?? -1
  if slash > scheme + 2 {
    return b.byteSlice(0, slash + 1) + p
  }
  return b + "/" + p
}

/// 请求头写在 header 字段里，是一段 JSON 字符串。proxy 是连接设置，不是
/// 一个请求头，不带上。
pub fn headersOf(s: BookSource) -> [string: string] {
  let raw = s.header.trim()
  if !raw.hasPrefix(r"{") { return [:] }
  var out: [string: string] = [:]
  if let v = try? json.parse(raw) {
    if let o = v.asObject() {
      for (k, val) in o {
        if k.lower() == "proxy" { continue }
        out[k] = stringOf(val)
      }
    }
  }
  return out
}

/// 书源自己的变量（variable 字段）：规则里的 @get:{key} 读它们。
pub fn varsOf(s: BookSource) -> [string: string] {
  let raw = s.variable.trim()
  if !raw.hasPrefix(r"{") { return [:] }
  var out: [string: string] = [:]
  if let v = try? json.parse(raw) {
    if let o = v.asObject() {
      for (k, val) in o {
        out[k] = stringOf(val)
      }
    }
  }
  return out
}

/// 书源自己的地址：相对链接按它解析，{{baseUrl}} 是它。
pub fn baseUrlOf(s: BookSource) -> string {
  var u = s.bookSourceUrl.trim()
  if u.isEmpty() { return "" }
  if !u.contains("://") { u = "http://{u}" }
  while u.hasSuffix("/") {
    u = u.slice(0, u.count() - 1)
  }
  return u
}

fn stringOf(v: json.Value) -> string = match v {
  .null => ""
  .string(s) => s
  .bool(b) => if b { "true" } else { "false" }
  .int(n) => "{n}"
  .float(f) => "{f}"
  _ => "{v}"
}
