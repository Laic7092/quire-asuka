// 净化规则：导入之后在这里开关、删除和清除。
//
// 规则本身由 legado-engine 执行；这个文件只改规则在列表里的启用状态，
// 正文和标题读到之后由 `sources.replaceRules` 作用上去。

import ./lib
import ./sources

/// 净化规则：列表、开关和删除。规则原文保留着，这里只改它在引擎里的
/// 启用状态；导入和引擎执行都在 `sources` 包里。
component ReplaceManager {
  let env = environment()

  /// 装在「内容源」的分段标签里时不画自己的标题和关闭按钮。
  prop embedded = false

  let rows = sources.replaceRules.list()

  fn askDelete(e: sources.ReplaceEntry) {
    alert("删除「{e.name}」？", message: "只是不再应用这条规则；重新导入还能回来。", actions: [
      .button(title: "取消", run: () => {}),
      .button(title: "删除", role: .destructive, run: () => {
        sources.replaceRules.remove(e.id)
        snackbar("已删除「{e.name}」")
      }),
    ])
  }

  fn askClear() {
    let count = sources.replaceRules.count()
    if count == 0 { return }
    alert("清除 {count} 条净化规则？", message: "正文和标题会回到没有净化的样子。", actions: [
      .button(title: "取消", run: () => {}),
      .button(title: "清除", role: .destructive, run: () => {
        sources.replaceRules.clear()
        snackbar("已清除净化规则")
      }),
    ])
  }

  Column {
    grow: 1
    gap: 12
    padding: lib.sheetPad(env, top: if embedded { 4 } else { 22 }, bottom: 26, side: 22)

    if !embedded {
      Row {
        gap: 8
        align: .center
        Text("净化规则") {
          font: .title3
          grow: 1
        }
        Button("") {
          icon: Icons.add
          variant: .glass
          tooltip: "导入净化规则"
          on press { present(SourceImport()) }
        }
        Button("") {
          icon: Icons.close
          variant: .glass
          on press { dismiss() }
        }
      }
    }

    Text("{sources.replaceRules.count()} 条规则 · {sources.replaceRules.enabledCount()} 条在用") {
      font: .footnote
      color: .secondaryLabel
    }

    if rows.isEmpty() {
      Column {
        gap: 10
        padding: [22, 0]
        align: .center
        Text("还没有净化规则") { font: .headline }
        Text("导入 Legado 的替换净化规则后，读到的正文和标题会按它们处理；缓存里存的仍是原文。") {
          font: .footnote
          color: .secondaryLabel
          textAlign: .center
        }
        Button("导入净化规则") {
          on press { present(SourceImport()) }
        }
      }
    } else {
      List {
        grow: 1
        appearance: .plain
        for e in rows key e.id {
          Row {
            gap: 10
            align: .center
            padding: [10, 0]
            Column {
              grow: 1
              gap: 3
              opacity: if e.enabled { 1 } else { 0.45 }
              Text(e.name) {
                font: .body
                lines: 1
              }
              Text(sources.replaceRules.patternOf(e)) {
                font: .caption
                color: .tertiaryLabel
                lines: 2
              }
              Row {
                gap: 6
                Text("→ {sources.replaceRules.replacementOf(e)}") {
                  font: .caption
                  color: .secondaryLabel
                  lines: 1
                }
                Text(sources.replaceRules.scopeOf(e)) {
                  font: .caption
                  color: .tertiaryLabel
                }
              }
            }
            Toggle {
              on: e.enabled
              checkbox: true
              height: 32
              on change(v) { sources.replaceRules.setEnabled(e.id, v) }
            }
            Button("") {
              icon: Icons.trash
              variant: .plain
              on press { askDelete(e) }
            }
          }
        }
      }
      Button("清除全部净化规则") {
        variant: .plain
        on press { askClear() }
      }
    }

    Text("规则由 legado-engine 执行；关掉的规则不会发给引擎。正文每次打开都会重新净化，标题规则在下次刷新目录后生效。") {
      font: .caption
      color: .tertiaryLabel
    }
  }
}
