// The shelf and the reading page, tested without a device: what shows,
// what a tap does, and what is remembered. The pages themselves are the
// engine's bitmaps (a native view), so the tests read the toolbar and the
// reading position rather than the pixels.

import platform/dialog
import std/fs

import ./engine
import ./lib

/// The app as it runs: the shelf, and the reader over it.
component Harness {
  Quire()
}

test "the shelf shows the sample books" {
  let app = mount(Harness(), provide: Library())
  await app.idle()
  app.expect("书架")
  app.expect("散文選")
  app.expect("野草")
}

test "a book that is only in the cloud is marked, not missing" {
  let library = Library()
  await library.seedSamples()
  if let row = library.shelf.find(s => s.id == "朱自清·散文選") {
    library.cloudHashes = [row.hash]
    try? fs.remove(fileOf(row.path))
  }
  let app = mount(Harness(), provide: library)
  await app.idle()
  app.expect("朱自清 · 未开始")
  app.expectNo("云端 ·")
}

test "an empty shelf offers a way in" {
  let library = Library()
  library.shelf = []
  library.seeded = true
  let app = mount(Harness(), provide: library)
  await app.idle()
  app.expect("书架还是空的")
  app.expect("导入书籍")
  app.expect("配置云端")
  app.expectNo("散文選")
}

test "an empty shelf offers the cloud once it is set up" {
  let library = Library()
  library.shelf = []
  library.seeded = true
  library.nutAccount = "reader@example.com"
  library.nutPassword = "app-password"
  let app = mount(Harness(), provide: library)
  await app.idle()
  app.expect("同步云端")
}

test "a book opens as a page the engine laid out" {
  let app = mount(Harness(), provide: Library())
  app.tap("散文選")
  await app.idle()
  // The page is the engine's bitmap, in the native BookPage view; the page
  // turn and the way back are taps on the page, so the only thing over it is
  // where the reader is.
  app.expect("BookPage")
  app.expect("1 / 4")
}

test "a book scrolls, and switches back to pages" {
  let lib = Library()
  let app = mount(Harness(), provide: lib)
  app.tap("散文選")
  await app.idle()
  app.expect("1 / 4")

  // 滚动: the whole book is one column of tiles, not a page turn, and no
  // chapter-by-chapter button interrupts it.
  lib.mode = "scroll"
  await app.idle()
  await sleep(600ms)
  await app.idle()
  app.expect("BookPage")
  app.expect("0%")
  app.expectNo("下一章")
  // The bands are the engine's, written where the native view reads them, and
  // named by their place in the book's flow (no chapter in the name: a band
  // may cross one).
  let bands = scrollBands()
  expect(!bands.isEmpty())
  expect(bands.any(b => b.y == 0))
  // And the first line of the book is on the band at the top, not blank paper.
  let top = bands.filter(b => b.y == 0)
  expect(!top.isEmpty() && darkPixels(top[0].path) > 200)

  // And back: the page is laid out again, at the same chapter.
  lib.mode = "page"
  await app.idle()
  app.expect("1 / 4")
  lib.mode = "page"
}

test "a new paper is another picture of the same column, not another column" {
  let lib = Library()
  let app = mount(Harness(), provide: lib)
  app.tap("散文選")
  await app.idle()
  lib.mode = "scroll"
  await app.idle()
  await sleep(600ms)
  await app.idle()
  expect(scrollBands().any(b => b.path.hasSuffix("-paper.eqp")))

  // The paper changes: the reader stays where it was, and the bands it shows
  // are drawn again — in the night's light ink, not relabelled paper.
  lib.theme = "night"
  await app.idle()
  await sleep(600ms)
  await app.idle()
  app.expect("0%")
  let night = scrollBands().filter(b => b.y == 0 && b.path.hasSuffix("-night.eqp"))
  expect(!night.isEmpty())
  expect(lightPixels(night[0].path) > 200)
  lib.theme = "paper"
}

test "a chapter from the contents jumps in scroll mode" {
  let lib = Library()
  let app = mount(Harness(), provide: lib)
  app.tap("散文選")
  await app.idle()
  lib.mode = "scroll"
  await app.idle()
  await sleep(600ms)
  await app.idle()

  // 目录 opens at the reader's chapter; picking another one is a place in
  // the column, so the reader is there without the page being laid out again.
  app.tap("目录")
  await app.idle()
  app.expect("第4章 荷塘月色")
  app.tap("第4章 荷塘月色")
  await app.idle()
  await sleep(300ms)
  await app.idle()

  let reading = lib.readingOf("朱自清·散文選")
  expect(reading.chapter == 3)
  expect(reading.percent < 0.05)

  // The window drawn is the one it landed on, not the one it left: chapter 3
  // is a third of the book, so its bands are past the first window's reach.
  let far = scrollBands().filter(b => b.y >= 2900)
  expect(!far.isEmpty())
  if let nearest = far.min(key: b => b.y) {
    // And it has the book's text on it, not blank paper.
    expect(darkPixels(nearest.path) > 200)
  }

  // The two modes keep the same place: a chapter and how far into it.
  lib.mode = "page"
  await app.idle()
  let paged = lib.readingOf("朱自清·散文選")
  expect(paged.chapter == 3)

  lib.mode = "scroll"
  await app.idle()
  await sleep(600ms)
  await app.idle()
  let again = lib.readingOf("朱自清·散文選")
  expect(again.chapter == 3)
}

test "the page goes away when it's put away" {
  let app = mount(Harness(), provide: Library())
  app.tap("散文選")
  await app.idle()
  app.expect("BookPage")
  app.tap("返回")
  await app.idle()
  app.expectNo("BookPage")
}

test "opening a book remembers where the reader is" {
  let lib = Library()
  let app = mount(Harness(), provide: lib)
  app.tap("散文選")
  await app.idle()
  // Whatever the page count, the reader has a position once a page shows.
  let reading = lib.readingOf("朱自清·散文選")
  expect(reading.chapter == 0)
  expect(reading.percent >= 0)
}

/// The pages the reader has written for a book, newest last: the file names
/// say how each was laid out.
/// One scroll band the reader wrote, and where it sits in the book's flow: the
/// file name is "{book}-scroll-{y}-{height}-{width}-…".
struct BandFile {
  y: float
  height: float
  path: string
}

fn scrollBands() -> [BandFile] {
  let dir = fs.join([fs.appDir(), "pages"])
  let found = (try? fs.walk(dir))?.filter(e => !e.isDir && e.name.contains("-scroll-")) ?? []
  var out: [BandFile] = []
  for entry in found {
    let parts = entry.name.split("-")
    if parts.count() >= 6 {
      out.push(BandFile(
        y: parts[2].toFloat() ?? 0, height: parts[3].toFloat() ?? 0, path: entry.path,
      ))
    }
  }
  return out
}

fn pagesMatching(tag: string) -> [string] {
  let dir = "{fs.appDir()}/pages"
  let found = try? fs.walk(dir)
  return (found ?? []).filter(e => !e.isDir && e.name.hasSuffix("-{tag}.eqp")).map(e => e.path)
}

/// How many pixels of a page are the ink's light colour, not the paper's.
fn lightPixels(path: string) -> int {
  let data = try? fs.read(path)
  let all = data?.count() ?? 0
  var light = 0
  var i = 12
  while i + 3 < all {
    if (data?.get(i) ?? 0) > 0xc0 { light += 1 }
    i += 4
  }
  return light
}

/// How many pixels are dark: the paper theme's ink, not its paper.
fn darkPixels(path: string) -> int {
  let data = try? fs.read(path)
  let all = data?.count() ?? 0
  var dark = 0
  var i = 12
  while i + 3 < all {
    if (data?.get(i) ?? 255) < 0x80 && (data?.get(i + 1) ?? 255) < 0x80 { dark += 1 }
    i += 4
  }
  return dark
}

/// A page file's first pixel: "EQP1", width, height, then RGBA.
fn firstPixel(path: string) -> [int] {
  let data = try? fs.read(path)
  var rgba: [int] = []
  for i in 12..<16 {
    rgba.push(data?.get(i) ?? -1)
  }
  return rgba
}

test "the type and the paper are laid out again, into a new page file" {
  let lib = Library()
  let app = mount(Harness(), provide: lib)
  app.tap("散文選")
  await app.idle()
  // The default: 19 points, 160% line, 100% margins, no letter spacing.
  let before = pagesMatching("s190-l16-m0-k0-w0-paper")
  expect(!before.isEmpty())

  // A different size is a different page: it can't be the file the native
  // view already shows, or the change would wait for a page turn.
  lib.size = 24
  await app.idle()
  let after = pagesMatching("s240-l16-m0-k0-w0-paper")
  expect(!after.isEmpty())
  expect(before[0] != after[0])
  // The tests share the development store: put it back as it was found.
  lib.size = 19
}

test "a page is drawn in the paper and the ink of its theme" {
  let lib = Library()
  let app = mount(Harness(), provide: lib)
  app.tap("散文選")
  await app.idle()
  let paper = pagesMatching("s190-l16-m0-k0-w0-paper")
  expect(!paper.isEmpty())
  // 纸白: #fbfaf7, the background the engine fills the page with.
  let white = firstPixel(paper[paper.count() - 1])
  expect(white.count() == 4)
  expect(white[0] == 0xfb)
  expect(white[1] == 0xfa)
  expect(white[2] == 0xf7)

  lib.theme = "night"
  await app.idle()
  let night = pagesMatching("s190-l16-m0-k0-w0-night")
  expect(!night.isEmpty())
  // 夜间: #16161a behind text drawn in #d8d6cf — not the light page with the
  // surroundings turned dark.
  lib.theme = "paper"
  let first = firstPixel(night[night.count() - 1])
  expect(first[0] == 0x16)
  expect(first[1] == 0x16)
  expect(first[2] == 0x1a)
  // And the text is light: the ink colours the glyphs, or the page would be
  // black on black — which is what a night page looked like.
  expect(lightPixels(night[night.count() - 1]) > 500)
}

test "the page cache goes when it outgrows its budget, and takes no other file" {
  let dir = fs.join([fs.appDir(), "pages"])
  try? fs.mkdirAll(dir)
  let keep = fs.join([dir, "keep-me.txt"])
  let page = fs.join([dir, "测试书-0-scroll-0-512-390-v844-l24r24-20-s190-l16-m0-k0-w0-paper.eqp"])
  let part = fs.join([dir, "测试书-0-scroll-0-512-390-v844-l24r24-20-s190-l16-m0-k0-w0-paper.eqp.part"])
  try? fs.writeText(keep, text: "not a page")
  try? fs.writeText(page, text: "EQP1, pretended")
  // A run that died mid-write leaves one of these: the engine renames into
  // place, so anything still called `.part` is a half band.
  try? fs.writeText(part, text: "half a band")

  // Whatever the budget, a half-written file is never worth keeping.
  prunePages(budget: 1_000_000_000)
  expect(!fs.exists(part))
  expect(fs.exists(page))

  // Over it: the pages go, everything else in the directory stays.
  prunePages(budget: 1)
  expect(!fs.exists(page))
  expect(fs.exists(keep))
  try? fs.remove(keep)
}

test "a position is kept, one row a book" {
  let lib = Library()
  lib.save("测试书", 2, 0.5)
  expect(lib.readingOf("测试书").chapter == 2)
  expect(lib.readingOf("测试书").percent == 0.5)
  lib.save("测试书", 3, 0.75)
  expect(lib.readings.count(b => b.id == "测试书") == 1)
  expect(lib.readingOf("测试书").label() == "第 4 章 · 75%")
}

test "an unread book says so" {
  let lib = Library()
  expect(lib.readingOf("没读过").label() == "未开始")
  // Every book on the shelf is a row with a file the engine reads, the
  // samples' as much as anything brought in: the text isn't kept.
  let app = mount(Harness(), provide: lib)
  await app.idle()
  expect(lib.books().count() >= 2)
  expect(lib.books().all(b => !b.path.isEmpty()))
  expect(lib.books().all(b => b.raw.isEmpty()))
  expect(lib.books().all(b => b.chapters.isEmpty()))
}

test "the appearance sheet changes the type and the paper" {
  let lib = Library()
  // The sheet itself: the buttons over the page have no text to tap by, so
  // the test mounts what they open.
  let app = mount(Appearance(typeface: "Noto Serif SC"), provide: lib)
  app.expect("阅读设置")
  app.expect("字号")
  app.expect("纸色")
  app.expect("行距")
  app.expect("边距")
  app.expect("字距")
  app.tap("夜间")
  expect(lib.theme == "night")
}

test "a .txt brought in becomes a book on the shelf" {
  let path = "{fs.tempDir()}/quire-import-test.txt"
  try await spawn { try fs.writeText(path, text: "第1章 测试\n\n一段文字。\n") }
  let lib = Library()
  let app = mount(Harness(), provide: lib)
  // What the import button does with a file the picker handed over.
  let added = try await lib.importFile(path)
  expect(added)
  await app.idle()
  app.expect("quire-import-test")
  // The row keeps the file's name under the app's directory, not the whole
  // path: iOS may give that directory another name after an update.
  let row = lib.shelf.find(s => s.id == "quire-import-test.txt")
  expect(row?.path == "books/quire-import-test.txt")
  // 内容 hash 是云端 blob 的名字，导入时就该有。
  expect(!(row?.hash ?? "").isEmpty())
  expect((row?.bytes ?? 0) > 0)
  let opened = lib.books().find(b => b.id == "quire-import-test.txt")
  expect(fs.exists(opened?.path ?? ""))
}

test "a kept path is found after the app's directory is renamed" {
  let dir = fs.join([fs.appDir(), "books"])
  let file = fs.join([dir, "挪了位置.txt"])
  try await spawn { try fs.mkdirAll(dir) }
  try await spawn { try fs.writeText(file, text: "第1章 一\n\n一段。\n") }
  // What the shelf keeps: the part after the app's own directory.
  expect(keptName(file) == "books/挪了位置.txt")
  expect(fileOf("books/挪了位置.txt") == file)
  // A row written by an older build holds the old container's whole path;
  // the file is still found under the app's directory of this launch.
  let old = "/private/var/mobile/Containers/Data/Application/OLD-UUID/Library/Application Support/books/挪了位置.txt"
  expect(keptName(old) == "books/挪了位置.txt")
  expect(fileOf(old) == file)
  try await spawn { try fs.remove(file) }
}

test "the same book is only on the shelf once" {
  let source = "{fs.tempDir()}/quire-once.txt"
  try await spawn { try fs.writeText(source, text: "第1章 一\n\n同一本书。\n") }
  let library = Library()
  library.forget("quire-once.txt")
  library.forget("quire-once-other.txt")
  let added = try await library.importFile(source)
  expect(added)
  expect(library.shelf.count(where: s => s.id == "quire-once.txt") == 1)
  // Where it was left is the book's, not the import's.
  library.save("quire-once.txt", chapter: 2, percent: 0.6)
  // The same file again: the row stays one, and so does the place.
  let again = try await library.importFile(source)
  expect(!again)
  expect(library.shelf.count(where: s => s.id == "quire-once.txt") == 1)
  expect(library.readingOf("quire-once.txt").chapter == 2)
  // A copy under another name is the same bytes: still one book, and the
  // copy isn't left in the app's directory under a name nothing uses.
  let copy = "{fs.tempDir()}/quire-once-copy.txt"
  try await spawn { try fs.writeText(copy, text: "第1章 一\n\n同一本书。\n") }
  let copied = try await library.importFile(copy)
  expect(!copied)
  expect(library.shelf.count(where: s => s.id == "quire-once-copy.txt") == 0)
  expect(!fs.exists(fs.join([fs.appDir(), "books/quire-once-copy.txt"])))
  // Different bytes are a book of their own, whatever the name says.
  let other = "{fs.tempDir()}/quire-once-other.txt"
  try await spawn { try fs.writeText(other, text: "第1章 二\n\n另一本。\n") }
  let addedOther = try await library.importFile(other)
  expect(addedOther)
  library.forget("quire-once.txt")
  library.forget("quire-once-other.txt")
}

test "the shelf keeps a row, not a book's text" {
  // What a launch reads back: where the file is, and what the shelf shows.
  // The text isn't kept — the file has it, and the engine reads the file.
  let row = lib.shelfOf(lib.Book(id: "x", title: "書", author: "人", chapters: [], path: "/tmp/x.epub"))
  expect(row.path == "/tmp/x.epub")
  let again = row.book()
  expect(again.id == "x")
  expect(again.title == "書")
  expect(again.author == "人")
  expect(again.raw.isEmpty())
  expect(again.chapters.isEmpty())
}

test "an .epub is kept as a file, not as its text" {
  let path = "{fs.tempDir()}/測試書.epub"
  try await spawn { try fs.writeText(path, text: "PK") }
  let library = Library()
  let app = mount(Harness(), provide: library)
  try await library.importFile(path)
  await app.idle()
  let id = lib.idOf("測試書.epub")
  let kept = library.books().find(b => b.id == id)
  expect(kept != none)
  // The engine opens the file itself; the shelf only has its name.
  expect(kept?.title == "測試書")
  expect(kept?.chapters.isEmpty() ?? false)
  library.forget(id)
  await app.idle()
}

test "a book with no local file and no cloud copy says why it can't open" {
  let library = Library()
  await library.seedSamples()
  if let row = library.shelf.find(s => s.id == "朱自清·散文選") {
    library.cloudHashes = []
    try? fs.remove(fileOf(row.path))
  }
  let book = lib.Book(id: "朱自清·散文選", title: "散文選", author: "", chapters: [])
  do {
    let _ = try await library.prepare(book)
    expect(false)
  } catch e {
    expect(e.message.contains("还没备份到云端"))
  }
}

test "cache cleanup evicts the least recently opened unpinned book" {
  let library = Library()
  library.cacheLimitMB = 1
  library.cloudHashes = ["ha", "hb"]
  library.pinned = ["a"]
  library.lastOpened = ["a": 2, "b": 1]
  let dir = fs.join([fs.appDir(), "books"])
  try await spawn {
    try fs.mkdirAll(dir)
    try fs.writeText(fs.join([dir, "a.txt"]), text: "a")
    try fs.writeText(fs.join([dir, "b.txt"]), text: "b")
  }
  library.shelf = [
    lib.Shelf(id: "a", title: "A", author: "", path: "books/a.txt", hash: "ha", bytes: 700000),
    lib.Shelf(id: "b", title: "B", author: "", path: "books/b.txt", hash: "hb", bytes: 700000),
  ]
  library.evictCache()
  expect(fs.exists(fs.join([dir, "a.txt"])))
  expect(!fs.exists(fs.join([dir, "b.txt"])))
}

test "a backed-up book can keep only its cloud copy" {
  let library = Library()
  library.cloudHashes = ["hc"]
  let dir = fs.join([fs.appDir(), "books"])
  let path = fs.join([dir, "c.txt"])
  try await spawn {
    try fs.mkdirAll(dir)
    try fs.writeText(path, text: "c")
  }
  library.shelf = [lib.Shelf(id: "c", title: "C", author: "", path: "books/c.txt", hash: "hc", bytes: 1)]
  expect(library.removeLocalCopy("c"))
  expect(!fs.exists(path))
  expect(library.removeLocalCopy("c") == false)
}

test "reading and bookmarks mark a book's sidecar for the next sync" {
  let library = Library()
  library.recordReading("a", seconds: 60)
  expect(library.docDirty.get("a") != none)
  library.addBookmark("b", chapter: 0, percent: 0.1)
  expect(library.docDirty.get("b") != none)
}

test "a file that is neither text nor an EPUB is refused" {
  let lib = Library()
  do {
    try await lib.importFile("/tmp/not-a-book.pdf")
  } catch e {
    expect(e.message == "只支持 .txt 和 .epub")
  }
}

test "long press an imported book and delete it" {
  let path = "{fs.tempDir()}/quire-longpress-test.txt"
  try await spawn { try fs.writeText(path, text: "第1章 测试\n\n一段文字。\n") }
  let library = Library()
  let app = mount(Harness(), provide: library)
  try await library.importFile(path)
  await app.idle()
  app.expect("quire-longpress-test")

  app.longPress("quire-longpress-test")
  await app.idle()
  app.expect("删除")
  app.tap("删除")
  await app.idle()
  app.expectNo("quire-longpress-test")
  expect(library.shelf.count(s => s.id == lib.idOf("quire-longpress-test.txt")) == 0)
}

test "long press a book opens its reading record" {
  let path = "{fs.tempDir()}/quire-record-menu.txt"
  try await spawn { try fs.writeText(path, text: "第1章 测试\n\n一段文字。\n") }
  let library = Library()
  let app = mount(Harness(), provide: library)
  try await library.importFile(path)
  await app.idle()
  app.longPress("quire-record-menu")
  await app.idle()
  app.expect("阅读记录")
  app.tap("阅读记录")
  await app.idle()
  app.expect("返回")
  app.expect("累计时长")
  app.expect("每天的记录")
  app.tap("返回")
  await app.idle()
  app.expect("quire-record-menu")
}

test "a sample book can be taken off the shelf" {
  let library = Library()
  let app = mount(Harness(), provide: library)
  await app.idle()
  app.expect("野草")

  app.longPress("野草")
  await app.idle()
  app.expect("删除")
  app.tap("删除")
  await app.idle()
  app.expectNo("野草")
  // A row like any other's: it's gone from the shelf, not hidden from a list
  // the app carries. The app still has the text (samples/ is compiled in).
  expect(library.shelf.find(s => s.title == "野草") == none)
  expect(library.seeded)
  expect(samples().find(b => b.title == "野草") != none)

  // Seeding is once: a launch doesn't bring it back. Put it back for the next
  // run (the store writes it down).
  library.seeded = false
  await library.seedSamples()
  await app.idle()
  app.expect("野草")
}

test "a bookmark is a place, not a count" {
  let lib = Library()
  // The store keeps its rows between runs: start from none.
  for mark in lib.bookmarksOf("書") {
    lib.removeBookmark(mark.id)
  }
  lib.addBookmark("書", chapter: 2, percent: 0.4)
  // The same place, counted a shade differently: still one bookmark.
  lib.addBookmark("書", chapter: 2, percent: 0.4004)
  expect(lib.bookmarksOf("書").count() == 1)
  lib.addBookmark("書", chapter: 3, percent: 0.5)
  expect(lib.bookmarksOf("書").count() == 2)
  let mark = lib.bookmarkAt("書", chapter: 3, percent: 0.5)
  expect(mark != none)
  expect(mark?.percent == 0.5)
  lib.removeBookmark(mark?.id ?? "")
  expect(lib.bookmarksOf("書").count() == 1)
  // A book off the shelf takes its bookmarks with it.
  lib.forget("書")
  expect(lib.bookmarksOf("書").isEmpty())
}

test "the contents sheet lists bookmarks, and drops one" {
  let library = Library()
  for mark in library.bookmarksOf("散文選") {
    library.removeBookmark(mark.id)
  }
  library.addBookmark("散文選", chapter: 1, percent: 0.3)
  let items = [
    engine.TocItem(title: "第一章", spine: 0, depth: 0),
    engine.TocItem(title: "第二章", spine: 1, depth: 0),
  ]
  var dropped = ""
  let app = mount(Contents(items, 1, "散文選") {
    on dropBookmark(id) { dropped = id }
  }, provide: library)
  await app.idle()
  // 书签 first, then the chapters; the row says where in the book it is.
  app.expect("书签")
  app.expect("第二章 · 30%")
  app.longPress("第二章 · 30%")
  await app.idle()
  app.expect("删除")
  app.tap("删除")
  expect(!dropped.isEmpty())
  library.removeBookmark(dropped)
}

test "the bookmark button's action keeps a place, and takes it back" {
  let lib = Library()
  for mark in lib.bookmarksOf("書") {
    lib.removeBookmark(mark.id)
  }
  expect(lib.toggleBookmark("書", chapter: 1, percent: 0.25))
  expect(lib.bookmarksOf("書").count() == 1)
  expect(lib.bookmarksOf("書")[0].percent == 0.25)
  // Pressing again on the same place takes it back rather than adding one.
  expect(!lib.toggleBookmark("書", chapter: 1, percent: 0.2503))
  expect(lib.bookmarksOf("書").isEmpty())
}

test "the home page hides sections that have nothing in them" {
  let lib = Library()
  let app = mount(Harness(), provide: lib)
  await app.idle()
  app.tap("首页")
  await app.idle()
  // 只有目标这一块有内容；在读和往年读完的书都不显示。
  app.expect("今年")
  app.expectNo("继续阅读")
  app.expectNo("之前读过")
  app.expectNo("还没有翻开的书。去书架挑一本，从第一页开始。")
  lib.goal = 24
  await app.idle()
  app.expect("今年读完了 0 本")
}

