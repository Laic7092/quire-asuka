test "a place is kept with the time it was kept" {
  let library = Library()
  library.save("書", chapter: 0, percent: 0.5)
  expect(library.readingOf("書").updated > 0)
}

test "阅读统计 shows the totals and each book's record" {
  let library = Library()
  await library.seedSamples()
  library.recordReading("朱自清·散文選", seconds: 600)
  let app = mount(Profile(), provide: library)
  await app.idle()
  // 我的入口先把今天读的时长写在入口下面。
  app.expect("阅读记录统计")
  app.expect("1 天 · 10 分钟")
  app.tap("阅读记录统计")
  await app.idle()
  app.expect("阅读统计")
  app.expect("总时长")
  app.expect("阅读天数")
  app.expect("连续阅读")
  app.expect("最近 7 天")
  app.expect("10 分钟")
  // 每本书一行，点进去是它自己的记录。
  app.tap("散文選")
  await app.idle()
  app.expect("阅读记录")
  app.expect("累计时长")
  app.expect("每天的记录")
  app.tap("返回")
  await app.idle()
  app.expect("阅读统计")
}

test "阅读统计 still opens before any time is kept" {
  let library = Library()
  await library.seedSamples()
  let app = mount(Profile(), provide: library)
  await app.idle()
  app.tap("阅读记录统计")
  await app.idle()
  // 以前的进度还在，只是时长从这一版才开始记。
  app.expect("阅读统计")
  app.expect("总时长")
  app.expect("还没有记录阅读时长。翻开一本书读一会儿，这里就会开始记下。")
  app.expect("散文選")
}

test "closing the reader keeps the time it was open" {
  let library = Library()
  let app = mount(Harness(), provide: library)
  app.tap("散文選")
  await app.idle()
  await sleep(2s)
  app.tap("返回")
  await app.idle()
  let record = lib.ofBook(library.readingDays, "朱自清·散文選")
  expect(record.seconds >= 1)
  expect(record.days == 1)
}

test "我 opens the sync setup, and its fields are kept" {
  let library = Library()
  let app = mount(Profile(), provide: library)
  await app.idle()
  app.expect("同步与备份")
  app.tap("同步与备份")
  await app.idle()
  // 没配置时直接进连接页，不先给一个空的主界面。
  app.expect("连接云端")
  app.expect("测试连接")
  app.expectNo("立即同步")
  // A field is the store's: typing is what a sync would use, with no Save.
  app.type("reader@example.com", into: "坚果云的登录邮箱")
  await app.idle()
  expect(library.nutAccount == "reader@example.com")
  app.tap("返回")
  await app.idle()
  app.expect("同步与备份")
}

test "配置好之后，同步页只留状态和动作，连接细节在二级页" {
  let library = Library()
  library.nutAccount = "reader@example.com"
  library.nutPassword = "app-password"
  let app = mount(Profile(), provide: library)
  await app.idle()
  app.tap("同步与备份")
  await app.idle()
  app.expect("同步")
  app.expect("立即同步")
  app.expect("云端位置")
  app.expect("启动时自动同步")
  app.expect("自动备份书籍")
  app.expectNo("备份全部到云端")
  app.expectNo("应用密码")
  app.expectNo("测试连接")
  // 存储的细节在二级页。
  app.tap("存储")
  await app.idle()
  app.expect("备份全部到云端")
  app.expect("本地缓存")
  app.tap("返回")
  await app.idle()
  app.expect("立即同步")
  // 连接字段收在「云端位置」里。
  app.tap("云端位置")
  await app.idle()
  app.expect("测试连接")
  app.expect("应用密码")
  app.tap("返回")
  await app.idle()
  app.expect("立即同步")
}

test "a password with no keychain is kept beside the app" {
  let library = Library()
  await library.loadCredentials()
  // The test host has no keychain: the fallback is what it uses.
  expect(!library.passwordSecured)
  library.nutPassword = "app-password"
  await sleep(50ms)
  let path = fs.join([fs.appDir(), "sync-password-nutstore"])
  expect(fs.exists(path))
  // Only the user may read it on Unix; Windows keeps only writability.
  let info = try? fs.stat(path)
  if let info = info {
    expect(info.mode == 0 || (info.mode & 0o077) == 0)
  }
  // The next launch (another Library over the same directory) finds it, and
  // doesn't ask again.
  let again = Library()
  await again.loadCredentials()
  expect(again.nutPassword == "app-password")
  expect(!again.passwordSecured)
}

test "the shelf draws a book as a grid tile or a list row" {
  let library = Library()
  await library.seedSamples()
  library.shelfLayout = "list"
  let app = mount(Harness(), provide: library)
  await app.idle()
  // 列表把作者和进度分成两列；网格把它们拼成一行。
  let rows = app.texts()
  expect(rows.contains("朱自清"))
  expect(rows.contains("未开始"))
  expect(!rows.contains("朱自清 · 未开始"))
  library.shelfLayout = "grid"
  await app.idle()
  expect(app.texts().contains("朱自清 · 未开始"))
}

test "the shelf's display choices set its layout and order" {
  let library = Library()
  let app = mount(Harness(), provide: library)
  await app.idle()
  app.tap("显示与排序")
  await app.idle()
  app.expect("网格")
  app.expect("列表")
  app.expect("最近阅读")
  app.expect("手动")
  app.tap("列表")
  await app.idle()
  expect(library.shelfLayout == "list")

  // A menu closes with the choice, and opens again for the next one; Linux's
  // page stays open instead.
  if @platform != .linux {
    app.tap("显示与排序")
    await app.idle()
  }
  app.tap("书名")
  await app.idle()
  expect(library.shelfSort == "title")

  if @platform != .linux {
    app.tap("显示与排序")
    await app.idle()
  }
  app.tap("作者名")
  await app.idle()
  expect(library.shelfSort == "author")
}

test "the Linux page for display and order sets the same" {
  let library = Library()
  let app = mount(ShelfDisplay(), provide: library)
  await app.idle()
  app.expect("显示与排序")
  app.expect("网格")
  app.expect("列表")
  app.expect("最近阅读")
  app.expect("手动")
  app.tap("列表")
  await app.idle()
  expect(library.shelfLayout == "list")
  app.tap("书名")
  await app.idle()
  expect(library.shelfSort == "title")
  app.tap("作者名")
  await app.idle()
  expect(library.shelfSort == "author")
}

test "the shelf's order is the sort it was told" {
  let library = Library()
  await library.seedSamples()
  // 野草 是最近读的，所以「最近阅读」把它排在前面；按书名时「朱」在「魯」前。
  library.readings = [
    lib.Reading(id: "魯迅·野草", percent: 0.4, updated: 200),
    lib.Reading(id: "朱自清·散文選", percent: 0.2, updated: 100),
  ]
  library.shelfSort = "recent"
  let app = mount(Harness(), provide: library)
  await app.idle()
  let recent = app.texts()
  let recentFirst = recent.index(t => t.contains("野草")) ?? -1
  let recentSecond = recent.index(t => t.contains("散文選")) ?? -1
  expect(recentFirst >= 0 && recentSecond >= 0 && recentFirst < recentSecond)
  library.shelfSort = "title"
  await app.idle()
  let byTitle = app.texts()
  let titleFirst = byTitle.index(t => t.contains("散文選")) ?? -1
  let titleSecond = byTitle.index(t => t.contains("野草")) ?? -1
  expect(titleFirst >= 0 && titleSecond >= 0 && titleFirst < titleSecond)
}

test "typing into a field doesn't close the connection page" {
  let library = Library()
  library.nutPassword = "saved"
  let app = mount(Profile(), provide: library)
  await app.idle()
  app.tap("同步与备份")
  await app.idle()
  app.type("r", into: "坚果云的登录邮箱")
  await app.idle()
  // 配好之后标题会从「连接云端」变成「云端位置」，但表单还得在：
  // 不然输入第一个字页面就跳走。
  app.expect("云端位置")
  app.expect("测试连接")
  app.expectNo("立即同步")
}

test "坚果云和其他 WebDAV 各留各的配置" {
  let library = Library()
  library.syncProvider = "nutstore"
  library.nutAccount = "nut@example.com"
  library.nutPassword = "nut-pass"
  library.nutFolder = "nut-folder"
  library.webServer = "https://dav.example.com/dav/"
  library.webAccount = "web@example.com"
  library.webPassword = "web-pass"
  library.webFolder = "web-folder"

  library.setProvider("webdav")
  expect(library.davAccountNow() == "web@example.com")
  expect(library.davPasswordNow() == "web-pass")
  expect(library.davFolderNow() == "web-folder")
  expect(library.davConfigured())

  // 换回来时，坚果云那套还在，没被 WebDAV 的字段盖掉。
  library.setProvider("nutstore")
  expect(library.davAccountNow() == "nut@example.com")
  expect(library.davPasswordNow() == "nut-pass")
  expect(library.davFolderNow() == "nut-folder")
  expect(library.webServer == "https://dav.example.com/dav/")
  expect(library.webAccount == "web@example.com")
}
