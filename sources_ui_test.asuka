// 书源的导入与管理：先看清有什么，再决定导不导；书源一多，先搜索再翻。

import ./sources

fn demoStore() -> sources.Sources {
  let s = sources.Sources()
  s.entries = [
    sources.Entry(
      id: "a",
      name: "甲源",
      url: "https://a.test",
      json: r#"{"bookSourceName":"甲源","bookSourceUrl":"https://a.test"}"#,
    ),
    sources.Entry(
      id: "b",
      name: "乙源",
      url: "https://b.test",
      json: r#"{"bookSourceName":"乙源","bookSourceUrl":"https://b.test"}"#,
    ),
  ]
  return s
}

component ManagerHarness(store: sources.Sources) {
  provide store
  SourceManager()
}

component ImportHarness(store: sources.Sources) {
  provide store
  SourceImport()
}

test "the manager finds a source by name" {
  let app = mount(ManagerHarness(demoStore()))
  await app.idle()
  app.expect("甲源")
  app.expect("乙源")
  app.type("乙", into: "搜索书源（名字、地址或分组）")
  await app.idle()
  app.expect("乙源")
  app.expectNo("甲源")
  app.expect("匹配 1 个 · 共 2 个书源")
}

test "pasting a collection says what is in it, then imports it" {
  let store = sources.Sources()
  let app = mount(ImportHarness(store))
  await app.idle()
  let collection = r#"[{"bookSourceName":"甲源","bookSourceUrl":"https://a.test"},{"bookSourceName":"乙源","bookSourceUrl":"https://b.test"}]"#
  app.type(collection, into: "把书源 JSON 粘在这里（单个或一份合集）")
  await app.idle()
  app.expect("识别到 2 个书源：甲源、乙源")
  app.tap("导入")
  await app.idle()
  app.expect("导入 2 个书源")
  app.expect("新导入：甲源、乙源")
  expect(store.entries.count() == 2)
}

test "a source in several groups is listed once, with its groups as labels" {
  let store = sources.Sources()
  store.entries = [
    sources.Entry(
      id: "multi",
      name: "多组源",
      group: "甲, 乙, 丙",
      url: "https://multi.test",
      json: r#"{"bookSourceName":"多组源","bookSourceUrl":"https://multi.test","bookSourceGroup":"甲, 乙, 丙"}"#,
    ),
  ]
  let app = mount(ManagerHarness(store))
  await app.idle()
  let texts = app.texts()
  expect(texts.count(where: t => t == "多组源") == 1)
  app.expect("甲")
  app.expect("乙")
  app.expect("丙")
}

test "a source's long note is cut to its first sentence" {
  let note = "搜索/分类需要登录。先在书源变量里设置 wenku8_user / wenku8_pass（legado_eval 执行 source.put，storageDir 会持久化）；详情/目录/正文免登录。"
  expect(sourceHint(note) == "搜索/分类需要登录")
}

test "the captcha login script carries the account and the code" {
  let script = captchaLoginScript("reader", "p&q", "8491", "https://www.wenku8.net", "https://www.wenku8.net/login.php?do=submit")
  expect(script.contains("checkcode"))
  expect(script.contains("8491"))
  expect(script.contains("https://www.wenku8.net/login.php?do=submit"))
  expect(!script.contains("@CODE@"))
  let (user, pass) = captchaCredentials(r#"{"wenku8_user":"reader","wenku8_pass":"p&q"}"#)
  expect(user == "reader")
  expect(pass == "p&q")
}

test "tapping a source opens its own detail" {
  let store = sources.Sources()
  store.entries = [
    sources.Entry(
      id: "detail",
      name: "详细源",
      group: "甲, 乙",
      url: "https://detail.test",
      json: r#"{"bookSourceName":"详细源","bookSourceUrl":"https://detail.test","bookSourceGroup":"甲, 乙","bookSourceComment":"这是说明","loginUrl":"https://detail.test/login","variable":"{\"user\":\"\",\"pass\":\"\"}","variableComment":"要登录","searchUrl":"/search?q={{key}}","exploreUrl":"[{\"title\":\"甲\",\"url\":\"/a\"},{\"title\":\"乙\",\"url\":\"/b\"},{\"title\":\"丙\",\"url\":\"/c\"}]","ruleSearch":{"bookList":".book","name":"a@text"},"ruleBookInfo":{"init":"body"},"ruleToc":{"chapterList":".ch"},"ruleContent":{"content":".body"}}"#,
    ),
  ]
  let app = mount(ManagerHarness(store))
  await app.idle()
  app.tap("详细源")
  await app.idle()
  app.expect("地址")
  app.expect("https://detail.test")
  app.expect("甲、乙")
  app.expect("搜索 · 发现 · 详情 · 目录 · 正文")
  app.expect("3 个分类")
  app.expect("https://detail.test/login")
  app.expect("user、pass")
  app.expect("这是说明")
  app.expect("删除书源")
}

component ContentHarness(store: sources.Sources) {
  provide store
  ContentSources()
}

test "the content-source toolbar toggles the source list's multi-select" {
  let app = mount(ContentHarness(demoStore()))
  await app.idle()
  app.expect("多选")
  app.tap("多选")
  await app.idle()
  app.expect("完成")
  app.expect("已选 0")
  app.tap("完成")
  await app.idle()
  app.expect("多选")
  app.expectNo("已选 0")
}
