// The book engine, called through its C ABI (ebook-engine's crates/ebook-abi,
// the `eb_plain_*` scalar surface): it parses EPUB and plain text, lays a
// chapter out into pages, and rasterizes a page to a file this app shows.
//
// A book is an integer handle (it can live in state, in a store). Nothing
// here draws: a page is an `EQP1` file (u32 width, u32 height, RGBA8) and
// BookPage (the native package) puts it on screen.

import std/fs

/// A page's box and chapter progress.
extern struct PageInfo {
  ok: Int32
  width: Float32
  height: Float32
  /// 0..1, of this chapter; -1 unknown.
  progress: Float32
}

/// Where a point in a page falls in the text.
extern struct Loc {
  /// -1: nothing there.
  page: Int32
  line: UInt32
  byte: UInt32
  /// 0..1, of the whole book; -1 unknown.
  progress: Float32
}

/// One rectangle of a selection, in the page's own points.
extern struct SelectionRect {
  /// 0: no such rectangle.
  ok: Int32
  /// The page it's on.
  page: UInt32
  x: Float32
  y: Float32
  w: Float32
  h: Float32
}

/// A book's link, resolved: a URL outside it, or a place inside it.
extern struct EbLink {
  ok: Int32
  /// -1 for an external link (or one that didn't resolve).
  spine: Int32
  external: Int32
}

extern fn eb_plain_link_at(id: Int32, page: UInt32, x: Float32, y: Float32) -> CString
extern fn eb_plain_resolve_link(id: Int32, href: CString) -> EbLink
extern fn eb_plain_resolved_fragment(id: Int32) -> CString
extern fn eb_plain_fragment_line(id: Int32, fragment: CString) -> Int32

extern fn eb_plain_open(data: bytes, name: CString?) -> Int32
extern fn eb_plain_close(id: Int32) -> Int32
extern fn eb_plain_last_error() -> CString
extern fn eb_plain_title(id: Int32) -> CString
extern fn eb_plain_cover_write(id: Int32, path: CString) -> Int32
extern fn eb_plain_spine_count(id: Int32) -> UInt32
extern fn eb_plain_spine_href(id: Int32, index: UInt32) -> CString
extern fn eb_plain_register_font(id: Int32, data: bytes) -> Int32
extern fn eb_plain_layout(
  id: Int32, spine: UInt32, width: Float32, height: Float32,
  top: Float32, right: Float32, bottom: Float32, left: Float32,
  fontScale: Float32, lineScale: Float32, letterPx: Float32, wordPx: Float32, align: UInt32,
) -> Int32
extern fn eb_plain_layout_scroll(
  id: Int32, spine: UInt32, width: Float32, height: Float32,
  top: Float32, right: Float32, bottom: Float32, left: Float32,
  fontScale: Float32, lineScale: Float32, letterPx: Float32, wordPx: Float32, align: UInt32,
) -> Int32

/// The content height of the last scroll layout, in points.
extern fn eb_plain_content_height(id: Int32) -> Float32
extern fn eb_plain_spine(id: Int32) -> Int32
extern fn eb_plain_page_count(id: Int32) -> UInt32
extern fn eb_plain_page_info(id: Int32, page: UInt32) -> PageInfo
extern fn eb_plain_page_raw(
  id: Int32, page: UInt32, scale: Float32, ink: UInt32, paper: UInt32, bold: bool, path: CString,
) -> Int32

/// A slice of the scroll page: from `y` down `height` points, at `scale`.
extern fn eb_plain_page_slice_raw(
  id: Int32, page: UInt32, y: Float32, height: Float32, scale: Float32,
  ink: UInt32, paper: UInt32, bold: bool, path: CString,
) -> Int32

/// Lay a chapter out and take one scroll window in the same call: a host
/// thread can draw a tile without another call replacing the layout.
extern fn eb_plain_scroll_slice_raw(
  id: Int32, spine: UInt32, width: Float32, height: Float32,
  top: Float32, right: Float32, bottom: Float32, left: Float32,
  fontScale: Float32, lineScale: Float32, letterPx: Float32, wordPx: Float32, align: UInt32,
  y: Float32, sliceHeight: Float32, scale: Float32,
  ink: UInt32, paper: UInt32, bold: bool, path: CString,
) -> Int32
/// One chapter in the whole-book scroll session: where it starts in the flow,
/// how tall it is, and whether it could be laid out at all.
extern struct ScrollChapter {
  ok: Int32
  /// `UInt32.max` for an index out of range.
  spine: UInt32
  top: Float32
  height: Float32
}

/// Where a point in the scroll column falls in the text.
extern struct ScrollLoc {
  /// -1: nothing there.
  spine: Int32
  line: UInt32
  byte: UInt32
  /// The line's box top, in the flow coordinates of the column.
  y: Float32
}

/// ---- Continuous scrolling, across chapters ----
///
/// The engine owns the column: chapter tops, lazily measured heights, the
/// band renderer (a band may cross a chapter and the seam stays in line),
/// hits, line/anchor-to-y and progress — all in the book's flow coordinates,
/// so the reader keeps no chapter table of its own.
extern fn eb_plain_scroll_begin(
  id: Int32, width: Float32, height: Float32,
  top: Float32, right: Float32, bottom: Float32, left: Float32,
  fontScale: Float32, lineScale: Float32, letterPx: Float32, wordPx: Float32, align: UInt32,
) -> Int32
extern fn eb_plain_scroll_chapter_count(id: Int32) -> UInt32
extern fn eb_plain_scroll_chapter(id: Int32, index: UInt32) -> ScrollChapter
extern fn eb_plain_scroll_total_height(id: Int32) -> Float32
extern fn eb_plain_scroll_spine_at(id: Int32, y: Float32) -> Int32
extern fn eb_plain_scroll_chapter_top(id: Int32, spine: UInt32) -> Float32
extern fn eb_plain_scroll_band_raw(
  id: Int32, y: Float32, height: Float32, scale: Float32,
  ink: UInt32, paper: UInt32, bold: bool, path: CString,
) -> Int32
extern fn eb_plain_scroll_hit(id: Int32, x: Float32, y: Float32) -> ScrollLoc
extern fn eb_plain_scroll_line_y(id: Int32, spine: UInt32, line: UInt32) -> Float32
extern fn eb_plain_scroll_anchor_y(id: Int32, spine: UInt32, fragment: CString) -> Float32
extern fn eb_plain_scroll_progress(id: Int32, y: Float32) -> Float32
extern fn eb_plain_hit(id: Int32, page: UInt32, x: Float32, y: Float32) -> Loc
extern fn eb_plain_progress(id: Int32, page: UInt32, line: UInt32, byte: UInt32) -> Float32
extern fn eb_plain_select(
  id: Int32, aPage: UInt32, aLine: UInt32, aByte: UInt32,
  bPage: UInt32, bLine: UInt32, bByte: UInt32,
) -> Int32
extern fn eb_plain_selection_rect_count(id: Int32) -> UInt32
extern fn eb_plain_selection_rect(id: Int32, index: UInt32) -> SelectionRect
extern fn eb_plain_selection_text(id: Int32) -> CString
extern fn eb_plain_selection_start(id: Int32) -> Loc
extern fn eb_plain_selection_end(id: Int32) -> Loc
extern fn eb_plain_toc_count(id: Int32) -> UInt32
extern fn eb_plain_toc_title(id: Int32, index: UInt32) -> CString
extern fn eb_plain_toc_spine(id: Int32, index: UInt32) -> Int32
extern fn eb_plain_toc_depth(id: Int32, index: UInt32) -> UInt32

/// What went wrong last, for the log.
pub fn lastError() -> string = eb_plain_last_error()

/// Opens a book: EPUB by its archive, plain text by anything else.
/// -1 when it failed (see lastError).
pub fn open(path: string) -> int {
  if !fs.exists(path) { return -1 }
  if let data = try? fs.read(path) {
    return int(eb_plain_open(data, path))
  }
  return -1
}

/// Releases a handle.
pub fn close(id: int) {
  if id > 0 { let _closed = eb_plain_close(i32(clamping: id)) }
}

/// Registers a font file the app ships (or one the system has). Without a
/// font the pages come out blank: the engine measures with the fonts given.
pub fn registerFont(id: int, path: string) -> bool {
  if id <= 0 || !fs.exists(path) { return false }
  if let data = try? fs.read(path) {
    if data.isEmpty() { return false }
    return eb_plain_register_font(i32(clamping: id), data) >= 0
  }
  return false
}

/// Registers a font the app carries in its own code.
pub fn registerFontBytes(id: int, data: bytes) -> bool {
  if id <= 0 || data.isEmpty() { return false }
  return eb_plain_register_font(i32(clamping: id), data) >= 0
}

/// The first font that exists, out of the ones a platform has.
pub fn registerFirstFont(id: int, paths: [string]) -> bool {
  for path in paths {
    if registerFont(id, path: path) { return true }
  }
  return false
}

/// A page's margins, in points: the text's column, not the screen's edges.
pub struct Margins {
  top: float
  right: float
  bottom: float
  left: float
}

/// Lays a chapter (`spine`, 0-based) out for a view of this size. Returns
/// its page count, -1 when it failed.
pub fn layout(id: int, spine: int, width: float, height: float, margins: Margins, fontScale: float, lineScale: float, letter: float = 0, word: float = 0, align: int = 0) -> int {
  if id <= 0 { return -1 }
  let rc = eb_plain_layout(
    i32(clamping: id), u32(clamping: spine), width, height,
    margins.top, margins.right, margins.bottom, margins.left,
    fontScale, lineScale, letter, word, u32(clamping: align),
  )
  if rc < 0 { return -1 }
  return int(eb_plain_page_count(i32(clamping: id)))
}

/// Lays a chapter out as one continuous scroll column. Returns its content
/// height in points, -1 when it failed. `margins.top`/`bottom` are ignored:
/// the host puts the top and bottom room around the list, not in each tile.
pub fn layoutScroll(id: int, spine: int, width: float, height: float, margins: Margins, fontScale: float, lineScale: float, letter: float = 0, word: float = 0, align: int = 0) -> float {
  if id <= 0 { return -1 }
  let rc = eb_plain_layout_scroll(
    i32(clamping: id), u32(clamping: spine), width, height,
    0, margins.right, 0, margins.left,
    fontScale, lineScale, letter, word, u32(clamping: align),
  )
  if rc < 0 { return -1 }
  return eb_plain_content_height(i32(clamping: id))
}

/// One page's box and chapter progress.
pub fn pageInfo(id: int, page: int) -> PageInfo = eb_plain_page_info(i32(clamping: id), u32(clamping: page))

/// Rasterizes a page into `path`, at `scale` device pixels per point.
pub fn renderPage(id: int, page: int, scale: float, ink: u32, paper: u32, bold: bool, path: string) -> bool {
  return eb_plain_page_raw(i32(clamping: id), u32(clamping: page), scale, ink, paper, bold, path) == 0
}

/// Rasterizes the slice at `y`, `height` points tall, into `path`.
pub fn renderSlice(id: int, page: int, y: float, height: float, scale: float, ink: u32, paper: u32, bold: bool, path: string) -> bool {
  return eb_plain_page_slice_raw(i32(clamping: id), u32(clamping: page), y, height, scale, ink, paper, bold, path) == 0
}

/// Lays `spine` out for scrolling and rasterizes one window of it in the
/// same engine call, so a background tile cannot be drawn from another
/// chapter's layout. Top and bottom margins are the host's, hence 0.
pub fn scrollSlice(id: int, spine: int, width: float, height: float, margins: Margins, fontScale: float, lineScale: float, letter: float, word: float, y: float, sliceHeight: float, scale: float, ink: u32, paper: u32, bold: bool, path: string) -> bool {
  if id <= 0 { return false }
  return eb_plain_scroll_slice_raw(
    i32(clamping: id), u32(clamping: spine), width, height,
    0, margins.right, 0, margins.left,
    fontScale, lineScale, letter, word, 0,
    y, sliceHeight, scale, ink, paper, bold, path,
  ) == 0
}

/// One chapter of the scroll column: where it starts in the flow, how tall it
/// is, and whether it could be laid out (a chapter that can't is height 0 and
/// doesn't stop the ones after it).
pub struct FlowChapter {
  spine: int
  top: float
  height: float
  ok: bool
}

/// Where a point in the scroll column falls in the text.
pub struct FlowLoc {
  /// -1: nothing there.
  spine: int
  line: int
  byte: int
  /// The line's box top, in flow coordinates.
  y: float
}

/// Opens the whole book as one scroll column: the engine keeps chapter tops,
/// measures heights lazily and renders any band of the flow. Top and bottom
/// margins are the scroll container's own room, so they're dropped here; left
/// and right are the text's column. Returns the chapter count, -1/-2 an error.
/// Call it after the font is registered: a new font drops the session.
pub fn beginScroll(id: int, width: float, height: float, margins: Margins, fontScale: float, lineScale: float, letter: float = 0, word: float = 0, align: int = 0) -> int {
  if id <= 0 { return -1 }
  return int(eb_plain_scroll_begin(
    i32(clamping: id), width, height,
    0, margins.right, 0, margins.left,
    fontScale, lineScale, letter, word, u32(clamping: align),
  ))
}

/// One chapter's place in the column. Asking for chapter i measures 0…i, so a
/// host may spread the work over frames; `flowHeight` measures the whole book.
pub fn flowChapter(id: int, index: int) -> FlowChapter {
  let c = eb_plain_scroll_chapter(i32(clamping: id), u32(clamping: index))
  return FlowChapter(
    spine: if c.spine == u32.max { -1 } else { int(c.spine) },
    top: c.top, height: c.height, ok: c.ok != 0,
  )
}

/// The column's total height in points (the scroll container's content size).
/// Measured on the first call; -1 when there's no session.
pub fn flowHeight(id: int) -> float = eb_plain_scroll_total_height(i32(clamping: id))

/// The chapter a flow y falls in; -1 past the end or with no session.
pub fn flowSpineAt(id: int, y: float) -> int = int(eb_plain_scroll_spine_at(i32(clamping: id), y))

/// One band of the column at `scale`, written to `path` as EQP1. A band may
/// cross a chapter: the engine draws each chapter it touches and keeps the
/// seam in line. Outside the content is paper.
pub fn flowBand(id: int, y: float, height: float, scale: float, ink: u32, paper: u32, bold: bool, path: string) -> bool {
  if id <= 0 || height <= 0 { return false }
  return eb_plain_scroll_band_raw(i32(clamping: id), y, height, scale, ink, paper, bold, path) == 0
}

/// Flow point → the text there (spine -1 when there's none).
pub fn flowHit(id: int, x: float, y: float) -> FlowLoc {
  let loc = eb_plain_scroll_hit(i32(clamping: id), x, y)
  return FlowLoc(spine: int(loc.spine), line: int(loc.line), byte: int(loc.byte), y: loc.y)
}

/// A line's box top, in flow coordinates; -1 when there's no such line.
pub fn flowLineY(id: int, spine: int, line: int) -> float = eb_plain_scroll_line_y(i32(clamping: id), u32(clamping: spine), u32(clamping: line))

/// A chapter's anchor ("#part-2") in flow coordinates; -1 when it has none.
pub fn flowAnchorY(id: int, spine: int, fragment: string) -> float = eb_plain_scroll_anchor_y(i32(clamping: id), u32(clamping: spine), fragment)

/// A flow y as 0…1 of the book; -1 on error.
pub fn flowProgress(id: int, y: float) -> float = eb_plain_scroll_progress(i32(clamping: id), y)

/// Where this point in the page falls in the text.
pub fn hit(id: int, page: int, x: float, y: float) -> Loc = eb_plain_hit(i32(clamping: id), u32(clamping: page), x, y)

/// One rectangle of a selection, in page points.
pub struct Rect {
  page: int
  x: float
  y: float
  w: float
  h: float
}

/// Selects from `a` to `b` (a `hit`'s page, line and byte), in either order.
/// Returns how many rectangles it made; 0 means empty or nothing to select.
/// The selection is kept on the handle for the readers below, until the next
/// call.
pub fn select(id: int, a: Loc, b: Loc) -> int {
  if id <= 0 { return 0 }
  let count = eb_plain_select(
    i32(clamping: id),
    u32(clamping: a.page), a.line, a.byte,
    u32(clamping: b.page), b.line, b.byte,
  )
  return if count > 0 { int(count) } else { 0 }
}

/// Selects by line and byte, for places a caller kept rather than hit.
pub fn selectLines(id: int, aLine: int, aByte: int, bLine: int, bByte: int) -> int {
  if id <= 0 { return 0 }
  let count = eb_plain_select(
    i32(clamping: id), 0, u32(clamping: aLine), u32(clamping: aByte),
    0, u32(clamping: bLine), u32(clamping: bByte),
  )
  return if count > 0 { int(count) } else { 0 }
}

/// One line of the last laid-out chapter, by its line number (the line a
/// `hit` gives): "" when there's no such line. It asks for the line as a
/// selection, so the text is exactly the source the line was set from.
pub fn lineText(id: int, line: int) -> string {
  if id <= 0 || line < 0 { return "" }
  let count = eb_plain_select(
    i32(clamping: id), 0, u32(clamping: line), 0,
    0, u32(clamping: line), 0xffffffff,
  )
  if count <= 0 { return "" }
  return eb_plain_selection_text(i32(clamping: id))
}

/// The last selection's rectangles, in page points.
pub fn selectionRects(id: int) -> [Rect] {
  var out: [Rect] = []
  if id <= 0 { return out }
  let key = i32(clamping: id)
  let count = eb_plain_selection_rect_count(key)
  for i in 0..<int(count) {
    let rect = eb_plain_selection_rect(key, u32(clamping: i))
    if rect.ok == 0 { continue }
    out.push(Rect(page: int(rect.page), x: rect.x, y: rect.y, w: rect.w, h: rect.h))
  }
  return out
}

/// The last selection's text ("" when there's none).
pub fn selectionText(id: int) -> string {
  if id <= 0 { return "" }
  return eb_plain_selection_text(i32(clamping: id))
}

/// The last selection's normalized start and end.
pub fn selectionStart(id: int) -> Loc = eb_plain_selection_start(i32(clamping: id))
pub fn selectionEnd(id: int) -> Loc = eb_plain_selection_end(i32(clamping: id))

/// The link at a point on the last laid-out page: "" when there's none.
pub fn linkAt(id: int, page: int, x: float, y: float) -> string {
  if id <= 0 { return "" }
  return eb_plain_link_at(i32(clamping: id), u32(clamping: page), x, y)
}

/// Where one of the book's links goes, and the anchor it names inside the
/// chapter ("" for its start).
pub struct Link {
  ok: bool
  external: bool
  /// The chapter, -1 for a URL outside the book.
  spine: int
  fragment: string
}

pub fn resolveLink(id: int, href: string) -> Link {
  let missing = Link(ok: false, external: false, spine: -1, fragment: "")
  if id <= 0 || href.isEmpty() { return missing }
  let link = eb_plain_resolve_link(i32(clamping: id), href)
  if link.ok == 0 { return missing }
  return Link(
    ok: true,
    external: link.external != 0,
    spine: int(link.spine),
    fragment: eb_plain_resolved_fragment(i32(clamping: id)),
  )
}

/// A fragment's line in the chapter last laid out; -1 when it isn't there.
pub fn fragmentLine(id: int, fragment: string) -> int {
  if id <= 0 || fragment.isEmpty() { return -1 }
  return int(eb_plain_fragment_line(i32(clamping: id), fragment))
}

/// A line of the last laid-out chapter as 0…1 of it: where a page falls.
pub fn progress(id: int, line: int) -> float {
  if id <= 0 || line < 0 { return 0 }
  return eb_plain_progress(i32(clamping: id), 0, u32(clamping: line), 0)
}

/// A directory entry of the table of contents.
pub struct TocItem {
  title: string
  spine: int
  depth: int
}

/// The table of contents.
pub fn contents(id: int) -> [TocItem] {
  var items: [TocItem] = []
  if id <= 0 { return items }
  let key = i32(clamping: id)
  let count = eb_plain_toc_count(key)
  for i in 0..<int(count) {
    items.push(TocItem(
      title: eb_plain_toc_title(key, u32(clamping: i)),
      spine: int(eb_plain_toc_spine(key, u32(clamping: i))),
      depth: int(eb_plain_toc_depth(key, u32(clamping: i))),
    ))
  }
  return items
}

/// The book's title: its metadata, or what the engine made of the file.
pub fn title(id: int) -> string = eb_plain_title(i32(clamping: id))

/// Writes the book's cover image (its original PNG/JPEG bytes) to `path`.
/// False when the book has no cover.
pub fn writeCover(id: int, path: string) -> bool {
  if id <= 0 { return false }
  return eb_plain_cover_write(i32(clamping: id), path) == 0
}

/// How many chapters (spine items) it has.
pub fn chapterCount(id: int) -> int = int(eb_plain_spine_count(i32(clamping: id)))

/// A chapter's name, from its href: "ch01.xhtml" is "ch01".
pub fn chapterName(id: int, index: int) -> string {
  let href = eb_plain_spine_href(i32(clamping: id), u32(clamping: index))
  return href
}
