// 发现页的分类有几种写法：JSON、带尾逗号的 JSON，以及一行一个
// `标题::地址`。这几种都要读得出来，不然发现页会多出一层“发现”。

import ./sources

test "an exploreUrl that is one line per category reads its categories" {
  let text = r#"{"bookSourceName":"快眼","bookSourceUrl":"http://www.botaodz.com/","exploreUrl":"全部::/category/all/\n玄幻::/category/xuanhuan/\n都市::/category/dushi/"}"#
  let def = try sources.decodeSource(try sources.parseList(text)[0])
  let categories = sources.exploreCategories(def)
  expect(categories.count() == 3)
  expect(categories[0].title == "全部")
  expect(categories[0].url == "/category/all/")
  expect(categories[2].title == "都市")
}

test "an exploreUrl with a trailing comma still reads as JSON" {
  let text = r#"{"bookSourceName":"穿越","bookSourceUrl":"http://www.kk169.org","exploreUrl":"[{\"title\":\"玄幻·魔法\",\"url\":\"book/sort1/0/{{page}}.html\"},{\"title\":\"武侠·修真\",\"url\":\"book/sort2/0/{{page}}.html\"},]"}"#
  let def = try sources.decodeSource(try sources.parseList(text)[0])
  let categories = sources.exploreCategories(def)
  expect(categories.count() == 2)
  expect(categories[0].title == "玄幻·魔法")
  expect(categories[1].url == r"book/sort2/0/{{page}}.html")
}

test "a plain URL is still the one category it was" {
  let text = r#"{"bookSourceName":"一个","bookSourceUrl":"x.test","exploreUrl":"/all?p={{page}}"}"#
  let def = try sources.decodeSource(try sources.parseList(text)[0])
  let categories = sources.exploreCategories(def)
  expect(categories.count() == 1)
  expect(categories[0].title == "发现")
}

test "a download source keeps its file links" {
  let text = r#"{"bookSourceName":"下载","bookSourceUrl":"https://d.test","bookSourceType":3,"ruleBookInfo":{"downloadUrls":"TXT::https://d.test/1.txt\nEPUB::https://d.test/1.epub\nhttps://d.test/2.txt\n\n# 注释\nhttps://d.test/2.txt"}}"#
  let def = try sources.decodeSource(try sources.parseList(text)[0])
  expect(sources.isDownloadSource(def))
  let files = sources.downloadOptions(def.infoRules().downloadUrls)
  expect(files.count() == 3)
  expect(files[0].name == "TXT")
  expect(files[1].name == "EPUB")
  // 没有名字的按地址给一个；重复的地址只留一份。
  expect(files[2].name == "TXT 3")
  expect(files[2].url == "https://d.test/2.txt")
}

test "a text source can have download links too" {
  let text = r#"{"bookSourceName":"在线","bookSourceUrl":"https://o.test","bookSourceType":0,"ruleBookInfo":{"downloadUrls":"简体::https://dl.test/down.php?type=utf8&id=1"}}"#
  let def = try sources.decodeSource(try sources.parseList(text)[0])
  expect(!sources.isDownloadSource(def))
  let files = sources.downloadOptions(def.infoRules().downloadUrls)
  expect(files.count() == 1)
  expect(files[0].name == "简体")
}

test "a source's login and variable comments are read" {
  let text = r#"{"bookSourceName":"登录","bookSourceUrl":"https://l.test","loginUrl":"https://l.test/login","variableComment":"先填账号密码"}"#
  let def = try sources.decodeSource(try sources.parseList(text)[0])
  expect(def.loginUrl == "https://l.test/login")
  expect(def.variableComment == "先填账号密码")
}

test "a variable is stored for getVariable and for each key" {
  let script = sources.variablesScript(r#"{"user":"a","pass":"b"}"#)
  expect(script.contains("source.putVariable("))
  expect(script.contains("source.put(\"user\", \"a\")"))
  expect(script.contains("source.put(\"pass\", \"b\")"))
}

test "variable keys come from the variable field and the source's scripts" {
  let text = r#"{"bookSourceName":"登录","bookSourceUrl":"https://w.test","variable":"{\"user\":\"\",\"pass\":\"\"}","jsLib":"var a=source.get('wenku8_user'); source.put(\"wenku8_pass\", 'x');"}"#
  let def = try sources.decodeSource(try sources.parseList(text)[0])
  let keys = sources.variableKeys(def)
  expect(keys.contains("user"))
  expect(keys.contains("pass"))
  expect(keys.contains("wenku8_user"))
  expect(keys.contains("wenku8_pass"))
  expect(keys == keys.unique())
}

test "a variable value reads and writes without losing the others" {
  let text = r#"{"user":"a","keep":"x","n":3}"#
  expect(sources.variableValueOf(text, "user") == "a")
  expect(sources.variableValueOf(text, "n") == "3")
  let next = sources.withVariableValue(text, "pass", "b")
  expect(sources.variableValueOf(next, "user") == "a")
  expect(sources.variableValueOf(next, "keep") == "x")
  expect(sources.variableValueOf(next, "pass") == "b")
}

test "a source with no variable still shows the keys its login script asks for" {
  let text = r#"{"bookSourceName":"轻小说文库","bookSourceUrl":"https://www.wenku8.net","jsLib":"var u=source.get('wenku8_user');var p=source.get('wenku8_pass');"}"#
  let def = try sources.decodeSource(try sources.parseList(text)[0])
  expect(sources.variableKeys(def) == ["wenku8_user", "wenku8_pass"])
}

test "a category's page number is written into its URL" {
  expect(sources.explorePageUrl(r"/list?page={{page}}", 3) == "/list?page=3")
  expect(sources.explorePageUrl(r"/list?page={page}", 2) == "/list?page=2")
  expect(sources.explorePageUrl(r"<js>'/list?page='+page</js>", 4) == "<js>page=4;'/list?page='+page</js>")
  expect(sources.explorePageUrl(r"@js:'/list?p='+page", 5) == "@js:page=5;'/list?p='+page")
}

test "only a category that names a page can be paged" {
  expect(sources.canExplorePages(r"/list?page={{page}}"))
  expect(sources.canExplorePages(r"<js>'/list?page='+page</js>"))
  expect(!sources.canExplorePages("/category/xuanhuan/"))
}

test "a page number the URL already carries moves on too" {
  // 书源常把第一页写死在分类地址里：「加载更多」得把那个数字往上加，
  // 否则每次都取回第一页。
  expect(sources.explorePageUrl("https://x.test/list?page=1", 3) == "https://x.test/list?page=3")
  expect(sources.explorePageUrl("/list?pageno=2&type=txt", 5) == "/list?pageno=5&type=txt")
  expect(sources.explorePageUrl("/list?pageno=2#top", 4) == "/list?pageno=4#top")
  expect(sources.canExplorePages("https://x.test/list?page=1"))
  // 页号不是数字（书源自己的名字），改不了，也就不说能翻页。
  expect(!sources.canExplorePages("https://x.test/list?page=all"))
  expect(sources.explorePageUrl("/list?page=all", 2) == "/list?page=all")
  // 单个 p 是帖子编号，不当页号。
  expect(!sources.canExplorePages("https://x.test/post?p=9"))
  expect(sources.explorePageUrl("/category/all/", 2) == "/category/all/")
}

test "the captcha login knows where the code image is" {
  let text = r#"{"bookSourceName":"轻小说","bookSourceUrl":"https://www.wenku8.net","loginUrl":"https://www.wenku8.net/login.php"}"#
  let def = try sources.decodeSource(try sources.parseList(text)[0])
  expect(sources.captchaLoginOf(def) == "https://www.wenku8.net/checkcode.php")
  expect(sources.captchaSubmitOf(def) == "https://www.wenku8.net/login.php?do=submit")
  let other = r#"{"bookSourceUrl":"https://other.test"}"#
  let plain = try sources.decodeSource(try sources.parseList(other)[0])
  expect(sources.captchaLoginOf(plain).isEmpty())
}
