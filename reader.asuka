// The reading page: the engine (ebook-engine) lays a chapter out into pages
// and rasterizes each one to a file; BookPage (the native package) shows it.
//
// Every way into the text — the page turn, the table of contents, the size
// and the paper — goes through the same task: lay the chapter out again,
// rasterize the page, and remember where the reader is.

import std/embed
import std/fs
import std/time
import platform/device
import platform/screen

import bookpage

import ./lib
import ./engine
import ./localbook
import ./remote
import ./sources

/// Points the engine lays out at, before the reader's own size multiplies it.
let baseSize = 19.0

/// 在线书一次装进引擎的章数。引擎的书是流式的（章节只能往后加），所以窗口
/// 是「从 base 起的这一批章」；读者走到窗口边上就换一窗——引擎和字体都还在，
/// 换的只是章节表。一章一章地取，整本从不下载。
let windowSpan = 40

/// 一章所在的窗口从全书的第几章起：一窗 `windowSpan` 章，窗口不跨块——
/// 换窗时章号按块算，读者要的那一章一定在窗口里。
fn windowBaseFor(chapter: int) -> int {
  if chapter <= 0 { return 0 }
  return (chapter / windowSpan) * windowSpan
}

/// 一窗几章：到目录末尾就少。
fn windowCountOf(total: int, base: int) -> int {
  var count = total - base
  if count > windowSpan { count = windowSpan }
  if count < 0 { count = 0 }
  return count
}

/// 浮在页面上的控件离屏幕边缘的宽。阅读页铺满整屏（纸连状态栏底下都刷），
/// 所以系统栏和安全区得自己让开：先加 safeLeft/safeRight，再留出系统栏那
/// 样的 16pt。横屏的刘海也因此在外面。
let chromeMargin: float = 16

/// Where the reader is in the column, in the Scroll's own coordinates. A frame's
/// scroll event writes it, so it can't be `state`: that would rebuild the page
/// on every frame of a fling. Nothing in the tree draws from it — a bookmark,
/// the saved place and the band window read it when they need it.
var scrollAt = 0.0

/// The face the pages are set in: a serif the app ships, so every device and
/// every test lays the same book out the same way (and Chinese always has
/// glyphs). SIL Open Font License; see fonts/OFL.txt.
let bundledFace = embed.bytes("fonts/NotoSerifSC-Regular.woff")

/// The families to ask the platform for, in order. iOS's font files aren't
/// where a reader would guess (and some live in the dyld cache), so the
/// platform's own font layer gives the path.
let fontFamilies = ["Songti SC", "PingFang SC", "Hiragino Sans GB", "Songti TC", "Noto Serif CJK SC"]

/// The file list to try when the platform can't name one.
fn fontCandidates() -> [string] {
  if @platform == .iOS || @platform == .macOS {
    return [
      "/System/Library/Fonts/Supplemental/Songti.ttc",
      "/System/Library/Fonts/PingFang.ttc",
      "/System/Library/Fonts/Supplemental/STIXTwoText.ttf",
    ]
  }
  if @platform == .windows {
    return [
      "C:/Windows/Fonts/simsun.ttc",
      "C:/Windows/Fonts/msyh.ttc",
      "C:/Windows/Fonts/segoeui.ttf",
    ]
  }
  return [
    "/usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf",
    "/usr/share/fonts/opentype/noto/NotoSerifCJK-Regular.ttc",
    "/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc",
    "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf",
  ]
}

/// The file the engine reads: the import's, or one written from the text the
/// shelf kept. A row's path is resolved against the app's directory before it
/// gets here; the fallback is a book whose row lost its file name.
async fn bookFileOf(book: lib.Book) throws -> string {
  if !book.path.isEmpty() && fs.exists(book.path) { return book.path }
  let dir = fs.join([fs.appDir(), "books"])
  // An imported book's id is its file's name (with the extension); a sample's
  // is its title, whose file is the title and .txt.
  let lower = book.id.lower()
  let name = if lower.hasSuffix(".txt") || lower.hasSuffix(".epub") { book.id } else { "{book.id}.txt" }
  let path = fs.join([dir, name])
  if !fs.exists(path) && !book.raw.isEmpty() {
    let raw = book.raw
    try await spawn { try fs.mkdirAll(dir) }
    try await spawn {
      try fs.writeText(path, text: raw)
    }
  }
  return path
}

/// The font the engine measures with: the platform's, by family name; else
/// a file at one of the usual paths.
fn fontFile() -> string {
  let files = try? bookpage.FontFiles()
  if let files = files {
    for family in fontFamilies {
      if let found = try? files.path(family: family) {
        if !found.isEmpty() { return found }
      }
    }
  }
  for path in fontCandidates() {
    if fs.exists(path) { return path }
  }
  // Nothing named: whatever the system's font directory has. The Chinese
  // faces by name first, since that's what the text is.
  for dir in ["/System/Library/Fonts", "/System/Library/Fonts/Supplemental", "/System/Library/Fonts/LanguageSupport", "/System/Library/Fonts/Core"] {
    if let entries = try? fs.walk(dir) {
      let fonts = entries.filter(e => !e.isDir && (e.name.lower().hasSuffix(".ttc") || e.name.lower().hasSuffix(".ttf")))
      for key in ["song", "ping", "hiragino", "heiti", "kai", "noto", "wqy", "droid"] {
        for entry in fonts {
          if entry.name.lower().contains(key) { return entry.path }
        }
      }
      if let first = fonts.first() { return first.path }
    }
  }
  return ""
}

/// A page's side margin in points: the default proportion (7.5% of the page,
/// at least 24 points) times the reader's setting, where 0 keeps the default,
/// 1 doubles it and -0.3 leaves seven tenths. The sheet shows this number, so
/// the slider says 24 点 rather than -30%.
fn sideMargin(width: float, delta: float) -> float {
  let side = if width * 0.075 > 24 { width * 0.075 } else { 24.0 }
  let factor = if delta > -0.9 { 1.0 + delta } else { 0.1 }
  return side * factor
}

/// The margins a page is set in, from the view it's shown in and the reader's
/// own factor (1 is the default: the proportion below, with a floor).
fn marginsOf(width: float, height: float, delta: float, env: Environment) -> engine.Margins {
  let top = if height * 0.055 > 28 { height * 0.055 } else { 28.0 }
  // 0 is the default proportions; the setting is how much wider they get.
  let factor = if delta > -0.9 { 1.0 + delta } else { 0.1 }
  // The page covers the screen, so the notch's and the home indicator's room
  // is the layout's to leave.
  return engine.Margins(
    top: top * factor + env.safeTop,
    right: sideMargin(width, delta) + env.safeRight,
    bottom: top * factor + env.safeBottom,
    left: sideMargin(width, delta) + env.safeLeft,
  )
}

/// A setting with its sign, as a person reads it: "+5%", "-20%", "0%".
fn signedPercent(v: float) -> string {
  let p = (v * 100).rounded().int()
  if p > 0 { return "+{p}%" }
  if p < 0 { return "{p}%" }
  return "0%"
}

/// The page files: one a book, chapter, page and size, next to the app's data.
fn pagesDir() -> string = fs.join([fs.appDir(), "pages"])

/// How many bytes of page files the app keeps. They are a cache — a page is a
/// few milliseconds to draw — so running over this costs one window's drawing,
/// not correctness. Reading a book for an hour writes a couple of gigabytes of
/// bands, so without a ceiling the directory grows with no end.
let pagesBudget = 200_000_000

/// Throws the page cache away when it outgrows its budget, and any half-written
/// file a killed run left behind. Wholesale rather than by age: keeping an age
/// per file is bookkeeping for something that is cheap to draw again.
fn prunePages(budget: int) {
  let entries = (try? fs.walk(pagesDir())) ?? []
  var total = 0
  var pages: [string] = []
  for entry in entries {
    if entry.isDir { continue }
    // The engine writes `{path}.{pid}.{seq}.part` and renames it into place,
    // so a `.part` that is still here is a write that never finished.
    if entry.name.hasSuffix(".part") {
      try? fs.remove(entry.path)
      continue
    }
    if !entry.name.hasSuffix(".eqp") { continue }
    total += (try? fs.stat(entry.path))?.size ?? 0
    pages.push(entry.path)
  }
  if total <= budget { return }
  for path in pages { try? fs.remove(path) }
}

/// A new engine can lay the same chapter out differently — 0.6.0's Chinese
/// typography changes line breaks, page heights and orphans — and a page file
/// is named after the book, the type and the chapter, not the engine that drew
/// it. On the first launch after an update, drop the page cache so a band the
/// old engine drew is not shown again; the marker is the version string, kept
/// outside the cache.
fn dropPagesFromAnotherEngine() {
  let marker = fs.join([fs.appDir(), "pages.version"])
  let current = engine.version()
  if let last = try? fs.readText(marker) {
    if last == current { return }
  }
  let entries = (try? fs.walk(pagesDir())) ?? []
  for entry in entries {
    if entry.isDir { continue }
    if entry.name.hasSuffix(".eqp") || entry.name.hasSuffix(".part") {
      try? fs.remove(entry.path)
    }
  }
  try? fs.writeText(marker, text: current)
}

/// One visible band of the column, at its place in the book's flow. The column
/// is a real Scroll and the engine owns the flow (chapter tops, seams), so a
/// band is only ever a window onto it, never a row of a list.
struct ScrollTile {
  key: string
  /// Where the band starts in the book's flow coordinates.
  y: float
  /// And where it sits in the Scroll (the page's top room included).
  top: float
  height: float
  path: string
}

/// A rectangle drawn over the page: a kept note's highlight, or the live
/// selection being dragged. Page points, from the engine's selection.
struct PageMark {
  key: string
  x: float
  y: float
  w: float
  h: float
}

/// One scroll band's file name: a slice of the flow, which may cross a chapter.
fn slicePath(book: string, y: float, height: float, width: float, viewHeight: float, insetLeft: float, insetRight: float, scale: float, tag: string) -> string {
  return fs.join([
    pagesDir(),
    "{book}-scroll-{y.int()}-{height.int()}-{width.int()}-v{viewHeight.int()}-l{insetLeft.int()}r{insetRight.int()}-{(scale * 10).int()}-{tag}.eqp",
  ])
}

component Reader(book: lib.Book) {
  use library: Library
  use allSources: sources.Sources?

  /// The reader is done: the app takes its layer away.
  event close
  /// The first page is on screen (or the book says why it has none): the app
  /// shows the layer then, so its open animation ends on a page.
  event ready

  state engineId: engine.Engine? = none
  state spine = 0
  state page = 0
  state pages = 1
  state pagePath = ""
  /// A chapter picture being looked at: an image file, and its own pixels.
  state imagePath = ""
  state imageW = 0
  state imageH = 0
  state frame = Frame()
  state error = ""
  state warning = ""
  state fontName = ""
  state opened = false
  /// 出错后的「重试」：重开一次书（reopenTick 让排版 task 再跑一遍），
  /// 或者重试换那个没打开的窗口。
  state reopenTick = 0
  state retryWindow = -1
  /// 在线书：本机的这一批章节从全书的第几章起，全书一共几章。本地书就是
  /// 整本，windowBase 永远是 0。
  state windowBase = 0
  state windowTotal = 0
  /// 这一窗里哪些章的正文已经在引擎里（全书章号）：换窗时清掉。取失败的
  /// 章不在这里，下次翻到还会再试；不把“试过”提前记下来，否则一次取消
  /// 就把它永久卡在占位上。
  state loadedChapters: [int] = []
  /// 引擎里这些章的正文换过几次：每换一次，页和带子都该重画。
  state chapterRev = 0
  /// 在线书的目录（全书下标）；空的时候用引擎自己的目录。
  state windowToc: [engine.TocItem] = []
  /// 翻出窗口时要去的那一章；-1 是没有请求。它不能做 task 的 key：task
  /// 一开始就把它清掉会取消自己（下一个 await 处就断），换窗口永远不发生。
  state windowTarget = -1
  /// 每请求一次换窗口 +1，task 只跟着它跑。
  state windowTick = 0
  /// 这次换窗口是往回翻（落在上一章最后一页）。
  state windowEnd = false
  /// 换窗口后要落到的章内位置（书签、笔记）。
  state windowPercent = -1.0
  state switching = false
  let online = !book.sourceId.isEmpty()
  /// 窗口式阅读：正文一章一章地交给引擎 —— 在线书从书源取，大 TXT 从文件
  /// 里读。两者的章节表都是全书的一段，章号按全书算；小书仍旧整本打开。
  state windowed = !book.sourceId.isEmpty()
  /// 大 TXT 的目录：每章从文件第几字节起、多长。换窗时按它推章节表。
  state localChapters: [localbook.ChapterAt] = []
  /// 本地书那条文件路径（大 TXT 按章读它）。
  state bookFilePath = ""
  /// 在线书这一窗的目录：占位和补正文都要它，换窗时读一次。
  state windowMeta: remote.Meta? = none
  /// `ready` is said once, however many pages follow it.
  state announced = false
  state shownTitle = book.title
  /// The page count and the title bar on top of the page: hidden while
  /// reading, a tap on the middle of the page brings them back.
  state chrome = true

  /// Scroll mode: the whole book as one real Scroll. The engine owns the
  /// column — chapter tops, heights, and a band renderer that may cross a
  /// chapter — so `scrollHeight` is its total flow height, and the reader
  /// only asks for the bands that are on screen.
  state scrollHeight = 0.0
  state scrollTile = 0.0
  state columnReady = false
  /// The tile bucket the reader is in. It is the only thing a scroll event
  /// changes about what the tree shows, so it is the state; the position
  /// itself is `scrollAt`, written every frame without a rebuild.
  state windowBucket = 0
  /// The column as it was last laid out: the type, the margins and the view's
  /// size — never the paper. A new paper is another picture of the same
  /// column, so it must not lay the column out again.
  state lastColumn = ""
  state tiles: [ScrollTile] = []
  /// The Scroll's content starts after this much room, and ends before as
  /// much: the page's own top and bottom margins.
  state scrollTopPad = 0.0
  /// An actual scroll position to go to once the Scroll is laid out: a jump,
  /// a bookmark, the saved place, or a type change. `scrollTick` makes the
  /// task run even when two places are the same.
  state scrollTarget = -1.0
  state scrollTick = 0
  /// A place to put at the top once the column is ready: a chapter and how
  /// far into it. Opening, a page-to-scroll switch, and a jump before the
  /// column exists all use this; a type change keeps the current place.
  state startChapter = -1
  state startWithin = 0.0
  /// The place the reader asked for, in the column's own terms. A chapter's
  /// top is an estimate until the bands around it have been laid out, so a
  /// jump is made again once they have (see `settleAnchor`): the place doesn't
  /// move, the page comes to it.
  state anchorChapter = -1
  state anchorWithin = 0.0
  /// A page-mode place to turn into a page once the chapter is laid out.
  state pendingPageFraction = -1.0
  /// A kept place (a bookmark's, a note's, the saved reading position), as the
  /// engine's stable address: applied once its chapter is laid out.
  state pendingLocator = ""
  /// A link's anchor, applied once its chapter is laid out: a footnote's
  /// fragment is a line in the chapter the page is about to show.
  state pendingFragment = ""
  state lastMode = ""
  /// The type the last page layout was made with: a slider moves it many
  /// times a second, and only the place the hand stops is worth a page.
  state lastTag = ""
  /// Where the reader is: how far into `hereChapter` (0…1). Not a page
  /// number, since the type's size is the reader's.
  state herePercent = 0.0
  /// The chapter that place is in. In scroll mode the chapter of the top line
  /// changes as the reader scrolls; `spine` is the page mode's chapter and
  /// stays put.
  state hereChapter = 0
  /// The capsule's number, written only when the integer percent changes:
  /// the view must not read the scroll offset itself.
  state shownPercent = 0
  /// Restarts the save task; the place is written after the scroll settles.
  state placeTick = 0

  /// 选区：长按选中一个词，按住拖到哪儿，远的那一端就跟到哪儿。两个端点
  /// 是规范化之前的（锚点不动，焦点跟手指），保存时用引擎给的顺序。
  state selOn = false
  state selAnchorLine = 0
  state selAnchorByte = 0
  state selFocusLine = 0
  state selFocusByte = 0
  /// 规范化后的起点和终点：存下的笔记按它记，不按手指的方向。
  state selStartLine = 0
  state selStartByte = 0
  state selEndLine = 0
  state selEndByte = 0
  state selText = ""
  /// 选区在当前页上的矩形，和这一页已有的高亮。
  state selRects: [PageMark] = []
  state marks: [PageMark] = []
  /// 搜索面板选中的命中：两端是引擎的稳定位置。跳到那一行之后在页上标出来，
  /// 翻页、换章、点开别的地方就清掉。
  state findStart = ""
  state findEnd = ""
  state findRects: [PageMark] = []
  /// 书内搜索留下的那批命中（引擎里这一窗的章号）、现在第几条、搜的词，
  /// 以及跑搜索时窗口从哪里开始。有它们，翻上一条/下一条不用重新搜。
  state findHits: [engine.FindHit] = []
  state findAt = -1
  state findQuery = ""
  state findBase = 0

  /// 阅读时长：打开（或重新开始活动）的时刻、最后一次活动的时刻、已经记到
  /// 哪一刻。空闲超过五分钟就不再算，书页开着过夜不会记成读了一夜。
  state sessionAt = 0
  state activeAt = 0
  state countedTo = 0

  let palette = lib.paletteFor(library.theme)
  let barStyle = if library.theme == "night" { screen.BarStyle.light } else { screen.BarStyle.dark }
  let env = environment()
  let scale = if env.scale > 0 { env.scale } else { 2.0 }
  let pageMargins = marginsOf(frame.width, frame.height, library.margins, env)
  let saved = library.readingOf(book.id)
  let tocItems = if windowed { windowToc } else { engine.contents(engineId) }
  let scrollList = Ref()

  let heading = if shownTitle.isEmpty() { book.title } else { shownTitle }
  /// 选区动作条的位置：在选区上方，顶上放不下就放到下方。
  let selTop = selRects.first()?.y ?? 0.0
  let selBottom = (selRects.last()?.y ?? 0.0) + (selRects.last()?.h ?? 0.0)
  let barTop = if selTop > env.safeTop + 70 {
    selTop - 52
  } else if selBottom + 56 < frame.height - env.safeBottom {
    selBottom + 10
  } else {
    selTop - 52
  }
  let selectionFill = if library.theme == "night" { #6ea8fe55 } else { #0a84ff33 }
  let noteFill = if library.theme == "night" { #f5b94244 } else { #f5c54266 }
  /// 搜索命中的颜色：和笔记的黄、选区的蓝都分开，一眼看出是刚跳到的那一处。
  let findFill = if library.theme == "night" { #6ea8fe55 } else { #0a84ff33 }
  /// The bookmark at the place the reader is, if there is one: the button
  /// fills, and pressing it again takes it back. These change once a screen,
  /// not once a scroll event.
  let marked = library.bookmarkAt(book.id, chapter: hereChapter, percent: herePercent)
  // 目录里的章号是全书（windowToc）的；窗口书架起来的书（在线书、大 TXT）
  // 里 `spine` 只是这一窗的章号，要加回 windowBase 才是全书章号。
  let currentChapter = if library.mode == "scroll" { hereChapter } else { windowBase + spine }

  // Opens where the book was left, in the chapter (spine) it was left in.
  // 在线书的 spine 要等窗口拼好才知道（openBook 里），这里只定本地书。
  task {
    if !windowed {
      spine = if saved.chapter > 0 { saved.chapter } else { 0 }
    }
  }

  // 翻出窗口：拼下一个窗口，重开引擎，落在要读的那一章。
  task("{windowTick}") {
    if windowTarget < 0 { return }
    await switchWindow(windowTarget)
  }

  // The buttons and the status bar are one layer: the page owns the whole
  // screen while it reads, and gives the bars back as it goes.
  effect { screen.setBars(style: barStyle, hideStatus: !chrome, hideNavigation: false) }

  // The engine holds the book's bytes: let it go as the reading page does.
  cleanup {
    screen.setBars(style: .auto, hideStatus: false, hideNavigation: false)
    if library.mode == "scroll" { savePlace() }
    flushSession()
    // The handle is a value: letting go of it closes the book.
    engineId = none
  }

  /// 读了一页、翻了一页、滚动了一下：这一段还算在读。
  fn touch() {
    if sessionAt == 0 { return }
    let now = time.now().unix()
    if now - activeAt > 300 {
      flushSession()
      // 中间的停顿不是阅读：从这一刻重新开始算。
      if now > countedTo { countedTo = now }
    } else if now - countedTo >= 60 {
      // 一分钟左右落一次盘，靠翻页或滚动顺手写，不另开计时器。
      flushSession()
    }
    activeAt = now
  }

  /// 把从上次记下到现在的阅读时间写进 store。空闲超过五分钟只算到
  /// 最后一次活动后五分钟；关页和每分钟各写一次。
  fn flushSession() {
    if !engine.isOpen(engineId) || sessionAt == 0 { return }
    let now = time.now().unix()
    var until = now
    if now - activeAt > 300 { until = activeAt + 300 }
    if until > now { until = now }
    if until <= countedTo { return }
    let seconds = until - countedTo
    countedTo = until
    library.recordReading(book.id, seconds: seconds)
  }

  /// Actually lays the chapter out and rasterizes the page.
  fn show() {
    if !engine.isOpen(engineId) || frame.width <= 32 || frame.height <= 64 { return }
    // A new page, size or type: a selection belongs to the layout it was made
    // in, so it goes before this one is drawn.
    clearSelection()
    let chapterCount = engine.chapterCount(engineId)
    if spine >= chapterCount { spine = if chapterCount > 0 { chapterCount - 1 } else { 0 } }
    if library.mode != lastMode { switchMode() }
    if library.mode == "scroll" {
      showScroll()
      return
    }
    let pagesNow = engine.layout(
      engineId, spine, frame.width, frame.height,
      pageMargins,
      library.size / baseSize, library.line, library.letter * library.size, library.word * library.size,
      align: library.align, rules: library.textRules(), profile: library.profile,
    )
    if pagesNow <= 0 { return }
    pages = pagesNow
    // A link with a fragment (a footnote's `#note-3`) names a line in this
    // chapter, which is a page once the chapter is laid out.
    if !pendingFragment.isEmpty() {
      let line = engine.fragmentLine(engineId, pendingFragment)
      if line >= 0 { pendingPageFraction = engine.progress(engineId, line) }
      pendingFragment = ""
    }
    if pendingPageFraction >= 0 {
      page = int(pendingPageFraction * float(pagesNow))
      if page >= pagesNow { page = pagesNow - 1 }
      pendingPageFraction = -1.0
    } else {
      page = lib.resolve(page, pages)
    }
    // A kept place is a paragraph, not a page: the page it falls on here is
    // this type size's answer, and that is the whole point of keeping it so.
    if !pendingLocator.isEmpty() {
      let where = engine.locate(engineId, pendingLocator)
      pendingLocator = ""
      if where.page >= 0 && int(where.page) < pagesNow { page = int(where.page) }
    }
    let path = fs.join([pagesDir(), "{book.id}-{spine}-{page}-{frame.width.int()}x{frame.height.int()}-{fileTag()}.eqp"])
    let ok = engine.renderPage(engineId, page, scale, lib.rgbaOf(palette.ink), lib.rgbaOf(palette.paper), false, path)
    if ok {
      pagePath = path
      let info = engine.pageInfo(engineId, page)
      hereChapter = windowBase + spine
      herePercent = info.progress
      library.save(book.id, windowBase + spine, info.progress, locator: placeLocator())
      announceReady()
      refreshMarks()
      refreshFind()
    }
  }

  /// The reader's place as the engine names it: a paragraph and a byte in it,
  /// which a page height or a type size can't move. "" for an online book —
  /// its spines are a window's, not the book's — and before anything is laid
  /// out.
  fn placeLocator() -> string {
    if !engine.isOpen(engineId) || windowed { return "" }
    if library.mode == "scroll" {
      if !columnReady || scrollHeight <= 0 { return "" }
      let where = engine.flowHit(engineId, pageMargins.left + 2, contentY())
      if where.spine < 0 { return "" }
      let range = engine.locatorRange(engineId, where.line, where.byte, where.line, where.byte)
      return range.split("|").first() ?? ""
    }
    if pages <= 0 { return "" }
    return engine.locatorAt(engineId, page, pageMargins.left + 2, pageMargins.top + 2)
  }

  /// The chapter whose pictures the contents sheet lists: the one laid out in
  /// page mode, the one under the reader in the column.
  fn imageChapterNow() -> int {
    if library.mode == "scroll" && columnReady {
      let chapter = engine.flowSpineAt(engineId, contentY())
      if chapter >= 0 { return chapter }
    }
    return spine
  }

  /// This chapter's pictures (the engine names them, originals included).
  fn chapterImagesNow() -> [engine.ImageInfo] {
    if !engine.isOpen(engineId) { return [] }
    let chapter = imageChapterNow()
    if library.mode == "scroll" {
      // Asking for the chapter measures it, so `images()` answers for it.
      let ch = engine.flowChapter(engineId, chapter)
      if !ch.ok { return [] }
    } else if engine.lastChapter(engineId) != chapter {
      return []
    }
    return engine.images(engineId)
  }

  /// One picture of the chapter, at its original resolution.
  fn showImage(imageId: int) {
    let images = chapterImagesNow()
    if let image = imageOf(images, id: imageId) {
      showPicture(image)
    }
  }

  fn showPicture(image: engine.ImageInfo) {
    let chapter = imageChapterNow()
    let path = fs.join([pagesDir(), "img-{book.id}-{chapter}-{image.id}-{fileTag()}.eqp"])
    if !fs.exists(path) {
      try? fs.mkdirAll(pagesDir())
      if !engine.writeImage(engineId, imageId: image.id, path: path) {
        snackbar("这张图打不开")
        return
      }
    }
    imageW = image.width
    imageH = image.height
    imagePath = path
  }

  /// A kept place in the column: the line it names, in the book's flow. -1 when
  /// the place isn't in that chapter.
  fn locatorY(chapter: int, locator: string) -> float {
    if !engine.isOpen(engineId) || locator.isEmpty() { return -1 }
    let ch = engine.flowChapter(engineId, chapter)
    if !ch.ok { return -1 }
    let where = engine.locate(engineId, locator)
    if where.page < 0 { return -1 }
    return engine.flowLineY(engineId, chapter, where.line)
  }

  /// The first page is on screen (or the book has none to put there): said
  /// once, so the app can end its open animation on the page rather than on
  /// paper that fills in after it.
  fn announceReady() {
    if announced { return }
    announced = true
    emit ready
  }

  /// The first layout of a new mode: a page's place becomes a chapter's, or
  /// the other way around. The first layout after opening keeps the place
  /// openBook took from the saved reading position.
  fn switchMode() {
    clearSelection()
    if lastMode.isEmpty() {
      columnReady = false
    } else if library.mode == "scroll" {
      let within = if pages > 1 { float(page) / float(pages) } else { 0.0 }
      startChapter = spine
      startWithin = within
      // The place is a page's; showScroll must not replace it with the old
      // column's. There is no old column yet.
      scrollHeight = 0
      columnReady = false
      scrollAt = 0.0
      windowBucket = 0
      tiles = []
    } else {
      let count = engine.chapterCount(engineId)
      var target = hereChapter - windowBase
      if target < 0 { target = 0 }
      if count > 0 && target >= count { target = count - 1 }
      if target != spine { spine = target }
      pendingPageFraction = herePercent
    }
    lastMode = library.mode
  }

  /// The top line at the top of what shows, in content coordinates.
  fn contentY() -> float {
    var y = scrollAt - scrollTopPad
    if y < 0 { y = 0 }
    if y > scrollHeight { y = scrollHeight }
    return y
  }

  /// How far into its chapter the top line is (0…1). The chapter and its top
  /// are the engine's: the reader keeps no chapter table of its own.
  fn scrollWithin() -> float {
    let y = contentY()
    let index = engine.flowSpineAt(engineId, y)
    if index < 0 { return 0 }
    let chapter = engine.flowChapter(engineId, index)
    if !chapter.ok || chapter.height <= 0 { return 0 }
    var local = y - chapter.top
    if local < 0 { local = 0 }
    if local > chapter.height { local = chapter.height }
    return local / chapter.height
  }

  fn windowBucketOf(y: float) -> int {
    if scrollTile <= 0 { return 0 }
    var content = y - scrollTopPad
    if content < 0 { content = 0 }
    return (content / scrollTile).int()
  }

  /// Opens the column: one call hands the engine the viewport and the type, and
  /// it keeps the chapter tops from then on. Heights are measured lazily — the
  /// total starts as an estimate and becomes the truth a chapter at a time —
  /// and a chapter that fails to lay out is height 0 without stopping the ones
  /// after it.
  fn showScroll() {
    // Where the reader is, in the old column's terms: a chapter and how far
    // into it. A fraction of the whole book wouldn't survive the new heights,
    // which is exactly what a type change brings.
    let keepingPlace = columnReady && scrollHeight > 0
    var keptChapter = -1
    var keptWithin = 0.0
    if keepingPlace {
      let index = engine.flowSpineAt(engineId, contentY())
      if index >= 0 {
        keptChapter = index
        keptWithin = scrollWithin()
      }
    }
    columnReady = false
    let targetChapter = startChapter
    let targetWithin = startWithin
    let tile = scrollTileHeight()
    let fontScale = library.size / baseSize
    let margins = engine.Margins(top: 0, right: pageMargins.right, bottom: 0, left: pageMargins.left)
    let count = engine.beginScroll(
      engineId, frame.width, frame.height, margins,
      fontScale, library.line, library.letter * library.size, library.word * library.size,
      align: library.align, rules: library.textRules(), profile: library.profile,
    )
    scrollTile = tile
    scrollTopPad = pageMargins.top
    // The heights measured the last time this book was read on this screen at
    // this type: the scrollbar starts where that reading left it, not on an
    // estimate. (An online book's chapters change under it, and the engine's
    // key says so: it would never match, so it isn't written.)
    if !windowed { let _restored = engine.readScrollIndex(engineId, scrollIndexPath()) }
    let total = engine.flowHeight(engineId)
    scrollHeight = if count > 0 && total > 0 { total } else { 0 }
    columnReady = true
    if count < 0 {
      // The engine refused the column (a book it can't lay out, a session it
      // dropped): say so instead of pretending the book is empty.
      error = "排版失败：{engine.lastError()}"
      lastColumn = ""
      announceReady()
      return
    }
    if scrollHeight <= 0 {
      tiles = []
      startChapter = -1
      startWithin = 0
      lastColumn = ""
      announceReady()
      return
    }
    startChapter = -1
    startWithin = 0
    // Laid out, at this type and this size: a paper change from here on is
    // a new picture, not a new column.
    lastColumn = columnKey()
    // A chapter's top is an estimate until the bands around it have been laid
    // out, so the place is kept as an anchor as well: the scroll goes to the
    // estimate now, and `settleAnchor` brings it to the measured top.
    if keepingPlace && keptChapter >= 0 {
      goToChapter(keptChapter, keptWithin)
    } else if targetChapter >= 0 {
      // A kept place names a paragraph: take it when that chapter still holds
      // it, and the fraction when it doesn't (a place from before there were
      // locators, or from another book).
      let y = locatorY(targetChapter, pendingLocator)
      if y >= 0 {
        let ch = engine.flowChapter(engineId, targetChapter)
        var within = targetWithin
        if ch.height > 0 { within = (y - ch.top) / ch.height }
        pendingLocator = ""
        goToChapter(targetChapter, within)
      } else {
        pendingLocator = ""
        goToChapter(targetChapter, targetWithin)
      }
    } else {
      goToScrollY(scrollTopPad)
    }
  }

  /// The heights measured for this book at this screen and this type. One file
  /// a book: the engine checks the key inside it, so a file for another size or
  /// another screen is simply not applied.
  fn scrollIndexPath() -> string = fs.join([pagesDir(), "{book.id}.idx"])

  /// Keeps them for the next open. Called where the place is saved (a scroll
  /// that has settled) and when the page goes away.
  fn keepColumnIndex() {
    if windowed || !engine.isOpen(engineId) || !columnReady || scrollHeight <= 0 { return }
    try? fs.mkdirAll(pagesDir())
    let _kept = engine.writeScrollIndex(engineId, scrollIndexPath())
  }

  /// Puts the Scroll at a flow y and makes the window there at once. The Scroll
  /// itself is moved by `scrollTick`'s task: state changes can't wait for a
  /// layout, and a jump must not tear the Scroll down and build it again.
  fn scrollTo(y: float) {
    var target = y
    let min = scrollTopPad
    let max = scrollTopPad + scrollHeight
    if target < min { target = min }
    if target > max { target = max }
    scrollAt = target
    windowBucket = windowBucketOf(target)
    shownPercent = percentAt(target)
    scrollTarget = target
    scrollTick += 1
    rememberScroll()
  }

  /// A flow y the reader asked for outright: nothing to come back to.
  fn goToScrollY(y: float) {
    anchorChapter = -1
    scrollTo(y)
  }

  /// Puts the Scroll at a place in a chapter — a table of contents row, a
  /// bookmark, the saved reading position — and remembers it as the anchor.
  /// The chapter's top is an estimate until its neighbours have been laid out,
  /// and the reader means the chapter, not the estimate.
  fn goToChapter(chapter: int, within: float) {
    if !engine.isOpen(engineId) { return }
    let ch = engine.flowChapter(engineId, chapter)
    if !ch.ok || ch.height <= 0 { return }
    var at = within
    if at < 0 { at = 0 }
    if at > 1 { at = 1 }
    anchorChapter = chapter
    anchorWithin = at
    scrollTo(scrollTopPad + ch.top + at * ch.height)
  }

  /// After the bands around the anchor have been laid out, its chapter's top is
  /// measured: put the reader on it. Before this, a jump to a chapter landed
  /// wherever the estimate of the chapters before it was wrong by.
  fn settleAnchor() {
    if anchorChapter < 0 || !engine.isOpen(engineId) { return }
    let chapter = anchorChapter
    let within = anchorWithin
    anchorChapter = -1
    let ch = engine.flowChapter(engineId, chapter)
    if !ch.ok || ch.height <= 0 { return }
    scrollTo(scrollTopPad + ch.top + within * ch.height)
  }

  /// The flow's height as the engine measures it now. Chapters are measured as
  /// the reader reaches them, so the total grows into the truth; the Scroll's
  /// content size has to follow it, or the end of the book sits at the wrong y.
  fn refreshColumn() {
    if !engine.isOpen(engineId) || !columnReady { return }
    let total = engine.flowHeight(engineId)
    if total <= 0 || (total - scrollHeight).abs() < 1 { return }
    scrollHeight = total
  }

  /// A band is smaller than the viewport: one screen per bitmap makes every
  /// band boundary a large image upload. 512 DIP keeps each one small, and a
  /// few of them fit around the visible screen — and a band is only a few
  /// milliseconds to draw, so a window fills in quickly.
  fn scrollTileHeight() -> float {
    if frame.width <= 0 { return 400 }
    let cap = 8_000_000.0 / (frame.width * scale * scale)
    let height = if frame.height < 512 { frame.height } else { 512.0 }
    let capped = if height < cap { height } else { cap }
    return if capped < 256 { 256.0 } else { capped }
  }

  /// The windows the column needs around the one showing: one tile of
  /// overscan either side, so a small scroll doesn't ask for new bitmaps.
  /// Bands sit on flow boundaries, not chapter ones: the engine stitches a band
  /// that crosses a chapter, so a seam is never a blank line or a new bitmap.
  fn windowTiles(offset: float) -> [ScrollTile] {
    var out: [ScrollTile] = []
    var content = offset - scrollTopPad
    if content < 0 { content = 0 }
    if content > scrollHeight { content = scrollHeight }
    for band in lib.bands(content, frame.height, scrollTile, scrollHeight, scrollTile * 2) {
      out.push(ScrollTile(
        key: band.key(), y: band.y, top: scrollTopPad + band.y,
        height: band.height, path: "",
      ))
    }
    return out
  }

  /// The reader's place in the column, as the engine's chapter and how far into
  /// it. Saving waits for the scroll to settle: a fling crosses several bands,
  /// and a store write per band is disk work in the middle of the gesture.
  fn rememberScroll() {
    if scrollHeight <= 0 { return }
    let index = engine.flowSpineAt(engineId, contentY())
    if index >= 0 {
      hereChapter = windowBase + index
      herePercent = scrollWithin()
      placeTick += 1
    }
    // 在线书的窗口不长：滚到这一窗的底，还有下一章就去拼下一窗。
    let count = engine.chapterCount(engineId)
    if windowed && windowTarget < 0 && !switching && columnReady && windowBase + count < windowTotal {
      if contentY() + frame.height >= scrollHeight - 2 {
        windowEnd = false
        requestWindow(windowBase + count)
      }
    }
  }

  fn savePlace() {
    if scrollHeight <= 0 { return }
    let index = engine.flowSpineAt(engineId, contentY())
    if index >= 0 {
      library.save(book.id, windowBase + index, scrollWithin(), locator: placeLocator())
    }
    // The same settle that writes the place writes what the column cost to
    // measure: the next open starts on real heights, not estimates.
    keepColumnIndex()
  }

  /// Keeps a bookmark at the exact line at the top, not at a band boundary.
  fn toggleBookmark() {
    touch()
    var chapter = windowBase + spine
    if library.mode == "scroll" {
      let index = engine.flowSpineAt(engineId, contentY())
      chapter = windowBase + (if index >= 0 { index } else { hereChapter - windowBase })
    }
    let percent = if library.mode == "scroll" { scrollWithin() } else { herePercent }
    if library.toggleBookmark(book.id, chapter: chapter, percent: percent, locator: placeLocator()) {
      snackbar("已加书签")
    } else {
      snackbar("已删除书签")
    }
  }

  /// 长按落点：还没有选区时先选中那里的一个词；已经有选区时，抓住离
  /// 手指近的那一端，让这一端跟到手指下，另一端不动。
  fn beginSelection(x: float, y: float) {
    touch()
    if library.mode != "page" || !engine.isOpen(engineId) || pages <= 0 { return }
    let loc = engine.hit(engineId, page, x, y)
    if loc.page < 0 { return }
    let line = int(loc.line)
    if selOn {
      // 选区的起点和终点是规范化过的：抓起点就留终点，反之亦然。
      if nearStart(line, int(loc.byte)) {
        selAnchorLine = selEndLine
        selAnchorByte = selEndByte
      } else {
        selAnchorLine = selStartLine
        selAnchorByte = selStartByte
      }
      selFocusLine = line
      selFocusByte = int(loc.byte)
      chrome = false
      updateSelection()
      return
    }
    let word = lib.wordAt(engine.lineText(engineId, line), int(loc.byte))
    selAnchorLine = line
    selAnchorByte = word.start
    selFocusLine = line
    selFocusByte = word.end
    if word.end <= word.start { return }
    // 选字时把顶上的按钮收起来：它们会压在选区和动作条上。
    chrome = false
    updateSelection()
  }

  /// 落点离选区的起点更近吗（起点在文档里更靠前）。
  fn nearStart(line: int, byte: int) -> bool {
    if line < selStartLine { return true }
    if line > selEndLine { return false }
    if selStartLine == selEndLine {
      return (byte - selStartByte).abs() <= (byte - selEndByte).abs()
    }
    let toStart = line - selStartLine
    let toEnd = selEndLine - line
    if toStart != toEnd { return toStart < toEnd }
    return (byte - selStartByte).abs() <= (byte - selEndByte).abs()
  }

  /// 按住拖：远的那一端跟到手指下的字。
  fn extendSelection(x: float, y: float) {
    if !selOn || !engine.isOpen(engineId) { return }
    let loc = engine.hit(engineId, page, x, y)
    if loc.page < 0 { return }
    selFocusLine = int(loc.line)
    selFocusByte = int(loc.byte)
    updateSelection()
  }

  /// 两端的引擎选区 → 当前页上要画的矩形和要存的位置。
  fn updateSelection() {
    let sel = engine.selectLines(engineId, selAnchorLine, selAnchorByte, selFocusLine, selFocusByte)
    if sel == none {
      // 焦点还在锚点那个字里：这一帧没有可扩的区间。选区留着，等手指
      // 移出这个字再扩；把它当成「取消」会让一次微小的左右抖动清掉
      // 整个选区。取消只有「取消」按钮和点选区外面两种。
      return
    }
    let start = engine.selectionStart(sel)
    let end = engine.selectionEnd(sel)
    selStartLine = int(start.line)
    selStartByte = int(start.byte)
    selEndLine = int(end.line)
    selEndByte = int(end.byte)
    selText = engine.selectionText(sel)
    var rects: [PageMark] = []
    var i = 0
    for rect in engine.selectionRects(sel) {
      if rect.page != page { continue }
      rects.push(PageMark(key: "s.{i}", x: rect.x, y: rect.y, w: rect.w, h: rect.h))
      i += 1
    }
    selRects = rects
    selOn = !selText.isEmpty()
  }

  fn finishSelection() {
    if selOn && selText.trim().isEmpty() { clearSelection() }
  }

  fn clearSelection() {
    if !selOn && selText.isEmpty() && selRects.isEmpty() { return }
    selOn = false
    selText = ""
    selRects = []
  }

  /// 这一页上已有笔记的高亮。笔记存的是引擎的稳定地址（段 + 段内字节）
  /// —— 排版变了，地址还指着同一段原文，所以按地址重新选中再画；只有老
  /// 笔记（没有地址）才退回当时的行号。两种都用引文校一遍：对不上就不画，
  /// 宁可不画，也不把高亮画到别的字上。
  fn refreshMarks() {
    if !engine.isOpen(engineId) || library.mode != "page" || pages <= 0 {
      marks = []
      return
    }
    var next: [PageMark] = []
    for note in library.notesInChapter(book.id, chapter: windowBase + spine) {
      var aLine = note.startLine
      var aByte = note.startByte
      var bLine = note.endLine
      var bByte = note.endByte
      if !note.locator.isEmpty() {
        let start = engine.locate(engineId, note.locator)
        if start.page < 0 { continue }
        aLine = start.line
        aByte = start.byte
        if !note.endLocator.isEmpty() {
          let end = engine.locate(engineId, note.endLocator)
          if end.page >= 0 {
            bLine = end.line
            bByte = end.byte
          }
        }
      }
      let sel = engine.selectLines(engineId, aLine, aByte, bLine, bByte)
      if sel == none { continue }
      // 比的是字，不是断行：同一段原文换一个字号就断在别处，字没变。
      if lib.squash(engine.selectionText(sel)) != lib.squash(note.quote) { continue }
      var i = 0
      for rect in engine.selectionRects(sel) {
        if rect.page != page { continue }
        next.push(PageMark(key: "m.{note.id}.{i}", x: rect.x, y: rect.y, w: rect.w, h: rect.h))
        i += 1
      }
    }
    marks = next
  }

  /// 现在的选区存成一条笔记（`text` 为空时是一条高亮）。
  fn keepSelection(text: string) {
    if !selOn || !engine.isOpen(engineId) { return }
    let percent = engine.progress(engineId, selStartLine)
    // 两端也存成引擎的稳定地址：以后换字号、换屏幕，高亮还落在同一段原文上。
    var startLocator = ""
    var endLocator = ""
    if !windowed {
      let range = engine.locatorRange(engineId, selStartLine, selStartByte, selEndLine, selEndByte)
      let parts = range.split("|")
      startLocator = parts.first() ?? ""
      if parts.count() > 1 { endLocator = parts[1] }
    }
    let _kept = library.addNote(
      book.id, chapter: windowBase + spine,
      startLine: selStartLine, startByte: selStartByte,
      endLine: selEndLine, endByte: selEndByte,
      percent: percent, quote: lib.squash(selText), text: text,
      locator: startLocator, endLocator: endLocator,
    )
    clearSelection()
    refreshMarks()
  }

  /// 搜索命中在页上的那一块。两端都是稳定位置，换字号之后还标在同一段原文上。
  fn refreshFind() {
    findRects = []
    if findStart.isEmpty() || !engine.isOpen(engineId) || library.mode != "page" || pages <= 0 { return }
    let start = engine.locate(engineId, findStart)
    if start.page < 0 || int(start.page) != page { return }
    var stop = start
    if !findEnd.isEmpty() {
      let end = engine.locate(engineId, findEnd)
      if end.page >= 0 && int(end.page) == page { stop = end }
    }
    let sel = engine.selectLines(engineId, int(start.line), int(start.byte), int(stop.line), int(stop.byte))
    if sel == none { return }
    var rects: [PageMark] = []
    var i = 0
    for rect in engine.selectionRects(sel) {
      if int(rect.page) == page {
        rects.push(PageMark(key: "f.{i}", x: rect.x, y: rect.y, w: rect.w, h: rect.h))
      }
      i += 1
    }
    findRects = rects
  }

  /// 跳到搜索列表里的第 `at` 条：把它的引擎章号换回这一窗的，再把两端的
  /// 稳定位置交给页面去标。整窗换过以后位置对不上，就只回到那一章的开头。
  fn showFind(at: int) {
    if at < 0 || at >= findHits.count() { return }
    findAt = at
    let hit = findHits[at]
    let chapter = findBase + hit.spine
    let local = chapter - windowBase
    let count = engine.chapterCount(engineId)
    if local < 0 || local >= count {
      goTo(chapter, 0)
      return
    }
    let start = "{local}:{hit.node}:{hit.offset}"
    let stop = "{local}:{hit.node}:{hit.end}"
    goTo(chapter, 0, locator: start)
    findStart = start
    findEnd = stop
    findRects = []
    // 同一章的页模式下 goTo 已经排好版了；换章时，下一次排版（show）
    // 会把命中画上去。
    if library.mode == "page" && engine.lastChapter(engineId) == local {
      refreshFind()
    }
  }

  fn findNext() {
    if findAt + 1 < findHits.count() { showFind(at: findAt + 1) }
  }

  fn findPrev() {
    if findAt > 0 { showFind(at: findAt - 1) }
  }

  fn clearFindHits() {
    findHits = []
    findAt = -1
    findQuery = ""
    clearFind()
  }

  /// 书内搜索的入口：也用它重新打开结果列表，带着上一轮的词。
  fn openFind() {
    present(Find(id: engineId, windowed: windowed, base: windowBase, loaded: loadedChapters, initial: findQuery) {
      on go(hits, at, query) {
        findHits = hits
        findBase = windowBase
        findQuery = query
        showFind(at: at)
      }
    })
  }

  /// 读者去了别处：搜索命中的标记不再属于这一页。
  fn clearFind() {
    if findStart.isEmpty() && findEnd.isEmpty() && findRects.isEmpty() { return }
    findStart = ""
    findEnd = ""
    findRects = []
  }

  /// 这一页上要画的矩形：已有笔记和搜索命中的高亮在下，手上的选区在上。
  /// 它交给 BookPage 自己的图层去画，而不是一个盖在页面上的 Canvas——iOS
  /// 上那样的画布会把页面的触摸全拦下来。
  fn pageHighlights() -> [bookpage.Highlight] {
    var out: [bookpage.Highlight] = []
    for mark in marks {
      out.push(bookpage.Highlight(x: mark.x, y: mark.y, w: mark.w, h: mark.h, color: noteFill))
    }
    for mark in findRects {
      out.push(bookpage.Highlight(x: mark.x, y: mark.y, w: mark.w, h: mark.h, color: findFill))
    }
    for mark in selRects {
      out.push(bookpage.Highlight(x: mark.x, y: mark.y, w: mark.w, h: mark.h, color: selectionFill))
    }
    return out
  }

  /// 这个点落在选区里吗：拖完手指常落在自己刚选的那几行上，那一下
  /// 不该被当成「取消」。每边留一点余量，和高亮的边对齐。
  fn pointInSelection(x: float, y: float) -> bool {
    for mark in selRects {
      if x >= mark.x - 6 && x <= mark.x + mark.w + 6 && y >= mark.y - 6 && y <= mark.y + mark.h + 6 {
        return true
      }
    }
    return false
  }

  fn percentAt(y: float) -> int {
    if scrollHeight <= 0 { return 0 }
    var content = y - scrollTopPad
    if content < 0 { content = 0 }
    if content > scrollHeight { content = scrollHeight }
    let p = engine.flowProgress(engineId, content)
    if p <= 0 { return 0 }
    if p >= 1 { return 100 }
    return (p * 100).int()
  }

  // The bands around the reader. One band is a few milliseconds now that the
  // engine paints only what's in it, so a window is filled band by band: what
  // is already on disk shows before anything new is drawn, and each new band
  // shows as soon as it lands, nearest the reader first. A fling then fills in
  // behind the finger instead of blanking the page until the whole window is
  // ready.
  task("{windowBucket}:{columnReady}:{scrollHeight.int()}:{scrollTile.int()}:{frame.width.int()}:{frame.height.int()}:{fileTag()}") {
    if library.mode != "scroll" || !columnReady || scrollHeight <= 0 { return }

    // Now and then, while the reader moves: one session writes a band every
    // 512 DIP it travels, and waiting for the next open to sweep them would
    // let a long read grow with no bound.
    if windowBucket % 64 == 0 {
      await spawn { prunePages(pagesBudget) }
    }

    let id = engineId
    let bookId = book.id
    let viewHeight = frame.height
    let right = pageMargins.right
    let left = pageMargins.left
    let scaleNow = scale
    let ink = lib.rgbaOf(palette.ink)
    let paper = lib.rgbaOf(palette.paper)
    let tag = fileTag()

    fn fileOf(tile: ScrollTile) -> string {
      return slicePath(
        book: bookId, y: tile.y, height: tile.height,
        width: frame.width, viewHeight: viewHeight,
        insetLeft: left, insetRight: right,
        scale: scaleNow, tag: tag,
      )
    }

    // What the column already has — the last window's bands, or an earlier
    // pass over this part of the book — is shown at once, before any drawing.
    // A band's file name carries everything that went into it: the type, the
    // margins, and the paper. So a band is only the same picture at the very
    // same name; a band kept under another paper would show the old paper on
    // the new screen until the reader scrolled it off.
    let old = tiles
    var next: [ScrollTile] = []
    for tile in windowTiles(scrollAt) {
      let file = fileOf(tile)
      var path = ""
      if old.any(seen => seen.path == file) {
        // The last window's band, unchanged: no stat needed.
        path = file
      } else if fs.exists(file) {
        // An earlier pass over this part of the book, under this same paper.
        path = file
      }
      next.push(ScrollTile(key: tile.key, y: tile.y, top: tile.top, height: tile.height, path: path))
    }
    // Nothing new on screen: don't hand the view tree the same list again.
    var changed = next.count() != old.count()
    if !changed {
      for i in 0..<next.count() {
        if next[i].key != old[i].key || next[i].path != old[i].path {
          changed = true
          break
        }
      }
    }
    if changed { tiles = next }
    if next.any(t => !t.path.isEmpty()) { announceReady() }

    // Nearest the reader first: the visible screen, then the room around it.
    let content = contentY()
    var order: [int] = []
    for i in 0..<next.count() { order.push(i) }
    order = order.sorted(key: i => (next[i].y - content).abs())

    for i in order {
      if !next[i].path.isEmpty() { continue }
      let tile = next[i]
      let file = fileOf(tile)
      // A band is laid out and rasterized off the main thread: a screenful
      // takes long enough to show as a hitch while the finger is scrolling.
      let _drawn = await engine.renderBand(
        id: id, y: tile.y, height: tile.height, scale: scaleNow,
        ink: ink, paper: paper, bold: false, path: file,
      )
      // The paper can change while a band is being drawn. That band belongs
      // to the screen the reader has already left: the task that follows the
      // new paper draws it again, so this pass must not put it back.
      if tag != fileTag() { return }
      if fs.exists(file) {
        next[i] = ScrollTile(key: tile.key, y: tile.y, top: tile.top, height: tile.height, path: file)
        tiles = next
        announceReady()
      }
    }

    // Laying these bands out measured the chapters they touch: the column's
    // height is more true than it was, and the place the reader asked for now
    // has a measured top to land on. Both follow from the same pass, in this
    // order — the new total first, then the place inside it.
    refreshColumn()
    settleAnchor()
  }

  // A fling crosses tiles. Save once it has been quiet for a moment; the
  // tick restarts this task on every tile, so only the last one writes.
  task("{placeTick}:{columnReady}:{scrollHeight.int()}") {
    if library.mode != "scroll" || !columnReady || placeTick == 0 { return }
    await sleep(250ms)
    savePlace()
  }

  // 在线书：读到哪一章取哪一章，顺手取后面两章。整本不下载；一窗取完才换窗。
  // 这个 task 不跟 `chapterRev`：取到正文会写它，跟了就等于每次成功都
  // 把自己重启、在 `await` 处取消掉，后面的 loadedChapters 来不及记。
  task("{spine}:{hereChapter}:{windowTick}:{columnReady}") {
    if !windowed || !engine.isOpen(engineId) { return }
    let at = if library.mode == "scroll" { hereChapter } else { windowBase + spine }
    await ensureChapter(at)
    await ensureChapter(at + 1)
    await ensureChapter(at + 2)
  }

  // The Scroll is moved here, after it has its new content height: a jump is
  // one scrollTo, never a teardown and a rebuild.
  task("{scrollTick}:{columnReady}:{frame.width.int()}:{frame.height.int()}") {
    if library.mode != "scroll" || !columnReady || scrollTarget < 0 { return }
    let target = scrollTarget
    await sleep(30ms)
    scrollList.scrollTo(0, target, animated: false)
    await sleep(16ms)
    if scrollTarget == target { scrollTarget = -1.0 }
  }

  /// How this page was laid out, in its file name: a page is a different
  /// file as soon as the type changes, so the native view shows the new one
  /// instead of the one it already has at the same path. The paper is in
  /// `fileTag` on top of this: it changes the picture, never the layout.
  fn layoutTag() -> string {
    let size = (library.size * 10).int()
    let line = (library.line * 10).int()
    let margin = (library.margins * 100).int()
    let letter = (library.letter * 1000).int()
    let word = (library.word * 1000).int()
    // 文本政策和版式档案也在这串里：换一项就是另一批页，旧图不能再用。
    let rules = library.textRules()
    let align = library.align
    let profile = library.profile
    return "s{size}-l{line}-m{margin}-k{letter}-w{word}-a{align}-r{rules}-p{profile}"
  }

  /// The paper a page was drawn on, as its file name says it: the same lines on
  /// another paper are another file, and must be. An online book adds the
  /// version of the text in the engine: when a chapter's body arrives, the pages
  /// drawn from the placeholder are not the pages of the chapter.
  fn fileTag() -> string {
    let rev = if windowed { "-r{chapterRev}" } else { "" }
    let win = if windowBase > 0 { "-w{windowBase}" } else { "" }
    return "{layoutTag()}{rev}{win}-{library.theme}"
  }

  /// The column a layout produced: what a new layout would give the same
  /// answer to. The paper is not in it — it neither moves a line nor changes
  /// a chapter's height. An online book's text changes under the column, so
  /// the version is.
  fn columnKey() -> string {
    let rev = if windowed { ":r{chapterRev}" } else { "" }
    return "{layoutTag()}:{frame.width.int()}x{frame.height.int()}{rev}"
  }

  /// 在线书：引擎里是一本「流式书」——目录先按章占好位置（标题已经有了，
  /// 正文还没取），读到哪一章才取哪一章的正文，替换进它自己的位置。整本不
  /// 下载；换窗也不重开引擎，字体还在，不会又加载一次。
  async fn openOnline() throws {
    let found = allSources?.definitionOf(book.sourceId)
    if found == none { throw Error("这本书的书源不在列表里了，先导入书源") }
    var meta = remote.readMeta(book.id)
    if meta == none {
      meta = try await remote.fetchMeta(found!, sources.Book(name: book.title, author: book.author, bookUrl: book.bookUrl))
      if let m = meta { remote.writeMeta(book.id, m) }
    }
    if meta == none { throw Error("这本书的目录没有读到") }
    windowMeta = meta
    windowTotal = meta!.toc.count()
    var whole: [engine.TocItem] = []
    for (i, entry) in meta!.toc.enumerated() {
      whole.push(engine.TocItem(title: entry.title, spine: i, depth: 0))
    }
    windowToc = whole
    var target = saved.chapter
    if target < 0 { target = 0 }
    if windowTotal > 0 && target >= windowTotal { target = windowTotal - 1 }
    try await buildWindow(base: windowBaseFor(target), target: target)
    spine = target - windowBase
    if spine < 0 { spine = 0 }
  }

  /// 正文还没到的章在引擎里的样子：章号得先占住，全书的目录才对得上。
  fn placeholderOf(at: int) -> string = "第 {at + 1} 章的正文正在取…"

  /// 在引擎里摆好一窗：从 base 起的章按目录标题占好位置，再把要读的那一章
  /// 的正文填进去，其余的读到再填。
  async fn buildWindow(base: int, target: int) throws {
    if online {
      windowMeta = remote.readMeta(book.id)
      if windowMeta == none { throw Error("这本书的目录读不到了") }
      if allSources?.definitionOf(book.sourceId) == none {
        throw Error("这本书的书源不在列表里了，先导入书源")
      }
    } else if localChapters.isEmpty() {
      throw Error("这本书的目录还没读出来")
    }
    if !engine.isOpen(engineId) { throw Error("引擎里没有这本书") }
    let count = windowCountOf(windowTotal, base: base)
    if count <= 0 { throw Error("这一章不在这本书里") }
    // 换窗只是换章节表：字体、书、引擎都还在。
    let _cleared = engine.clearChapters(engineId)
    for k in 0..<count {
      let at = base + k
      let _n = engine.appendChapter(engineId, title: chapterTitleOf(at), text: placeholderOf(at))
    }
    windowBase = base
    // 搜索结果是按原来那一窗的章号记的；换窗后对不上了，收起结果条。
    if !findHits.isEmpty() && base != findBase { clearFindHits() }
    loadedChapters = []
    // 要读的那一章先取：正文到了才排版，读者看不见占位。
    if await loadChapter(target, redraw: false) {
      loadedChapters = loadedChapters + [target]
    } else {
      snackbar("这一章的正文没有读到")
    }
  }

  /// 目录里第 `at` 章的标题：书源给的，或者文本里那一行。
  fn chapterTitleOf(at: int) -> string {
    if online {
      if let meta = windowMeta { return remote.headingOf(meta, at) }
      return "第 {at + 1} 章"
    }
    if at >= 0 && at < localChapters.count() {
      return localbook.titleOf(localChapters[at], at: at)
    }
    return "第 {at + 1} 章"
  }

  /// 取一章的正文，填进引擎里它自己的位置：在线书从书源取，大 TXT 从文件
  /// 里读那一段。
  async fn loadChapter(at: int, redraw: bool = true) -> bool {
    if !engine.isOpen(engineId) || at < 0 || at >= windowTotal { return false }
    let local = at - windowBase
    if local < 0 || local >= engine.chapterCount(engineId) { return false }
    var text: string? = none
    if online {
      let def = allSources?.definitionOf(book.sourceId)
      if let d = def, let meta = windowMeta {
        text = try? await remote.chapterText(d, id: book.id, meta: meta, at: at)
      }
    } else if at < localChapters.count() {
      text = try? await localbook.bodyOf(bookFilePath, chapter: localChapters[at])
    }
    // 读的时候窗口可能已经换了：那一章的正文就不属于现在这本书了。
    if !engine.isOpen(engineId) || at - windowBase != local { return false }
    let body = lib.chapterBody(text ?? "", at: at)
    // 在线书源给的正文通常没有章节标题；本地 TXT 的正文里本来就有那一行。
    let filled = if online { lib.withChapterHeading(body, title: chapterTitleOf(at)) } else { body }
    let ok = engine.replaceChapter(engineId, spine: local, title: chapterTitleOf(at), text: filled)
    if ok && redraw { chapterRev += 1 }
    return ok
  }

  /// 读到一章，就取这一章的正文，顺手把后面两章也取了：翻页不停在「正在取」
  /// 上。取过的章记得住，换窗时清空。
  async fn ensureChapter(at: int) {
    if !windowed || !engine.isOpen(engineId) || at < 0 || at >= windowTotal { return }
    if loadedChapters.contains(at) { return }
    if online && windowMeta == none { return }
    if await loadChapter(at) {
      loadedChapters = loadedChapters + [at]
    }
  }

  /// 大 TXT：扫一遍文件得到目录（章号、标题、字节范围），之后和在线书走同
  /// 一条窗口路，只是「取正文」是从文件里读。
  async fn openLocalStream() throws {
    let index = try await localbook.indexOf(bookFilePath)
    if index.isEmpty() || (index.count() == 1 && index[0].length == 0) {
      throw Error("《{book.title}》里没有可读的文字")
    }
    localChapters = index
    windowTotal = index.count()
    var whole: [engine.TocItem] = []
    for (i, chapter) in index.enumerated() {
      whole.push(engine.TocItem(title: localbook.titleOf(chapter, at: i), spine: i, depth: 0))
    }
    windowToc = whole
    var target = saved.chapter
    if target < 0 { target = 0 }
    if target >= windowTotal { target = 0 }
    try await buildWindow(base: windowBaseFor(target), target: target)
    spine = target - windowBase
    if spine < 0 { spine = 0 }
  }

  /// 字体：应用的衬线字体先试，平台的不行再找一个文件。
  fn mountFace(id: engine.Engine?) {
    if engine.registerFontBytes(id, data: bundledFace) {
      fontName = "Noto Serif SC"
    } else {
      let font = fontFile()
      fontName = lib.fileName(font)
      if font.isEmpty() {
        warning = "找不到可用的字体：正文画不出来"
      } else if !engine.registerFont(id, path: font) {
        warning = "字体打不开：{lib.fileName(font)}"
      }
    }
  }

  /// 请求换窗口。target 单独存，tick 变了 task 才动；task 里不提前清
  /// 目标，否则会把自己取消。
  fn requestWindow(target: int) {
    windowTarget = target
    windowTick += 1
    snackbar("正在取后面的章节…")
  }

  /// 换一个窗口：上一窗的最后几页读完了，或者目录/书签要去别的章。
  async fn switchWindow(target: int) {
    if switching { return }
    switching = true
    defer { switching = false }
    // 往回翻时落在上一章的末尾。
    let atEnd = windowEnd
    do {
      try await buildWindow(base: windowBaseFor(target), target: target)
    } catch e {
      error = lib.plain(e.message)
      retryWindow = target
      windowTarget = -1
      return
    }
    // 上一窗的章节已经换掉了：它们的 IR、断行和图片可以提前还，别等到
    // 引擎自己的预算才想起。只在确实积了一些的时候做，免得把刚热起来的
    // 字体位图再扔一次。
    if engine.memoryBytes(engineId) > 24_000_000 {
      let _trimmed = engine.trimMemory(engineId)
    }
    spine = target - windowBase
    if spine < 0 { spine = 0 }
    let count = engine.chapterCount(engineId)
    if count > 0 && spine >= count { spine = count - 1 }
    page = if atEnd { -1 } else { 0 }
    if windowPercent >= 0 {
      pendingPageFraction = windowPercent
      windowPercent = -1.0
    }
    // 滚动模式没有「页」：窗口换了，整列重新量一遍，落在这一章的开头
    // （往回翻就落在上一章的末尾）。
    if library.mode == "scroll" {
      startChapter = spine
      startWithin = if atEnd { 1.0 } else { 0.0 }
      columnReady = false
      scrollHeight = 0
      scrollAt = 0.0
      windowBucket = 0
      tiles = []
      lastColumn = ""
    }
    windowEnd = false
    windowTarget = -1
    retryWindow = -1
    show()
  }

  /// Opens the engine once, and the font it measures with.
  async fn openBook() throws {
    if opened { return }
    opened = true
    var id: engine.Engine? = none
    if online {
      // 在线书没有整本字节：引擎里先是一本空书，章节按窗推给它。
      id = engine.newBook(book.title)
    } else {
      let file = try await bookFileOf(book)
      if !fs.exists(file) {
        error = "找不到《{book.title}》的文件"
        retryWindow = -1
        announceReady()
        return
      }
      bookFilePath = file
      // 大 TXT 不整本进内存：扫一遍得到章号，正文按章从文件里读。
      if await localbook.streams(file) {
        windowed = true
        id = engine.newBook(if book.title.isEmpty() { "未命名" } else { book.title })
      } else {
        id = engine.open(file)
      }
    }
    if !engine.isOpen(id) {
      error = "打不开这本书：{engine.lastError()}"
      retryWindow = -1
      announceReady()
      return
    }
    if !windowed {
      let named = engine.title(id)
      if !named.isEmpty() { shownTitle = named }
    }
    engineId = id
    let now = time.now().unix()
    if sessionAt == 0 {
      sessionAt = now
      activeAt = now
      countedTo = now
    }
    mountFace(id)
    var firstChapter = saved.chapter
    if firstChapter < 0 { firstChapter = 0 }
    if windowed {
      // 目录是全书的一份（书源给的，或者扫出来的），窗口从要读的那一章起。
      if online { try await openOnline() } else { try await openLocalStream() }
      firstChapter = spine
    } else {
      let count = engine.chapterCount(id)
      if count > 0 && firstChapter >= count { firstChapter = 0 }
    }
    // Where the book was left: a chapter and how far into it — and the
    // paragraph it names, when there is one.
    startChapter = firstChapter
    startWithin = if saved.percent < 0 { 0 } else if saved.percent > 1 { 1 } else { saved.percent }
    pendingLocator = saved.locator
    if library.mode == "page" { pendingPageFraction = startWithin }
    try await spawn { try fs.mkdirAll(pagesDir()) }
    // Off the main thread, once a book opens: the cache is for the reading that
    // is about to happen, not for everything ever read.
    await spawn { prunePages(pagesBudget) }
    show()
  }

  // One pass for every change: the chapter, the page, the view's size, the
  // size of the type, the paper, the reading mode. The engine's layout is
  // idempotent, so this is only as expensive as the page it produces.
  task("{spine}:{page}:{frame.width}:{frame.height}:{library.size}:{library.line}:{library.margins}:{library.letter}:{library.word}:{library.theme}:{library.mode}:{chapterRev}:{reopenTick}") {
    if frame.width <= 32 { return }
    // A new paper is another picture of the column the reader is in, not
    // another layout: the band task follows the new tag by itself and the
    // Scroll stays where it is. Laying the whole book out again for a colour
    // is the one thing a theme switch must never cost.
    if library.mode == "scroll" && lastMode == "scroll" && columnKey() == lastColumn {
      return
    }
    // A slider changes several times a second. In scroll mode every change
    // means laying out every chapter; in page mode it means a whole page
    // rasterized to a file on the main thread. Wait for the hand to stop:
    // the next change cancels this run, and the last one lays out once.
    let tag = layoutTag()
    let retyped = !lastTag.isEmpty() && lastTag != tag
    lastTag = tag
    if library.mode == "scroll" && columnReady {
      await sleep(180ms)
    } else if retyped {
      await sleep(150ms)
    }
    do {
      try await openBook()
    } catch e {
      opened = false
      error = lib.plain(e.message)
      retryWindow = -1
      announceReady()
      return
    }
    show()
  }

  /// 出错之后再来一次：换窗失败的重试那个窗口，开书失败的重开一次。
  fn retry() {
    error = ""
    if retryWindow >= 0 {
      requestWindow(retryWindow)
      return
    }
    opened = false
    reopenTick += 1
  }

  // After a chapter or a mode change, put the Scroll where the reader was.

  fn next() {
    touch()
    clearSelection()
    clearFind()
    let count = engine.chapterCount(engineId)
    let place = lib.forward(spine, page, pages, count)
    // 这一窗读完了，而全书还有：去拼下一窗，不把「窗口的末页」当「全书的墨尾」。
    if windowed && place.spine == spine && place.page == page && windowBase + count < windowTotal {
      windowEnd = false
      requestWindow(windowBase + count)
      return
    }
    spine = place.spine
    page = place.page
  }

  fn back() {
    touch()
    clearSelection()
    clearFind()
    if windowed && spine == 0 && page <= 0 && windowBase > 0 {
      windowEnd = true
      requestWindow(windowBase - 1)
      return
    }
    // A turn out of a chapter's first page lands on the last page of the one
    // before it (-1, resolved by show() once that chapter is laid out).
    let place = lib.backward(spine, page, engine.chapterCount(engineId))
    spine = place.spine
    page = place.page
  }

  /// A table of contents row is a chapter's start. In scroll mode the column
  /// already holds every chapter: this is one scrollTo, never a new layout.
  fn jump(index: int) {
    touch()
    clearSelection()
    clearFind()
    let count = engine.chapterCount(engineId)
    let local = index - windowBase
    if windowed && (local < 0 || local >= count) {
      windowEnd = false
      requestWindow(index)
      return
    }
    if local < 0 || local >= count { return }
    if library.mode == "scroll" {
      // The engine owns the chapter's top. Asking for it measures that chapter
      // — the ones before it may still be estimates — so the place is kept as
      // an anchor and put right once its neighbours have been laid out.
      if columnReady && scrollHeight > 0 {
        goToChapter(local, 0)
        return
      }
      // Not laid out yet: the next layout takes this as its place.
      startChapter = local
      startWithin = 0
      return
    }
    spine = local
    page = 0
  }

  /// A bookmark's place: a chapter, and how far into it (or the paragraph it
  /// names). A table of contents row is a chapter's start; this is anywhere.
  fn goTo(chapter: int, percent: float, locator: string = "") {
    touch()
    clearSelection()
    clearFind()
    let count = engine.chapterCount(engineId)
    if count <= 0 { return }
    let local = chapter - windowBase
    var at = percent
    if at < 0 { at = 0 }
    if at > 1 { at = 1 }
    if windowed && (local < 0 || local >= count) {
      windowPercent = at
      windowEnd = false
      requestWindow(chapter)
      return
    }
    if local < 0 || local >= count { return }
    if library.mode == "scroll" {
      if columnReady && scrollHeight > 0 {
        let y = locatorY(local, locator)
        if y >= 0 {
          let ch = engine.flowChapter(engineId, local)
          var within = at
          if ch.height > 0 { within = (y - ch.top) / ch.height }
          goToChapter(local, within)
          return
        }
        goToChapter(local, at)
      } else {
        startChapter = local
        startWithin = at
        pendingLocator = locator
      }
      return
    }
    let same = local == spine
    spine = local
    page = 0
    // Page mode: the fraction is within this chapter, so it is the page — and
    // a paragraph, when there is one, is the page it lands on here.
    pendingPageFraction = at
    pendingLocator = locator
    if same { show() }
  }

  /// A link on the page: a URL goes to the app that takes it, a place in the
  /// book to its chapter — and, for a footnote, to its anchor in that chapter.
  fn follow(href: string) {
    touch()
    clearSelection()
    clearFind()
    if !engine.isOpen(engineId) || href.isEmpty() { return }
    let target = engine.resolveLink(engineId, href)
    if !target.ok { return }
    if target.external {
      device.openURL(href)
      return
    }
    let count = engine.chapterCount(engineId)
    if target.spine < 0 || target.spine >= count { return }
    if library.mode == "scroll" {
      goLinkScroll(target.spine, target.fragment)
    } else {
      goLinkPage(target.spine, target.fragment)
    }
  }

  /// A chapter and an anchor in page mode: the layout that follows turns the
  /// anchor into its line, and the line into its page.
  fn goLinkPage(chapter: int, fragment: string) {
    spine = chapter
    page = 0
    pendingPageFraction = 0
    pendingFragment = fragment
    show()
  }

  /// A chapter and an anchor in scroll mode: the column already holds them,
  /// so this is a scrollTo, not a new layout.
  fn goLinkScroll(chapter: int, fragment: string) {
    if columnReady && scrollHeight > 0 {
      let ch = engine.flowChapter(engineId, chapter)
      var y = -1.0
      if !fragment.isEmpty() { y = engine.flowAnchorY(engineId, chapter, fragment) }
      if y < 0 && ch.ok { y = ch.top }
      if y < 0 { return }
      var within = 0.0
      if ch.height > 0 { within = (y - ch.top) / ch.height }
      goToChapter(chapter, within)
      return
    }
    startChapter = chapter
    startWithin = 0
  }

  /// The link at a point of the book's flow. A chapter's links are in its own
  /// layout, so the tap is asked for there: flowHit focuses that chapter (the
  /// order matters, linkAt reads the last layout), and chapter.top makes the
  /// flow y the chapter's own.
  fn linkAtFlow(x: float, flowY: float) -> string {
    if !engine.isOpen(engineId) { return "" }
    let spine = engine.flowSpineAt(engineId, flowY)
    if spine < 0 { return "" }
    let chapter = engine.flowChapter(engineId, spine)
    if !chapter.ok { return "" }
    let where = engine.flowHit(engineId, x, flowY)
    if where.spine < 0 { return "" }
    return engine.linkAt(engineId, 0, x, flowY - chapter.top)
  }

  View {
    background: palette.paper
    grow: 1
    on layout(f) { frame = f }

    if !error.isEmpty() {
      Column {
        grow: 1
        justify: .center
        align: .center
        gap: 14
        padding: 32
        Text(error) { color: palette.muted; textAlign: .center }
        Button("重试") {
          variant: .bordered
          on press { retry() }
        }
      }
    } else if library.mode == "scroll" {
      if !columnReady {
        Column {
          grow: 1
          justify: .center
          align: .center
          Text("排版中…") { color: palette.muted }
        }
      } else if scrollHeight <= 0 {
        Column {
          grow: 1
          justify: .center
          align: .center
          Text("本书没有内容") { color: palette.muted }
        }
      } else {
        // The whole book is one real Scroll. Its content is the column's
        // height; the engine's tiles are windows placed in it, not rows of a
        // list. A jump is just a scrollTo, so a table of contents row and a
        // bookmark land where they say.
        Scroll {
          ref: scrollList
          grow: 1
          background: palette.paper
          on scroll(x, y) {
            // Where the reader is: written every frame, as a var, so a fling
            // rebuilds nothing. A bookmark and the saved place read it.
            scrollAt = y
            // The native Scroll moves the paper; the app only needs a new
            // window when the reader crosses a tile. The capsule gets its
            // own, much cheaper number.
            let bucket = windowBucketOf(y)
            if bucket != windowBucket {
              windowBucket = bucket
              // Once a band, not once a frame: a session is measured in
              // minutes, and this is the first write that rebuilds anything.
              touch()
              rememberScroll()
            }
            let p = percentAt(y)
            if p != shownPercent { shownPercent = p }
          }
          View {
            height: scrollTopPad + scrollHeight + pageMargins.bottom
            background: palette.paper
            for tile in tiles key tile.key {
              View {
                absolute: true
                top: tile.top
                left: 0
                width: frame.width
                height: tile.height
                background: palette.paper
                if !tile.path.isEmpty() {
                  bookpage.BookPage(path: tile.path) {
                    grow: 1
                    on press(x, y) {
                      touch()
                      // The band's y is the book's flow: a link is found in
                      // the chapter the tap fell in, at its own coordinates.
                      let href = linkAtFlow(x, tile.y + y)
                      if !href.isEmpty() {
                        follow(href)
                      } else {
                        chrome = !chrome
                      }
                    }
                  }
                }
              }
            }
            Text("全书完") {
              absolute: true
              top: scrollTopPad + scrollHeight + 20
              left: 24
              font: .footnote
              color: palette.muted
            }
          }
        }
      }
    } else if pagePath.isEmpty() {
      Column {
        grow: 1
        justify: .center
        align: .center
        Text("排版中…") { color: palette.muted }
      }
    } else {
      // The page covers the screen and takes the tap: its left third goes
      // back, its right third forward, its middle puts the chrome away.
      bookpage.BookPage(path: pagePath) {
        grow: 1
        // 高亮画在页面自己的图层里，不挡触摸；选区在时，拖动直接调整它。
        highlights: pageHighlights()
        selecting: selOn
        scale: scale
        on press(x, y) {
          touch()
          // 点选区里面不清它：拖完手一松常常落在这里。点外面才是取消。
          if selOn {
            if pointInSelection(x, y) { return }
            clearSelection()
            return
          }
          // A link is a box on the page: a tap in it goes where it says,
          // rather than turning the page under it.
          let href = engine.linkAt(engineId, page, x, y)
          if !href.isEmpty() {
            follow(href)
          } else {
            let width = if frame.width > 0 { frame.width } else { 320.0 }
            if x < width / 3 {
              back()
            } else if x > width * 2 / 3 {
              next()
            } else {
              chrome = !chrome
            }
          }
          let _where = y
        }
        on hold(x, y) { beginSelection(x, y) }
        on drag(x, y) { extendSelection(x, y) }
        on release { finishSelection() }
      }
    }

    // 选区定下来后的一排动作：复制、高亮、写笔记，或者不要这个选区。
    if selOn {
      Row {
        absolute: true
        top: barTop
        left: env.safeLeft + chromeMargin
        right: env.safeRight + chromeMargin
        justify: .center
        gap: 6
        Button("复制") {
          variant: .glass
          font: Font(size: 13)
          on press {
            device.copy(selText)
            snackbar("已复制")
          }
        }
        Button("高亮") {
          variant: .glass
          font: Font(size: 13)
          on press {
            keepSelection("")
            snackbar("已高亮")
          }
        }
        Button("笔记") {
          variant: .glass
          font: Font(size: 13)
          on press {
            present(NoteEditor(quote: selText, draft: "", existing: false) {
              on save(text) {
                keepSelection(text)
                snackbar("已保存笔记")
              }
            })
          }
        }
        Button("") {
          icon: Icons.close
          variant: .glass
          label: "取消"
          tooltip: "取消"
          on press { clearSelection() }
        }
      }
    }

    // Three buttons, the platform's own, in a row over the page: back, the
    // type, the contents. Nothing around them.
    if chrome {
      Row {
        absolute: true
        top: env.safeTop + 8
        left: env.safeLeft + chromeMargin
        right: env.safeRight + chromeMargin
        gap: 4
        Button("") {
          icon: Icons.back
          variant: .glass
          label: "返回"
          on press { emit close }
        }
        // 返回 on the left; the others at the right, where a reader's are.
        View { grow: 1 }
        Button("") {
          icon: Icons.search
          variant: .glass
          label: "搜索"
          tooltip: "书内搜索"
          on press { openFind() }
        }
        Button("") {
          icon: Icons.typography
          variant: .glass
          label: "排版"
          on press { present(Appearance(typeface: fontName, cacheBytes: engine.memoryBytes(engineId))) }
        }
        Button("") {
          icon: if marked != none { Icons.bookmarkFilled } else { Icons.bookmark }
          variant: .glass
          label: "书签"
          tooltip: "书签"
          on press { toggleBookmark() }
        }
        Button("") {
          icon: Icons.contents
          variant: .glass
          label: "目录"
          tooltip: "目录"
          on press {
            present(Contents(tocItems, currentChapter, book.id, images: chapterImagesNow()) {
              on pick(i) {
                if i >= 0 && i < tocItems.count() { jump(tocItems[i].spine) }
              }
              on goBookmark(chapter, percent, locator) { goTo(chapter, percent, locator: locator) }
              on dropBookmark(id) { library.removeBookmark(id) }
              on dropNote(id) {
                library.removeNote(id)
                refreshMarks()
              }
              on image(i) { showImage(i) }
            })
          }
        }
      }

      // Where the reader is: a small glass capsule in the middle, the same
      // liquid glass as the buttons above. A Button is the only element with
      // that glass variant, so this one is a label-shaped button with no
      // action.
      Row {
        absolute: true
        bottom: env.safeBottom + chromeMargin
        left: 0
        right: 0
        justify: .center
        Button(if library.mode == "scroll" { "{shownPercent}%" } else { "{page + 1} / {pages}" }) {
          variant: .glass
          font: Font(size: 11)
          color: palette.muted
          padding: [3, 9]
          radius: 11
          a11yHidden: true
        }
      }

      // 书内搜索的那一批还在：翻上一条、下一条，点中间回到结果列表。
      if findAt >= 0 && !findHits.isEmpty() {
        Row {
          absolute: true
          bottom: env.safeBottom + chromeMargin + 38
          left: 0
          right: 0
          justify: .center
          Row {
            gap: 2
            align: .center
            padding: [2, 4]
            radius: 20
            background: palette.paper
            border: 1
            borderColor: palette.rule
            Button("") {
              icon: Icons.back
              variant: .plain
              color: palette.ink
              label: "上一条结果"
              disabled: findAt <= 0
              on press { findPrev() }
            }
            Button("{findAt + 1} / {findHits.count()}") {
              variant: .plain
              font: Font(size: 12)
              color: palette.muted
              label: "搜索「{findQuery}」的结果"
              on press { openFind() }
            }
            Button("") {
              icon: Icons.disclosure
              variant: .plain
              color: palette.ink
              label: "下一条结果"
              disabled: findAt >= findHits.count() - 1
              on press { findNext() }
            }
            Button("") {
              icon: Icons.close
              variant: .plain
              color: palette.muted
              label: "结束搜索"
              on press { clearFindHits() }
            }
          }
        }
      }
    }

    // A book with no font still pages, with nothing on them: say why over
    // the page, rather than showing a blank one.
    if !warning.isEmpty() {
      Column {
        grow: 1
        justify: .start
        // 页面铺到状态栏底下：这条提示也得让开安全区，不然被刘海和圆角吃掉。
        padding: [env.safeTop, env.safeLeft + chromeMargin, 0, env.safeRight + chromeMargin]
        Text(warning) {
          font: .footnote
          color: palette.ink
          padding: [8, 12]
          background: palette.rule
          textAlign: .center
        }
      }
    }

    // A chapter picture covers the page while it is open. It is the reader's
    // own layer: the contents sheet closes underneath it, and no second sheet
    // is put up while that one is going away.
    if !imagePath.isEmpty() {
      View {
        absolute: true
        top: 0
        left: 0
        right: 0
        bottom: 0
        background: #101014
        ImageViewer(path: imagePath, pixelsW: imageW, pixelsH: imageH) {
          on close {
            imagePath = ""
            imageW = 0
            imageH = 0
          }
        }
      }
    }
  }
}
