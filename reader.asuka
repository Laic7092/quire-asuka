// The reading page: the engine (ebook-engine) lays a chapter out into pages
// and rasterizes each one to a file; BookPage (the native package) shows it.
//
// Every way into the text — the page turn, the table of contents, the size
// and the paper — goes through the same task: lay the chapter out again,
// rasterize the page, and remember where the reader is.

import std/embed
import std/fs

import bookpage

import ./lib
import ./engine

/// Points the engine lays out at, before the reader's own size multiplies it.
let baseSize = 19.0

/// The face the pages are set in: a serif the app ships, so every device and
/// every test lays the same book out the same way (and Chinese always has
/// glyphs). SIL Open Font License; see fonts/OFL.txt.
let bundledFace = embed.bytes("fonts/NotoSerifSC-Regular.woff2")

/// The families to ask the platform for, in order. iOS's font files aren't
/// where a reader would guess (and some live in the dyld cache), so the
/// platform's own font layer gives the path.
let fontFamilies = ["Songti SC", "PingFang SC", "Hiragino Sans GB", "Songti TC", "Noto Serif CJK SC"]

/// The file list to try when the platform can't name one.
fn fontCandidates() -> [string] {
  if @platform == .iOS || @platform == .macOS {
    return [
      "/System/Library/Fonts/Supplemental/Songti.ttc",
      "/System/Library/Fonts/PingFang.ttc",
      "/System/Library/Fonts/Supplemental/STIXTwoText.ttf",
    ]
  }
  return [
    "/usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf",
    "/usr/share/fonts/opentype/noto/NotoSerifCJK-Regular.ttc",
    "/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc",
    "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf",
  ]
}

/// The file the engine reads: the import's, or one written from the text the
/// shelf kept.
async fn bookFileOf(book: lib.Book) throws -> string {
  if !book.path.isEmpty() && fs.exists(book.path) { return book.path }
  let dir = fs.join([fs.appDir(), "books"])
  let path = fs.join([dir, "{book.id}.txt"])
  if !fs.exists(path) && !book.raw.isEmpty() {
    let raw = book.raw
    try await spawn { try fs.mkdirAll(dir) }
    try await spawn {
      try fs.writeText(path, text: raw)
    }
  }
  return path
}

/// The font the engine measures with: the platform's, by family name; else
/// a file at one of the usual paths.
fn fontFile() -> string {
  let files = try? bookpage.FontFiles()
  if let files = files {
    for family in fontFamilies {
      if let found = try? files.path(family: family) {
        if !found.isEmpty() { return found }
      }
    }
  }
  for path in fontCandidates() {
    if fs.exists(path) { return path }
  }
  // Nothing named: whatever the system's font directory has. The Chinese
  // faces by name first, since that's what the text is.
  for dir in ["/System/Library/Fonts", "/System/Library/Fonts/Supplemental", "/System/Library/Fonts/LanguageSupport", "/System/Library/Fonts/Core"] {
    if let entries = try? fs.walk(dir) {
      let fonts = entries.filter(e => !e.isDir && (e.name.lower().hasSuffix(".ttc") || e.name.lower().hasSuffix(".ttf")))
      for key in ["song", "ping", "hiragino", "heiti", "kai", "noto", "wqy", "droid"] {
        for entry in fonts {
          if entry.name.lower().contains(key) { return entry.path }
        }
      }
      if let first = fonts.first() { return first.path }
    }
  }
  return ""
}

/// The margins a page is set in, from the view it's shown in and the reader's
/// own factor (1 is the default: the proportion below, with a floor).
fn marginsOf(width: float, height: float, delta: float, env: Environment) -> engine.Margins {
  let side = if width * 0.075 > 24 { width * 0.075 } else { 24.0 }
  let top = if height * 0.055 > 28 { height * 0.055 } else { 28.0 }
  // 0 is the default proportions; the setting is how much wider they get.
  let factor = if delta > -0.9 { 1.0 + delta } else { 0.1 }
  // The page covers the screen, so the notch's and the home indicator's room
  // is the layout's to leave.
  return engine.Margins(
    top: top * factor + env.safeTop,
    right: side * factor + env.safeRight,
    bottom: top * factor + env.safeBottom,
    left: side * factor + env.safeLeft,
  )
}

/// The page files: one a book, chapter, page and size, next to the app's data.
fn pagesDir() -> string = fs.join([fs.appDir(), "pages"])

/// A row in the scroll list: a tile of a chapter, or the room above/below
/// the book. `spine` is -1 for the top room and -2 for the end of the book.
struct ScrollRow {
  spine: int
  y: float
  height: float
  top: float
}

/// A tile on screen: what `remember` needs to know where the top is.
struct VisibleTile {
  chapter: int
  at: float
}

/// One scroll tile's file name: a slice of one chapter, not a page.
fn slicePath(book: string, spine: int, index: int, top: float, height: float, width: float, viewHeight: float, insetLeft: float, insetRight: float, scale: float, tag: string) -> string {
  return fs.join([
    pagesDir(),
    "{book}-{spine}-scroll-{index}-{top.int()}-{height.int()}-{width.int()}-v{viewHeight.int()}-l{insetLeft.int()}r{insetRight.int()}-{(scale * 10).int()}-{tag}.eqp",
  ])
}

/// One screenful of a chapter in scroll mode: the engine lays the chapter out
/// again (it keeps only one) and rasterizes exactly this window. A List row is
/// recycled, so the task is keyed on the row: the same view shows a different
/// slice when it comes back, and a cached file skips the engine.
component ScrollTile(engineId: int, book: string, row: int, spine: int, y: float, at: float, tileHeight: float, tileWidth: float, viewHeight: float, insetLeft: float, insetRight: float, fontScale: float, lineScale: float, letter: float, word: float, scale: float, ink: u32, paper: u32, tag: string) {
  event shown(chapter: int, at: float)
  event hidden(at: float)
  state path = ""

  task("{row}:{spine}:{y}:{tileHeight}:{tileWidth}:{viewHeight}:{insetLeft}:{insetRight}:{fontScale}:{lineScale}:{letter}:{word}:{scale}:{tag}:{ink}:{paper}") {
    let id = engineId
    let file = slicePath(book: book, spine: spine, index: row, top: y, height: tileHeight, width: tileWidth, viewHeight: viewHeight, insetLeft: insetLeft, insetRight: insetRight, scale: scale, tag: tag)
    path = ""
    if !fs.exists(file) {
      let height = engine.layoutScroll(
        id, spine, tileWidth, viewHeight,
        engine.Margins(top: 0, right: insetRight, bottom: 0, left: insetLeft),
        fontScale, lineScale, letter, word,
      )
      if height < 0 { return }
      if !engine.renderSlice(id, 0, y, tileHeight, scale, ink, paper, false, file) { return }
    }
    path = file
    emit shown(spine, at)
  }

  // The List recycles this row as it goes off screen: the parent can then
  // stop counting it among the visible tiles.
  cleanup { emit hidden(at) }

  View {
    width: tileWidth
    height: tileHeight
    bookpage.BookPage(path: path) { grow: 1 }
  }
}

component Contents(items: [engine.TocItem], at: int) {
  event pick(index: int)
  let list = Ref()
  // The TOC's row for the chapter being read: a spine may be missing from
  // the TOC, and nested entries mean the row isn't the spine.
  let here = items.index(item => item.spine == at) ?? 0

  // Open where the reader is, not at the first chapter.
  task {
    await sleep(30ms)
    list.scrollToItem(here, animated: false)
  }

  Column {
    gap: 0
    padding: [16, 0]
    Row {
      padding: [8, 20]
      gap: 8
      align: .center
      Text("目录") {
        font: .title3
        grow: 1
      }
      Button("") {
        icon: "xmark"
        variant: .glassProminent
        on press { dismiss() }
      }
    }
    List {
      ref: list
      grow: 1
      for (i, item) in items.enumerated() key i {
        Row {
          padding: [12, 20]
          gap: 10
          align: .center
          on press {
            emit pick(i)
            dismiss()
          }
          Text(item.title) {
            grow: 1
            lines: 2
            font: if item.spine == at { .body.bold() } else { .body }
            color: if item.spine == at { .accent } else { .label }
          }
          Text("{item.spine + 1}") {
            font: .caption
            color: .secondaryLabel
          }
        }
      }
    }
  }
}

/// Type size, line spacing, the margins, the letter spacing, and the paper.
/// Everything a page is laid out with, so nothing has to be guessed at.
component Appearance(typeface: string) {
  use library: Library

  let papers = [
    ["paper", "纸白"],
    ["sepia", "米黄"],
    ["night", "夜间"],
  ]

  Column {
    padding: [24, 24]
    gap: 16

    Row {
      gap: 8
      align: .center
      Text("阅读设置") {
        font: .title3
        grow: 1
      }
      Button("") {
        icon: "xmark"
        variant: .glassProminent
        on press { dismiss() }
      }
    }

    Text("翻页方式") { font: .headline }
    Segmented(["分页", "滚动"]) {
      selected: if library.mode == "scroll" { 1 } else { 0 }
      on change(i) { library.mode = if i == 1 { "scroll" } else { "page" } }
    }

    Row {
      gap: 12
      align: .center
      Text("字号") {
        font: .subheadline
        width: 42
      }
      Slider {
        bind value: library.size
        min: 14
        max: 30
        grow: 1
      }
      Text("{library.size.int()} 点") {
        font: .footnote
        color: .secondaryLabel
        width: 44
        textAlign: .end
      }
    }

    Row {
      gap: 12
      align: .center
      Text("行距") {
        font: .subheadline
        width: 42
      }
      Slider {
        bind value: library.line
        min: 1.2
        max: 2.2
        grow: 1
      }
      Text("{(library.line * 100).int()}%") {
        font: .footnote
        color: .secondaryLabel
        width: 44
        textAlign: .end
      }
    }

    // 0 is the default留白; the slider goes either way from it.
    Row {
      gap: 12
      align: .center
      Text("边距") {
        font: .subheadline
        width: 42
      }
      Slider {
        bind value: library.margins
        min: -0.3
        max: 1
        grow: 1
      }
      Text("{(library.margins * 100).int()}%") {
        font: .footnote
        color: .secondaryLabel
        width: 44
        textAlign: .end
      }
    }

    Row {
      gap: 12
      align: .center
      Text("字距") {
        font: .subheadline
        width: 42
      }
      Slider {
        bind value: library.letter
        min: -1
        max: 3
        grow: 1
      }
      Text(library.letter.fixed(1)) {
        font: .footnote
        color: .secondaryLabel
        width: 44
        textAlign: .end
      }
    }

    Row {
      gap: 12
      align: .center
      Text("词距") {
        font: .subheadline
        width: 42
      }
      Slider {
        bind value: library.word
        min: -2
        max: 8
        grow: 1
      }
      Text(library.word.fixed(1)) {
        font: .footnote
        color: .secondaryLabel
        width: 44
        textAlign: .end
      }
    }

    Text("纸色") { font: .headline }
    Segmented(papers.map(p => p[1])) {
      selected: papers.index(p => p[0] == library.theme) ?? 0
      on change(i) { library.theme = papers[i][0] }
    }
    if !typeface.isEmpty() {
      Text("字体：{typeface}") {
        font: .footnote
        color: .secondaryLabel
      }
    }
  }
}

component Reader(book: lib.Book) {
  use library: Library

  state engineId = -1
  state spine = 0
  state page = 0
  state pages = 1
  state pagePath = ""
  state frame = Frame()
  state error = ""
  state warning = ""
  state fontName = ""
  state opened = false
  state shownTitle = book.title
  /// The page count and the title bar on top of the page: hidden while
  /// reading, a tap on the middle of the page brings them back.
  state chrome = true

  /// Scroll mode: the whole book as one column of tiles. `ScrollRow`'s spine
  /// is -1 for the top room and -2 for the end of the book.
  state scrollRows: [ScrollRow] = []
  state scrollHeight = 0.0
  state scrollTile = 0.0
  state scrollDone = false
  /// The content y at the top of what shows.
  state topY = -1.0
  /// The tiles the List currently has on screen.
  state visible: [VisibleTile] = []
  /// The whole-book fraction to put at the top, once the list is ready.
  state startFraction = 0.0
  /// A jump is pending; a type or paper change doesn't move the reader.
  state jumped = true
  /// A page-mode place to turn into a page once the chapter is laid out.
  state pendingPageFraction = -1.0
  state lastMode = ""

  let palette = lib.paletteFor(library.theme)
  let env = environment()
  let scale = if env.scale > 0 { env.scale } else { 2.0 }
  let pageMargins = marginsOf(frame.width, frame.height, library.margins, env)
  let saved = library.readingOf(book.id)
  let scrollList = Ref()

  let heading = if shownTitle.isEmpty() { book.title } else { shownTitle }

  // Opens where the book was left, in the chapter (spine) it was left in.
  task {
    spine = if saved.chapter > 0 { saved.chapter } else { 0 }
  }

  // The engine holds the book's bytes: let it go as the reading page does.
  cleanup {
    if engineId > 0 {
      engine.close(engineId)
      engineId = -1
    }
  }

  /// Actually lays the chapter out and rasterizes the page.
  fn show() {
    if engineId <= 0 || frame.width <= 32 || frame.height <= 64 { return }
    let chapterCount = engine.chapterCount(engineId)
    if spine >= chapterCount { spine = if chapterCount > 0 { chapterCount - 1 } else { 0 } }
    if library.mode != lastMode { switchMode() }
    if library.mode == "scroll" {
      showScroll()
      return
    }
    let pagesNow = engine.layout(
      engineId, spine, frame.width, frame.height,
      pageMargins,
      library.size / baseSize, library.line, library.letter, library.word,
    )
    if pagesNow <= 0 { return }
    pages = pagesNow
    if pendingPageFraction >= 0 {
      page = int(pendingPageFraction * float(pagesNow))
      if page >= pagesNow { page = pagesNow - 1 }
      pendingPageFraction = -1.0
    } else {
      page = lib.resolve(page, pages)
    }
    let path = fs.join([pagesDir(), "{book.id}-{spine}-{page}-{frame.width.int()}x{frame.height.int()}-{layoutTag()}.eqp"])
    let ok = engine.renderPage(engineId, page, scale, lib.rgbaOf(palette.ink), lib.rgbaOf(palette.paper), false, path)
    if ok {
      pagePath = path
      let info = engine.pageInfo(engineId, page)
      let chapters = if chapterCount > 0 { float(chapterCount) } else { 1.0 }
      library.save(book.id, spine, (float(spine) + info.progress) / chapters)
    }
  }

  /// The first layout of a new mode: a page's place becomes a whole-book
  /// fraction, or the other way around. The first layout after opening keeps
  /// the fraction openBook took from the saved reading position.
  fn switchMode() {
    if lastMode.isEmpty() {
      jumped = library.mode != "scroll"
      topY = -1
      scrollDone = false
    } else if library.mode == "scroll" {
      let count = engine.chapterCount(engineId)
      let chapters = if count > 0 { float(count) } else { 1.0 }
      let within = if pages > 1 { float(page) / float(pages) } else { 0.0 }
      startFraction = (float(spine) + within) / chapters
      jumped = false
      topY = -1
      visible = []
      scrollDone = false
    } else {
      let count = engine.chapterCount(engineId)
      let chapters = if count > 0 { float(count) } else { 1.0 }
      let book = if scrollHeight > 0 && topY >= 0 { topY / scrollHeight } else { startFraction }
      var place = book * chapters
      if place < 0 { place = 0 }
      let end = if count > 0 { float(count) - 0.001 } else { 0.0 }
      if place > end { place = end }
      let target = int(place)
      if target != spine { spine = target }
      pendingPageFraction = place - float(target)
      jumped = true
    }
    lastMode = library.mode
  }

  /// Lays every chapter out once to learn its height, then cuts the whole
  /// book into screenful tiles. The chapters join at their content height:
  /// the last row of one can be shorter, and the next starts right under it,
  /// so scrolling never stops at a chapter boundary.
  fn showScroll() {
    scrollDone = false
    // A new layout while the reader is already in place: the old y no longer
    // names the same line, so let the first visible tile say where it is.
    if jumped {
      topY = -1
      visible = []
    }
    let count = engine.chapterCount(engineId)
    let tile = scrollTileHeight()
    let fontScale = library.size / baseSize
    var rows: [ScrollRow] = [
      ScrollRow(spine: -1, y: 0, height: pageMargins.top, top: 0),
    ]
    var total = 0.0
    for c in 0..<count {
      let height = engine.layoutScroll(
        engineId, c, frame.width, frame.height,
        engine.Margins(top: 0, right: pageMargins.right, bottom: 0, left: pageMargins.left),
        fontScale, library.line, library.letter, library.word,
      )
      if height <= 0 { continue }
      var y = 0.0
      while y < height {
        var h = tile
        if height - y < h { h = height - y }
        rows.push(ScrollRow(spine: c, y: y, height: h, top: total + y))
        y += h
      }
      total += height
    }
    rows.push(ScrollRow(spine: -2, y: 0, height: pageMargins.bottom, top: total))
    scrollRows = rows
    scrollTile = tile
    scrollHeight = total
    scrollDone = true
  }

  /// A tile is one screenful, capped so its bitmap stays under the engine's
  /// page-pixel budget (a 4K window at 2x would otherwise be too large).
  fn scrollTileHeight() -> float {
    if frame.width <= 0 { return 400 }
    let cap = 8_000_000.0 / (frame.width * scale * scale)
    let height = if frame.height < cap { frame.height } else { cap }
    return if height < 256 { 256.0 } else { height }
  }

  /// A tile came on screen. While a jump is pending it's one of the rows
  /// built before the list moves, so it's counted but not where the reader is.
  fn appear(chapter: int, at: float) {
    if at < 0 { return }
    if visible.find(t => t.at == at) == none { visible.push(VisibleTile(chapter: chapter, at: at)) }
    if jumped { settle() }
  }

  /// A tile went off screen: it's no longer a candidate for the top.
  fn vanish(at: float) {
    visible = visible.filter(t => t.at != at)
    if jumped { settle() }
  }

  /// The top visible tile is the reader's place: save it as whole-book
  /// progress, with its chapter, one row a book.
  fn settle() {
    if visible.isEmpty() { return }
    var best = visible[0]
    for tile in visible {
      if tile.at < best.at { best = tile }
    }
    if topY >= 0 && best.at == topY { return }
    topY = best.at
    let chapters = engine.chapterCount(engineId)
    if chapters <= 0 || scrollHeight <= 0 { return }
    var fraction = best.at / scrollHeight
    if fraction < 0 { fraction = 0 }
    if fraction > 1 { fraction = 1 }
    library.save(book.id, best.chapter, fraction)
  }

  fn scrollPercent() -> int {
    if scrollHeight <= 0 || topY < 0 { return 0 }
    var p = topY / scrollHeight * 100
    if p < 0 { p = 0 }
    if p > 100 { p = 100 }
    return p.int()
  }

  /// How this page was laid out, in its file name: a page is a different
  /// file as soon as the type or the paper changes, so the native view shows
  /// the new one instead of the one it already has at the same path.
  fn layoutTag() -> string {
    let size = (library.size * 10).int()
    let line = (library.line * 10).int()
    let margin = (library.margins * 100).int()
    let letter = (library.letter * 10).int()
    let word = (library.word * 10).int()
    return "s{size}-l{line}-m{margin}-k{letter}-w{word}-{library.theme}"
  }

  /// Opens the engine once, and the font it measures with.
  async fn openBook() throws {
    if opened { return }
    opened = true
    let file = try await bookFileOf(book)
    if !fs.exists(file) {
      error = "找不到《{book.title}》的文件"
      return
    }
    let id = engine.open(file)
    if id <= 0 {
      error = "打不开这本书：{engine.lastError()}"
      return
    }
    engineId = id
    // The app's own face first: it's what the pages are designed around, and
    // the platform's fonts aren't readable as files everywhere (iOS keeps
    // several in the dyld cache).
    if engine.registerFontBytes(id, data: bundledFace) {
      fontName = "Noto Serif SC"
    } else {
      let font = fontFile()
      fontName = lib.fileName(font)
      if font.isEmpty() {
        warning = "找不到可用的字体：正文画不出来"
      } else if !engine.registerFont(id, path: font) {
        warning = "字体打不开：{lib.fileName(font)}"
      }
    }
    let named = engine.title(id)
    if !named.isEmpty() { shownTitle = named }
    let count = engine.chapterCount(id)
    if count > 0 && spine >= count { spine = 0 }
    // Where the book was left, as a whole-book fraction. Page mode uses the
    // chapter; scroll mode puts this fraction at the top of the column.
    if saved.percent > 0 {
      startFraction = if saved.percent > 1 { 1 } else { saved.percent }
    } else {
      startFraction = 0
    }
    try await spawn { try fs.mkdirAll(pagesDir()) }
    show()
  }

  // One pass for every change: the chapter, the page, the view's size, the
  // size of the type, the paper, the reading mode. The engine's layout is
  // idempotent, so this is only as expensive as the page it produces.
  task("{spine}:{page}:{frame.width}:{frame.height}:{library.size}:{library.line}:{library.margins}:{library.letter}:{library.theme}:{library.mode}") {
    if frame.width <= 32 { return }
    try? await openBook()
    show()
  }

  // After a chapter or a mode change, put the list where the reader was. A
  // type or paper change keeps the place: `jumped` is already true then.
  task("{spine}:{library.mode}:{scrollRows.count()}:{scrollHeight}:{scrollTile}:{startFraction}:{scrollDone}") {
    if library.mode != "scroll" || !scrollDone || scrollRows.count() <= 2 || scrollTile <= 0 || jumped { return }
    await sleep(30ms)
    let topPad = pageMargins.top
    var y = topPad + startFraction * scrollHeight
    let maxY = topPad + scrollHeight - scrollTile
    if y < topPad { y = topPad }
    if y > maxY { y = maxY }
    if y < topPad { y = topPad }
    scrollList.scrollTo(0, y, animated: false)
    await sleep(60ms)
    var at = startFraction * scrollHeight
    if at < 0 { at = 0 }
    if at > scrollHeight { at = scrollHeight }
    topY = at
    jumped = true
    settle()
  }

  fn next() {
    let place = lib.forward(spine, page, pages, engine.chapterCount(engineId))
    spine = place.spine
    page = place.page
  }

  fn back() {
    // A turn out of a chapter's first page lands on the last page of the one
    // before it (-1, resolved by show() once that chapter is laid out).
    let place = lib.backward(spine, page, engine.chapterCount(engineId))
    spine = place.spine
    page = place.page
  }

  fn jump(index: int) {
    let count = engine.chapterCount(engineId)
    if index < 0 || index >= count { return }
    let same = index == spine
    spine = index
    page = 0
    // Where this chapter begins in the whole-book column.
    var at = 0.0
    if scrollHeight > 0 {
      var found = false
      for row in scrollRows {
        if row.spine == index {
          at = row.top
          found = true
          break
        }
      }
      if !found { at = float(index) / float(count) * scrollHeight }
      startFraction = at / scrollHeight
    } else {
      startFraction = 0
    }
    topY = -1
    visible = []
    jumped = false
    scrollDone = false
    // Choosing the chapter already open changes no task key: lay it out here
    // so the jump task has a list to scroll.
    if library.mode == "scroll" && same { showScroll() }
  }

  View {
    background: palette.paper
    grow: 1
    on layout(f) { frame = f }

    if !error.isEmpty() {
      Column {
        grow: 1
        justify: .center
        align: .center
        padding: 32
        Text(error) { color: palette.muted; textAlign: .center }
      }
    } else if library.mode == "scroll" {
      if !scrollDone {
        Column {
          grow: 1
          justify: .center
          align: .center
          Text("排版中…") { color: palette.muted }
        }
      } else if scrollRows.count() <= 2 {
        Column {
          grow: 1
          justify: .center
          align: .center
          Text("本书没有内容") { color: palette.muted }
        }
      } else {
        // The whole book is one column: a row a screenful, made only while
        // it shows. The first and last rows are the room above and below it.
        // Chapters meet at their content height, so scrolling runs through.
        List {
          ref: scrollList
          grow: 1
          for (i, row) in scrollRows.enumerated() key i {
            if row.spine == -1 {
              View { height: row.height }
            } else if row.spine == -2 {
              Column {
                padding: [24, 24]
                gap: 16
                Text("全书完") {
                  font: .footnote
                  color: palette.muted
                }
                View { height: row.height }
              }
            } else {
              ScrollTile(
                engineId: engineId, book: book.id, row: i, spine: row.spine,
                y: row.y, at: row.top, tileHeight: row.height, tileWidth: frame.width,
                viewHeight: frame.height, insetLeft: pageMargins.left, insetRight: pageMargins.right,
                fontScale: library.size / baseSize, lineScale: library.line,
                letter: library.letter, word: library.word, scale: scale,
                ink: lib.rgbaOf(palette.ink), paper: lib.rgbaOf(palette.paper),
                tag: layoutTag(),
              ) {
                on shown(chapter, at) { appear(chapter: chapter, at: at) }
                on hidden(at) { vanish(at: at) }
              }
            }
          }
        }
      }
    } else if pagePath.isEmpty() {
      Column {
        grow: 1
        justify: .center
        align: .center
        Text("排版中…") { color: palette.muted }
      }
    } else {
      // The page covers the screen and takes the tap: its left third goes
      // back, its right third forward, its middle puts the chrome away.
      bookpage.BookPage(path: pagePath) {
        grow: 1
        on press(x, y) {
          let width = if frame.width > 0 { frame.width } else { 320.0 }
          if x < width / 3 {
            back()
          } else if x > width * 2 / 3 {
            next()
          } else {
            chrome = !chrome
          }
          let _where = y
        }
      }
    }

    // Three buttons, the platform's own, in a row over the page: back, the
    // type, the contents. Nothing around them.
    if chrome {
      Row {
        absolute: true
        top: env.safeTop + 6
        left: 8
        right: 8
        gap: 4
        Button("") {
          icon: "chevron.left"
          variant: .glassProminent
          on press { dismiss() }
        }
        // 返回 on the left; the other two at the right, where a reader's are.
        View { grow: 1 }
        Button("") {
          icon: "textformat"
          variant: .glassProminent
          on press { present(Appearance(typeface: fontName)) }
        }
        Button("") {
          icon: "list.bullet"
          variant: .glassProminent
          on press {
            present(Contents(engine.contents(engineId), spine) {
              on pick(i) {
                let items = engine.contents(engineId)
                if i >= 0 && i < items.count() { jump(items[i].spine) }
              }
            })
          }
        }
      }

      // Where the reader is: a capsule in the page's corner, filled with the
      // platform's own material (asuka has no badge view: a material and a
      // radius are the native way to float a label over content).
      Row {
        absolute: true
        bottom: env.safeBottom + 8
        right: 16
        View {
          material: .thin
          radius: 11
          padding: [3, 9]
          Text(if library.mode == "scroll" { "{scrollPercent()}%" } else { "{page + 1} / {pages}" }) {
            font: Font(size: 11)
            color: palette.muted
          }
        }
      }
    }

    // A book with no font still pages, with nothing on them: say why over
    // the page, rather than showing a blank one.
    if !warning.isEmpty() {
      Column {
        grow: 1
        justify: .start
        Text(warning) {
          font: .footnote
          color: palette.ink
          padding: [8, 12]
          background: palette.rule
          textAlign: .center
        }
      }
    }
  }
}
