// The reading page: the engine (ebook-engine) lays a chapter out into pages
// and rasterizes each one to a file; BookPage (the native package) shows it.
//
// Every way into the text — the page turn, the table of contents, the size
// and the paper — goes through the same task: lay the chapter out again,
// rasterize the page, and remember where the reader is.

import std/embed
import std/fs

import bookpage

import ./lib
import ./engine

/// Points the engine lays out at, before the reader's own size multiplies it.
let baseSize = 19.0

/// The face the pages are set in: a serif the app ships, so every device and
/// every test lays the same book out the same way (and Chinese always has
/// glyphs). SIL Open Font License; see fonts/OFL.txt.
let bundledFace = embed.bytes("fonts/NotoSerifSC-Regular.otf")

/// The families to ask the platform for, in order. iOS's font files aren't
/// where a reader would guess (and some live in the dyld cache), so the
/// platform's own font layer gives the path.
let fontFamilies = ["Songti SC", "PingFang SC", "Hiragino Sans GB", "Songti TC", "Noto Serif CJK SC"]

/// The file list to try when the platform can't name one.
fn fontCandidates() -> [string] {
  if @platform == .iOS || @platform == .macOS {
    return [
      "/System/Library/Fonts/Supplemental/Songti.ttc",
      "/System/Library/Fonts/PingFang.ttc",
      "/System/Library/Fonts/Supplemental/STIXTwoText.ttf",
    ]
  }
  return [
    "/usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf",
    "/usr/share/fonts/opentype/noto/NotoSerifCJK-Regular.ttc",
    "/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc",
    "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf",
  ]
}

/// The file the engine reads: the import's, or one written from the text the
/// shelf kept.
async fn bookFileOf(book: lib.Book) throws -> string {
  if !book.path.isEmpty() && fs.exists(book.path) { return book.path }
  let dir = fs.join([fs.appDir(), "books"])
  let path = fs.join([dir, "{book.id}.txt"])
  if !fs.exists(path) && !book.raw.isEmpty() {
    let raw = book.raw
    try await spawn { try fs.mkdirAll(dir) }
    try await spawn {
      try fs.writeText(path, text: raw)
    }
  }
  return path
}

/// The font the engine measures with: the platform's, by family name; else
/// a file at one of the usual paths.
fn fontFile() -> string {
  let files = try? bookpage.FontFiles()
  if let files = files {
    for family in fontFamilies {
      if let found = try? files.path(family: family) {
        if !found.isEmpty() { return found }
      }
    }
  }
  for path in fontCandidates() {
    if fs.exists(path) { return path }
  }
  // Nothing named: whatever the system's font directory has. The Chinese
  // faces by name first, since that's what the text is.
  for dir in ["/System/Library/Fonts", "/System/Library/Fonts/Supplemental", "/System/Library/Fonts/LanguageSupport", "/System/Library/Fonts/Core"] {
    if let entries = try? fs.walk(dir) {
      let fonts = entries.filter(e => !e.isDir && (e.name.lower().hasSuffix(".ttc") || e.name.lower().hasSuffix(".ttf")))
      for key in ["song", "ping", "hiragino", "heiti", "kai", "noto", "wqy", "droid"] {
        for entry in fonts {
          if entry.name.lower().contains(key) { return entry.path }
        }
      }
      if let first = fonts.first() { return first.path }
    }
  }
  return ""
}

/// The margins a page is set in, from the view it's shown in and the reader's
/// own factor (1 is the default: the proportion below, with a floor).
fn marginsOf(width: float, height: float, delta: float, env: Environment) -> engine.Margins {
  let side = if width * 0.075 > 24 { width * 0.075 } else { 24.0 }
  let top = if height * 0.055 > 28 { height * 0.055 } else { 28.0 }
  // 0 is the default proportions; the setting is how much wider they get.
  let factor = if delta > -0.9 { 1.0 + delta } else { 0.1 }
  // The page covers the screen, so the notch's and the home indicator's room
  // is the layout's to leave.
  return engine.Margins(
    top: top * factor + env.safeTop,
    right: side * factor + env.safeRight,
    bottom: top * factor + env.safeBottom,
    left: side * factor + env.safeLeft,
  )
}

/// The page files: one a book, chapter, page and size, next to the app's data.
fn pagesDir() -> string = fs.join([fs.appDir(), "pages"])

component Contents(items: [engine.TocItem], at: int) {
  event pick(index: int)

  Column {
    gap: 0
    padding: [16, 0]
    Text("目录") {
      font: .title3
      padding: [8, 20]
    }
    List {
      grow: 1
      for (i, item) in items.enumerated() key i {
        Row {
          padding: [12, 20]
          gap: 10
          align: .center
          on press {
            emit pick(i)
            dismiss()
          }
          Text(item.title) {
            grow: 1
            lines: 2
            font: if item.spine == at { .body.bold() } else { .body }
            color: if item.spine == at { .accent } else { .label }
          }
          Text("{item.spine + 1}") {
            font: .caption
            color: .secondaryLabel
          }
        }
      }
    }
  }
}

/// Type size, line spacing, the margins, the letter spacing, and the paper.
/// Everything a page is laid out with, so nothing has to be guessed at.
component Appearance(typeface: string) {
  use library: Library

  let papers = [
    ["paper", "纸白"],
    ["sepia", "米黄"],
    ["night", "夜间"],
  ]

  Column {
    padding: [24, 24]
    gap: 16

    Row {
      gap: 12
      align: .center
      Text("字号") {
        font: .subheadline
        width: 42
      }
      Slider {
        bind value: library.size
        min: 14
        max: 30
        grow: 1
      }
      Text("{library.size.int()} 点") {
        font: .footnote
        color: .secondaryLabel
        width: 44
        textAlign: .end
      }
    }

    Row {
      gap: 12
      align: .center
      Text("行距") {
        font: .subheadline
        width: 42
      }
      Slider {
        bind value: library.line
        min: 1.2
        max: 2.2
        grow: 1
      }
      Text("{(library.line * 100).int()}%") {
        font: .footnote
        color: .secondaryLabel
        width: 44
        textAlign: .end
      }
    }

    // 0 is the default留白; the slider goes either way from it.
    Row {
      gap: 12
      align: .center
      Text("边距") {
        font: .subheadline
        width: 42
      }
      Slider {
        bind value: library.margins
        min: -0.3
        max: 1
        grow: 1
      }
      Text("{(library.margins * 100).int()}%") {
        font: .footnote
        color: .secondaryLabel
        width: 44
        textAlign: .end
      }
    }

    Row {
      gap: 12
      align: .center
      Text("字距") {
        font: .subheadline
        width: 42
      }
      Slider {
        bind value: library.letter
        min: -1
        max: 3
        grow: 1
      }
      Text(library.letter.fixed(1)) {
        font: .footnote
        color: .secondaryLabel
        width: 44
        textAlign: .end
      }
    }

    Row {
      gap: 12
      align: .center
      Text("词距") {
        font: .subheadline
        width: 42
      }
      Slider {
        bind value: library.word
        min: -2
        max: 8
        grow: 1
      }
      Text(library.word.fixed(1)) {
        font: .footnote
        color: .secondaryLabel
        width: 44
        textAlign: .end
      }
    }

    Text("纸色") { font: .headline }
    Segmented(papers.map(p => p[1])) {
      selected: papers.index(p => p[0] == library.theme) ?? 0
      on change(i) { library.theme = papers[i][0] }
    }
    if !typeface.isEmpty() {
      Text("字体：{typeface}") {
        font: .footnote
        color: .secondaryLabel
      }
    }
  }
}

component Reader(book: lib.Book) {
  use library: Library

  state engineId = -1
  state spine = 0
  state page = 0
  state pages = 1
  state pagePath = ""
  state frame = Frame()
  state error = ""
  state warning = ""
  state fontName = ""
  state opened = false
  state shownTitle = book.title
  /// The page count and the title bar on top of the page: hidden while
  /// reading, a tap on the middle of the page brings them back.
  state chrome = true

  let palette = lib.paletteFor(library.theme)
  let env = environment()
  let scale = if env.scale > 0 { env.scale } else { 2.0 }
  let saved = library.readingOf(book.id)

  let heading = if shownTitle.isEmpty() { book.title } else { shownTitle }

  // Opens where the book was left, in the chapter (spine) it was left in.
  task {
    spine = if saved.chapter > 0 { saved.chapter } else { 0 }
  }

  // The engine holds the book's bytes: let it go as the reading page does.
  cleanup {
    if engineId > 0 {
      engine.close(engineId)
      engineId = -1
    }
  }

  /// Actually lays the chapter out and rasterizes the page.
  fn show() {
    if engineId <= 0 || frame.width <= 32 || frame.height <= 64 { return }
    let chapterCount = engine.chapterCount(engineId)
    if spine >= chapterCount { spine = if chapterCount > 0 { chapterCount - 1 } else { 0 } }
    let pagesNow = engine.layout(
      engineId, spine, frame.width, frame.height,
      marginsOf(frame.width, frame.height, library.margins, env),
      library.size / baseSize, library.line, library.letter, library.word,
    )
    if pagesNow <= 0 { return }
    pages = pagesNow
    page = lib.resolve(page, pages)
    let path = fs.join([pagesDir(), "{book.id}-{spine}-{page}-{frame.width.int()}x{frame.height.int()}-{layoutTag()}.eqp"])
    let ok = engine.renderPage(engineId, page, scale, lib.rgbaOf(palette.ink), lib.rgbaOf(palette.paper), false, path)
    if ok {
      pagePath = path
      let info = engine.pageInfo(engineId, page)
      let chapters = if chapterCount > 0 { float(chapterCount) } else { 1.0 }
      library.save(book.id, spine, (float(spine) + info.progress) / chapters)
    }
  }

  /// How this page was laid out, in its file name: a page is a different
  /// file as soon as the type or the paper changes, so the native view shows
  /// the new one instead of the one it already has at the same path.
  fn layoutTag() -> string {
    let size = (library.size * 10).int()
    let line = (library.line * 10).int()
    let margin = (library.margins * 100).int()
    let letter = (library.letter * 10).int()
    let word = (library.word * 10).int()
    return "s{size}-l{line}-m{margin}-k{letter}-w{word}-{library.theme}"
  }

  /// Opens the engine once, and the font it measures with.
  async fn openBook() throws {
    if opened { return }
    opened = true
    let file = try await bookFileOf(book)
    if !fs.exists(file) {
      error = "找不到《{book.title}》的文件"
      return
    }
    let id = engine.open(file)
    if id <= 0 {
      error = "打不开这本书：{engine.lastError()}"
      return
    }
    engineId = id
    // The app's own face first: it's what the pages are designed around, and
    // the platform's fonts aren't readable as files everywhere (iOS keeps
    // several in the dyld cache).
    if engine.registerFontBytes(id, data: bundledFace) {
      fontName = "Noto Serif SC"
    } else {
      let font = fontFile()
      fontName = lib.fileName(font)
      if font.isEmpty() {
        warning = "找不到可用的字体：正文画不出来"
      } else if !engine.registerFont(id, path: font) {
        warning = "字体打不开：{lib.fileName(font)}"
      }
    }
    let named = engine.title(id)
    if !named.isEmpty() { shownTitle = named }
    let count = engine.chapterCount(id)
    if count > 0 && spine >= count { spine = 0 }
    try await spawn { try fs.mkdirAll(pagesDir()) }
    show()
  }

  // One pass for every change: the chapter, the page, the view's size, the
  // size of the type, the paper. The engine's layout is idempotent, so this
  // is only as expensive as the page it produces.
  task("{spine}:{page}:{frame.width}:{frame.height}:{library.size}:{library.line}:{library.margins}:{library.letter}:{library.theme}") {
    if frame.width <= 32 { return }
    try? await openBook()
    show()
  }

  fn next() {
    let place = lib.forward(spine, page, pages, engine.chapterCount(engineId))
    spine = place.spine
    page = place.page
  }

  fn back() {
    // A turn out of a chapter's first page lands on the last page of the one
    // before it (-1, resolved by show() once that chapter is laid out).
    let place = lib.backward(spine, page, engine.chapterCount(engineId))
    spine = place.spine
    page = place.page
  }

  fn jump(index: int) {
    let count = engine.chapterCount(engineId)
    if index < 0 || index >= count { return }
    spine = index
    page = 0
  }

  View {
    background: palette.paper
    grow: 1
    on layout(f) { frame = f }

    if !error.isEmpty() {
      Column {
        grow: 1
        justify: .center
        align: .center
        padding: 32
        Text(error) { color: palette.muted; textAlign: .center }
      }
    } else if pagePath.isEmpty() {
      Column {
        grow: 1
        justify: .center
        align: .center
        Text("排版中…") { color: palette.muted }
      }
    } else {
      // The page covers the screen and takes the tap: its left third goes
      // back, its right third forward, its middle puts the chrome away.
      bookpage.BookPage(path: pagePath) {
        grow: 1
        on press(x, y) {
          let width = if frame.width > 0 { frame.width } else { 320.0 }
          if x < width / 3 {
            back()
          } else if x > width * 2 / 3 {
            next()
          } else {
            chrome = !chrome
          }
          let _where = y
        }
      }
    }

    // Three buttons, the platform's own, in a row over the page: back, the
    // type, the contents. Nothing around them.
    if chrome {
      Row {
        absolute: true
        top: env.safeTop + 6
        left: 8
        right: 8
        gap: 4
        Button("") {
          icon: "chevron.left"
          on press { dismiss() }
        }
        // 返回 on the left; the other two at the right, where a reader's are.
        View { grow: 1 }
        Button("") {
          icon: "textformat"
          on press { present(Appearance(typeface: fontName)) }
        }
        Button("") {
          icon: "list.bullet"
          on press {
            present(Contents(engine.contents(engineId), spine) {
              on pick(i) {
                let items = engine.contents(engineId)
                if i >= 0 && i < items.count() { jump(items[i].spine) }
              }
            })
          }
        }
      }

      // Where the reader is: a capsule in the page's corner, filled with the
      // platform's own material (asuka has no badge view: a material and a
      // radius are the native way to float a label over content).
      Row {
        absolute: true
        bottom: env.safeBottom + 8
        right: 16
        View {
          material: .thin
          radius: 11
          padding: [3, 9]
          Text("{page + 1} / {pages}") {
            font: Font(size: 11)
            color: palette.muted
          }
        }
      }
    }

    // A book with no font still pages, with nothing on them: say why over
    // the page, rather than showing a blank one.
    if !warning.isEmpty() {
      Column {
        grow: 1
        justify: .start
        Text(warning) {
          font: .footnote
          color: palette.ink
          padding: [8, 12]
          background: palette.rule
          textAlign: .center
        }
      }
    }
  }
}
