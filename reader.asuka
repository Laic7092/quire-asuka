// The reading page: the engine (ebook-engine) lays a chapter out into pages
// and rasterizes each one to a file; BookPage (the native package) shows it.
//
// Every way into the text — the page turn, the table of contents, the size
// and the paper — goes through the same task: lay the chapter out again,
// rasterize the page, and remember where the reader is.

import std/embed
import std/fs
import std/time
import platform/device
import platform/screen

import bookpage

import ./lib
import ./engine

/// Points the engine lays out at, before the reader's own size multiplies it.
let baseSize = 19.0

/// 浮在页面上的控件离屏幕边缘的宽。阅读页铺满整屏（纸连状态栏底下都刷），
/// 所以系统栏和安全区得自己让开：先加 safeLeft/safeRight，再留出系统栏那
/// 样的 16pt。横屏的刘海也因此在外面。
let chromeMargin: float = 16

/// Where the reader is in the column, in the Scroll's own coordinates. A frame's
/// scroll event writes it, so it can't be `state`: that would rebuild the page
/// on every frame of a fling. Nothing in the tree draws from it — a bookmark,
/// the saved place and the band window read it when they need it.
var scrollAt = 0.0

/// The face the pages are set in: a serif the app ships, so every device and
/// every test lays the same book out the same way (and Chinese always has
/// glyphs). SIL Open Font License; see fonts/OFL.txt.
let bundledFace = embed.bytes("fonts/NotoSerifSC-Regular.woff")

/// The families to ask the platform for, in order. iOS's font files aren't
/// where a reader would guess (and some live in the dyld cache), so the
/// platform's own font layer gives the path.
let fontFamilies = ["Songti SC", "PingFang SC", "Hiragino Sans GB", "Songti TC", "Noto Serif CJK SC"]

/// The file list to try when the platform can't name one.
fn fontCandidates() -> [string] {
  if @platform == .iOS || @platform == .macOS {
    return [
      "/System/Library/Fonts/Supplemental/Songti.ttc",
      "/System/Library/Fonts/PingFang.ttc",
      "/System/Library/Fonts/Supplemental/STIXTwoText.ttf",
    ]
  }
  if @platform == .windows {
    return [
      "C:/Windows/Fonts/simsun.ttc",
      "C:/Windows/Fonts/msyh.ttc",
      "C:/Windows/Fonts/segoeui.ttf",
    ]
  }
  return [
    "/usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf",
    "/usr/share/fonts/opentype/noto/NotoSerifCJK-Regular.ttc",
    "/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc",
    "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf",
  ]
}

/// The file the engine reads: the import's, or one written from the text the
/// shelf kept. A row's path is resolved against the app's directory before it
/// gets here; the fallback is a book whose row lost its file name.
async fn bookFileOf(book: lib.Book) throws -> string {
  if !book.path.isEmpty() && fs.exists(book.path) { return book.path }
  let dir = fs.join([fs.appDir(), "books"])
  // An imported book's id is its file's name (with the extension); a sample's
  // is its title, whose file is the title and .txt.
  let lower = book.id.lower()
  let name = if lower.hasSuffix(".txt") || lower.hasSuffix(".epub") { book.id } else { "{book.id}.txt" }
  let path = fs.join([dir, name])
  if !fs.exists(path) && !book.raw.isEmpty() {
    let raw = book.raw
    try await spawn { try fs.mkdirAll(dir) }
    try await spawn {
      try fs.writeText(path, text: raw)
    }
  }
  return path
}

/// The font the engine measures with: the platform's, by family name; else
/// a file at one of the usual paths.
fn fontFile() -> string {
  let files = try? bookpage.FontFiles()
  if let files = files {
    for family in fontFamilies {
      if let found = try? files.path(family: family) {
        if !found.isEmpty() { return found }
      }
    }
  }
  for path in fontCandidates() {
    if fs.exists(path) { return path }
  }
  // Nothing named: whatever the system's font directory has. The Chinese
  // faces by name first, since that's what the text is.
  for dir in ["/System/Library/Fonts", "/System/Library/Fonts/Supplemental", "/System/Library/Fonts/LanguageSupport", "/System/Library/Fonts/Core"] {
    if let entries = try? fs.walk(dir) {
      let fonts = entries.filter(e => !e.isDir && (e.name.lower().hasSuffix(".ttc") || e.name.lower().hasSuffix(".ttf")))
      for key in ["song", "ping", "hiragino", "heiti", "kai", "noto", "wqy", "droid"] {
        for entry in fonts {
          if entry.name.lower().contains(key) { return entry.path }
        }
      }
      if let first = fonts.first() { return first.path }
    }
  }
  return ""
}

/// A page's side margin in points: the default proportion (7.5% of the page,
/// at least 24 points) times the reader's setting, where 0 keeps the default,
/// 1 doubles it and -0.3 leaves seven tenths. The sheet shows this number, so
/// the slider says 24 点 rather than -30%.
fn sideMargin(width: float, delta: float) -> float {
  let side = if width * 0.075 > 24 { width * 0.075 } else { 24.0 }
  let factor = if delta > -0.9 { 1.0 + delta } else { 0.1 }
  return side * factor
}

/// The margins a page is set in, from the view it's shown in and the reader's
/// own factor (1 is the default: the proportion below, with a floor).
fn marginsOf(width: float, height: float, delta: float, env: Environment) -> engine.Margins {
  let top = if height * 0.055 > 28 { height * 0.055 } else { 28.0 }
  // 0 is the default proportions; the setting is how much wider they get.
  let factor = if delta > -0.9 { 1.0 + delta } else { 0.1 }
  // The page covers the screen, so the notch's and the home indicator's room
  // is the layout's to leave.
  return engine.Margins(
    top: top * factor + env.safeTop,
    right: sideMargin(width, delta) + env.safeRight,
    bottom: top * factor + env.safeBottom,
    left: sideMargin(width, delta) + env.safeLeft,
  )
}

/// A setting with its sign, as a person reads it: "+5%", "-20%", "0%".
fn signedPercent(v: float) -> string {
  let p = (v * 100).rounded().int()
  if p > 0 { return "+{p}%" }
  if p < 0 { return "{p}%" }
  return "0%"
}

/// The page files: one a book, chapter, page and size, next to the app's data.
fn pagesDir() -> string = fs.join([fs.appDir(), "pages"])

/// How many bytes of page files the app keeps. They are a cache — a page is a
/// few milliseconds to draw — so running over this costs one window's drawing,
/// not correctness. Reading a book for an hour writes a couple of gigabytes of
/// bands, so without a ceiling the directory grows with no end.
let pagesBudget = 200_000_000

/// Throws the page cache away when it outgrows its budget, and any half-written
/// file a killed run left behind. Wholesale rather than by age: keeping an age
/// per file is bookkeeping for something that is cheap to draw again.
fn prunePages(budget: int) {
  let entries = (try? fs.walk(pagesDir())) ?? []
  var total = 0
  var pages: [string] = []
  for entry in entries {
    if entry.isDir { continue }
    // The engine writes `{path}.{pid}.{seq}.part` and renames it into place,
    // so a `.part` that is still here is a write that never finished.
    if entry.name.hasSuffix(".part") {
      try? fs.remove(entry.path)
      continue
    }
    if !entry.name.hasSuffix(".eqp") { continue }
    total += (try? fs.stat(entry.path))?.size ?? 0
    pages.push(entry.path)
  }
  if total <= budget { return }
  for path in pages { try? fs.remove(path) }
}

/// One visible band of the column, at its place in the book's flow. The column
/// is a real Scroll and the engine owns the flow (chapter tops, seams), so a
/// band is only ever a window onto it, never a row of a list.
struct ScrollTile {
  key: string
  /// Where the band starts in the book's flow coordinates.
  y: float
  /// And where it sits in the Scroll (the page's top room included).
  top: float
  height: float
  path: string
}

/// A rectangle drawn over the page: a kept note's highlight, or the live
/// selection being dragged. Page points, from the engine's selection.
struct PageMark {
  key: string
  x: float
  y: float
  w: float
  h: float
}

/// One scroll band's file name: a slice of the flow, which may cross a chapter.
fn slicePath(book: string, y: float, height: float, width: float, viewHeight: float, insetLeft: float, insetRight: float, scale: float, tag: string) -> string {
  return fs.join([
    pagesDir(),
    "{book}-scroll-{y.int()}-{height.int()}-{width.int()}-v{viewHeight.int()}-l{insetLeft.int()}r{insetRight.int()}-{(scale * 10).int()}-{tag}.eqp",
  ])
}

/// A bookmark's row: its chapter's title from the table of contents (a chapter
/// can be missing from it), and how far into the book it is.
fn markTitle(mark: lib.Bookmark, items: [engine.TocItem]) -> string {
  let item = items.find(i => i.spine == mark.chapter)
  let name = item?.title ?? "第 {mark.chapter + 1} 章"
  return "{name} · {(mark.percent * 100).int()}%"
}

/// What a row of the contents sheet is: a section's name, a place the reader
/// kept, or a chapter.
enum ContentsRowKind {
  header
  bookmark
  note
  chapter
}

/// One row of the contents sheet, all three kinds: a List's rows come from a
/// `for`, so the sections are rows like any other.
struct ContentsRow {
  kind: ContentsRowKind
  title: string
  chapter: int
  percent: float
  index: int
  id: string
  /// A note row's quote and what the reader wrote; "" for other rows.
  quote: string = ""
  text: string = ""
}

/// The contents sheet's rows: the bookmarks under a 书签 heading, the notes
/// under a 笔记 one, then the table of contents under its own.
fn contentsRows(marks: [lib.Bookmark], notes: [lib.Note], items: [engine.TocItem]) -> [ContentsRow] {
  var rows: [ContentsRow] = []
  var sections = false
  if !marks.isEmpty() {
    rows.push(ContentsRow(kind: .header, title: "书签", chapter: 0, percent: 0, index: 0, id: "h.bookmarks"))
    for mark in marks {
      rows.push(ContentsRow(
        kind: .bookmark, title: markTitle(mark, items),
        chapter: mark.chapter, percent: mark.percent, index: 0, id: mark.id,
      ))
    }
    sections = true
  }
  if !notes.isEmpty() {
    rows.push(ContentsRow(kind: .header, title: "笔记", chapter: 0, percent: 0, index: 0, id: "h.notes"))
    for note in notes {
      rows.push(ContentsRow(
        kind: .note, title: note.preview(), chapter: note.chapter, percent: note.percent,
        index: 0, id: note.id, quote: note.quote, text: note.text,
      ))
    }
    sections = true
  }
  if sections {
    rows.push(ContentsRow(kind: .header, title: "目录", chapter: 0, percent: 0, index: 0, id: "h.toc"))
  }
  for (i, item) in items.enumerated() {
    rows.push(ContentsRow(
      kind: .chapter, title: item.title, chapter: item.spine, percent: 0, index: i,
      id: "c.{i}",
    ))
  }
  return rows
}

component Contents(items: [engine.TocItem], at: int, book: string) {
  event pick(index: int)
  event goBookmark(chapter: int, percent: float)
  event dropBookmark(id: string)
  event dropNote(id: string)
  use library: Library

  let rows = contentsRows(library.bookmarksOf(book), library.notesOf(book), items)
  let list = Ref()

  // The row for the chapter being read: a spine may be missing from the TOC,
  // and nested entries mean the row isn't the spine.
  let here = rows.index(r => r.kind == .chapter && r.chapter == at) ?? 0

  // Open where the reader is, not at the first chapter.
  task {
    await sleep(30ms)
    list.scrollToItem(here, animated: false)
  }

  Column {
    gap: 0
    padding: [16, 0]
    Row {
      padding: [8, 20]
      gap: 8
      align: .center
      Text("目录") {
        font: .title3
        grow: 1
      }
      Button("") {
        icon: Icons.close
        variant: .glass
        on press { dismiss() }
      }
    }
    List {
      ref: list
      grow: 1
      for row in rows key row.id {
        match row.kind {
          .header => Row {
            padding: [12, 20]
            Text(row.title) {
              font: .footnote
              color: .secondaryLabel
            }
          }
          .bookmark => Menu {
            longPress: true
            actions: [.button(title: "删除", role: .destructive, run: () => { emit dropBookmark(row.id) })]
            Row {
              padding: [12, 20]
              gap: 10
              align: .center
              on press {
                emit goBookmark(chapter: row.chapter, percent: row.percent)
                dismiss()
              }
              Text(row.title) {
                grow: 1
                lines: 1
                color: .label
              }
            }
          }
          .note => Menu {
            longPress: true
            actions: [
              .button(title: "编辑", run: () => {
                present(NoteEditor(quote: row.quote, draft: row.text, existing: true) {
                  on save(text) {
                    library.updateNote(row.id, text: text)
                  }
                  on remove { emit dropNote(row.id) }
                })
              }),
              .button(title: "删除", role: .destructive, run: () => { emit dropNote(row.id) }),
            ]
            Row {
              padding: [12, 20]
              gap: 10
              align: .center
              on press {
                emit goBookmark(chapter: row.chapter, percent: row.percent)
                dismiss()
              }
              Column {
                grow: 1
                gap: 3
                Text(row.title) {
                  lines: 2
                  color: .label
                }
                if !row.text.isEmpty() {
                  Text(row.text) {
                    font: .footnote
                    lines: 1
                    color: .secondaryLabel
                  }
                }
              }
              Text("{(row.percent * 100).int()}%") {
                font: .caption
                color: .secondaryLabel
              }
            }
          }
          .chapter => Row {
            padding: [12, 20]
            gap: 10
            align: .center
            on press {
              emit pick(row.index)
              dismiss()
            }
            Text(row.title) {
              grow: 1
              lines: 2
              font: if row.chapter == at { .body.bold() } else { .body }
              color: if row.chapter == at { .accent } else { .label }
            }
            Text("{row.chapter + 1}") {
              font: .caption
              color: .secondaryLabel
            }
          }
        }
      }
    }
  }
}

/// A setting as the 0…1 a slider's track holds, and back. The slider's
/// value reaches the platform before its min and max do, so a value outside
/// the platform's default 0…1 is clamped where the track starts: settings
/// use the whole track, and the sheet maps.
fn norm(v: float, lo: float, hi: float) -> float {
  if hi <= lo { return 0 }
  var x = (v - lo) / (hi - lo)
  if x < 0 { x = 0 }
  if x > 1 { x = 1 }
  return x
}

fn denorm(f: float, lo: float, hi: float) -> float = lo + f * (hi - lo)

/// Type size, line spacing, the margins, the letter spacing, and the paper.
/// Everything a page is laid out with, so nothing has to be guessed at.
component Appearance(typeface: string) {
  use library: Library

  let papers = [
    ["paper", "纸白"],
    ["sepia", "米黄"],
    ["night", "夜间"],
  ]

  /// 滑块的位置是 0…1，不是设置值本身：Slider 的 value 比 min/max 先
  /// 到平台，落在默认的 0…1 之外就会被平台夹住，滑块停在最左（或最
  /// 右），和旁边的数字对不上。0…1 的轨道永远不会被夹，位置也一样准。
  state size = norm(peek(library.size), 14, 30)
  state line = norm(peek(library.line), 0.8, 2.5)
  state margins = norm(peek(library.margins), -0.1, 0.1)
  state letter = norm(peek(library.letter), -0.1, 0.1)
  state word = norm(peek(library.word), -0.2, 0.2)

  Column {
    padding: [24, 24]
    gap: 16

    Row {
      gap: 8
      align: .center
      Text("阅读设置") {
        font: .title3
        grow: 1
      }
      Button("") {
        icon: Icons.close
        variant: .glass
        on press { dismiss() }
      }
    }

    Text("翻页方式") { font: .headline }
    Segmented(["分页", "滚动"]) {
      selected: if library.mode == "scroll" { 1 } else { 0 }
      on change(i) { library.mode = if i == 1 { "scroll" } else { "page" } }
    }

    Row {
      gap: 12
      align: .center
      Text("字号") {
        font: .subheadline
        width: 42
      }
      Slider {
        value: size
        min: 0
        max: 1
        grow: 1
        on change(f) {
          size = f
          library.size = denorm(f, 14, 30)
        }
      }
      Text("{denorm(size, 14, 30).rounded().int()} 点") {
        font: .footnote
        color: .secondaryLabel
        width: 44
        textAlign: .end
      }
    }

    Row {
      gap: 12
      align: .center
      Text("行距") {
        font: .subheadline
        width: 42
      }
      Slider {
        value: line
        min: 0
        max: 1
        grow: 1
        on change(f) {
          line = f
          library.line = denorm(f, 0.8, 2.5)
        }
      }
      Text("{denorm(line, 0.8, 2.5).fixed(1)} 倍") {
        font: .footnote
        color: .secondaryLabel
        width: 44
        textAlign: .end
      }
    }

    // 0 is the default留白; the slider goes either way from it.
    Row {
      gap: 12
      align: .center
      Text("边距") {
        font: .subheadline
        width: 42
      }
      Slider {
        value: margins
        min: 0
        max: 1
        grow: 1
        on change(f) {
          margins = f
          library.margins = denorm(f, -0.1, 0.1)
        }
      }
      Text(signedPercent(denorm(margins, -0.1, 0.1))) {
        font: .footnote
        color: .secondaryLabel
        width: 44
        textAlign: .end
      }
    }

    Row {
      gap: 12
      align: .center
      Text("字距") {
        font: .subheadline
        width: 42
      }
      Slider {
        value: letter
        min: 0
        max: 1
        grow: 1
        on change(f) {
          letter = f
          library.letter = denorm(f, -0.1, 0.1)
        }
      }
      Text(signedPercent(denorm(letter, -0.1, 0.1))) {
        font: .footnote
        color: .secondaryLabel
        width: 44
        textAlign: .end
      }
    }

    Row {
      gap: 12
      align: .center
      Text("词距") {
        font: .subheadline
        width: 42
      }
      Slider {
        value: word
        min: 0
        max: 1
        grow: 1
        on change(f) {
          word = f
          library.word = denorm(f, -0.2, 0.2)
        }
      }
      Text(signedPercent(denorm(word, -0.2, 0.2))) {
        font: .footnote
        color: .secondaryLabel
        width: 44
        textAlign: .end
      }
    }

    Text("纸色") { font: .headline }
    Segmented(papers.map(p => p[1])) {
      selected: papers.index(p => p[0] == library.theme) ?? 0
      on change(i) { library.theme = papers[i][0] }
    }
    if !typeface.isEmpty() {
      Text("字体：{typeface}") {
        font: .footnote
        color: .secondaryLabel
      }
    }
  }
}

/// A note being written: the quote it is about, above the words the reader
/// has to say. A note already made can be taken off from here too.
component NoteEditor(quote: string, draft: string, existing: bool) {
  state text = draft

  event save(text: string)
  event remove

  Column {
    padding: [20, 20]
    gap: 14

    Text(if existing { "编辑笔记" } else { "笔记" }) { font: .title3 }

    Column {
      padding: [10, 12]
      gap: 4
      radius: 10
      background: .secondaryBackground
      Text(quote) {
        font: .footnote
        color: .secondaryLabel
        lines: 6
      }
    }

    TextField {
      bind text: text
      placeholder: "写下你的想法"
    }

    Row {
      gap: 8
      align: .center
      if existing {
        Button("删除") {
          variant: .glass
          on press {
            emit remove
            dismiss()
          }
        }
      }
      View { grow: 1 }
      Button("取消") {
        variant: .glass
        on press { dismiss() }
      }
      Button("保存") {
        on press {
          emit save(text)
          dismiss()
        }
      }
    }
  }
}

component Reader(book: lib.Book) {
  use library: Library

  /// The reader is done: the app takes its layer away.
  event close
  /// The first page is on screen (or the book says why it has none): the app
  /// shows the layer then, so its open animation ends on a page.
  event ready

  state engineId = -1
  state spine = 0
  state page = 0
  state pages = 1
  state pagePath = ""
  state frame = Frame()
  state error = ""
  state warning = ""
  state fontName = ""
  state opened = false
  /// `ready` is said once, however many pages follow it.
  state announced = false
  state shownTitle = book.title
  /// The page count and the title bar on top of the page: hidden while
  /// reading, a tap on the middle of the page brings them back.
  state chrome = true

  /// Scroll mode: the whole book as one real Scroll. The engine owns the
  /// column — chapter tops, heights, and a band renderer that may cross a
  /// chapter — so `scrollHeight` is its total flow height, and the reader
  /// only asks for the bands that are on screen.
  state scrollHeight = 0.0
  state scrollTile = 0.0
  state columnReady = false
  /// The tile bucket the reader is in. It is the only thing a scroll event
  /// changes about what the tree shows, so it is the state; the position
  /// itself is `scrollAt`, written every frame without a rebuild.
  state windowBucket = 0
  /// The column as it was last laid out: the type, the margins and the view's
  /// size — never the paper. A new paper is another picture of the same
  /// column, so it must not lay the column out again.
  state lastColumn = ""
  state tiles: [ScrollTile] = []
  /// The Scroll's content starts after this much room, and ends before as
  /// much: the page's own top and bottom margins.
  state scrollTopPad = 0.0
  /// An actual scroll position to go to once the Scroll is laid out: a jump,
  /// a bookmark, the saved place, or a type change. `scrollTick` makes the
  /// task run even when two places are the same.
  state scrollTarget = -1.0
  state scrollTick = 0
  /// A place to put at the top once the column is ready: a chapter and how
  /// far into it. Opening, a page-to-scroll switch, and a jump before the
  /// column exists all use this; a type change keeps the current place.
  state startChapter = -1
  state startWithin = 0.0
  /// A page-mode place to turn into a page once the chapter is laid out.
  state pendingPageFraction = -1.0
  /// A link's anchor, applied once its chapter is laid out: a footnote's
  /// fragment is a line in the chapter the page is about to show.
  state pendingFragment = ""
  state lastMode = ""
  /// The type the last page layout was made with: a slider moves it many
  /// times a second, and only the place the hand stops is worth a page.
  state lastTag = ""
  /// Where the reader is: how far into `hereChapter` (0…1). Not a page
  /// number, since the type's size is the reader's.
  state herePercent = 0.0
  /// The chapter that place is in. In scroll mode the chapter of the top line
  /// changes as the reader scrolls; `spine` is the page mode's chapter and
  /// stays put.
  state hereChapter = 0
  /// The capsule's number, written only when the integer percent changes:
  /// the view must not read the scroll offset itself.
  state shownPercent = 0
  /// Restarts the save task; the place is written after the scroll settles.
  state placeTick = 0

  /// 选区：长按选中一个词，按住拖到哪儿，远的那一端就跟到哪儿。两个端点
  /// 是规范化之前的（锚点不动，焦点跟手指），保存时用引擎给的顺序。
  state selOn = false
  state selAnchorLine = 0
  state selAnchorByte = 0
  state selFocusLine = 0
  state selFocusByte = 0
  /// 规范化后的起点和终点：存下的笔记按它记，不按手指的方向。
  state selStartLine = 0
  state selStartByte = 0
  state selEndLine = 0
  state selEndByte = 0
  state selText = ""
  /// 选区在当前页上的矩形，和这一页已有的高亮。
  state selRects: [PageMark] = []
  state marks: [PageMark] = []

  /// 阅读时长：打开（或重新开始活动）的时刻、最后一次活动的时刻、已经记到
  /// 哪一刻。空闲超过五分钟就不再算，书页开着过夜不会记成读了一夜。
  state sessionAt = 0
  state activeAt = 0
  state countedTo = 0

  let palette = lib.paletteFor(library.theme)
  let barStyle = if library.theme == "night" { screen.BarStyle.light } else { screen.BarStyle.dark }
  let env = environment()
  let scale = if env.scale > 0 { env.scale } else { 2.0 }
  let pageMargins = marginsOf(frame.width, frame.height, library.margins, env)
  let saved = library.readingOf(book.id)
  let scrollList = Ref()

  let heading = if shownTitle.isEmpty() { book.title } else { shownTitle }
  /// 选区动作条的位置：在选区上方，顶上放不下就放到下方。
  let selTop = selRects.first()?.y ?? 0.0
  let selBottom = (selRects.last()?.y ?? 0.0) + (selRects.last()?.h ?? 0.0)
  let barTop = if selTop > env.safeTop + 70 {
    selTop - 52
  } else if selBottom + 56 < frame.height - env.safeBottom {
    selBottom + 10
  } else {
    selTop - 52
  }
  let selectionFill = if library.theme == "night" { #6ea8fe55 } else { #0a84ff33 }
  let noteFill = if library.theme == "night" { #f5b94244 } else { #f5c54266 }
  /// The bookmark at the place the reader is, if there is one: the button
  /// fills, and pressing it again takes it back. These change once a screen,
  /// not once a scroll event.
  let marked = library.bookmarkAt(book.id, chapter: hereChapter, percent: herePercent)
  let currentChapter = if library.mode == "scroll" { hereChapter } else { spine }

  // Opens where the book was left, in the chapter (spine) it was left in.
  task {
    spine = if saved.chapter > 0 { saved.chapter } else { 0 }
  }

  // The buttons and the status bar are one layer: the page owns the whole
  // screen while it reads, and gives the bars back as it goes.
  effect { screen.setBars(style: barStyle, hideStatus: !chrome, hideNavigation: false) }

  // The engine holds the book's bytes: let it go as the reading page does.
  cleanup {
    screen.setBars(style: .auto, hideStatus: false, hideNavigation: false)
    if library.mode == "scroll" { savePlace() }
    flushSession()
    if engineId > 0 {
      engine.close(engineId)
      engineId = -1
    }
  }

  /// 读了一页、翻了一页、滚动了一下：这一段还算在读。
  fn touch() {
    if sessionAt == 0 { return }
    let now = time.now().unix()
    if now - activeAt > 300 {
      flushSession()
      // 中间的停顿不是阅读：从这一刻重新开始算。
      if now > countedTo { countedTo = now }
    } else if now - countedTo >= 60 {
      // 一分钟左右落一次盘，靠翻页或滚动顺手写，不另开计时器。
      flushSession()
    }
    activeAt = now
  }

  /// 把从上次记下到现在的阅读时间写进 store。空闲超过五分钟只算到
  /// 最后一次活动后五分钟；关页和每分钟各写一次。
  fn flushSession() {
    if engineId <= 0 || sessionAt == 0 { return }
    let now = time.now().unix()
    var until = now
    if now - activeAt > 300 { until = activeAt + 300 }
    if until > now { until = now }
    if until <= countedTo { return }
    let seconds = until - countedTo
    countedTo = until
    library.recordReading(book.id, seconds: seconds)
  }

  /// Actually lays the chapter out and rasterizes the page.
  fn show() {
    if engineId <= 0 || frame.width <= 32 || frame.height <= 64 { return }
    // A new page, size or type: a selection belongs to the layout it was made
    // in, so it goes before this one is drawn.
    clearSelection()
    let chapterCount = engine.chapterCount(engineId)
    if spine >= chapterCount { spine = if chapterCount > 0 { chapterCount - 1 } else { 0 } }
    if library.mode != lastMode { switchMode() }
    if library.mode == "scroll" {
      showScroll()
      return
    }
    let pagesNow = engine.layout(
      engineId, spine, frame.width, frame.height,
      pageMargins,
      library.size / baseSize, library.line, library.letter * library.size, library.word * library.size,
    )
    if pagesNow <= 0 { return }
    pages = pagesNow
    // A link with a fragment (a footnote's `#note-3`) names a line in this
    // chapter, which is a page once the chapter is laid out.
    if !pendingFragment.isEmpty() {
      let line = engine.fragmentLine(engineId, pendingFragment)
      if line >= 0 { pendingPageFraction = engine.progress(engineId, line) }
      pendingFragment = ""
    }
    if pendingPageFraction >= 0 {
      page = int(pendingPageFraction * float(pagesNow))
      if page >= pagesNow { page = pagesNow - 1 }
      pendingPageFraction = -1.0
    } else {
      page = lib.resolve(page, pages)
    }
    let path = fs.join([pagesDir(), "{book.id}-{spine}-{page}-{frame.width.int()}x{frame.height.int()}-{fileTag()}.eqp"])
    let ok = engine.renderPage(engineId, page, scale, lib.rgbaOf(palette.ink), lib.rgbaOf(palette.paper), false, path)
    if ok {
      pagePath = path
      let info = engine.pageInfo(engineId, page)
      hereChapter = spine
      herePercent = info.progress
      library.save(book.id, spine, info.progress)
      announceReady()
      refreshMarks()
    }
  }

  /// The first page is on screen (or the book has none to put there): said
  /// once, so the app can end its open animation on the page rather than on
  /// paper that fills in after it.
  fn announceReady() {
    if announced { return }
    announced = true
    emit ready
  }

  /// The first layout of a new mode: a page's place becomes a chapter's, or
  /// the other way around. The first layout after opening keeps the place
  /// openBook took from the saved reading position.
  fn switchMode() {
    clearSelection()
    if lastMode.isEmpty() {
      columnReady = false
    } else if library.mode == "scroll" {
      let within = if pages > 1 { float(page) / float(pages) } else { 0.0 }
      startChapter = spine
      startWithin = within
      // The place is a page's; showScroll must not replace it with the old
      // column's. There is no old column yet.
      scrollHeight = 0
      columnReady = false
      scrollAt = 0.0
      windowBucket = 0
      tiles = []
    } else {
      let count = engine.chapterCount(engineId)
      var target = hereChapter
      if target < 0 { target = 0 }
      if count > 0 && target >= count { target = count - 1 }
      if target != spine { spine = target }
      pendingPageFraction = herePercent
    }
    lastMode = library.mode
  }

  /// The top line at the top of what shows, in content coordinates.
  fn contentY() -> float {
    var y = scrollAt - scrollTopPad
    if y < 0 { y = 0 }
    if y > scrollHeight { y = scrollHeight }
    return y
  }

  fn contentFraction() -> float {
    if scrollHeight <= 0 { return 0 }
    return contentY() / scrollHeight
  }

  /// How far into its chapter the top line is (0…1). The chapter and its top
  /// are the engine's: the reader keeps no chapter table of its own.
  fn scrollWithin() -> float {
    let y = contentY()
    let index = engine.flowSpineAt(engineId, y)
    if index < 0 { return 0 }
    let chapter = engine.flowChapter(engineId, index)
    if !chapter.ok || chapter.height <= 0 { return 0 }
    var local = y - chapter.top
    if local < 0 { local = 0 }
    if local > chapter.height { local = chapter.height }
    return local / chapter.height
  }

  fn windowBucketOf(y: float) -> int {
    if scrollTile <= 0 { return 0 }
    var content = y - scrollTopPad
    if content < 0 { content = 0 }
    return (content / scrollTile).int()
  }

  /// Opens the column: one call hands the engine the viewport and the type, and
  /// it keeps the chapter tops from then on. Heights are measured lazily — the
  /// total is what the Scroll's content height is — and a chapter that fails to
  /// lay out is height 0 without stopping the ones after it.
  fn showScroll() {
    columnReady = false
    // A new layout while the reader is already in place keeps the same place
    // in the column. Opening, or a switch from pages, names a chapter and how
    // far into it instead.
    let keepingPlace = scrollHeight > 0
    let keptFraction = contentFraction()
    let targetChapter = startChapter
    let targetWithin = startWithin
    let tile = scrollTileHeight()
    let fontScale = library.size / baseSize
    let margins = engine.Margins(top: 0, right: pageMargins.right, bottom: 0, left: pageMargins.left)
    let count = engine.beginScroll(
      engineId, frame.width, frame.height, margins,
      fontScale, library.line, library.letter * library.size, library.word * library.size,
    )
    scrollTile = tile
    scrollTopPad = pageMargins.top
    let total = engine.flowHeight(engineId)
    scrollHeight = if count > 0 && total > 0 { total } else { 0 }
    columnReady = true
    if count < 0 {
      // The engine refused the column (a book it can't lay out, a session it
      // dropped): say so instead of pretending the book is empty.
      error = "排版失败：{engine.lastError()}"
      lastColumn = ""
      announceReady()
      return
    }
    if scrollHeight <= 0 {
      tiles = []
      startChapter = -1
      startWithin = 0
      lastColumn = ""
      announceReady()
      return
    }
    var target = 0.0
    if keepingPlace {
      target = keptFraction * scrollHeight
    } else if targetChapter >= 0 {
      let chapter = engine.flowChapter(engineId, targetChapter)
      if chapter.ok {
        target = chapter.top + targetWithin * chapter.height
      }
    }
    if target < 0 { target = 0 }
    if target > scrollHeight { target = scrollHeight }
    startChapter = -1
    startWithin = 0
    // Laid out, at this type and this size: a paper change from here on is
    // a new picture, not a new column.
    lastColumn = columnKey()
    goToScrollY(scrollTopPad + target)
  }

  /// Puts the Scroll at an absolute y in its own coordinates, and makes the
  /// window there at once. The Scroll itself is moved by `scrollTick`'s task:
  /// state changes can't wait for a layout, and a jump must not tear the
  /// Scroll down and build it again.
  fn goToScrollY(y: float) {
    var target = y
    let min = scrollTopPad
    let max = scrollTopPad + scrollHeight
    if target < min { target = min }
    if target > max { target = max }
    scrollAt = target
    windowBucket = windowBucketOf(target)
    shownPercent = percentAt(target)
    scrollTarget = target
    scrollTick += 1
    rememberScroll()
  }

  /// A band is smaller than the viewport: one screen per bitmap makes every
  /// band boundary a large image upload. 512 DIP keeps each one small, and a
  /// few of them fit around the visible screen — and a band is only a few
  /// milliseconds to draw, so a window fills in quickly.
  fn scrollTileHeight() -> float {
    if frame.width <= 0 { return 400 }
    let cap = 8_000_000.0 / (frame.width * scale * scale)
    let height = if frame.height < 512 { frame.height } else { 512.0 }
    let capped = if height < cap { height } else { cap }
    return if capped < 256 { 256.0 } else { capped }
  }

  /// The windows the column needs around the one showing: one tile of
  /// overscan either side, so a small scroll doesn't ask for new bitmaps.
  /// Bands sit on flow boundaries, not chapter ones: the engine stitches a band
  /// that crosses a chapter, so a seam is never a blank line or a new bitmap.
  fn windowTiles(offset: float) -> [ScrollTile] {
    var out: [ScrollTile] = []
    var content = offset - scrollTopPad
    if content < 0 { content = 0 }
    if content > scrollHeight { content = scrollHeight }
    for band in lib.bands(content, frame.height, scrollTile, scrollHeight, scrollTile * 2) {
      out.push(ScrollTile(
        key: band.key(), y: band.y, top: scrollTopPad + band.y,
        height: band.height, path: "",
      ))
    }
    return out
  }

  /// The reader's place in the column, as the engine's chapter and how far into
  /// it. Saving waits for the scroll to settle: a fling crosses several bands,
  /// and a store write per band is disk work in the middle of the gesture.
  fn rememberScroll() {
    if scrollHeight <= 0 { return }
    let index = engine.flowSpineAt(engineId, contentY())
    if index >= 0 {
      hereChapter = index
      herePercent = scrollWithin()
      placeTick += 1
    }
  }

  fn savePlace() {
    if scrollHeight <= 0 { return }
    let index = engine.flowSpineAt(engineId, contentY())
    if index >= 0 { library.save(book.id, index, scrollWithin()) }
  }

  /// Keeps a bookmark at the exact line at the top, not at a band boundary.
  fn toggleBookmark() {
    touch()
    var chapter = spine
    if library.mode == "scroll" {
      let index = engine.flowSpineAt(engineId, contentY())
      chapter = if index >= 0 { index } else { hereChapter }
    }
    let percent = if library.mode == "scroll" { scrollWithin() } else { herePercent }
    if library.toggleBookmark(book.id, chapter: chapter, percent: percent) {
      snackbar("已加书签")
    } else {
      snackbar("已删除书签")
    }
  }

  /// 长按落点：还没有选区时先选中那里的一个词；已经有选区时，抓住离
  /// 手指近的那一端，让这一端跟到手指下，另一端不动。
  fn beginSelection(x: float, y: float) {
    touch()
    if library.mode != "page" || engineId <= 0 || pages <= 0 { return }
    let loc = engine.hit(engineId, page, x, y)
    if loc.page < 0 { return }
    let line = int(loc.line)
    if selOn {
      // 选区的起点和终点是规范化过的：抓起点就留终点，反之亦然。
      if nearStart(line, int(loc.byte)) {
        selAnchorLine = selEndLine
        selAnchorByte = selEndByte
      } else {
        selAnchorLine = selStartLine
        selAnchorByte = selStartByte
      }
      selFocusLine = line
      selFocusByte = int(loc.byte)
      chrome = false
      updateSelection()
      return
    }
    let word = lib.wordAt(engine.lineText(engineId, line), int(loc.byte))
    selAnchorLine = line
    selAnchorByte = word.start
    selFocusLine = line
    selFocusByte = word.end
    if word.end <= word.start { return }
    // 选字时把顶上的按钮收起来：它们会压在选区和动作条上。
    chrome = false
    updateSelection()
  }

  /// 落点离选区的起点更近吗（起点在文档里更靠前）。
  fn nearStart(line: int, byte: int) -> bool {
    if line < selStartLine { return true }
    if line > selEndLine { return false }
    if selStartLine == selEndLine {
      return (byte - selStartByte).abs() <= (byte - selEndByte).abs()
    }
    let toStart = line - selStartLine
    let toEnd = selEndLine - line
    if toStart != toEnd { return toStart < toEnd }
    return (byte - selStartByte).abs() <= (byte - selEndByte).abs()
  }

  /// 按住拖：远的那一端跟到手指下的字。
  fn extendSelection(x: float, y: float) {
    if !selOn || engineId <= 0 { return }
    let loc = engine.hit(engineId, page, x, y)
    if loc.page < 0 { return }
    selFocusLine = int(loc.line)
    selFocusByte = int(loc.byte)
    updateSelection()
  }

  /// 两端的引擎选区 → 当前页上要画的矩形和要存的位置。
  fn updateSelection() {
    let count = engine.selectLines(engineId, selAnchorLine, selAnchorByte, selFocusLine, selFocusByte)
    if count <= 0 {
      // 焦点还在锚点那个字里：这一帧没有可扩的区间。选区留着，等手指
      // 移出这个字再扩；把它当成「取消」会让一次微小的左右抖动清掉
      // 整个选区。取消只有「取消」按钮和点选区外面两种。
      return
    }
    let start = engine.selectionStart(engineId)
    let end = engine.selectionEnd(engineId)
    selStartLine = int(start.line)
    selStartByte = int(start.byte)
    selEndLine = int(end.line)
    selEndByte = int(end.byte)
    selText = engine.selectionText(engineId)
    var rects: [PageMark] = []
    var i = 0
    for rect in engine.selectionRects(engineId) {
      if rect.page != page { continue }
      rects.push(PageMark(key: "s.{i}", x: rect.x, y: rect.y, w: rect.w, h: rect.h))
      i += 1
    }
    selRects = rects
    selOn = !selText.isEmpty()
  }

  fn finishSelection() {
    if selOn && selText.trim().isEmpty() { clearSelection() }
  }

  fn clearSelection() {
    if !selOn && selText.isEmpty() && selRects.isEmpty() { return }
    selOn = false
    selText = ""
    selRects = []
  }

  /// 这一页上已有笔记的高亮。笔记按章和行号存：排版没变时引擎重新选中
  /// 同一段原文，和存下的引文对得上才画；换了字号或屏幕、行号对不上的，
  /// 宁可不画，也不把高亮画到别的字上。
  fn refreshMarks() {
    if engineId <= 0 || library.mode != "page" || pages <= 0 {
      marks = []
      return
    }
    var next: [PageMark] = []
    for note in library.notesInChapter(book.id, chapter: spine) {
      let count = engine.selectLines(engineId, note.startLine, note.startByte, note.endLine, note.endByte)
      if count <= 0 { continue }
      if engine.selectionText(engineId) != note.quote { continue }
      var i = 0
      for rect in engine.selectionRects(engineId) {
        if rect.page != page { continue }
        next.push(PageMark(key: "m.{note.id}.{i}", x: rect.x, y: rect.y, w: rect.w, h: rect.h))
        i += 1
      }
    }
    marks = next
  }

  /// 现在的选区存成一条笔记（`text` 为空时是一条高亮）。
  fn keepSelection(text: string) {
    if !selOn || engineId <= 0 { return }
    let percent = engine.progress(engineId, selStartLine)
    let _kept = library.addNote(
      book.id, chapter: spine,
      startLine: selStartLine, startByte: selStartByte,
      endLine: selEndLine, endByte: selEndByte,
      percent: percent, quote: selText, text: text,
    )
    clearSelection()
    refreshMarks()
  }

  /// 这一页上要画的矩形：已有笔记的高亮在下，手上的选区在上。它交给
  /// BookPage 自己的图层去画，而不是一个盖在页面上的 Canvas——iOS 上
  /// 那样的画布会把页面的触摸全拦下来。
  fn pageHighlights() -> [bookpage.Highlight] {
    var out: [bookpage.Highlight] = []
    for mark in marks {
      out.push(bookpage.Highlight(x: mark.x, y: mark.y, w: mark.w, h: mark.h, color: noteFill))
    }
    for mark in selRects {
      out.push(bookpage.Highlight(x: mark.x, y: mark.y, w: mark.w, h: mark.h, color: selectionFill))
    }
    return out
  }

  /// 这个点落在选区里吗：拖完手指常落在自己刚选的那几行上，那一下
  /// 不该被当成「取消」。每边留一点余量，和高亮的边对齐。
  fn pointInSelection(x: float, y: float) -> bool {
    for mark in selRects {
      if x >= mark.x - 6 && x <= mark.x + mark.w + 6 && y >= mark.y - 6 && y <= mark.y + mark.h + 6 {
        return true
      }
    }
    return false
  }

  fn percentAt(y: float) -> int {
    if scrollHeight <= 0 { return 0 }
    var content = y - scrollTopPad
    if content < 0 { content = 0 }
    if content > scrollHeight { content = scrollHeight }
    let p = engine.flowProgress(engineId, content)
    if p <= 0 { return 0 }
    if p >= 1 { return 100 }
    return (p * 100).int()
  }

  // The bands around the reader. One band is a few milliseconds now that the
  // engine paints only what's in it, so a window is filled band by band: what
  // is already on disk shows before anything new is drawn, and each new band
  // shows as soon as it lands, nearest the reader first. A fling then fills in
  // behind the finger instead of blanking the page until the whole window is
  // ready.
  task("{windowBucket}:{columnReady}:{scrollHeight.int()}:{scrollTile.int()}:{frame.width.int()}:{frame.height.int()}:{fileTag()}") {
    if library.mode != "scroll" || !columnReady || scrollHeight <= 0 { return }

    // Now and then, while the reader moves: one session writes a band every
    // 512 DIP it travels, and waiting for the next open to sweep them would
    // let a long read grow with no bound.
    if windowBucket % 64 == 0 {
      await spawn { prunePages(pagesBudget) }
    }

    let id = engineId
    let bookId = book.id
    let viewHeight = frame.height
    let right = pageMargins.right
    let left = pageMargins.left
    let scaleNow = scale
    let ink = lib.rgbaOf(palette.ink)
    let paper = lib.rgbaOf(palette.paper)
    let tag = fileTag()

    fn fileOf(tile: ScrollTile) -> string {
      return slicePath(
        book: bookId, y: tile.y, height: tile.height,
        width: frame.width, viewHeight: viewHeight,
        insetLeft: left, insetRight: right,
        scale: scaleNow, tag: tag,
      )
    }

    // What the column already has — the last window's bands, or an earlier
    // pass over this part of the book — is shown at once, before any drawing.
    // A band's file name carries everything that went into it: the type, the
    // margins, and the paper. So a band is only the same picture at the very
    // same name; a band kept under another paper would show the old paper on
    // the new screen until the reader scrolled it off.
    let old = tiles
    var next: [ScrollTile] = []
    for tile in windowTiles(scrollAt) {
      let file = fileOf(tile)
      var path = ""
      if old.any(seen => seen.path == file) {
        // The last window's band, unchanged: no stat needed.
        path = file
      } else if fs.exists(file) {
        // An earlier pass over this part of the book, under this same paper.
        path = file
      }
      next.push(ScrollTile(key: tile.key, y: tile.y, top: tile.top, height: tile.height, path: path))
    }
    // Nothing new on screen: don't hand the view tree the same list again.
    var changed = next.count() != old.count()
    if !changed {
      for i in 0..<next.count() {
        if next[i].key != old[i].key || next[i].path != old[i].path {
          changed = true
          break
        }
      }
    }
    if changed { tiles = next }
    if next.any(t => !t.path.isEmpty()) { announceReady() }

    // Nearest the reader first: the visible screen, then the room around it.
    let content = contentY()
    var order: [int] = []
    for i in 0..<next.count() { order.push(i) }
    order = order.sorted(key: i => (next[i].y - content).abs())

    for i in order {
      if !next[i].path.isEmpty() { continue }
      let tile = next[i]
      let file = fileOf(tile)
      let _drawn = await spawn {
        return engine.flowBand(
          id: id, y: tile.y, height: tile.height, scale: scaleNow,
          ink: ink, paper: paper, bold: false, path: file,
        )
      }
      // The paper can change while a band is being drawn. That band belongs
      // to the screen the reader has already left: the task that follows the
      // new paper draws it again, so this pass must not put it back.
      if tag != fileTag() { return }
      if fs.exists(file) {
        next[i] = ScrollTile(key: tile.key, y: tile.y, top: tile.top, height: tile.height, path: file)
        tiles = next
        announceReady()
      }
    }
  }

  // A fling crosses tiles. Save once it has been quiet for a moment; the
  // tick restarts this task on every tile, so only the last one writes.
  task("{placeTick}:{columnReady}:{scrollHeight.int()}") {
    if library.mode != "scroll" || !columnReady || placeTick == 0 { return }
    await sleep(250ms)
    savePlace()
  }

  // The Scroll is moved here, after it has its new content height: a jump is
  // one scrollTo, never a teardown and a rebuild.
  task("{scrollTick}:{columnReady}:{frame.width.int()}:{frame.height.int()}") {
    if library.mode != "scroll" || !columnReady || scrollTarget < 0 { return }
    let target = scrollTarget
    await sleep(30ms)
    scrollList.scrollTo(0, target, animated: false)
    await sleep(16ms)
    if scrollTarget == target { scrollTarget = -1.0 }
  }

  /// How this page was laid out, in its file name: a page is a different
  /// file as soon as the type changes, so the native view shows the new one
  /// instead of the one it already has at the same path. The paper is in
  /// `fileTag` on top of this: it changes the picture, never the layout.
  fn layoutTag() -> string {
    let size = (library.size * 10).int()
    let line = (library.line * 10).int()
    let margin = (library.margins * 100).int()
    let letter = (library.letter * 1000).int()
    let word = (library.word * 1000).int()
    return "s{size}-l{line}-m{margin}-k{letter}-w{word}"
  }

  /// The paper a page was drawn on, as its file name says it: the same lines on
  /// another paper are another file, and must be.
  fn fileTag() -> string = "{layoutTag()}-{library.theme}"

  /// The column a layout produced: what a new layout would give the same
  /// answer to. The paper is not in it — it neither moves a line nor changes
  /// a chapter's height.
  fn columnKey() -> string = "{layoutTag()}:{frame.width.int()}x{frame.height.int()}"

  /// Opens the engine once, and the font it measures with.
  async fn openBook() throws {
    if opened { return }
    opened = true
    let file = try await bookFileOf(book)
    if !fs.exists(file) {
      error = "找不到《{book.title}》的文件"
      announceReady()
      return
    }
    let id = engine.open(file)
    if id <= 0 {
      error = "打不开这本书：{engine.lastError()}"
      announceReady()
      return
    }
    engineId = id
    let now = time.now().unix()
    if sessionAt == 0 {
      sessionAt = now
      activeAt = now
      countedTo = now
    }
    // The app's own face first: it's what the pages are designed around, and
    // the platform's fonts aren't readable as files everywhere (iOS keeps
    // several in the dyld cache).
    if engine.registerFontBytes(id, data: bundledFace) {
      fontName = "Noto Serif SC"
    } else {
      let font = fontFile()
      fontName = lib.fileName(font)
      if font.isEmpty() {
        warning = "找不到可用的字体：正文画不出来"
      } else if !engine.registerFont(id, path: font) {
        warning = "字体打不开：{lib.fileName(font)}"
      }
    }
    let named = engine.title(id)
    if !named.isEmpty() { shownTitle = named }
    let count = engine.chapterCount(id)
    if count > 0 && spine >= count { spine = 0 }
    // Where the book was left: a chapter and how far into it. Both modes
    // take that as their place.
    startChapter = if saved.chapter > 0 { saved.chapter } else { 0 }
    startWithin = if saved.percent < 0 { 0 } else if saved.percent > 1 { 1 } else { saved.percent }
    if count > 0 && startChapter >= count { startChapter = count - 1 }
    if library.mode == "page" { pendingPageFraction = startWithin }
    try await spawn { try fs.mkdirAll(pagesDir()) }
    // Off the main thread, once a book opens: the cache is for the reading that
    // is about to happen, not for everything ever read.
    await spawn { prunePages(pagesBudget) }
    show()
  }

  // One pass for every change: the chapter, the page, the view's size, the
  // size of the type, the paper, the reading mode. The engine's layout is
  // idempotent, so this is only as expensive as the page it produces.
  task("{spine}:{page}:{frame.width}:{frame.height}:{library.size}:{library.line}:{library.margins}:{library.letter}:{library.word}:{library.theme}:{library.mode}") {
    if frame.width <= 32 { return }
    // A new paper is another picture of the column the reader is in, not
    // another layout: the band task follows the new tag by itself and the
    // Scroll stays where it is. Laying the whole book out again for a colour
    // is the one thing a theme switch must never cost.
    if library.mode == "scroll" && lastMode == "scroll" && columnKey() == lastColumn {
      return
    }
    // A slider changes several times a second. In scroll mode every change
    // means laying out every chapter; in page mode it means a whole page
    // rasterized to a file on the main thread. Wait for the hand to stop:
    // the next change cancels this run, and the last one lays out once.
    let tag = layoutTag()
    let retyped = !lastTag.isEmpty() && lastTag != tag
    lastTag = tag
    if library.mode == "scroll" && columnReady {
      await sleep(180ms)
    } else if retyped {
      await sleep(150ms)
    }
    try? await openBook()
    show()
  }

  // After a chapter or a mode change, put the Scroll where the reader was.

  fn next() {
    touch()
    clearSelection()
    let place = lib.forward(spine, page, pages, engine.chapterCount(engineId))
    spine = place.spine
    page = place.page
  }

  fn back() {
    touch()
    clearSelection()
    // A turn out of a chapter's first page lands on the last page of the one
    // before it (-1, resolved by show() once that chapter is laid out).
    let place = lib.backward(spine, page, engine.chapterCount(engineId))
    spine = place.spine
    page = place.page
  }

  /// A table of contents row is a chapter's start. In scroll mode the column
  /// already holds every chapter: this is one scrollTo, never a new layout.
  fn jump(index: int) {
    touch()
    clearSelection()
    let count = engine.chapterCount(engineId)
    if index < 0 || index >= count { return }
    if library.mode == "scroll" {
      // The engine owns the chapter's top, and asking for one measures the
      // chapters before it: no table of our own to look it up in.
      if columnReady && scrollHeight > 0 {
        let chapter = engine.flowChapter(engineId, index)
        if chapter.ok {
          goToScrollY(scrollTopPad + chapter.top)
          return
        }
      }
      // Not laid out yet: the next layout takes this as its place.
      startChapter = index
      startWithin = 0
      return
    }
    spine = index
    page = 0
  }

  /// A bookmark's place: a chapter, and how far into it. A table of contents
  /// row is a chapter's start; this is anywhere in it.
  fn goTo(chapter: int, percent: float) {
    touch()
    clearSelection()
    let count = engine.chapterCount(engineId)
    if count <= 0 || chapter < 0 || chapter >= count { return }
    var at = percent
    if at < 0 { at = 0 }
    if at > 1 { at = 1 }
    if library.mode == "scroll" {
      if columnReady && scrollHeight > 0 {
        var target = at * scrollHeight
        let ch = engine.flowChapter(engineId, chapter)
        if ch.ok { target = ch.top + at * ch.height }
        goToScrollY(scrollTopPad + target)
      } else {
        startChapter = chapter
        startWithin = at
      }
      return
    }
    let same = chapter == spine
    spine = chapter
    page = 0
    // Page mode: the fraction is within this chapter, so it is the page.
    pendingPageFraction = at
    if same { show() }
  }

  /// A link on the page: a URL goes to the app that takes it, a place in the
  /// book to its chapter — and, for a footnote, to its anchor in that chapter.
  fn follow(href: string) {
    touch()
    clearSelection()
    if engineId <= 0 || href.isEmpty() { return }
    let target = engine.resolveLink(engineId, href)
    if !target.ok { return }
    if target.external {
      device.openURL(href)
      return
    }
    let count = engine.chapterCount(engineId)
    if target.spine < 0 || target.spine >= count { return }
    if library.mode == "scroll" {
      goLinkScroll(target.spine, target.fragment)
    } else {
      goLinkPage(target.spine, target.fragment)
    }
  }

  /// A chapter and an anchor in page mode: the layout that follows turns the
  /// anchor into its line, and the line into its page.
  fn goLinkPage(chapter: int, fragment: string) {
    spine = chapter
    page = 0
    pendingPageFraction = 0
    pendingFragment = fragment
    show()
  }

  /// A chapter and an anchor in scroll mode: the column already holds them,
  /// so this is a scrollTo, not a new layout.
  fn goLinkScroll(chapter: int, fragment: string) {
    if columnReady && scrollHeight > 0 {
      var y = -1.0
      if !fragment.isEmpty() { y = engine.flowAnchorY(engineId, chapter, fragment) }
      if y < 0 {
        let ch = engine.flowChapter(engineId, chapter)
        y = if ch.ok { ch.top } else { 0.0 }
      }
      goToScrollY(scrollTopPad + y)
      return
    }
    startChapter = chapter
    startWithin = 0
  }

  /// The link at a point of the book's flow. A chapter's links are in its own
  /// layout, so the tap is asked for there: flowHit focuses that chapter (the
  /// order matters, linkAt reads the last layout), and chapter.top makes the
  /// flow y the chapter's own.
  fn linkAtFlow(x: float, flowY: float) -> string {
    if engineId <= 0 { return "" }
    let spine = engine.flowSpineAt(engineId, flowY)
    if spine < 0 { return "" }
    let chapter = engine.flowChapter(engineId, spine)
    if !chapter.ok { return "" }
    let where = engine.flowHit(engineId, x, flowY)
    if where.spine < 0 { return "" }
    return engine.linkAt(engineId, 0, x, flowY - chapter.top)
  }

  View {
    background: palette.paper
    grow: 1
    on layout(f) { frame = f }

    if !error.isEmpty() {
      Column {
        grow: 1
        justify: .center
        align: .center
        padding: 32
        Text(error) { color: palette.muted; textAlign: .center }
      }
    } else if library.mode == "scroll" {
      if !columnReady {
        Column {
          grow: 1
          justify: .center
          align: .center
          Text("排版中…") { color: palette.muted }
        }
      } else if scrollHeight <= 0 {
        Column {
          grow: 1
          justify: .center
          align: .center
          Text("本书没有内容") { color: palette.muted }
        }
      } else {
        // The whole book is one real Scroll. Its content is the column's
        // height; the engine's tiles are windows placed in it, not rows of a
        // list. A jump is just a scrollTo, so a table of contents row and a
        // bookmark land where they say.
        Scroll {
          ref: scrollList
          grow: 1
          background: palette.paper
          on scroll(x, y) {
            // Where the reader is: written every frame, as a var, so a fling
            // rebuilds nothing. A bookmark and the saved place read it.
            scrollAt = y
            // The native Scroll moves the paper; the app only needs a new
            // window when the reader crosses a tile. The capsule gets its
            // own, much cheaper number.
            let bucket = windowBucketOf(y)
            if bucket != windowBucket {
              windowBucket = bucket
              // Once a band, not once a frame: a session is measured in
              // minutes, and this is the first write that rebuilds anything.
              touch()
              rememberScroll()
            }
            let p = percentAt(y)
            if p != shownPercent { shownPercent = p }
          }
          View {
            height: scrollTopPad + scrollHeight + pageMargins.bottom
            background: palette.paper
            for tile in tiles key tile.key {
              View {
                absolute: true
                top: tile.top
                left: 0
                width: frame.width
                height: tile.height
                background: palette.paper
                if !tile.path.isEmpty() {
                  bookpage.BookPage(path: tile.path) {
                    grow: 1
                    on press(x, y) {
                      touch()
                      // The band's y is the book's flow: a link is found in
                      // the chapter the tap fell in, at its own coordinates.
                      let href = linkAtFlow(x, tile.y + y)
                      if !href.isEmpty() {
                        follow(href)
                      } else {
                        chrome = !chrome
                      }
                    }
                  }
                }
              }
            }
            Text("全书完") {
              absolute: true
              top: scrollTopPad + scrollHeight + 20
              left: 24
              font: .footnote
              color: palette.muted
            }
          }
        }
      }
    } else if pagePath.isEmpty() {
      Column {
        grow: 1
        justify: .center
        align: .center
        Text("排版中…") { color: palette.muted }
      }
    } else {
      // The page covers the screen and takes the tap: its left third goes
      // back, its right third forward, its middle puts the chrome away.
      bookpage.BookPage(path: pagePath) {
        grow: 1
        // 高亮画在页面自己的图层里，不挡触摸；选区在时，拖动直接调整它。
        highlights: pageHighlights()
        selecting: selOn
        scale: scale
        on press(x, y) {
          touch()
          // 点选区里面不清它：拖完手一松常常落在这里。点外面才是取消。
          if selOn {
            if pointInSelection(x, y) { return }
            clearSelection()
            return
          }
          // A link is a box on the page: a tap in it goes where it says,
          // rather than turning the page under it.
          let href = engine.linkAt(engineId, page, x, y)
          if !href.isEmpty() {
            follow(href)
          } else {
            let width = if frame.width > 0 { frame.width } else { 320.0 }
            if x < width / 3 {
              back()
            } else if x > width * 2 / 3 {
              next()
            } else {
              chrome = !chrome
            }
          }
          let _where = y
        }
        on hold(x, y) { beginSelection(x, y) }
        on drag(x, y) { extendSelection(x, y) }
        on release { finishSelection() }
      }
    }

    // 选区定下来后的一排动作：复制、高亮、写笔记，或者不要这个选区。
    if selOn {
      Row {
        absolute: true
        top: barTop
        left: env.safeLeft + chromeMargin
        right: env.safeRight + chromeMargin
        justify: .center
        gap: 6
        Button("复制") {
          variant: .glass
          font: Font(size: 13)
          on press {
            device.copy(selText)
            snackbar("已复制")
          }
        }
        Button("高亮") {
          variant: .glass
          font: Font(size: 13)
          on press {
            keepSelection("")
            snackbar("已高亮")
          }
        }
        Button("笔记") {
          variant: .glass
          font: Font(size: 13)
          on press {
            present(NoteEditor(quote: selText, draft: "", existing: false) {
              on save(text) {
                keepSelection(text)
                snackbar("已保存笔记")
              }
            })
          }
        }
        Button("") {
          icon: Icons.close
          variant: .glass
          label: "取消"
          tooltip: "取消"
          on press { clearSelection() }
        }
      }
    }

    // Three buttons, the platform's own, in a row over the page: back, the
    // type, the contents. Nothing around them.
    if chrome {
      Row {
        absolute: true
        top: env.safeTop + 8
        left: env.safeLeft + chromeMargin
        right: env.safeRight + chromeMargin
        gap: 4
        Button("") {
          icon: Icons.back
          variant: .glass
          label: "返回"
          on press { emit close }
        }
        // 返回 on the left; the other two at the right, where a reader's are.
        View { grow: 1 }
        Button("") {
          icon: Icons.typography
          variant: .glass
          label: "排版"
          on press { present(Appearance(typeface: fontName)) }
        }
        Button("") {
          icon: if marked != none { Icons.bookmarkFilled } else { Icons.bookmark }
          variant: .glass
          label: "书签"
          tooltip: "书签"
          on press { toggleBookmark() }
        }
        Button("") {
          icon: Icons.contents
          variant: .glass
          label: "目录"
          tooltip: "目录"
          on press {
            present(Contents(engine.contents(engineId), currentChapter, book.id) {
              on pick(i) {
                let items = engine.contents(engineId)
                if i >= 0 && i < items.count() { jump(items[i].spine) }
              }
              on goBookmark(chapter, percent) { goTo(chapter, percent) }
              on dropBookmark(id) { library.removeBookmark(id) }
              on dropNote(id) {
                library.removeNote(id)
                refreshMarks()
              }
            })
          }
        }
      }

      // Where the reader is: a small glass capsule in the middle, the same
      // liquid glass as the buttons above. A Button is the only element with
      // that glass variant, so this one is a label-shaped button with no
      // action.
      Row {
        absolute: true
        bottom: env.safeBottom + chromeMargin
        left: 0
        right: 0
        justify: .center
        Button(if library.mode == "scroll" { "{shownPercent}%" } else { "{page + 1} / {pages}" }) {
          variant: .glass
          font: Font(size: 11)
          color: palette.muted
          padding: [3, 9]
          radius: 11
          a11yHidden: true
        }
      }
    }

    // A book with no font still pages, with nothing on them: say why over
    // the page, rather than showing a blank one.
    if !warning.isEmpty() {
      Column {
        grow: 1
        justify: .start
        // 页面铺到状态栏底下：这条提示也得让开安全区，不然被刘海和圆角吃掉。
        padding: [env.safeTop, env.safeLeft + chromeMargin, 0, env.safeRight + chromeMargin]
        Text(warning) {
          font: .footnote
          color: palette.ink
          padding: [8, 12]
          background: palette.rule
          textAlign: .center
        }
      }
    }
  }
}
