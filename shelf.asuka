// The shelf: one cell a book, the way Quire's library shows it — covers,
// titles, and where each one was left. The display menu at the top right
// picks a grid or a list, and the order the cells are in.

import platform/dialog
import std/fs

import ./engine
import ./lib
import ./sources

/// Cover colors from Quire's icon sheet: ink, cloth, dusk.
let spines = [#2b2b2f, #3d5143, #4a3f63, #7a5b33, #2c5560]

// The page is drawn on one left keyline (lib.pageKeyline): the status bar's
// time, the title and every cover start there. A list row's text takes the
// second line, one cover and one gap to the right, so the eye has two stable
// axes.
//
// The grid's gap is one number: the wrapping Row's, and the one the page's
// measure counts cells with. They must agree, so neither is written twice.
let shelfGridGap: float = 22
// As many covers of this width as a row has room for; a cell wider than
// shelfTileMax takes another column instead of stretching one cover across
// the row (a narrow window can still end with narrower ones).
let shelfTileCover: float = 150
let shelfTileMax: float = 200
// 封面在格子里留一点边：整行仍然均分，但封面不顶满格子，整页轻一些。
let shelfTileFit: float = 0.92
// 网格里放封面的槽：封面按自己的比例站在槽底，槽高固定，行高才不会
// 被一张特别高的封面撑开，进度行也始终在同一条线上。
let shelfCoverSlot: float = 0.62
let shelfRowCover: float = 44
let shelfRowGap: float = 12

/// A title's cover color, the same every launch.
fn spine(title: string) -> Color {
  var h = 0
  for c in title {
    h = (h * 31 + c.code()) % 9973
  }
  return spines[h % spines.count()]
}

/// The list's line under the title: who wrote it, or why there is no file
/// here. (A grid tile leaves the author out: its title is the cover.)
fn authorLine(book: lib.Book) -> string {
  if !book.remote && !book.path.isEmpty() && !fs.exists(book.path) {
    return if book.hash.isEmpty() { "文件找不到了" } else { "未备份到云端" }
  }
  return book.author
}

component Cover(book: lib.Book) {
  use library: Library

  /// 封面的宽。书脊上的书名按它缩放：40pt 的列表封面和 150pt 的网格封面
  /// 不能共用一套字号，否则小封面里的字会挤出封面再被裁掉。
  prop size = shelfTileCover
  /// 网格里让图片按自己的比例（长宽比）显示；列表仍用统一的小框。
  prop natural = false

  // The book's row may predate covers: ask the engine once, then keep the
  // file next to the app's data. Text books have no cover and keep the spine.
  // A cloud-only book has no file to ask the engine about yet.
  state cover = if !book.cover.isEmpty() && fs.exists(book.cover) { book.cover } else { "" }

  task(book.id, book.remote, book.cover, library.assetsTick) {
    if !book.cover.isEmpty() && fs.exists(book.cover) {
      cover = book.cover
      return
    }
    cover = ""
    if book.remote { return }
    if book.path.isEmpty() || !book.path.lower().hasSuffix(".epub") { return }
    let path = coverPath(book.id)
    if !fs.exists(path) {
      let id = engine.open(book.path)
      if !engine.isOpen(id) { return }
      let wrote = engine.writeCover(id, path: path)
      if !wrote { return }
    }
    cover = path
    library.setCover(book.id, coverName(book.id))
  }

  let titleSize = max(9, min(17, size * 0.11))
  let pad = max(3, min(12, size * 0.07))
  // 书名在封面内换行，最多三行：长书名因此是省略，不是横着或竖着
  // 溢出封面。
  let innerWidth = size - 2 * pad

  if natural && !cover.isEmpty() && fs.exists(cover) {
    // 只定宽，高度交给图片的原始比例；外面那个固定高的槽负责让行整齐。
    Image(source: cover) {
      width: size
      shrink: 0
      radius: 8
      clip: true
      background: spine(book.title)
      shadow: Shadow(color: #0000002e, radius: 6, y: 3)
    }
  } else {
    View {
      width: size
      // 封面是固定尺寸：标题再长也不该把它挤窄。
      shrink: 0
      aspectRatio: 0.68
      radius: 8
      clip: true
      background: spine(book.title)
      // 书站在纸上，给它一点影子；iOS 上裁切会把影子一起裁掉，宿主自己
      // 把子视图裁进另一层再留影子，这里只写一句。
      shadow: Shadow(color: #0000002e, radius: 6, y: 3)
      if !cover.isEmpty() && fs.exists(cover) {
        Image(source: cover) {
          grow: 1
          mode: .fill
        }
      } else {
        Column {
          grow: 1
          justify: .center
          align: .center
          padding: pad
          Text(book.title) {
            width: innerWidth
            font: Font(size: titleSize)
            color: #f4efe6
            lines: 3
            textAlign: .center
          }
        }
      }
    }
  }
}

/// The cell itself: a cover, and how far in the reader is. The author is the
/// list's to show: a grid of covers reads as the covers themselves.
component BookTile(book: lib.Book, reading: lib.Reading) {
  prop showCloud = false
  /// 一格占的宽：封面与它同宽，格子因此正好填满一行，封面贴在两边的
  /// keyline 上。
  prop cellWidth = shelfTileCover
  /// 长按时弹出的菜单。只有封面接住它，槽里的空白和下面的进度行不接。
  prop menu: [Action] = []
  event open

  // 文件不在本机：云端有就是「按需下载」，没有才是真的找不到。
  let missing = !book.remote && !book.path.isEmpty() && !fs.exists(book.path)
  // 封面比格子窄一点，左右各留出一点白；下面那一行也跟着封面收，
  // 否则进度条会比封面宽，看着像错位。
  let coverWidth = cellWidth * shelfTileFit
  let coverSlotHeight = coverWidth / shelfCoverSlot

  Column {
    width: cellWidth
    gap: 6
    align: .center
    // 固定高的槽：每张封面按自己的比例站在槽底，行高由槽决定，不跟着
    // 封面长短变。
    Column {
      width: cellWidth
      height: coverSlotHeight
      justify: .end
      align: .center
      Menu {
        longPress: true
        actions: menu
        width: coverWidth
        View {
          width: coverWidth
          on press { emit open }
          Cover(book) {
            size: coverWidth
            natural: true
          }
        }
      }
    }
    // 网格只给封面和进度：书名在封面上，作者留给列表。文件不在本机时
    // 这一行改成说哪一种不在。云端状态贴在它的右侧。
    Row {
      width: coverWidth
      gap: 5
      align: .center
      Text(if missing {
        if book.hash.isEmpty() { "文件找不到了" } else { "未备份到云端" }
      } else {
        reading.label()
      }) {
        font: .caption
        color: if missing { .red } else { .secondaryLabel }
        lines: 1
        shrink: 1
      }
      if book.sourceId.isEmpty() && showCloud {
        Symbol(if book.remote || book.backedUp { Icons.cloud } else { Icons.cloudOff }) {
          font: .caption2
          color: if book.remote || book.backedUp { .secondaryLabel } else { .tertiaryLabel }
        }
      }
      if !book.sourceId.isEmpty() {
        Symbol(Icons.globe) {
          font: .caption2
          color: .secondaryLabel
          label: "在线书"
        }
      }
    }
  }
}

/// The same book as a list row: a small cover, its title, then the author and
/// the place, each on its own line.
component BookRow(book: lib.Book, reading: lib.Reading) {
  prop showCloud = false
  event open

  let missing = !book.remote && !book.path.isEmpty() && !fs.exists(book.path)

  Row {
    gap: shelfRowGap
    align: .center
    // keyline 放在行里，不放 List 上：滚动条因此贴着屏幕边，不跟着
    // 内容一起缩进。
    padding: [9, lib.pageKeyline]
    on press { emit open }
    Cover(book) { size: shelfRowCover }
    Column {
      grow: 1
      // 标题太长时在这一列里截断，不回头去挤封面。basis: 0 让这列
      // 从零开始拿剩下的宽，不再用标题的固有宽度参加分配。
      shrink: 1
      basis: 0
      minWidth: 0
      gap: 6
      // 书名与作者是一组，贴紧；进度单独在下面，隔得开一点。
      Column {
        gap: 2
        Text(book.title) {
          font: .body
          lines: 2
        }
        Text(authorLine(book)) {
          font: .caption
          color: if missing { .red } else { .secondaryLabel }
          lines: 1
        }
      }
      Text(reading.label()) {
        font: .caption
        color: .secondaryLabel
        lines: 1
      }
    }
    if book.sourceId.isEmpty() && showCloud {
      Symbol(if book.remote || book.backedUp { Icons.cloud } else { Icons.cloudOff }) {
        font: .caption2
        color: if book.remote || book.backedUp { .secondaryLabel } else { .tertiaryLabel }
      }
    }
    if !book.sourceId.isEmpty() {
      Symbol(Icons.globe) {
        font: .caption2
        color: .secondaryLabel
        label: "在线书"
      }
    }
  }
}

/// A book on the shelf: long press one for its actions, a sample's as much as
/// an imported one's. The menu is the same in either layout; only the body
/// under it changes.
component BookCell(book: lib.Book, reading: lib.Reading) {
  prop pinned = false
  prop showCloud = false
  prop mode = "grid"
  prop cellWidth = shelfTileCover
  event open
  event delete
  event backup
  event pin
  event evict
  event record

  // 云端与存储直接排在菜单里，不再收进二级菜单：长按一次就能点到，
  // 折起来还得再探一层。只列出这一刻有意义的：本机独有的书先备份；
  // 已经在云端的书才谈固定和「只留云端」；只在云端的书没有可做的。
  let cloudItems: [Action] = if !book.sourceId.isEmpty() {
    []
  } else if !book.backedUp {
    [.button(title: "备份到云端", icon: Icons.upload, run: () => { emit backup })]
  } else if book.remote {
    []
  } else if pinned {
    [
      .button(title: "取消固定", icon: Icons.pin, run: () => { emit pin }),
      .button(title: "仅保留在云端", icon: Icons.cloud, run: () => { emit evict }),
    ]
  } else {
    [
      .button(title: "固定在本机", icon: Icons.pin, run: () => { emit pin }),
      .button(title: "仅保留在云端", icon: Icons.cloud, run: () => { emit evict }),
    ]
  }

  let menuActions: [Action] = if book.backedUp && book.remote {
    [
      .button(title: "阅读记录", icon: Icons.statistics, run: () => { emit record }),
      .button(title: "删除", icon: Icons.trash, role: .destructive, run: () => { emit delete }),
    ]
  } else {
    let first: [Action] = [
      .button(title: "阅读记录", icon: Icons.statistics, run: () => { emit record }),
    ]
    let last: [Action] = [
      .button(title: "删除", icon: Icons.trash, role: .destructive, run: () => { emit delete }),
    ]
    first + cloudItems + last
  }

  if mode == "list" {
    // 列表里整行都是书，长按整行；网格只让封面接住长按。
    Menu {
      longPress: true
      actions: menuActions
      BookRow(book, reading) {
        showCloud: showCloud
        on open { emit open }
      }
    }
  } else {
    BookTile(book, reading) {
      showCloud: showCloud
      cellWidth: cellWidth
      menu: menuActions
      on open { emit open }
    }
  }
}

/// One row of the shelf with its own actions: the shelf can be drawn as a grid
/// or a list without the screen repeating the same handlers twice.
component ShelfBook(book: lib.Book, reading: lib.Reading) {
  use library: Library

  prop mode = "grid"
  prop showCloud = false
  prop cellWidth = shelfTileCover
  event open

  BookCell(book, reading) {
    pinned: library.pinned.contains(book.id)
    showCloud: showCloud
    mode: mode
    cellWidth: cellWidth
    on open { emit open }
    on backup {
      if book.remote {
        snackbar("先打开这本书，下载到本机后再备份")
      } else {
        do {
          snackbar(try await library.backupBook(book))
        } catch e {
          snackbar(lib.plain(e.message))
        }
      }
    }
    on pin {
      library.togglePin(book.id)
      snackbar(if library.pinned.contains(book.id) { "已固定《{book.title}》" } else { "已取消固定《{book.title}》" })
    }
    on evict {
      if book.remote {
        snackbar("《{book.title}》已经只在云端")
      } else if library.removeLocalCopy(book.id) {
        snackbar("已从本机移除《{book.title}》，云端仍保留")
      } else if library.pinned.contains(book.id) {
        snackbar("这本书已固定在本机，先取消固定")
      } else {
        snackbar("先备份到云端，才能只保留云端副本")
      }
    }
    on record {
      present(BookRecordSheet(book))
    }
    on delete {
      // 等菜单这次动作走完再删：网格按行分块，删一本会让后面的书
      // 换到另一行；在菜单回调里直接删，会把正在回调的那一格拆掉。
      await sleep(1ms)
      library.forget(book.id)
      snackbar("已删除《{book.title}》")
    }
  }
}

/// 书架空了：两条能立刻把书放上来的路。这里只放大两个动作，不再写
/// 一段说明；同步按钮的文案由云端是否配置好决定。
component EmptyShelf {
  prop configured = false
  event chooseFile
  event cloud

  Column {
    grow: 1
    justify: .center
    align: .center
    padding: [24, 24, 56, 24]
    gap: 22

    // 一排立着的书，颜色来自封面用的那组。书下面是一条书架线，
    // 让空状态仍然是「书架」，不是一张通用的提示卡。
    Column {
      gap: 0
      Row {
        gap: 6
        align: .end
        View { width: 20; height: 50; radius: 3; background: spines[1] }
        View { width: 24; height: 62; radius: 3; background: spines[2] }
        View { width: 18; height: 44; radius: 3; background: spines[3] }
        View { width: 22; height: 56; radius: 3; background: spines[4] }
      }
      View {
        width: 132
        height: 3
        radius: 2
        background: .separator
      }
    }

    Column {
      gap: 6
      align: .center
      Text("书架还是空的") {
        font: .title2.bold()
      }
      Text("导入一本 .txt 或 .epub；如果云端已经有书架，连接后也能同步过来。") {
        font: .footnote
        color: .secondaryLabel
        textAlign: .center
        lines: 3
      }
    }

    Row {
      gap: 10
      Button("导入书籍") {
        icon: Icons.add
        variant: .tinted
        on press { emit chooseFile }
      }
      Button(if configured { "同步云端" } else { "配置云端" }) {
        icon: Icons.cloud
        variant: .bordered
        on press { emit cloud }
      }
    }
  }
}

/// One option of 显示与排序: the chosen one keeps a check at its end.
component DisplayOption(title: string, selected: bool) {
  event choose

  Row {
    gap: 12
    align: .center
    padding: [12, 4]
    on press { emit choose }
    Text(title) {
      font: .body
      grow: 1
    }
    if selected {
      Symbol(Icons.checkmark) {
        font: .body
        color: .accent
      }
    }
  }
}

/// 显示与排序 on Linux: the platform's own menu can't be a toolbar menu here
/// (it stops opening once a checked item changes, as the bar re-packs its
/// buttons), so Linux gets this page instead. The other platforms open the
/// system's menu from the bar button.
component ShelfDisplay {
  use library: Library
  let env = environment()

  Column {
    gap: 16
    padding: lib.sheetPad(env, top: 22, bottom: 30, side: 22)

    Row {
      gap: 8
      align: .center
      Text("显示与排序") {
        font: .title3
        grow: 1
      }
      Button("") {
        icon: Icons.close
        variant: .glass
        on press { dismiss() }
      }
    }

    Text("显示") { font: .headline }
    Column {
      gap: 0
      DisplayOption("网格", library.shelfLayout == "grid") {
        on choose { library.shelfLayout = "grid" }
      }
      DisplayOption("列表", library.shelfLayout == "list") {
        on choose { library.shelfLayout = "list" }
      }
    }

    Text("排序") { font: .headline }
    Column {
      gap: 0
      DisplayOption("最近阅读", library.shelfSort == "recent") {
        on choose { library.shelfSort = "recent" }
      }
      DisplayOption("书名", library.shelfSort == "title") {
        on choose { library.shelfSort = "title" }
      }
      DisplayOption("作者名", library.shelfSort == "author") {
        on choose { library.shelfSort = "author" }
      }
      DisplayOption("手动", library.shelfSort == "manual") {
        on choose { library.shelfSort = "manual" }
      }
      Text("手动：按书架上原来的顺序") {
        font: .caption
        color: .secondaryLabel
        padding: [2, 4]
      }
    }
  }
}

screen Shelf {
  use library: Library
  /// 在线书的书源列表：单独挂载书架（测试、或还没 provide 源）时没有。
  use allSources: sources.Sources?

  /// A book was chosen: the app opens the reader over the shelf.
  event open(book: lib.Book)

  title: "书架"

  // 同步 is a state of this shelf, not a feature buried in settings: the
  // cloud says whether the shelf has a copy in the cloud, and tapping it
  // opens the page where the account and the folder are.
  let syncFailed = library.syncMessage.hasPrefix("同步失败")
  // Symbols every platform draws: the names live in icons.asuka, which
  // gives Linux a Material name where a symbol has no SF equivalent. The
  // cloud itself is the state; the color and the tooltip say which.
  let syncIcon = if !library.davConfigured() {
    Icons.cloudOff
  } else if library.syncBusy {
    Icons.syncBusy
  } else if syncFailed {
    Icons.syncFailed
  } else {
    Icons.cloud
  }
  let syncTip = if !library.davConfigured() {
    "同步未配置"
  } else if library.syncBusy {
    "正在同步"
  } else if syncFailed {
    "上次同步失败"
  } else {
    "同步"
  }

  // Import and sync sit at the top right of the bar, not as floating actions.
  // 显示 comes first: it only changes how the shelf looks, while sync and
  // import change what it holds, so they keep the rightmost place.
  toolbar {
    if !library.shelf.isEmpty() {
      // 显示与排序 is the platform's own menu where it has one: a UIMenu on
      // iOS, Material's on Android, an NSMenu on a Mac, a pop-up on Windows
      // and a popover in a browser. Linux keeps the page: its menu stops
      // opening once a checked item changes.
      if @platform == .linux {
        Button("显示与排序") {
          icon: Icons.display
          variant: .glass
          tooltip: "显示方式与排序"
          on press { present(ShelfDisplay()) }
        }
      } else {
        Button("显示与排序") {
          icon: Icons.display
          variant: .glass
          tooltip: "显示方式与排序"
          menu: [
            .section(title: "显示", items: [
              .button(title: "网格", checked: library.shelfLayout == "grid", run: () => { library.shelfLayout = "grid" }),
              .button(title: "列表", checked: library.shelfLayout == "list", run: () => { library.shelfLayout = "list" }),
            ]),
            .section(title: "排序", items: [
              .button(title: "最近阅读", checked: library.shelfSort == "recent", run: () => { library.shelfSort = "recent" }),
              .button(title: "书名", checked: library.shelfSort == "title", run: () => { library.shelfSort = "title" }),
              .button(title: "作者名", checked: library.shelfSort == "author", run: () => { library.shelfSort = "author" }),
              .button(title: "手动", checked: library.shelfSort == "manual", run: () => { library.shelfSort = "manual" }),
            ]),
          ]
        }
      }
    }
    // 正常状态（已配置、不在同步、上次没失败）不占位置：同步是背景
    // 动作，不是常驻入口。未配置、正在同步、上次失败时才出现。
    if !library.davConfigured() || library.syncBusy || syncFailed {
      Button("同步") {
        icon: syncIcon
        variant: .glass
        tooltip: syncTip
        color: if syncFailed {
          .red
        } else if !library.davConfigured() {
          .secondaryLabel
        } else {
          .accent
        }
        on press { present(SyncSettings()) }
      }
    }
    Button("导入") {
      icon: Icons.add
      variant: .glass
      tooltip: "导入 .txt 或 .epub，可多选"
      on press { await pick() }
    }
  }

  // Runs the import, and says so when it can't. 进度和汇总与 Files / Mail
  // 递进来的多本是同一套（imports.asuka）。
  async fn bring(paths: [string]) {
    await bringBooks(library, paths)
  }

  async fn pick() {
    do {
      let paths = try await dialog.open(
        title: "导入书籍",
        button: "导入",
        // Both formats the engine reads: it tells them apart by the file's
        // own bytes, so the picker only has to let them through. 一次可以
        // 选多本；bring 一本一本导入，其中一本失败不会挡住后面的。
        filters: [dialog.Filter(name: "文本与 EPUB", extensions: ["txt", "epub"])],
        multiple: true,
      )
      await bring(paths)
    } catch e {
      snackbar(lib.plain(e.message))
    }
  }

  async fn syncFromCloud() {
    do {
      let state = allSources?.syncState() ?? sources.SyncState()
      let (message, merged) = try await library.syncNow(state)
      if let s = allSources { s.applySync(merged) }
      snackbar(message)
    } catch e {
      snackbar(lib.plain(e.message))
    }
  }

  // 一格占的宽：按书架的宽算出一行摆几个封面，封面就占满一格，边缘
  // 因此压在两边的 keyline 上。
  state cellWidth = shelfTileCover
  // 网格一行摆几本：窗口宽度算出来的列数，书也按它攒成 List 的行。
  state gridColumns = 2

  let env = environment()
  let books = library.books()
  let listMode = library.shelfLayout == "list"
  let ordered = lib.sortBooks(books, library.readings, library.shelfSort)
  let gridRows = ordered.chunked(gridColumns)

  View {
    grow: 1
    // 书架的宽就是这一页的宽（List 和 Scroll 都没有 layout 事件）：
    // 一行的格宽是内容区减去 keyline 和格间距后，按列数均分。
    // 横屏时页面左右有安全区，列表被收在里面，算列数也得先减掉，
    // 否则会按整屏宽多算一列，最后一列被截掉。
    on layout(f) {
      let room = f.width - env.safeLeft - env.safeRight - 2 * lib.pageKeyline
      var n = max(1, int((room + shelfGridGap) / (shelfTileCover + shelfGridGap)))
      // 窄窗口（小屏手机、分屏）放不下两本 150pt 的书时，一张封面会
      // 撑满整行：多分一列，书小一点，也不让一行只有一张大封面。
      while n < 4 && (room - shelfGridGap * float(n - 1)) / float(n) > shelfTileMax {
        n += 1
      }
      let w = (room - shelfGridGap * float(n - 1)) / float(n)
      if n != gridColumns { gridColumns = n }
      if w != cellWidth { cellWidth = w }
    }

    if books.isEmpty() {
      // 首次启动的样书还没放进来时先留白，免得空状态一闪而过；
      // 样书放好以后（seeded）再空，就是读者真的把书架清空了。
      if library.seeded {
        EmptyShelf {
          configured: library.davConfigured()
          on chooseFile { await pick() }
          on cloud {
            if library.davConfigured() {
              await syncFromCloud()
            } else {
              present(SyncSettings())
            }
          }
        }
      } else {
        View { grow: 1 }
      }
    } else if listMode {
      // 只让开横屏的左右安全区。上下不能包 SafeArea：List 自己已经按
      // 导航栏和 tab 栏调整内容，再让一次会把内容挤到中间，也滚不到
      // 液态玻璃下面。
      View {
        grow: 1
        padding: [0, env.safeLeft, 0, env.safeRight]
        Column {
          grow: 1
          padding: [10, 0]
          List {
            grow: 1
            for b in ordered key b.id {
              ShelfBook(b, library.readingOf(b.id)) {
                mode: "list"
                showCloud: library.davConfigured()
                on open { emit open(b) }
              }
            }
          }
        }
      }
    } else {
      // 网格：每一行书是 List 的一行。滚动条贴着安全区的边，keyline 放
      // 进行里；每行上下各留半格，两行合起来就是一个格间距。左右同样
      // 只让安全区，上下留给 List 自己处理。
      View {
        grow: 1
        padding: [0, env.safeLeft, 0, env.safeRight]
        List {
          grow: 1
          appearance: .bare
          // 顶部不要再叠一层：第一行自己的 11 已经是它和导航栏的距离，
          // 再加 List 的上内边距，两本书会离顶端太远。底部留着 11，
          // 最后一行和 tab 栏之间就不贴着。
          padding: [0, 0, 11, 0]
          for (i, row) in gridRows.enumerated() key i {
            Row {
              padding: [11, lib.pageKeyline]
              gap: shelfGridGap
              for b in row key b.id {
                ShelfBook(b, library.readingOf(b.id)) {
                  mode: "grid"
                  showCloud: library.davConfigured()
                  cellWidth: cellWidth
                  on open { emit open(b) }
                }
              }
            }
          }
        }
      }
    }
  }
}
