// The shelf: one cell a book, the way Quire's library shows it — covers,
// titles, and where each one was left.

import platform/dialog
import std/fs

import ./engine
import ./lib

/// Cover colors from Quire's icon sheet: ink, cloth, dusk.
let spines = [#2b2b2f, #3d5143, #4a3f63, #7a5b33, #2c5560]

/// A title's cover color, the same every launch.
fn spine(title: string) -> Color {
  var h = 0
  for c in title {
    h = (h * 31 + c.code()) % 9973
  }
  return spines[h % spines.count()]
}

component Cover(book: lib.Book) {
  use library: Library

  // The book's row may predate covers: ask the engine once, then keep the
  // file next to the app's data. Text books have no cover and keep the spine.
  // A cloud-only book has no file to ask the engine about yet.
  state cover = if !book.cover.isEmpty() && fs.exists(book.cover) { book.cover } else { "" }

  task(book.id, book.remote, book.cover, library.assetsTick) {
    if !book.cover.isEmpty() && fs.exists(book.cover) {
      cover = book.cover
      return
    }
    cover = ""
    if book.remote { return }
    if book.path.isEmpty() || !book.path.lower().hasSuffix(".epub") { return }
    let path = coverPath(book.id)
    if !fs.exists(path) {
      let id = engine.open(book.path)
      if id <= 0 { return }
      let wrote = engine.writeCover(id, path: path)
      engine.close(id)
      if !wrote { return }
    }
    cover = path
    library.setCover(book.id, coverName(book.id))
  }

  View {
    aspectRatio: 0.68
    radius: 8
    clip: true
    background: spine(book.title)
    if !cover.isEmpty() && fs.exists(cover) {
      Image(source: cover) {
        grow: 1
        mode: .fill
      }
    } else {
      Column {
        grow: 1
        justify: .center
        align: .center
        padding: 10
        Text(book.title) {
          font: .headline
          color: #f4efe6
          lines: 3
          textAlign: .center
        }
      }
    }
  }
}

/// The cell itself: a cover, a title, and where the reader is.
component BookTile(book: lib.Book, reading: lib.Reading) {
  event open

  // 文件不在本机：云端有就是「按需下载」，没有才是真的找不到。
  let missing = !book.remote && !book.path.isEmpty() && !fs.exists(book.path)

  Column {
    gap: 6
    align: .center
    padding: [0, 10]
    on press { emit open }
    Cover(book) { width: 150 }
    Text(book.title) {
      font: .subheadline
      lines: 1
      textAlign: .center
    }
    Text(if book.remote {
      "云端 · {reading.label()}"
    } else if missing {
      if book.hash.isEmpty() { "文件找不到了" } else { "未备份到云端" }
    } else if book.author.isEmpty() {
      reading.label()
    } else {
      "{book.author} · {reading.label()}"
    }) {
      font: .caption
      color: if missing { .red } else { .secondaryLabel }
      lines: 1
      textAlign: .center
    }
  }
}

/// A book on the shelf: long press one for its actions, a sample's as much as
/// an imported one's.
component BookCell(book: lib.Book, reading: lib.Reading) {
  prop pinned = false
  event open
  event delete
  event backup
  event pin
  event evict

  Menu {
    longPress: true
    actions: [
      .button(title: if pinned { "取消固定" } else { "固定在本机" }, run: () => { emit pin }),
      .button(title: "备份到云端", run: () => { emit backup }),
      .button(title: "仅保留在云端", run: () => { emit evict }),
      .button(title: "删除", role: .destructive, run: () => { emit delete }),
    ]
    BookTile(book, reading) { on open { emit open } }
  }
}

/// 书架空了：两条能立刻把书放上来的路。这里只放大两个动作，不再写
/// 一段说明；同步按钮的文案由云端是否配置好决定。
component EmptyShelf {
  prop configured = false
  event chooseFile
  event cloud

  Column {
    grow: 1
    justify: .center
    align: .center
    padding: [24, 24, 56, 24]
    gap: 22

    // 一排立着的书，颜色来自封面用的那组。书下面是一条书架线，
    // 让空状态仍然是「书架」，不是一张通用的提示卡。
    Column {
      gap: 0
      Row {
        gap: 6
        align: .end
        View { width: 20; height: 50; radius: 3; background: spines[1] }
        View { width: 24; height: 62; radius: 3; background: spines[2] }
        View { width: 18; height: 44; radius: 3; background: spines[3] }
        View { width: 22; height: 56; radius: 3; background: spines[4] }
      }
      View {
        width: 132
        height: 3
        radius: 2
        background: .separator
      }
    }

    Column {
      gap: 6
      align: .center
      Text("书架还是空的") {
        font: .title2.bold()
      }
      Text("导入一本 .txt 或 .epub；如果云端已经有书架，连接后也能同步过来。") {
        font: .footnote
        color: .secondaryLabel
        textAlign: .center
        lines: 3
      }
    }

    Row {
      gap: 10
      Button("导入书籍") {
        icon: Icons.add
        variant: .tinted
        on press { emit chooseFile }
      }
      Button(if configured { "同步云端" } else { "配置云端" }) {
        icon: Icons.cloud
        variant: .bordered
        on press { emit cloud }
      }
    }
  }
}

screen Shelf {
  use library: Library

  /// A book was chosen: the app opens the reader over the shelf.
  event open(book: lib.Book)

  title: "书架"
  largeTitle: true

  // 同步 is a state of this shelf, not a feature buried in settings: the
  // cloud says whether the shelf has a copy in the cloud, and tapping it
  // opens the page where the account and the folder are.
  let syncFailed = library.syncMessage.hasPrefix("同步失败")
  // Symbols every platform draws: the names live in icons.asuka, which
  // gives Linux a Material name where a symbol has no SF equivalent. The
  // cloud itself is the state; the color and the tooltip say which.
  let syncIcon = if !library.davConfigured() {
    Icons.cloudOff
  } else if library.syncBusy {
    Icons.syncBusy
  } else if syncFailed {
    Icons.syncFailed
  } else {
    Icons.cloud
  }
  let syncTip = if !library.davConfigured() {
    "同步未配置"
  } else if library.syncBusy {
    "正在同步"
  } else if syncFailed {
    "上次同步失败"
  } else {
    "同步"
  }

  // Import and sync sit at the top right of the bar, not as floating actions.
  toolbar {
    Button("") {
      icon: syncIcon
      variant: .glass
      label: "同步"
      tooltip: syncTip
      color: if syncFailed {
        .red
      } else if !library.davConfigured() {
        .secondaryLabel
      } else {
        .label
      }
      on press { present(SyncSettings()) }
    }
    Button("") {
      icon: Icons.add
      variant: .glass
      label: "导入"
      tooltip: "导入 .txt 或 .epub"
      on press { await pick() }
    }
  }

  // Runs the import, and says so when it can't.
  async fn bring(paths: [string]) {
    for p in paths {
      let title = lib.titleOf(lib.fileName(p))
      do {
        // A book already on the shelf (the same bytes, whatever the file is
        // called) is reported, not added again.
        if try await library.importFile(p) {
          snackbar("已加入《{title}》")
        } else {
          snackbar("《{title}》已经在书架上了")
        }
      } catch e {
        snackbar(e.message)
      }
    }
  }

  async fn pick() {
    do {
      let paths = try await dialog.open(
        title: "导入书籍",
        button: "导入",
        // Both formats the engine reads: it tells them apart by the file's
        // own bytes, so the picker only has to let them through.
        filters: [dialog.Filter(name: "文本与 EPUB", extensions: ["txt", "epub"])],
        multiple: false,
      )
      await bring(paths)
    } catch e {
      snackbar(e.message)
    }
  }

  // Files handed over by Files, Mail or another app (iOS's "Open in").
  // onOpenFiles can't wait, so hand them to a task that can.
  state incoming: [string] = []

  task(incoming) {
    if !incoming.isEmpty() {
      let paths = incoming
      incoming = []
      await bring(paths)
    }
  }

  onOpenFiles(paths => { incoming = paths })

  async fn syncFromCloud() {
    do {
      snackbar(try await library.syncNow())
    } catch e {
      snackbar(e.message)
    }
  }

  // As many covers in a row as the window has room for, 150 points each.
  let width = environment().width
  let columns = if width > 1180 { 6 } else if width > 980 { 5 } else if width > 780 { 4 } else if width > 560 { 3 } else { 2 }
  let books = library.books()

  View {
    grow: 1

    if books.isEmpty() {
      // 首次启动的样书还没放进来时先留白，免得空状态一闪而过；
      // 样书放好以后（seeded）再空，就是读者真的把书架清空了。
      if library.seeded {
        EmptyShelf {
          configured: library.davConfigured()
          on chooseFile { await pick() }
          on cloud {
            if library.davConfigured() {
              await syncFromCloud()
            } else {
              present(SyncSettings())
            }
          }
        }
      } else {
        View { grow: 1 }
      }
    } else {
      List {
        columns: columns
        gap: 22
        padding: [22, 20]
        for b in books key b.id {
          BookCell(b, library.readingOf(b.id)) {
            pinned: library.pinned.contains(b.id)
            on open { emit open(b) }
            on backup {
              if b.remote {
                snackbar("先打开这本书，下载到本机后再备份")
              } else {
                do {
                  snackbar(try await library.backupBook(b))
                } catch e {
                  snackbar(e.message)
                }
              }
            }
            on pin {
              library.togglePin(b.id)
              snackbar(if library.pinned.contains(b.id) { "已固定《{b.title}》" } else { "已取消固定《{b.title}》" })
            }
            on evict {
              if b.remote {
                snackbar("《{b.title}》已经只在云端")
              } else if library.removeLocalCopy(b.id) {
                snackbar("已从本机移除《{b.title}》，云端仍保留")
              } else if library.pinned.contains(b.id) {
                snackbar("这本书已固定在本机，先取消固定")
              } else {
                snackbar("先备份到云端，才能只保留云端副本")
              }
            }
            on delete {
              library.forget(b.id)
              snackbar("已删除《{b.title}》")
            }
          }
        }
      }
    }
  }
}
