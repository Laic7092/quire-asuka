// 搜索：在导入的书源里找书。
//
// 标题栏的搜索框是系统的搜索栏；搜到的书按书名排，点一本看详情和目录，
// 可以试读一章，也可以放进书架。入架的是一本「在线书」：书架只记书源和
// 书页，目录存一份，正文读到哪取到哪，不整本下载。文件型书源（没有章节，
// 只有 downloadUrls）的书不这样入架：它的文件下载下来，就是一本本地书。

import platform/device
import platform/dialog
import std/fs
import std/json

import ./lib
import ./remote
import ./sources

/// 一条搜索结果：哪本书，是哪个书源给的。
struct Hit {
  sourceId: string
  sourceName: string
  book: sources.Book
}

/// 一个书源的搜索：找到的书，或者它为什么没找成。
struct Outcome {
  hits: [Hit] = []
  failed: string = ""
}

/// 发现页的一栏：哪个书源的哪个分类。
struct ExploreHit {
  sourceId: string
  sourceName: string
  category: sources.ExploreCategory
}

/// 一个分类里的行：一本书，或者最后那行「加载更多」。List 的行只能来自
/// 一个 for，所以「加载更多」也是一行；挂在 for 后面的 Column 会让 List
/// 在运行时 panic。
enum DiscoverBookRow {
  book(sources.Book, int)
  more

  fn key() -> string = match self {
    .book(b, i) => "{b.bookUrl}:{i}"
    .more => "__discover_more__"
  }
}

/// 发现页的第一层：带 exploreUrl 的书源，各自带着自己的分类。
struct ExploreSource {
  id: string
  name: string
  group: string
  categories: [sources.ExploreCategory]
}

async fn exploreSourceOf(store: sources.Sources, e: sources.Entry) -> ExploreSource? {
  if let d = store.definition(e) {
    let categories = await sources.exploreCategoriesOf(d)
    if !categories.isEmpty() {
      return ExploreSource(id: e.id, name: e.name, group: e.group, categories: categories)
    }
  }
  return none
}

async fn exploreSources(store: sources.Sources, entries: [sources.Entry]) -> [ExploreSource] {
  // 分类可能要从地址取回来：一两个书源慢，不要挡住其余书源。
  let enabled = entries.filter(e => e.enabled)
  let rows = await all(enabled, e => await exploreSourceOf(store, e), limit: 6)
  return rows.compactMap(r => r)
}

/// 书名变成文件名：路径里不能有的字符换成下划线。
fn fileTitle(title: string) -> string {
  var out = ""
  for c in title {
    if c == '/' || c == '\\' || c == ':' || c == '*' || c == '?' || c == '"' || c == '<' || c == '>' || c == '|' {
      out += "_"
    } else {
      out += c
    }
  }
  let t = out.trim()
  return if t.isEmpty() { "网络小说" } else { t }
}

/// 地址里路径的那一段：去掉 `?` 后的查询和 `#` 后的片段。
/// `https://download.zxcs.zip/书名.txt` 里的 `.zip` 是域名，不是扩展名。
fn urlPathOf(url: string) -> string {
  var path = url.trim()
  if let at = path.find("?") { path = path.byteSlice(0, at) }
  if let at = path.find("#") { path = path.byteSlice(0, at) }
  return path
}

/// 查询串里的一个参数（`type=txt` 的 `type`），没有时是空。
fn urlQueryValue(url: string, key: string) -> string {
  let at = url.find("?") ?? -1
  if at < 0 { return "" }
  var query = url.byteSlice(at + 1, url.byteCount())
  if let hash = query.find("#") { query = query.byteSlice(0, hash) }
  for part in query.split("&") {
    if let eq = part.find("=") {
      if part.byteSlice(0, eq).trim().lower() == key {
        return part.byteSlice(eq + 1, part.byteCount()).trim().lower()
      }
    }
  }
  return ""
}

/// 路径最后一段的扩展名，小写；没有点是空。域名不在这里面。
fn fileExtensionOf(path: string) -> string {
  let lower = path.lower()
  let slash = lower.findLast("/") ?? -1
  let name = if slash >= 0 { lower.byteSlice(slash + 1, lower.byteCount()) } else { lower }
  let dot = name.findLast(".") ?? -1
  if dot < 0 || dot + 1 >= name.byteCount() { return "" }
  return name.byteSlice(dot + 1, name.byteCount())
}

/// 下载下来的文件名：书名，加上书源给的名字（有多个文件时）。扩展名先看
/// 路径，再看 `?type=txt` 这类查询，最后才看选项名字。
fn downloadNameFor(title: string, option: sources.DownloadOption, count: int) -> string {
  let ext = fileExtensionOf(urlPathOf(option.url))
  let type = urlQueryValue(option.url, "type")
  let format = urlQueryValue(option.url, "format")
  let kind = "{type} {format}".lower()
  let chosen = if ext == "epub" { ".epub" } else if ext == "txt" {
    ".txt"
  } else if kind.contains("epub") {
    ".epub"
  } else if kind.contains("txt") || kind.contains("utf8") || kind.contains("utf-8") {
    ".txt"
  } else if option.name.lower().contains("epub") {
    ".epub"
  } else {
    ".txt"
  }
  var base = fileTitle(title)
  if count > 1 { base = "{base}-{fileTitle(option.name)}" }
  return "{base}{chosen}"
}

/// 压缩包、PDF 之类，下载下来阅读器也打不开：在点下去之前说清楚。
/// 只看路径的扩展名和 `type`/`format` 参数，不看域名：`zxcs.zip` 是
/// 知轩的域名，下载的却是一个 .txt。
fn downloadUnsupported(url: string) -> bool {
  let blocked = ["zip", "rar", "7z", "pdf", "mobi", "azw3"]
  let ext = fileExtensionOf(urlPathOf(url))
  if blocked.contains(ext) { return true }
  let kind = urlQueryValue(url, "type")
  if blocked.contains(kind) { return true }
  let format = urlQueryValue(url, "format")
  return blocked.contains(format)
}

/// 搜索结果里的一条：封面、书名、作者，和它来自哪个书源。
component ResultRow(hit: Hit) {
  /// 合并重复书时，这个书名+作者还在另外几个书源里。
  prop also = 0
  event open

  Row {
    gap: 12
    align: .center
    padding: [10, lib.pageKeyline]
    on press { emit open }
    RemoteCover(url: hit.book.coverUrl) {
      width: 46
      height: 64
    }
    Column {
      grow: 1
      // 标题再长也不挤封面：这一列从零开始拿剩下的宽。
      shrink: 1
      basis: 0
      minWidth: 0
      gap: 4
      Text(hit.book.name) {
        font: .headline
        lines: 2
      }
      if !hit.book.author.isEmpty() {
        Text(hit.book.author) {
          font: .subheadline
          color: .secondaryLabel
          lines: 1
        }
      }
      Text(if also > 0 { "{hit.sourceName} · 还有 {also} 个书源" } else { hit.sourceName }) {
        font: .caption
        color: .tertiaryLabel
        lines: 1
      }
    }
  }
}

/// 网络上的封面：没有地址时不占位，等它的图到了才画。
component RemoteCover(url: string) {
  prop width = 76
  prop height = 108

  View {
    width: width
    height: height
    // 封面是固定尺寸：标题再长也不该把它挤窄。
    shrink: 0
    radius: 7
    clip: true
    background: .secondaryBackground
    if !url.isEmpty() {
      Image(source: url) {
        grow: 1
        mode: .fill
      }
    }
  }
}

/// 发现页的一条结果：和搜索的一条一样，只是从分类来。
component ExploreResultRow(row: ExploreHit, book: sources.Book) {
  event open

  ResultRow(Hit(sourceId: row.sourceId, sourceName: row.sourceName, book: book)) {
    on open { emit open }
  }
}

/// 书源里的书详情：一本书的封面、简介，和它的目录。加入书架只存目录。
screen SearchBook(hit: Hit) {
  use allSources: sources.Sources
  use library: Library

  event open(book: lib.Book)

  title: hit.book.name

  state adding = false
  state note = ""
  /// 正在下的文件地址（空的是没有下载）：按钮跟着它说。
  state downloading = ""

  let detail = load detailOf(hit)

  fn definition() -> sources.BookSource? {
    for e in allSources.list() {
      if e.id == hit.sourceId {
        return allSources.definition(e)
      }
    }
    return none
  }

  async fn detailOf(the: Hit) throws -> sources.Detail {
    let def = definition()
    if def == none { throw Error("这个书源已经不在列表里了") }
    return try await sources.detailOf(def!, the.book)
  }

  async fn addToShelf(d: sources.Detail) {
    if adding { return }
    let def = definition()
    if def == none {
      note = "这个书源已经不在列表里了"
      return
    }
    adding = true
    note = "正在记下目录…"
    do {
      let meta = remote.buildMeta(d, sourceId: def!.bookSourceUrl)
      let id = onlineId(meta.sourceId, bookUrl: meta.bookUrl)
      remote.writeMeta(id, meta)
      // 封面小，随目录一起取；取不到就画书脊。
      var cover = ""
      if !meta.coverUrl.isEmpty() {
        let target = fs.join([fs.appDir(), "covers", "{id}.img"])
        if (try? await remote.fetchCover(def!, url: meta.coverUrl, into: target)) == true {
          cover = "covers/{id}.img"
        }
      }
      // 第一章顺手取回来：书架的字数、第一次打开都立刻有东西。
      try? await remote.chapterText(def!, id: id, meta: meta, at: 0)
      let book = library.addOnline(meta, cover: cover)
      note = "已加入书架，正文按章取"
      emit open(book)
    } catch e {
      note = e.message
    }
    adding = false
  }

  /// 文件型书源的书：引擎用自己的 header/cookie/代理把文件取下来，原样
  /// 落到 books/，再走和「从文件导入」同一条路——之后它就是一本本地书。
  async fn downloadAndOpen(d: sources.Detail, f: sources.DownloadOption) {
    if !downloading.isEmpty() { return }
    let def = definition()
    if def == none {
      note = "这个书源已经不在列表里了"
      return
    }
    if downloadUnsupported(f.url) {
      note = "这个文件不是 TXT 或 EPUB：{f.url}"
      return
    }
    let name = downloadNameFor(d.info.book.name, f, d.files.count())
    let dir = fs.join([fs.appDir(), "books"])
    let path = fs.join([dir, name])
    downloading = f.url
    note = "正在下载 {f.name}…"
    do {
      try await spawn { try fs.mkdirAll(dir) }
      let file = try await sources.downloadOf(def!, url: f.url, into: path)
      let kb = file.size / 1024
      note = "已下载 {kb} KB（{file.charset}），正在导入…"
      let added = try await library.importFile(path)
      if let row = library.shelf.find(s => s.path == "books/{name}") {
        note = if added { "已加入书架：{row.title}" } else { "书架上已经有这本书" }
        emit open(row.book())
      } else {
        note = "下载好了，但书架上没有找到它"
        try? fs.remove(path)
      }
    } catch e {
      note = e.message
      try? fs.remove(path)
    }
    downloading = ""
  }

  SafeArea {
    grow: 1
    match detail {
      .pending => Column {
        grow: 1
        justify: .center
        align: .center
        gap: 12
        ProgressRing {}
        Text("正在读《{hit.book.name}》的详情…") {
          font: .footnote
          color: .secondaryLabel
        }
      }
      .failed(e) => Column {
        grow: 1
        justify: .center
        align: .center
        gap: 12
        Text("没能打开这本书") { font: .headline }
        Text(e.message) {
          font: .footnote
          color: .secondaryLabel
          textAlign: .center
        }
        Button("重试") {
          on press { detail.reload() }
        }
      }
      .ready(d) => Column {
        grow: 1
        Column {
          gap: 12
          padding: [14, lib.pageKeyline, 10, lib.pageKeyline]
          Row {
            gap: 14
            align: .start
            RemoteCover(url: d.info.book.coverUrl) {
              width: 78
              height: 110
            }
            Column {
              grow: 1
              // 标题再长也不挤封面：这一列从零开始拿剩下的宽。
              shrink: 1
              basis: 0
              minWidth: 0
              gap: 5
              Text(d.info.book.name) {
                font: .title3.bold()
                lines: 3
              }
              if !d.info.book.author.isEmpty() {
                Text(d.info.book.author) {
                  font: .subheadline
                  color: .secondaryLabel
                }
              }
              Text(if d.chapters.isEmpty() {
                if d.files.isEmpty() { "{hit.sourceName} · 没有章节" } else { "{hit.sourceName} · {d.files.count()} 个文件" }
              } else {
                "{hit.sourceName} · {d.chapters.count()} 章"
              }) {
                font: .caption
                color: .tertiaryLabel
              }
              if !d.info.book.lastChapter.isEmpty() {
                Text("最新：{d.info.book.lastChapter}") {
                  font: .caption
                  color: .secondaryLabel
                  lines: 1
                }
              }
            }
          }
          if !d.info.book.intro.isEmpty() {
            Text(d.info.book.intro) {
              font: .footnote
              color: .secondaryLabel
              lines: 7
            }
          }
          if !d.files.isEmpty() {
            Column {
              gap: 8
              Text(if d.chapters.isEmpty() { "下载后加入书架" } else { "也可以下载整本" }) {
                font: .caption.bold()
                color: .secondaryLabel
              }
              for f in d.files key f.url {
                Row {
                  gap: 10
                  align: .center
                  Text(f.name) {
                    font: .footnote
                    grow: 1
                    lines: 1
                  }
                  Button(if downloading == f.url { "下载中…" } else { "下载并导入" }) {
                    on press { await downloadAndOpen(d, f) }
                    disabled: !downloading.isEmpty()
                  }
                }
              }
            }
          }
          if !note.isEmpty() {
            Text(note) {
              font: .footnote
              color: .tertiaryLabel
            }
          }
          if !d.chapters.isEmpty() {
            Row {
              gap: 10
              Button(if adding { "正在加入…" } else { "加入书架" }) {
                on press { await addToShelf(d) }
                disabled: adding
              }
            }
          }
        }
        if d.chapters.isEmpty() {
          Column {
            grow: 1
            justify: .center
            align: .center
            gap: 8
            padding: [24, 30]
            Text(if d.files.isEmpty() {
              "这个书源没有给出章节，也没有给出下载地址。"
            } else {
              "文件型书源没有章节：下载下来就是一本本地书，按 TXT 的章节读。"
            }) {
              font: .footnote
              color: .secondaryLabel
              textAlign: .center
            }
          }
        } else {
          List {
            appearance: .plain
            grow: 1
            for (i, c) in d.chapters.enumerated() key i {
              Row {
                gap: 10
                align: .center
                padding: [11, lib.pageKeyline]
                on press { push(SearchChapter(hit, c)) }
                Text("{i + 1}") {
                  font: .caption
                  color: .tertiaryLabel
                  width: 34
                }
                Text(c.title) {
                  font: .body
                  grow: 1
                  lines: 1
                }
                Symbol(Icons.disclosure) {
                  font: .caption
                  color: .tertiaryLabel
                }
              }
            }
          }
        }
      }
    }
  }
}

/// 一章的正文：按段落排，长按可以选中复制。
screen SearchChapter(hit: Hit, chapter: sources.Chapter) {
  use allSources: sources.Sources

  title: chapter.title

  let body = load textOf(hit, chapter)

  async fn textOf(the: Hit, c: sources.Chapter) throws -> string {
    for e in allSources.list() {
      if e.id == the.sourceId {
        if let def = allSources.definition(e) {
          return try await sources.contentOf(def, the.book, c)
        }
        break
      }
    }
    throw Error("这个书源已经不在列表里了")
  }

  SafeArea {
    grow: 1
    background: .background
    match body {
      .pending => Column {
        grow: 1
        justify: .center
        align: .center
        gap: 12
        ProgressRing {}
        Text("正在取这一章…") {
          font: .footnote
          color: .secondaryLabel
        }
      }
      .failed(e) => Column {
        grow: 1
        justify: .center
        align: .center
        gap: 12
        Text("这一章没有取到") { font: .headline }
        Text(e.message) {
          font: .footnote
          color: .secondaryLabel
          textAlign: .center
        }
        Button("重试") {
          on press { body.reload() }
        }
      }
      .ready(text) => ChapterBody(text)
    }
  }
}

/// 一段正文的文字：一行一段。
component ChapterBody(text: string) {
  let paragraphs = text.split("\n").map(p => p.trim()).filter(p => !p.isEmpty())

  Scroll {
    Column {
      gap: 14
      padding: [20, lib.pageKeyline, 44, lib.pageKeyline]
      for (i, p) in paragraphs.enumerated() key i {
        Text(p) {
          font: Font(size: 17)
          color: .label
        }
      }
    }
  }
}

/// 书源列表里的分组：空组用这个键，显示成「未分组」。
let sourceUngrouped = "__ungrouped__"

struct SourceSection {
  key: string
  title: string
  rows: [sources.Entry]
}

fn sourceGroupNames(all: [sources.Entry]) -> [string] {
  var names: [string] = []
  for e in all {
    let groups = sources.entryGroups(e)
    if groups.isEmpty() {
      if !names.contains(sourceUngrouped) { names.push(sourceUngrouped) }
    } else {
      for g in groups {
        if !names.contains(g) { names.push(g) }
      }
    }
  }
  names.sort()
  if names.contains(sourceUngrouped) {
    names.removeWhere(n => n == sourceUngrouped)
    names.push(sourceUngrouped)
  }
  return names
}

/// 当前要列的书源：按分组筛选、按关键词找，一条书源只出现一次。
/// 它属于几个分组，是下一行标签的事，不再按分组重复列。
fn sourceRows(all: [sources.Entry], filter: string, query: string) -> [sources.Entry] {
  let q = query.trim()
  var rows: [sources.Entry] = []
  for e in all {
    let groups = sources.entryGroups(e)
    let inGroup = if filter.isEmpty() {
      true
    } else if filter == sourceUngrouped {
      groups.isEmpty()
    } else {
      groups.contains(filter)
    }
    let matches = q.isEmpty() || e.name.contains(q, ignoreCase: true) ||
      e.url.contains(q, ignoreCase: true) || e.group.contains(q, ignoreCase: true)
    if inGroup && matches { rows.push(e) }
  }
  rows.sort(key: e => e.name)
  return rows
}

/// 粘贴时先看一眼：这段 JSON 里有几个书源、叫什么，或者哪里不对。
struct SourcePreview {
  count: int = 0
  names: [string] = []
  error: string = ""
}

/// 书源变量要写的是一段 JSON 对象；空的不算。
fn isJsonObject(text: string) -> bool {
  let t = text.trim()
  if t.isEmpty() { return false }
  if let v = try? json.parse(t) {
    return v.asObject() != none
  }
  return false
}

/// Cookie 写到书源根地址下（路径是 `/`）；`baseUrlOf` 去掉了末尾的 `/`。
fn cookieUrlOf(s: sources.BookSource) -> string {
  let base = sources.baseUrlOf(s)
  if base.isEmpty() { return "" }
  return if base.hasSuffix("/") { base } else { "{base}/" }
}

/// 从浏览器复制过来的可能是 `Cookie: a=b; c=d`，只留后面那段；也允许
/// 只粘 `a=b; c=d`。多行粘贴时把换行当成空格。
fn cookieHeaderFrom(text: string) -> string {
  var header = text.trim().replace("\r", "\n")
  header = header.split("\n").map(line => line.trim()).filter(line => !line.isEmpty()).joined(separator: "; ")
  if header.lower().hasPrefix("cookie:") {
    header = header.byteSlice(7, header.byteCount()).trim()
  }
  return header
}

/// 变量名像密码、令牌或 Cookie 的，输入框遮起来。
fn secretVariable(key: string) -> bool {
  let k = key.lower()
  return k.contains("pass") || k.contains("pwd") || k.contains("secret") || k.contains("token") || k.contains("cookie")
}

/// 书源的说明常常是一大段写给宿主看的备注（storageDir、legado_eval、
/// 下载限速……）。面板里只留第一句：读者只需要知道要不要登录。
fn sourceHint(text: string) -> string {
  var line = ""
  for l in text.trim().replace("\r", "\n").lines() {
    if !l.trim().isEmpty() {
      line = l.trim()
      break
    }
  }
  if line.isEmpty() { return "" }
  var first = ""
  var ended = false
  for ch in line.chars() {
    if ch == '。' || ch == '；' || ch == '！' || ch == '？' || ch == ';' {
      ended = true
      break
    }
    first += "{ch}"
  }
  var out = first.trim()
  if out.isEmpty() { out = line }
  if !ended && out.count() < line.count() { out = "{out}…" }
  if out.count() > 60 { out = "{out.slice(0, 60).trim()}…" }
  return out
}

/// 验证码登录用的账号密码：先看 jsLib 推出来的键，再看书源变量里常见的
/// `user` / `pass` 写法。
fn captchaCredentials(text: string) -> (string, string) {
  let users = [
    sources.variableValueOf(text, "wenku8_user"),
    sources.variableValueOf(text, "user"),
    sources.variableValueOf(text, "username"),
  ]
  let passes = [
    sources.variableValueOf(text, "wenku8_pass"),
    sources.variableValueOf(text, "pass"),
    sources.variableValueOf(text, "password"),
  ]
  let user = users.find(v => !v.trim().isEmpty()) ?? ""
  let pass = passes.find(v => !v.trim().isEmpty()) ?? ""
  return (user, pass)
}

/// 带验证码的登录：和书源 jsLib 做的事一样，只多一个 `checkcode`
/// （wenku8 的登录页要它）。回 `ok`，或者服务器错误页里写的原因。
fn captchaLoginScript(user: string, pass: string, code: string, base: string, submit: string) -> string {
  let template = r"""
(function(){
  var body = 'username=' + encodeURIComponent(@USER@) +
    '&password=' + encodeURIComponent(@PASS@) +
    '&checkcode=' + encodeURIComponent(@CODE@) +
    '&usecookie=315360000&action=login&submit=' + encodeURIComponent('登录');
  var r = java.post(@SUBMIT@, body, {'Referer': @BASE@ + '/login.php', 'Content-Type': 'application/x-www-form-urlencoded'});
  var jar = cookie.getCookie(@BASE@ + '/');
  if (jar.indexOf('jieqiUserInfo') >= 0 || jar.indexOf('jieqiUserName') >= 0) return 'ok';
  var m = String(r.body).match(/错误原因：([^<]*)/);
  return m ? m[1] : ('HTTP ' + r.code);
})()
"""
  var script = template.replace("@USER@", json.encode(user))
  script = script.replace("@PASS@", json.encode(pass))
  script = script.replace("@CODE@", json.encode(code))
  script = script.replace("@BASE@", json.encode(base))
  script = script.replace("@SUBMIT@", json.encode(submit))
  return script
}

fn previewOf(text: string) -> SourcePreview {
  if text.trim().isEmpty() { return SourcePreview() }
  do {
    let list = try sources.parseList(text)
    return SourcePreview(count: list.count(), names: list.map(v => sources.nameOf(v)))
  } catch e {
    return SourcePreview(error: e.message)
  }
}

component SourceFilterChip(title: string, selected: bool) {
  event choose

  Button(title) {
    variant: if selected { .tinted } else { .bordered }
    on press { emit choose }
  }
}

/// 发现页的一个分类：几个字的标签，一行排好几个，不各占一整行。
component CategoryChip(title: string) {
  event choose

  Button(title) {
    variant: .bordered
    font: .footnote
    on press { emit choose }
  }
}

/// 书源列表：按分组排，可以选择一批一起开关、分组或删除。新书源从
/// 「导入」进来。
component SourceManager {
  use allSources: sources.Sources
  let env = environment()

  state selecting = false
  state selected: [string] = []
  state filter = ""
  state query = ""
  state moving = false
  state groupText = ""

  let all = allSources.list()
  let filters = sourceGroupNames(all)
  let shown = sourceRows(all, filter, query)
  let sectionTitle = if filter.isEmpty() {
    "全部书源"
  } else if filter == sourceUngrouped {
    "未分组"
  } else {
    filter
  }
  let sections: [SourceSection] = if shown.isEmpty() {
    []
  } else {
    [SourceSection(key: "all", title: sectionTitle, rows: shown)]
  }
  let allSelected = !shown.isEmpty() && shown.all(e => selected.contains(e.id))

  /// 正在编辑哪条书源的变量（空的是收起），和这段 JSON、说明与结果。
  state loginId = ""
  state loginText = ""
  state loginKeys: [string] = []
  state loginRaw = false
  state loginNote = ""
  state loginHelp = ""
  state loginBusy = false
  state verifying = false
  /// 面板里正在看哪一页：0 是书源变量，1 是网页登录拿回来的 Cookie，
  /// 站点要图形验证码时还有 2。
  state loginTab = 0
  /// 网页登录拿回来的 Cookie：直接进书源的会话，绕开书源自己的登录脚本。
  state cookieText = ""
  state cookieNote = ""
  state cookieBusy = false
  state cookieHave = false
  /// 图形验证码：站点（目前是轻小说文库）在登录页要 `checkcode`，
  /// 书源的 jsLib 只发账号密码，所以取一张图给读者读，再带上码登录。
  state captchaOn = false
  state captchaPath = ""
  state captchaCode = ""
  state captchaNote = ""
  state captchaBusy = false
  state captchaTick = 0

  /// 变量里至少填了一个值：空着的不算登录。
  fn hasFilledVariables() -> bool = loginKeys.any(k => !sources.variableValueOf(loginText, k).trim().isEmpty())

  async fn toggleLogin(e: sources.Entry) {
    if loginId == e.id {
      loginId = ""
      return
    }
    loginBusy = true
    loginNote = ""
    loginHelp = ""
    loginText = ""
    loginKeys = []
    loginRaw = false
    loginTab = 0
    cookieText = ""
    cookieNote = ""
    cookieHave = false
    captchaOn = false
    captchaPath = ""
    captchaCode = ""
    captchaNote = ""
    let def = allSources.definition(e)
    if def == none {
      loginNote = "这条书源读不出来"
      loginBusy = false
      return
    }
    let d = def!
    loginHelp = d.variableComment.trim()
    if loginHelp.isEmpty() { loginHelp = sourceHint(d.bookSourceComment) }
    loginKeys = sources.variableKeys(d)
    let stored = (try? await sources.storedVariables(d)) ?? ""
    var text = stored.trim()
    if text.isEmpty() { text = d.variable.trim() }
    loginText = if text.isEmpty() { "\{}" } else { text }
    loginRaw = loginKeys.isEmpty() || !isJsonObject(loginText)
    let at = cookieUrlOf(d)
    if !at.isEmpty() {
      let current = (try? await sources.cookieHeaderOf(d, url: at)) ?? ""
      cookieHave = !current.trim().isEmpty()
    }
    captchaOn = !sources.captchaLoginOf(d).isEmpty()
    loginId = e.id
    loginBusy = false
  }

  async fn saveLogin(e: sources.Entry) {
    if loginBusy { return }
    let def = allSources.definition(e)
    if def == none {
      loginNote = "这条书源读不出来"
      return
    }
    loginBusy = true
    loginNote = ""
    do {
      try await sources.saveVariables(def!, loginText)
      loginNote = "已保存，下一次请求会带上"
    } catch err {
      loginNote = err.message
    }
    loginBusy = false
  }

  async fn saveCookie(e: sources.Entry) {
    if cookieBusy { return }
    let def = allSources.definition(e)
    if def == none {
      cookieNote = "这条书源读不出来"
      return
    }
    let at = cookieUrlOf(def!)
    if at.isEmpty() {
      cookieNote = "这条书源没有地址，存不了 Cookie"
      return
    }
    let header = cookieHeaderFrom(cookieText)
    if header.isEmpty() {
      cookieNote = "先把浏览器里的 Cookie 粘进来"
      return
    }
    cookieBusy = true
    cookieNote = ""
    do {
      // 粘一份就是换一套会话：只“加”进 jar 的话，浏览器粘来的 host-only
      // Cookie 会和登录脚本下发的域级 Cookie 同名并存，旧的还可能挡在前面。
      try await sources.replaceCookiesOf(def!, url: at, cookie: header)
      cookieHave = true
      cookieText = ""
      cookieNote = "已替换这个书源的 Cookie，接下来的搜索和发现会带上它"
    } catch err {
      cookieNote = err.message
    }
    cookieBusy = false
  }

  async fn clearCookie(e: sources.Entry) {
    if cookieBusy { return }
    let def = allSources.definition(e)
    if def == none {
      cookieNote = "这条书源读不出来"
      return
    }
    let at = cookieUrlOf(def!)
    if at.isEmpty() {
      cookieNote = "这条书源没有地址，清不了 Cookie"
      return
    }
    cookieBusy = true
    cookieNote = ""
    do {
      try await sources.clearCookiesOf(def!, url: at)
      cookieHave = false
      cookieNote = "已清除这个书源的 Cookie"
    } catch err {
      cookieNote = err.message
    }
    cookieBusy = false
  }

  /// 登录有没有用，只能问一次真请求：书源的登录是它自己的 jsLib 在
  /// 搜索/发现时做的，ABI 没有单独问「登录了吗」的调用。
  async fn verifyLogin(e: sources.Entry) {
    if verifying { return }
    let def = allSources.definition(e)
    if def == none {
      loginNote = "这条书源读不出来"
      return
    }
    let d = def!
    verifying = true
    loginNote = "正在用这条书源搜一次…"
    // 粘了 Cookie 还没点保存的，验证时先存下来：页面上「验证」的
    // 意思就是「用现在填的去试」。
    let header = cookieHeaderFrom(cookieText)
    let at = cookieUrlOf(d)
    if !at.isEmpty() && !header.isEmpty() {
      do {
        try await sources.replaceCookiesOf(d, url: at, cookie: header)
        cookieHave = true
        cookieText = ""
      } catch err {
        loginNote = "Cookie 没存上：{err.message}"
        verifying = false
        return
      }
    } else if !at.isEmpty() && cookieHave && hasFilledVariables() {
      // jar 里有旧 Cookie 时，书源的 jsLib 看到 `jieqiUserInfo` 在就直接
      // 返回，账号密码填对了也不会去 POST。验证的是变量里的账号，就先
      // 把它送走，让登录真的跑一次。
      do {
        try await sources.clearCookiesOf(d, url: at)
        cookieHave = false
        loginNote = "已清掉旧 Cookie，正在用变量里的账号重登…"
      } catch err {
        loginNote = "旧 Cookie 清不掉：{err.message}"
        verifying = false
        return
      }
    }
    do {
      let books = try await sources.search(d, key: "我的", page: 1)
      loginNote = if books.isEmpty() {
        "搜索回来了，但一本书也没有：可能还没登上，换 Cookie 或账号再试"
      } else {
        "搜索可以用了，这次找到 {books.count()} 本"
      }
    } catch err {
      loginNote = if captchaOn {
        "这个站点要图形验证码：到「验证码」页取图登录"
      } else {
        "还不行：{err.message}"
      }
    }
    verifying = false
  }

  /// 取一张新的图形验证码：图片和登录 POST 用同一个源会话（同一个 jar），
  /// 所以验证码和随后的登录对得上。
  async fn fetchCaptcha(e: sources.Entry) {
    if captchaBusy { return }
    let def = allSources.definition(e)
    if def == none {
      captchaNote = "这条书源读不出来"
      return
    }
    let d = def!
    let url = sources.captchaLoginOf(d)
    if url.isEmpty() {
      captchaNote = "这个书源不需要图形验证码"
      return
    }
    captchaBusy = true
    captchaNote = ""
    captchaCode = ""
    do {
      let dir = fs.join([fs.appDir(), "captcha"])
      try await spawn { try fs.mkdirAll(dir) }
      captchaTick += 1
      let path = fs.join([dir, "login-{captchaTick}.png"])
      let file = try await sources.downloadOf(d, url: url, into: path)
      captchaPath = file.path
      captchaNote = "读图上的字，填好再登录；看不清就换一张"
    } catch err {
      captchaNote = err.message
    }
    captchaBusy = false
  }

  /// 带上验证码登录：账号密码取「变量」页里现在填的值。
  async fn captchaLogin(e: sources.Entry) {
    if captchaBusy { return }
    let def = allSources.definition(e)
    if def == none {
      captchaNote = "这条书源读不出来"
      return
    }
    let d = def!
    let (user, pass) = captchaCredentials(loginText)
    if user.isEmpty() || pass.isEmpty() {
      captchaNote = "先在「变量」页填账号和密码"
      return
    }
    let code = captchaCode.trim()
    if code.isEmpty() {
      captchaNote = "先填图上的验证码"
      return
    }
    captchaBusy = true
    captchaNote = "正在登录…"
    do {
      let script = captchaLoginScript(
        user, pass, code,
        base: sources.baseUrlOf(d),
        submit: sources.captchaSubmitOf(d),
      )
      let answer = try await sources.nativeEval(sources.sourceJSON(d), script: script)
      if answer.trim() == "ok" {
        cookieHave = true
        captchaPath = ""
        captchaCode = ""
        captchaNote = "登录成功，搜索和发现会带上这个会话"
      } else if answer.contains("校验码") {
        captchaNote = "验证码不对，换一张再试"
      } else {
        captchaNote = answer.trim()
      }
    } catch err {
      captchaNote = err.message
    }
    captchaBusy = false
  }

  fn toggle(id: string) {
    if selected.contains(id) {
      selected.removeWhere(s => s == id)
    } else {
      selected.push(id)
    }
  }

  fn toggleAll() {
    if allSelected {
      selected = []
      return
    }
    var next: [string] = []
    for e in shown {
      if !next.contains(e.id) { next.push(e.id) }
    }
    selected = next
  }

  fn toggleGroup(rows: [sources.Entry]) {
    let allIn = rows.all(e => selected.contains(e.id))
    var next = selected
    if allIn {
      next.removeWhere(s => rows.any(e => e.id == s))
    } else {
      for e in rows {
        if !next.contains(e.id) { next.push(e.id) }
      }
    }
    selected = next
  }

  fn applyGroup() {
    if selected.isEmpty() { return }
    let name = groupText.trim()
    allSources.setGroupMany(selected, name)
    moving = false
    groupText = ""
    selecting = false
    selected = []
    filter = ""
    snackbar(if name.isEmpty() { "已移到未分组" } else { "已移到「{name}」" })
  }

  fn askDelete() {
    if selected.isEmpty() { return }
    let count = selected.count()
    alert("删除 {count} 个书源？", message: "书架上的在线书会打不开；删除也会同步到其他设备。", actions: [
      .button(title: "取消", run: () => {}),
      .button(title: "删除", role: .destructive, run: () => {
        allSources.removeMany(selected)
        selected = []
        selecting = false
        filter = ""
        loginId = ""
        snackbar("已删除 {count} 个书源")
      }),
    ])
  }

  fn askDeleteOne(e: sources.Entry) {
    alert("删除「{e.name}」？", message: "书架上的在线书会打不开；删除也会同步到其他设备。", actions: [
      .button(title: "取消", run: () => {}),
      .button(title: "删除", role: .destructive, run: () => {
        allSources.remove(e.id)
        filter = ""
        if loginId == e.id { loginId = "" }
        snackbar("已删除「{e.name}」")
      }),
    ])
  }

  Column {
    grow: 1
    gap: 12
    padding: lib.sheetPad(env, top: 22, bottom: 26, side: 22)

    Row {
      gap: 8
      align: .center
      Text("书源") {
        font: .title3
        grow: 1
      }
      if !all.isEmpty() {
        // 导入从这里也能进，不必先关掉这一页。
        Button("") {
          icon: Icons.add
          variant: .glass
          tooltip: "导入书源"
          on press { present(SourceImport()) }
        }
        // 一直是「多选」，靠高亮表示开着：不再在「选择」和「完成」之间
        // 秒切，手指按下去不会觉得按钮自己跳了一下。完成在下面那一条。
        Button("多选") {
          variant: if selecting { .tinted } else { .glass }
          on press {
            selecting = !selecting
            if !selecting { selected = [] }
            moving = false
          }
        }
      }
      Button("") {
        icon: Icons.close
        variant: .glass
        on press { dismiss() }
      }
    }

    Text(if query.trim().isEmpty() {
      "{allSources.count()} 个书源 · {allSources.enabledCount()} 个在用"
    } else {
      "匹配 {shown.count()} 个 · 共 {allSources.count()} 个书源"
    }) {
      font: .footnote
      color: .secondaryLabel
    }

    if !sources.bookSourcesAvailable() {
      Text("这个平台还没有书源引擎（legado-engine），导入的书源暂时不能搜索。") {
        font: .footnote
        color: .secondaryLabel
      }
    }

    if all.isEmpty() {
      Column {
        gap: 10
        padding: [20, 0]
        align: .center
        Text("还没有书源") { font: .headline }
        Text("导入一份阅读3.0（Legado）的书源 JSON，就能在这里搜书。") {
          font: .footnote
          color: .secondaryLabel
          textAlign: .center
        }
        Button("导入书源") {
          on press { present(SourceImport()) }
        }
      }
    } else {
      Row {
        gap: 8
        align: .center
        TextField {
          bind text: query
          placeholder: "搜索书源（名字、地址或分组）"
          grow: 1
          autocapitalize: .off
          autocorrect: .no
        }
        if !query.isEmpty() {
          Button("") {
            icon: Icons.close
            variant: .plain
            tooltip: "清空搜索"
            on press { query = "" }
          }
        }
      }

      if !filters.isEmpty() {
        Scroll {
          width: 100%
          horizontal: true
          Row {
            gap: 8
            SourceFilterChip("全部", filter.isEmpty()) {
              on choose { filter = "" }
            }
            for name in filters key name {
              SourceFilterChip(if name == sourceUngrouped { "未分组" } else { name }, filter == name) {
                on choose { filter = name }
              }
            }
          }
        }
      }

      if moving {
        Row {
          gap: 8
          align: .center
          TextField {
            bind text: groupText
            placeholder: "分组名称；多个组用逗号分开，留空为未分组"
            grow: 1
          }
          Button("应用") {
            on press { applyGroup() }
            disabled: selected.isEmpty()
          }
          Button("取消") {
            variant: .plain
            on press { moving = false }
          }
        }
      }

      if shown.isEmpty() {
        Column {
          gap: 10
          padding: [30, 0]
          align: .center
          Text("没有找到书源") { font: .headline }
          Text(if query.trim().isEmpty() {
            "这个分组里没有书源。"
          } else {
            "名字、地址和分组里都没有「{query.trim()}」。"
          }) {
            font: .footnote
            color: .secondaryLabel
            textAlign: .center
          }
          Button("清除搜索与分组") {
            on press {
              query = ""
              filter = ""
            }
          }
        }
      } else {
        List {
          grow: 1
          appearance: .plain
          for section in sections key section.key {
            Column {
              Row {
                gap: 8
                align: .center
                padding: [10, 0, 4, 0]
                on press {
                  if selecting { toggleGroup(section.rows) }
                }
                Text(section.title) {
                  font: .caption.bold()
                  color: .secondaryLabel
                  grow: 1
                }
                Text("{section.rows.count()}") {
                  font: .caption
                  color: .tertiaryLabel
                }
                if selecting {
                  Text(if section.rows.all(e => selected.contains(e.id)) { "取消本组" } else { "全选本组" }) {
                    font: .caption
                    color: .accent
                  }
                }
              }
              for e in section.rows key e.id {
                Column {
                  gap: 0
                  Row {
                    gap: 10
                    align: .center
                    padding: [9, 0]
                    if selecting {
                      Toggle {
                        on: selected.contains(e.id)
                        checkbox: true
                        height: 32
                        on change(v) { toggle(e.id) }
                      }
                    }
                    Column {
                      grow: 1
                      gap: 2
                      opacity: if e.enabled { 1 } else { 0.45 }
                      // 多选时整行都能点：不必去找那个小方框。
                      on press { if selecting { toggle(e.id) } }
                      Text(e.name) {
                        font: .body
                        lines: 1
                      }
                      Text(e.url) {
                        font: .caption
                        color: .tertiaryLabel
                        lines: 1
                      }
                      if !sources.entryGroups(e).isEmpty() {
                        Scroll {
                          width: 100%
                          horizontal: true
                          Row {
                            gap: 4
                            for g in sources.entryGroups(e) key g {
                              Text(g) {
                                font: .caption
                                color: .secondaryLabel
                                padding: [2, 6]
                                radius: 4
                                background: .secondaryBackground
                              }
                            }
                          }
                        }
                      }
                    }
                    if !selecting {
                      Button("") {
                        icon: Icons.key
                        variant: .plain
                        tooltip: "登录与变量"
                        on press { await toggleLogin(e) }
                      }
                      Toggle {
                        on: e.enabled
                        checkbox: true
                        height: 32
                        on change(v) { allSources.setEnabled(e.id, v) }
                      }
                      Button("") {
                        icon: Icons.trash
                        variant: .plain
                        on press { askDeleteOne(e) }
                      }
                    }
                  }
                  if loginId == e.id {
                    Column {
                      gap: 8
                      padding: [2, 0, 10, 0]
                      Segmented(if captchaOn { ["变量", "Cookie", "验证码"] } else { ["变量", "Cookie"] }) {
                        selected: loginTab
                        on change(i) { loginTab = i }
                      }
                      if loginTab == 0 {
                        if !loginHelp.isEmpty() {
                          Text(loginHelp) {
                            font: .caption
                            color: .secondaryLabel
                          }
                        }
                        if loginKeys.isEmpty() {
                          Text("规则里没写变量名；要登录就按书源说明写一段 JSON。") {
                            font: .caption
                            color: .tertiaryLabel
                          }
                        } else {
                          Text("这个书源要这些变量：{loginKeys.joined(separator: "、")}") {
                            font: .caption
                            color: .tertiaryLabel
                          }
                          if !loginRaw {
                            for key in loginKeys key key {
                              Column {
                                gap: 4
                                Text(key) {
                                  font: .caption.bold()
                                  color: .secondaryLabel
                                }
                                TextField {
                                  text: sources.variableValueOf(loginText, key)
                                  on change(v) { loginText = sources.withVariableValue(loginText, key, v) }
                                  placeholder: if secretVariable(key) { "密码或令牌" } else { "值" }
                                  autocapitalize: .off
                                  autocorrect: .no
                                  secure: secretVariable(key)
                                }
                              }
                            }
                          }
                        }
                        if loginKeys.isEmpty() || loginRaw {
                          TextField {
                            bind text: loginText
                            multiline: true
                            height: 120
                            autocapitalize: .off
                            autocorrect: .no
                            placeholder: r#"{"user":"…","pass":"…"}"#
                          }
                          Text(if isJsonObject(loginText) {
                            "这段 JSON 可以保存。"
                          } else {
                            r#"还不是一段 JSON 对象：要像 {"user":"…"} 这样。"#
                          }) {
                            font: .caption
                            color: if isJsonObject(loginText) { .secondaryLabel } else { .orange }
                          }
                        }
                        if !loginKeys.isEmpty() {
                          Button(if loginRaw { "回到逐项填写" } else { "原始 JSON" }) {
                            variant: .plain
                            on press { loginRaw = !loginRaw }
                          }
                        }
                        Text("保存后，下一次搜索或发现会用它登录。") {
                          font: .caption
                          color: .tertiaryLabel
                        }
                        Row {
                          gap: 10
                          Button(if loginBusy { "保存中…" } else { "保存变量" }) {
                            on press { await saveLogin(e) }
                            disabled: loginBusy || !isJsonObject(loginText)
                          }
                          Button(if verifying {
                            "验证中…"
                          } else if cookieHave && hasFilledVariables() {
                            "清 Cookie 再验证"
                          } else {
                            "搜一次验证"
                          }) {
                            on press { await verifyLogin(e) }
                            disabled: verifying
                          }
                          Button("收起") {
                            variant: .plain
                            on press { loginId = "" }
                          }
                        }
                        if !loginNote.isEmpty() {
                          Text(loginNote) {
                            font: .footnote
                            color: .secondaryLabel
                          }
                        }
                      } else if loginTab == 1 {
                        Text("网页登录") {
                          font: .caption.bold()
                          color: .secondaryLabel
                        }
                        Text(if cookieHave {
                          "已经有一份 Cookie。粘新的保存会换掉它（同一个地址），换账号就用这个。"
                        } else {
                          "在浏览器登录后，把 Cookie 请求头粘到这里。"
                        }) {
                          font: .caption
                          color: .tertiaryLabel
                        }
                        TextField {
                          bind text: cookieText
                          multiline: true
                          height: 78
                          autocapitalize: .off
                          autocorrect: .no
                          placeholder: "jieqiUserInfo=…; jieqiUserName=…"
                        }
                        Row {
                          gap: 10
                          Button(if cookieBusy { "保存中…" } else { "保存 Cookie" }) {
                            on press { await saveCookie(e) }
                            disabled: cookieBusy
                          }
                          if cookieHave {
                            Button("清除 Cookie") {
                              variant: .plain
                              on press { await clearCookie(e) }
                              disabled: cookieBusy
                            }
                          }
                          Button("收起") {
                            variant: .plain
                            on press { loginId = "" }
                          }
                        }
                        if !cookieNote.isEmpty() {
                          Text(cookieNote) {
                            font: .footnote
                            color: .secondaryLabel
                          }
                        }
                      } else {
                        Text("图形验证码") {
                          font: .caption.bold()
                          color: .secondaryLabel
                        }
                        Text("这个站点的登录页要验证码。账号密码用「变量」页里填的，先取一张图，填上再登录。") {
                          font: .caption
                          color: .tertiaryLabel
                        }
                        if !captchaPath.isEmpty() {
                          Image(source: captchaPath) {
                            width: 136
                            height: 40
                            radius: 4
                            background: .secondaryBackground
                          }
                        }
                        Row {
                          gap: 10
                          Button(if captchaBusy {
                            "取图中…"
                          } else if captchaPath.isEmpty() {
                            "取验证码"
                          } else {
                            "换一张"
                          }) {
                            on press { await fetchCaptcha(e) }
                            disabled: captchaBusy
                          }
                          TextField {
                            bind text: captchaCode
                            placeholder: "图上的字"
                            width: 110
                            autocapitalize: .off
                            autocorrect: .no
                          }
                          Button(if captchaBusy { "登录中…" } else { "登录" }) {
                            on press { await captchaLogin(e) }
                            disabled: captchaBusy || captchaCode.trim().isEmpty()
                          }
                        }
                        if !captchaNote.isEmpty() {
                          Text(captchaNote) {
                            font: .footnote
                            color: .secondaryLabel
                          }
                        }
                        Button("收起") {
                          variant: .plain
                          on press { loginId = "" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }

      if selecting {
        Row {
          gap: 10
          align: .center
          Button("完成") {
            on press {
              selecting = false
              selected = []
              moving = false
            }
          }
          Button(if allSelected { "全不选" } else { "全选" }) {
            on press { toggleAll() }
          }
          Text("已选 {selected.count()}") {
            font: .footnote
            color: .secondaryLabel
            grow: 1
          }
          Button("") {
            icon: Icons.display
            variant: .glass
            tooltip: "批量操作"
            menu: [
              .button(title: "启用所选", disabled: selected.isEmpty(), run: () => { allSources.setEnabledMany(selected, true) }),
              .button(title: "停用所选", disabled: selected.isEmpty(), run: () => { allSources.setEnabledMany(selected, false) }),
              .button(title: "设置分组", disabled: selected.isEmpty(), run: () => {
                moving = true
                groupText = ""
              }),
              .button(title: "删除所选", role: .destructive, disabled: selected.isEmpty(), run: () => { askDelete() }),
            ]
          }
        }
      }
    }
  }
}

/// 导入书源：粘贴一段 JSON，或者从链接、文件取。
component SourceImport {
  use allSources: sources.Sources
  let env = environment()

  state mode = 0
  state text = ""
  state address = ""
  state busy = false
  state note = ""
  state error = ""
  /// 这一次真正新进来的书源：导入后列出来，才知道进来了什么。
  state addedNames: [string] = []

  let preview = previewOf(text)
  let ready = if mode == 0 { preview.count > 0 } else { !address.trim().isEmpty() }
  let previewNames = if preview.names.count() <= 3 {
    preview.names.joined(separator: "、")
  } else {
    "{preview.names.slice(0, 3).joined(separator: "、")} 等 {preview.count} 个"
  }
  let addedList = if addedNames.count() <= 5 {
    addedNames.joined(separator: "、")
  } else {
    "{addedNames.slice(0, 5).joined(separator: "、")} 等 {addedNames.count()} 个"
  }

  let engineNote = if sources.bookSourcesAvailable() {
    "书源规则与 JavaScript 由 {sources.nativeVersion()} 执行；cookie 和书源变量存在应用目录里。"
  } else {
    "这个平台还没有书源引擎（legado-engine），导入的书源暂时不能搜索。"
  }

  async fn run() {
    if busy { return }
    busy = true
    note = ""
    error = ""
    addedNames = []
    do {
      let report = if mode == 0 {
        try allSources.importText(text)
      } else {
        try await allSources.importUrl(address)
      }
      note = report.text()
      addedNames = report.names
      if report.added > 0 {
        text = ""
        address = ""
        // 书源自带的变量（Legado 的 `variable`）写进引擎：它不读 JSON
        // 里的这个字段，登录用的账号密码于是要先到这里。
        await allSources.seedVariables(report.ids)
      }
    } catch e {
      error = e.message
    }
    busy = false
  }

  async fn fromFile() {
    if busy { return }
    busy = true
    note = ""
    error = ""
    addedNames = []
    do {
      let paths = try await dialog.open(
        title: "导入书源",
        button: "导入",
        filters: [dialog.Filter(name: "书源 JSON", extensions: ["json", "txt"])],
      )
      var names: [string] = []
      for p in paths {
        let content = try await spawn { try fs.readText(p) }
        let report = try allSources.importText(content)
        note = if note.isEmpty() { report.text() } else { "{note}\n{report.text()}" }
        for name in report.names { names.push(name) }
        addedNames = names
        await allSources.seedVariables(report.ids)
      }
    } catch e {
      error = e.message
    }
    busy = false
  }

  /// 书源常常是别人发来的一段文字或一个链接：先读剪贴板，少一次长按。
  async fn pasteClipboard() {
    if busy { return }
    do {
      let got = try await device.clipboardText()
      let t = got?.trim() ?? ""
      if t.isEmpty() {
        error = "剪贴板里没有文字"
        return
      }
      error = ""
      if mode == 0 {
        text = t
      } else {
        address = t
      }
    } catch e {
      error = e.message
    }
  }

  Column {
    gap: 14
    padding: lib.sheetPad(env, top: 22, bottom: 28, side: 22)

    Row {
      gap: 8
      align: .center
      Text("导入书源") {
        font: .title3
        grow: 1
      }
      Button("") {
        icon: Icons.close
        variant: .glass
        on press { dismiss() }
      }
    }

    Segmented(["粘贴", "链接"]) {
      selected: mode
      on change(i) { mode = i }
    }

    if mode == 0 {
      TextField {
        bind text: text
        multiline: true
        placeholder: "把书源 JSON 粘在这里（单个或一份合集）"
        height: 200
      }
      if !text.trim().isEmpty() {
        // 先说是几个、叫什么，或者哪里不对：不用按了导入才知道。
        Text(if preview.error.isEmpty() {
          "识别到 {preview.count} 个书源：{previewNames}"
        } else {
          preview.error
        }) {
          font: .caption
          color: if preview.error.isEmpty() { .secondaryLabel } else { .orange }
          lines: 3
        }
      }
    } else {
      TextField {
        bind text: address
        placeholder: "https://…/sources.json"
        autocapitalize: .off
        autocorrect: .no
        returnKey: .search
      }
    }

    Row {
      gap: 10
      Button(if busy { "导入中…" } else { "导入" }) {
        on press { await run() }
        disabled: busy || !ready
      }
      Button("粘贴") {
        on press { await pasteClipboard() }
        disabled: busy
      }
      Button("从文件导入") {
        on press { await fromFile() }
        disabled: busy
      }
    }

    if !error.isEmpty() {
      Text(error) {
        font: .footnote
        color: .orange
      }
    }

    if !note.isEmpty() {
      Text(note) {
        font: .footnote
        color: .secondaryLabel
      }
    }

    if !addedNames.isEmpty() {
      Text("新导入：{addedList}") {
        font: .caption
        color: .secondaryLabel
        lines: 3
      }
    }

    Text(engineNote) {
      font: .caption
      color: .tertiaryLabel
    }
  }
}

/// 搜索结果的范围：全部（引擎怎么匹配就怎么算）、书名、作者，或精确
/// 匹配。Legado 的搜索接口只有一个关键词，所以这些是在结果回来后筛。
fn hitMatches(hit: Hit, q: string, scope: string) -> bool {
  let key = q.trim()
  if key.isEmpty() || scope == "all" { return true }
  if scope == "title" { return hit.book.name.contains(key, ignoreCase: true) }
  if scope == "author" { return hit.book.author.contains(key, ignoreCase: true) }
  if scope == "exact" {
    return hit.book.name.trim().equals(key, ignoreCase: true) ||
      hit.book.author.trim().equals(key, ignoreCase: true)
  }
  return true
}

fn scopeName(scope: string) -> string {
  if scope == "title" { return "书名" }
  if scope == "author" { return "作者" }
  if scope == "exact" { return "精确" }
  return "全部"
}

/// 列表里的一行：一本书，和合并重复书时它还在几个书源里。
struct ShownHit {
  hit: Hit
  also: int = 0
}

fn shownHits(results: [Hit], q: string, scope: string, dedupe: bool) -> [ShownHit] {
  let filtered = results.filter(h => hitMatches(h, q, scope))
  if !dedupe { return filtered.map(h => ShownHit(hit: h)) }
  var out: [ShownHit] = []
  for h in filtered {
    let key = "{h.book.name.lower()}\n{h.book.author.lower()}"
    var found = false
    for i in 0..<out.count() {
      let at = "{out[i].hit.book.name.lower()}\n{out[i].hit.book.author.lower()}"
      if at == key {
        var row = out[i]
        row.also += 1
        out[i] = row
        found = true
        break
      }
    }
    if !found { out.push(ShownHit(hit: h)) }
  }
  return out
}

struct SearchRequest {
  token: int = 0
  q: string = ""
}

/// 搜索页本身：没有结果时是提示，找到后是列表。一次搜索是一个带版本号
/// 的 task：再按一次搜索、或点停止，旧的 task 被取消，慢的请求回来也
/// 不会再写进界面。
screen Search {
  use allSources: sources.Sources

  /// 书架接住一本刚取回来的书：它已经是一本普通书了。
  event open(book: lib.Book)

  title: "搜索"
  bind search: key
  searchPlaceholder: "书名或作者"

  state key = ""
  state busy = false
  state results: [Hit] = []
  state note = ""
  /// 这一轮搜到哪儿了：每回来一个书源 +1。结果不再等全部书源。
  state searched = 0
  state failures: [string] = []
  /// 搜索结果的范围；只影响显示，不会少发一个书源请求。
  state scope = "all"
  /// 合并同名同作者的书，只留第一个来源，并标出还有几个来源。
  state dedupe = false
  /// 一次请求：token 变了就取消上一轮。
  state request = SearchRequest()

  let env = environment()
  let shown = shownHits(results, request.q, scope, dedupe)

  on searchSubmit { start() }

  toolbar {
    Button(scopeName(scope)) {
      icon: Icons.display
      variant: .glass
      tooltip: "搜索范围与结果"
      menu: [
        .section(title: "搜索范围", items: [
          .button(title: "全部", checked: scope == "all", run: () => { scope = "all" }),
          .button(title: "书名", checked: scope == "title", run: () => { scope = "title" }),
          .button(title: "作者", checked: scope == "author", run: () => { scope = "author" }),
          .button(title: "精确匹配", checked: scope == "exact", run: () => { scope = "exact" }),
        ]),
        .section(title: "结果", items: [
          .button(title: "合并重复书", checked: dedupe, run: () => { dedupe = !dedupe }),
        ]),
      ]
    }
    if busy {
      Button("停止") {
        icon: Icons.close
        variant: .glass
        tooltip: "停止这一轮搜索"
        on press { stop() }
      }
    }
  }

  /// 一个书源回来就写进结果：不再等最慢的那个。
  async fn searchOne(e: sources.Entry, q: string, run: int) -> Outcome {
    if request.token != run { return Outcome() }
    let def = allSources.definition(e)
    if def == none {
      if request.token == run {
        searched += 1
        failures.push("{e.name} 的书源读不出来")
      }
      return Outcome(failed: "{e.name} 的书源读不出来")
    }
    do {
      let books = try await sources.search(def!, q, 1)
      if request.token != run { return Outcome() }
      let hits = books.map(b => Hit(sourceId: e.id, sourceName: e.name, book: b))
      results = (results + hits).sorted(key: h => h.book.name)
      searched += 1
      return Outcome(hits: hits)
    } catch err {
      if request.token != run { return Outcome() }
      searched += 1
      failures.push("{e.name}：{err.message}")
      return Outcome(failed: "{e.name}：{err.message}")
    }
  }

  fn start() {
    let q = key.trim()
    if q.isEmpty() { return }
    if !sources.bookSourcesAvailable() {
      results = []
      note = "这个平台还没有书源引擎（legado-engine），暂时不能搜索书源"
      snackbar(note)
      return
    }
    if allSources.enabledCount() == 0 {
      results = []
      note = "还没有可用的书源，先去发现页导入一个"
      snackbar(note)
      return
    }
    request = SearchRequest(token: request.token + 1, q: q)
  }

  fn stop() {
    if !busy { return }
    request = SearchRequest(token: request.token + 1, q: "")
    snackbar("已停止搜索")
  }

  // 搜索在一个 task 里：request.token 一变（新搜索或停止），上一轮就被
  // 取消；它正在 await 的 all(...) 也会被取消，而不是留在后台继续跑。
  task(request.token) {
    if request.q.isEmpty() {
      busy = false
      return
    }
    await run(request.q, request.token)
  }

  async fn run(q: string, run: int) {
    busy = true
    note = ""
    results = []
    failures = []
    searched = 0
    let total = allSources.enabledCount()
    snackbar("正在 {total} 个书源里找「{q}」…")
    let list = allSources.enabled()
    let _outcomes = await all(list, e => await searchOne(e, q, run), limit: 8)
    if request.token != run { return }
    busy = false
    let found = shownHits(results, q, scope, dedupe).count()
    if found == 0 {
      if !results.isEmpty() {
        note = "找到 {results.count()} 本，但没有符合「{scopeName(scope)}」这范围的"
      } else if failures.isEmpty() {
        note = "没有找到「{q}」"
      } else {
        note = "没有找到「{q}」。{failures.first() ?? ""}"
      }
      snackbar(note)
    } else {
      note = ""
      let extra = if failures.isEmpty() { "" } else { " · {failures.count()} 个书源失败" }
      snackbar("找到 {found} 本{extra}")
    }
  }

  // 上下的安全区不能整页套 SafeArea：结果列表自己会按 tab 栏调整，
  // 再让一次就滚不到玻璃下面。左右让开；搜索框在导航栏里，内容从栏下开始。
  View {
    grow: 1
    padding: [0, env.safeLeft, 0, env.safeRight]

    if allSources.isEmpty() {
      Column {
        grow: 1
        justify: .center
        align: .center
        gap: 14
        padding: [24, 40, env.safeBottom + 24, 40]
        Symbol(Icons.contents) {
          font: .title
          color: .tertiaryLabel
        }
        Text("还没有书源") {
          font: .title3
        }
        Text("书源告诉 Quire 去哪里搜、怎么读一本书。去发现页导入一份阅读3.0（Legado）的书源 JSON 就可以开始。") {
          font: .footnote
          color: .secondaryLabel
          textAlign: .center
        }
        Button("返回发现页") {
          on press { pop() }
        }
      }
    } else if shown.isEmpty() {
      Column {
        grow: 1
        justify: .center
        align: .center
        gap: 10
        padding: [24, 40, env.safeBottom + 24, 40]
        if busy {
          ProgressRing {}
          Text("正在 {allSources.enabledCount()} 个书源里找…（{searched}/{allSources.enabledCount()}）") {
            font: .footnote
            color: .secondaryLabel
          }
        } else {
          Symbol(Icons.search) {
            font: .title
            color: .tertiaryLabel
          }
          Text(if !note.isEmpty() {
            note
          } else if !results.isEmpty() {
            "没有符合「{scopeName(scope)}」这范围的书"
          } else {
            "在 {allSources.enabledCount()} 个书源里搜一本书"
          }) {
            font: .footnote
            color: .secondaryLabel
            textAlign: .center
          }
        }
      }
    } else {
      List {
        appearance: .plain
        grow: 1
        for row in shown key "{row.hit.sourceId}:{row.hit.book.bookUrl}" {
          ResultRow(row.hit) {
            also: row.also
            on open {
              push(SearchBook(row.hit) {
                on open(book) { emit open(book) }
              })
            }
          }
        }
      }
    }
  }
}

/// 发现：带 exploreUrl 的书源。每个书源是 List 的一个分区，它的分类就是
/// 分区里的原生行；点分类直接看这个分类的书。走的是引擎的
/// `legado_explore`，和搜索共用同一套规则、JavaScript 和 cookie。
screen Discover {
  use allSources: sources.Sources

  event open(book: lib.Book)

  title: "发现"
  let env = environment()
  // 书源列表是 load 的输入：导入、删除或改开关后，发现页立刻重读，
  // 不用退出这一页再进来。
  let sourceEntries = allSources.entries
  let rows = load exploreSources(allSources, sourceEntries)
  let sources: [ExploreSource] = match rows {
    .ready(list) => list
    _ => []
  }
  /// 只看一个书源（空的是全部）：书源一多，横着挑比竖着翻快。
  state jump = ""
  let picked = sources.find(s => s.id == jump)
  let shown = if picked == none { sources } else { [picked!] }
  toolbar {
    Button("搜索书源") {
      icon: Icons.search
      variant: .glass
      tooltip: "搜索书源"
      on press {
        push(Search() {
          on open(book) { emit open(book) }
        })
      }
    }
    Button("书源管理") {
      icon: Icons.contents
      variant: .glass
      tooltip: "管理书源"
      on press { present(SourceManager()) }
    }
    Button("导入") {
      icon: Icons.add
      variant: .glass
      tooltip: "导入书源"
      on press { present(SourceImport()) }
    }
  }

  View {
    grow: 1
    padding: [0, env.safeLeft, 0, env.safeRight]
    match rows {
      .pending => Column {
        grow: 1
        justify: .center
        align: .center
        gap: 12
        padding: [24, 40]
        ProgressRing {}
        Text("正在读取书源的发现页…") {
          font: .footnote
          color: .secondaryLabel
        }
      }
      .failed(e) => Column {
        grow: 1
        justify: .center
        align: .center
        gap: 12
        padding: [24, 40]
        Text("发现页没有读出来") { font: .headline }
        Text(e.message) {
          font: .footnote
          color: .secondaryLabel
          textAlign: .center
        }
        Button("重试") {
          on press { rows.reload() }
        }
      }
      .ready(list) => if list.isEmpty() {
        Column {
          grow: 1
          justify: .center
          align: .center
          gap: 12
          padding: [24, 40]
          Symbol(Icons.globe) {
            font: .title
            color: .tertiaryLabel
          }
          Text("没有带发现页的书源") {
            font: .headline
          }
          Text("这个书源的 exploreUrl 是空的，或者还没有启用。导入或管理书源在右上角。") {
            font: .footnote
            color: .secondaryLabel
            textAlign: .center
          }
        }
      } else {
        // 整页只有一个 List：顶部 inset、状态栏和导航栏都交给它。分类是
        // 标签、书源是标题，行与行之间用留白分开，所以不要 List 的分割线
        // 和分组底色（Bare）；Plain 会在第一行上面也画一条。
        List {
          appearance: .bare
          grow: 1
          for (i, s) in shown.enumerated() key s.id {
            Column {
              gap: 0
              if i == 0 && sources.count() > 1 {
                Scroll {
                  width: 100%
                  horizontal: true
                  padding: [0, lib.pageKeyline, 8, lib.pageKeyline]
                  Row {
                    gap: 8
                    SourceFilterChip("全部", jump.isEmpty()) {
                      on choose { jump = "" }
                    }
                    for x in sources key x.id {
                      SourceFilterChip(x.name, jump == x.id) {
                        on choose { jump = if jump == x.id { "" } else { x.id } }
                      }
                    }
                  }
                }
              }
              Row {
                gap: 8
                align: .center
                padding: [if i == 0 && sources.count() <= 1 {
                  0
                } else if i == 0 {
                  6
                } else {
                  12
                }, lib.pageKeyline, 10, lib.pageKeyline]
                Text(s.name) {
                  font: .headline
                  grow: 1
                  lines: 1
                }
                Text(if s.group.isEmpty() { "{s.categories.count()} 个分类" } else { "{s.group} · {s.categories.count()} 个分类" }) {
                  font: .caption
                  color: .secondaryLabel
                  lines: 1
                }
              }
              Row {
                wrap: true
                gap: 8
                padding: [0, lib.pageKeyline]
                for c in s.categories key c.url {
                  CategoryChip(c.title) {
                    on choose {
                      push(DiscoverList(ExploreHit(sourceId: s.id, sourceName: s.name, category: c)) {
                        on open(book) { emit open(book) }
                      })
                    }
                  }
                }
              }
              View { height: 14 }
            }
          }
        }
      }
    }
  }
}

/// 一个发现分类里的书。点一本和搜索结果一样，进详情。
screen DiscoverList(row: ExploreHit) {
  use allSources: sources.Sources

  event open(book: lib.Book)

  title: row.category.title
  let target = row.category.url
  let books = load booksOf(row)

  async fn booksOf(the: ExploreHit) throws -> [sources.Book] {
    if the.category.url.trim().isEmpty() { throw Error("这个分类没有地址") }
    let def = allSources.definitionOf(the.sourceId)
    if def == none { throw Error("这个书源已经不在列表里了") }
    // 有些书源自己的发现页会绕远路；到了时间还没回来，说清楚，而不是
    // 一直停在“正在打开”。
    return try await withTimeout(20s) {
      return try await sources.explore(def!, the.category.url)
    }
  }

  /// 已经翻到的页：第一页在 `books`，后面的接在 `extra` 里。
  state extra: [sources.Book] = []
  state nextPage = 2
  state loadingMore = false
  state moreNote = ""
  /// 静态分类地址只有第一页，就不给「加载更多」。
  state more = sources.canExplorePages(row.category.url)
  let shownBooks = (books.value ?? []) + extra

  /// List 的每一行：先书，最后是「加载更多」那一行（到了头就没有）。
  fn shownRows() -> [DiscoverBookRow] {
    var out = shownBooks.enumerated().map(p => DiscoverBookRow.book(p.1, p.0))
    if more || loadingMore || !moreNote.isEmpty() {
      out.push(DiscoverBookRow.more)
    }
    return out
  }

  async fn loadMore() {
    if loadingMore || !more { return }
    let def = allSources.definitionOf(row.sourceId)
    if def == none {
      more = false
      moreNote = "这个书源已经不在列表里了"
      return
    }
    loadingMore = true
    moreNote = ""
    do {
      let found = try await withTimeout(20s) {
        return try await sources.explorePage(def!, url: row.category.url, page: nextPage)
      }
      // 有些不带页号的地址会一直回同一页：没有新的书就算到头了。
      var fresh: [sources.Book] = []
      var seen = shownBooks.map(b => b.bookUrl)
      for b in found {
        if b.bookUrl.isEmpty() || seen.contains(b.bookUrl) { continue }
        seen.push(b.bookUrl)
        fresh.push(b)
      }
      if fresh.isEmpty() {
        more = false
        moreNote = "没有更多了"
      } else {
        extra = extra + fresh
        nextPage += 1
      }
    } catch e {
      moreNote = e.message
    }
    loadingMore = false
  }

  View {
    grow: 1
    match books {
      .pending => Column {
        grow: 1
        justify: .center
        align: .center
        gap: 12
        padding: [24, 40]
        ProgressRing {}
        Text("正在打开「{row.category.title}」…") {
          font: .footnote
          color: .secondaryLabel
        }
        Text(target) {
          font: .caption2
          color: .tertiaryLabel
          textAlign: .center
          lines: 2
        }
      }
      .failed(e) => Column {
        grow: 1
        justify: .center
        align: .center
        gap: 12
        padding: [24, 40]
        Text("这个分类没有打开") { font: .headline }
        Text(e.message) {
          font: .footnote
          color: .secondaryLabel
          textAlign: .center
        }
        Text(target) {
          font: .caption2
          color: .tertiaryLabel
          textAlign: .center
          lines: 2
        }
        Button("重试") {
          on press { books.reload() }
        }
      }
      .ready(list) => if list.isEmpty() && extra.isEmpty() {
        Column {
          grow: 1
          justify: .center
          align: .center
          gap: 10
          padding: [24, 40]
          Symbol(Icons.globe) {
            font: .title
            color: .tertiaryLabel
          }
          Text("这个分类里没有书") {
            font: .footnote
            color: .secondaryLabel
          }
        }
      } else {
        List {
          appearance: .plain
          grow: 1
          for r in shownRows() key r.key() {
            match r {
              .book(book, _) => ExploreResultRow(row, book) {
                on open {
                  push(SearchBook(Hit(sourceId: row.sourceId, sourceName: row.sourceName, book: book)) {
                    on open(b) { emit open(b) }
                  })
                }
              }
              .more => Column {
                gap: 6
                align: .center
                padding: [6, lib.pageKeyline, 24, lib.pageKeyline]
                if loadingMore {
                  ProgressRing {}
                } else if more {
                  Button("加载更多") {
                    on press { await loadMore() }
                  }
                }
                if !moreNote.isEmpty() {
                  Text(moreNote) {
                    font: .footnote
                    color: .secondaryLabel
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
