// Quire on Asuka: the shelf, and a reading page whose layout is the engine's
// (ebook-engine, Rust, through its C ABI), drawn by each platform's own view.

import std/fs

import ./lib
import ./sources
import ./engine

/// 版本号：asuka.toml 的 `version`，「我」和「关于」都读这一处，改版本
/// 只改这里和 asuka.toml 两行。
let appVersion = "0.1"

/// The app's own root: the shelf and the book it opened, as two views, not a
/// modal presented over the shelf. The reading page is a full-window layer,
/// so the paper reaches the status bar too and the shelf's own bar is under
/// it, not behind it.
component Quire {
  use library: Library
  use allSources: sources.Sources?

  state reading = lib.Book(id: "", title: "", author: "", chapters: [])
  /// The reader's layer is mounted while the engine opens the book, and shown
  /// once its first page is on screen: the open animation then ends on a page,
  /// not on paper that fills in after it.
  state readingMounted = false
  state readingShown = false
  /// Which tab shows. The shelf is the one the app opens on; 发现 is the
  /// third tab, and its bar's top right opens 搜索.
  state tab = 1

  /// 别的应用递进来的东西：文件（「用 Quire 打开」）和链接（浏览器的
  /// yuedu:// / legado://）。这些登记在 App 的根组件上：它一直在，冷启动
  /// 时系统也找得到——放在 Tab 里的组件那时还没挂上。
  state incomingFiles: [string] = []
  state incomingLink = ""

  onOpenFiles(paths => { incomingFiles = paths })
  onOpenURL(raw => { incomingLink = raw })

  let paper = lib.paletteFor(library.theme).paper

  /// 打开一本书：云端书先只下载这一本，校验后再把阅读页放上来。
  /// 本地书则直接打开，不碰网络。
  async fn openBook(book: lib.Book) {
    if book.remote {
      snackbar("正在从云端下载《{book.title}》…")
    }
    do {
      reading = try await library.prepare(book)
      readingShown = false
      readingMounted = true
    } catch e {
      snackbar(lib.plain(e.message))
    }
  }

  /// The reader's first page is there (or it says why there isn't one): it
  /// rises into the window over the shelf, paper and all.
  fn revealReader() {
    if !readingMounted || readingShown { return }
    animate(Animation(duration: 520ms, curve: .spring)) { readingShown = true }
  }

  // 递进来的文件和链接不能等（onOpenFiles / onOpenURL 不是 async），
  // 先记下，再交给能等的 task：一个 task 处理文件，一个处理链接。
  task(incomingFiles) {
    if incomingFiles.isEmpty() { return }
    // 清空要等处理完：task 的 key 就是 incomingFiles，先在 await 之前写它
    // 会把正在跑的这个 task 取消掉（导入于是停在半路）。
    await receiveFiles(incomingFiles)
    incomingFiles = []
  }

  task(incomingLink) {
    if incomingLink.isEmpty() { return }
    await importLink(incomingLink)
    incomingLink = ""
  }

  /// 文件按后缀分派：.json 是书源合集，.txt/.epub 是书。书走书架「导入」
  /// 同一条路（进度、去重与汇总）；几份书源合集也先报进度，最后把
  /// 各自的计数加起来说一句。
  async fn receiveFiles(paths: [string]) {
    var collections: [string] = []
    var books: [string] = []
    for p in paths {
      if lib.fileName(p).lower().hasSuffix(".json") {
        collections.push(p)
      } else {
        books.push(p)
      }
    }

    let manyCollections = collections.count() > 1
    var total: sources.ImportReport? = none
    for (i, p) in collections.enumerated() {
      let name = lib.fileName(p)
      if manyCollections { snackbar("正在导入书源 {i + 1}/{collections.count()}：{name}") }
      if let report = await importSourceFile(p, name, quiet: manyCollections) {
        total = if let t = total { t.plus(report) } else { report }
      }
    }
    if manyCollections {
      if let t = total { snackbar(t.text()) }
    }

    await bringBooks(library, books)
  }

  /// 一份书源合集（或别的从文件递进来的东西）：交给引擎分类，读出来的
  /// 书源补上变量。结果交给调用方（多份时要汇总），这里只在单份时说话。
  async fn importSourceFile(p: string, name: string, quiet: bool = false) -> sources.ImportReport? {
    if let store = allSources {
      do {
        let text = try await spawn { try fs.readText(p) }
        let report = try await store.importAny(text)
        if !quiet { snackbar(report.text()) }
        await store.seedVariables(report.ids)
        return report
      } catch e {
        if !quiet { snackbar(lib.plain(e.message)) }
        return none
      }
    } else {
      if !quiet { snackbar("这个平台还没有书源引擎，打不开 {name}") }
      return none
    }
  }

  /// 一键导入的链接：`yuedu://booksource/importonline?src=…` 和
  /// `legado://import/auto?src=…` 的语法是引擎的，原样交给它解。
  async fn importLink(raw: string) {
    if let store = allSources {
      do {
        let report = try await store.importAny(raw)
        snackbar(report.text())
        await store.seedVariables(report.ids)
      } catch e {
        snackbar(lib.plain(e.message))
      }
    } else {
      snackbar("这个平台还没有书源引擎（legado-engine）")
    }
  }

  // A book whose first page takes long still gets shown: it says what it's
  // doing rather than leaving the shelf looking untouched.
  task("{readingMounted}:{readingShown}") {
    if !readingMounted || readingShown { return }
    await sleep(1200ms)
    revealReader()
  }

  // A launch's first steps, in order: rows written by an older build keep
  // their files' whole paths (iOS may have renamed that container since), so
  // they're cut back to names; the samples go on the shelf once; and then,
  // if the reader asked for it, the shelf meets the server's.
  task {
    library.migratePaths()
    // A page file names its book, type and chapter, not the engine build that
    // drew it. After an engine update (0.6.0's typography changes pagination)
    // the old bands must not be shown again.
    dropPagesFromAnotherEngine()
    // 原生书源引擎的 cookie 和书源变量放在应用目录里；没有这个库的平台
    // 什么都不做，书源搜索会直接说这个平台暂时没有引擎。
    sources.nativeOpen(fs.join([fs.appDir(), "legado"]))
    await library.loadCredentials()
    await library.seedSamples()
    // 引擎的自检：链接进来的库是按哪一版 C ABI 编的，以及它有没有这个
    // 应用要的两种格式。两者都是构建的问题，一次说清比等到开第一本书
    // 再失败好；真正的目录、图片和缓存信息在「关于 Quire」里。
    if let probe = engine.newBook("Quire") {
      if engine.abiVersion() != engine.expectedAbi {
        snackbar("引擎 ABI 不匹配：库是 {engine.abiVersion()}，应用按 {engine.expectedAbi} 编译")
      } else {
        // 自检书是一本流式书：能查到 stream 就说明句柄、排版会话和
        // 章节流这条链是通的。EPUB 与 TXT 的能力按各自打开的书查，
        // 导入时再校。
        let caps = engine.capabilities(probe)
        if !caps.stream {
          snackbar("引擎自检失败：流式章节不可用")
        }
      }
    }
    if let s = allSources {
      s.applySync(await library.syncIfAuto(s.syncState()))
      // 书源变量：导入的 JSON 里带着一份（Legado 的 `variable`），引擎
      // 不读它，只读存储目录下的那份。开机补一次，几年旧书源和从同步
      // 里拿回来的书源也能登。
      await s.seedVariables()
    }
  }

  View {
    grow: 1
    background: paper

    Tabs {
      selected: tab
      on change(i) { tab = i }

      Tab("首页") {
        icon: Icons.home
        Stack {
          Home() {
            on open(book) { await openBook(book) }
          }
        }
      }
      Tab("书架") {
        icon: Icons.shelf
        Stack {
          Shelf() {
            on open(book) { await openBook(book) }
          }
        }
      }
      Tab("发现") {
        icon: Icons.globe
        Stack {
          Discover() {
            on open(book) { await openBook(book) }
          }
        }
      }
    }

    // The reader is a layer of the app, not a sheet: no presentation
    // container around it, so its own paper is what the window shows.
    if readingMounted {
      View {
        absolute: true
        top: 0
        left: 0
        right: 0
        bottom: 0
        background: paper
        opacity: if readingShown { 1 } else { 0 }
        transform: if readingShown { Transform() } else { Transform(y: 12, scale: 0.94) }
        Reader(reading) {
          on ready { revealReader() }
          // The page settles back before the layer goes: the reader stays
          // whole for the whole fade, pages and all.
          on close {
            await animate(Animation(duration: 240ms, curve: .easeIn)) { readingShown = false }
            readingMounted = false
          }
        }
      }
    }
  }
}

app {
  provide Library()
  provide sources.Sources()
  Quire()
}
