// A book the app feeds (an online source), through the app's own bindings: a
// title, then chapters appended as they arrive, each replaceable in place. The
// reader's online path is this and nothing else, so this is what it stands on.

import std/embed

import ./engine
import ./remote

let streamFace = embed.bytes("fonts/NotoSerifSC-Regular.woff")

/// A stream book with a font, as the reader opens an online book.
fn streamBook(title: string) -> int {
  let id = engine.newBook(title)
  let _font = engine.registerFontBytes(id, data: streamFace)
  return id
}

fn paragraphsOf(lines: [string]) -> string = lines.joined(separator: "\n")

let streamMargins = engine.Margins(top: 0, right: 24, bottom: 0, left: 24)

test "a fed book has the chapters it was given, in order" {
  let id = streamBook("在线书")
  expect(id > 0)
  expect(engine.chapterCount(id) == 0)
  expect(engine.appendChapter(id, title: "第一章", text: paragraphsOf(["甲。", "乙。"])) == 1)
  expect(engine.appendChapter(id, title: "第二章", text: paragraphsOf(["丙。"])) == 2)
  expect(engine.chapterCount(id) == 2)

  let pages = engine.layout(id, 0, 390, 844, streamMargins, 1.0, 1.6)
  expect(pages > 0)
  expect(engine.pageInfo(id, 0).ok == 1)
  // 一章的正文在它自己的位置上，不在邻章里。
  expect(engine.progress(id, 0) >= 0)
  engine.close(id)
}

test "replacing a chapter keeps its place and changes its version" {
  let id = streamBook("在线书")
  let _a = engine.appendChapter(id, title: "第一章", text: "占位。")
  let _b = engine.appendChapter(id, title: "第二章", text: "第二章的正文。")
  let before = engine.chapterRev(id, 0)
  expect(before > 0)
  expect(engine.chapterRev(id, 1) != before)

  // 正文到了：换掉占位，章号不变，版本变了（页位图的键就靠它）。
  expect(engine.replaceChapter(id, spine: 0, title: "第一章", text: paragraphsOf(["甲。", "乙。", "丙。"])))
  expect(engine.chapterCount(id) == 2)
  expect(engine.chapterRev(id, 0) != before)
  // 换过的那一章排版是新正文，没换的那一章还在。
  let pages = engine.layout(id, 0, 390, 844, streamMargins, 1.0, 1.6)
  expect(pages > 0)
  expect(engine.layout(id, 1, 390, 844, streamMargins, 1.0, 1.6) > 0)
  // 越界、空正文都不收：读者看见的是一个明确的失败，不是半章。
  expect(!engine.replaceChapter(id, spine: 9, title: "x", text: "x"))
  expect(!engine.replaceChapter(id, spine: 0, title: "x", text: ""))
  engine.close(id)
}

test "clearing a fed book leaves it empty and ready for another window" {
  let id = streamBook("在线书")
  let _a = engine.appendChapter(id, title: "第一章", text: "甲。")
  expect(engine.clearChapters(id))
  expect(engine.chapterCount(id) == 0)
  // 换一窗：章从 0 重新数，读者看见的是新的一批。
  expect(engine.appendChapter(id, title: "第四十一章", text: "乙。") == 1)
  expect(engine.layout(id, 0, 390, 844, streamMargins, 1.0, 1.6) > 0)
  engine.close(id)
}

test "a fed book is a scroll column like any other" {
  let id = streamBook("在线书")
  for k in 0..<4 {
    let _n = engine.appendChapter(id, title: "第 {k + 1} 章", text: paragraphsOf(["甲。", "乙。", "丙。", "丁。"]))
  }
  expect(engine.beginScroll(id, 390, 844, streamMargins, 1.0, 1.6) == 4)
  let total = engine.flowHeight(id)
  expect(total > 0)
  // 后面的章到了：追加一章，列就长一章（引擎给新章一个估计高度）。
  let _n = engine.appendChapter(id, title: "第 5 章", text: paragraphsOf(["戊。"]))
  expect(engine.flowHeight(id) > total)
  expect(engine.beginScroll(id, 390, 844, streamMargins, 1.0, 1.6) == 5)

  // 换一章的正文：它按占位量过的高度作废，量新正文，列的总高跟着变。
  let before = engine.flowHeight(id)
  var many: [string] = []
  for k in 0..<200 { many.push("第 {k} 句：这一章的正文比占位长得多，要占好几屏。") }
  let _ok = engine.replaceChapter(id, spine: 4, title: "第 5 章", text: paragraphsOf(many))
  let chapter = engine.flowChapter(id, 4)
  expect(chapter.ok)
  expect(chapter.height > 844)
  expect(engine.flowHeight(id) > before)
  engine.close(id)
}

test "a window's chapters are a slice of the book's" {
  // 在线书一窗接一窗地读；窗口的起止是全书的哪几章，读者和书签都按全书算。
  expect(windowBaseFor(0) == 0)
  expect(windowBaseFor(3) == 0)
  expect(windowBaseFor(4) == 0)
  expect(windowBaseFor(43) == 40)
  expect(windowBaseFor(44) == 40)
  expect(windowBaseFor(84) == 80)
  expect(windowCountOf(100, base: 0) == 40)
  expect(windowCountOf(100, base: 80) == 20)
  expect(windowCountOf(10, base: 0) == 10)
  expect(windowCountOf(10, base: 10) == 0)
}

test "a chapter's text reaches the engine as paragraphs" {
  let id = streamBook("在线书")
  let text = remote.chapterBody("  第一段。\n\n第二段。  \n", at: 0)
  expect(text == "第一段。\n第二段。")
  let _n = engine.appendChapter(id, title: "第一章", text: text)
  expect(engine.layout(id, 0, 390, 844, streamMargins, 1.0, 1.6) > 0)
  engine.close(id)
}
