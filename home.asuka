// The home page: what is still being read, the year's goal, what was read
// before, and the books this year has had. The avatar at the top is the way
// into the reader's own settings; its entries are placeholders for now.

import std/time

import ./lib

/// The year it is now, and a place's year: a reading row keeps the moment it
/// was last saved as unix seconds, so "this year" is a comparison of clocks.
fn thisYear() -> int = time.now().year()

fn yearOf(seconds: int) -> int {
  if seconds <= 0 { return 0 }
  return time.unix(seconds: seconds).year()
}

/// A saved place as a day: "6月1日" for a row that has one.
fn whenOf(seconds: int) -> string {
  if seconds <= 0 { return "" }
  return time.unix(seconds: seconds).format("M月d日")
}

fn percentText(p: float) -> string = "{(p * 100).int()}%"

/// A title's book, from the shelf's rows the home page already has.
fn bookOf(books: [lib.Book], id: string) -> lib.Book? {
  for b in books {
    if b.id == id { return b }
  }
  return none
}

fn isReading(r: lib.Reading) -> bool = r.percent > 0.001 && r.percent < 0.999

fn isDone(r: lib.Reading) -> bool = r.percent >= 0.999

/// The home page's rows, in the order they show: what to pick up, how the
/// year is going, and what was finished before it.
enum HomeSection {
  reading
  year
  done
}

/// How far a book is read, as the thin bar the page's rows carry.
component ReadingBar(value: float) {
  prop color: Color = .accent

  View {
    height: 4
    radius: 2
    background: .separator
    View {
      width: 100% * value
      height: 4
      radius: 2
      background: color
    }
  }
}

component SectionHead(title: string) {
  prop icon = ""

  Row {
    gap: 8
    align: .center
    if !icon.isEmpty() {
      Symbol(icon) {
        font: .footnote
        color: .secondaryLabel
      }
    }
    Text(title) {
      font: .title3.bold()
      grow: 1
    }
  }
}

component EmptyNote(text: string) {
  prop icon = Icons.emptyBook

  Row {
    gap: 10
    align: .center
    padding: [14, 16]
    radius: 14
    background: .secondaryBackground
    Symbol(icon) {
      font: .subheadline
      color: .tertiaryLabel
    }
    Text(text) {
      font: .footnote
      color: .secondaryLabel
      grow: 1
    }
  }
}

/// 继续阅读: the one book to pick up again. A card rather than a list, so a
/// reader with ten books open still sees the rest of the page; the shelf is
/// where all of them are. The bar says how far, and is the only thing that
/// does — a number beside it would say the same.
component ContinueCard(book: lib.Book, reading: lib.Reading) {
  event open

  Row {
    gap: 14
    align: .center
    padding: 14
    radius: 18
    background: .secondaryBackground
    on press { emit open }
    Cover(book) { size: 64 }
    Column {
      grow: 1
      // 标题再长也不挤封面：这一列从零开始拿剩下的宽。
      shrink: 1
      basis: 0
      minWidth: 0
      gap: 9
      Text(book.title) {
        font: .headline
        lines: 2
      }
      ReadingBar(reading.percent)
    }
  }
}

/// A book in one of the page's sideways strips: a cover and its title, as a
/// shelf of what was finished.
component MiniBook(book: lib.Book) {
  event open

  Column {
    width: 104
    gap: 6
    align: .center
    on press { emit open }
    Cover(book) { size: 104 }
    Text(book.title) {
      font: .subheadline
      lines: 1
      textAlign: .center
    }
  }
}

/// 阅读目标: a ring for the year, and a stepper to change the number.
component GoalCard(done: int, goal: int, filled: float) {
  event goalChange(goal: int)

  Row {
    gap: 16
    align: .center
    padding: 16
    radius: 18
    background: .secondaryBackground
    ProgressRing {
      value: filled
      width: 62
      color: if goal > 0 && done >= goal { .green } else { .accent }
    }
    Column {
      grow: 1
      Text(if goal > 0 && done >= goal { "今年的目标读完了" } else { "今年读完了 {done} 本" }) {
        font: .headline
      }
    }
    Stepper {
      value: float(goal)
      min: 1
      max: 200
      on change(v) { emit goalChange(int(v)) }
    }
  }
}

/// 今年读过的书: a log. The date it was last read leads, the title follows;
/// no cover and no bar — those belong to the two sections above it.
component YearRow(book: lib.Book, reading: lib.Reading) {
  event open

  Row {
    gap: 12
    align: .center
    padding: [11, 0]
    on press { emit open }
    Text(whenOf(reading.updated)) {
      font: .caption2
      color: .tertiaryLabel
      width: 52
    }
    Column {
      grow: 1
      gap: 2
      Text(book.title) {
        font: .body
        lines: 1
      }
      if !book.author.isEmpty() {
        Text(book.author) {
          font: .caption2
          color: .secondaryLabel
          lines: 1
        }
      }
    }
    Text(if isDone(reading) { "读完" } else { percentText(reading.percent) }) {
      font: .caption2
      color: if isDone(reading) { .green } else { .secondaryLabel }
    }
  }
}

/// 我：the avatar's page. 同步与备份 and 阅读记录统计 have screens behind
/// them; 关于 Quire is the one entry without a page yet.
component Profile {
  use library: Library

  /// Which page this sheet shows: its own list, or the WebDAV setup.
  state page = ""

  let syncNote = if !library.davConfigured() {
    "跨设备同步书架、进度与书签"
  } else if library.syncLast > 0 {
    "上次同步 {whenOf(library.syncLast)}"
  } else {
    "已配置 · 尚未同步"
  }

  let readingNote = if library.readingDays.isEmpty() {
    "读完的书、读过的日子"
  } else {
    "{lib.daysRead(library.readingDays)} 天 · {span(lib.total(library.readingDays))}"
  }
  let entries = [
    ProfileEntry(icon: Icons.cloud, title: "同步与备份", note: syncNote),
    ProfileEntry(icon: Icons.statistics, title: "阅读记录统计", note: readingNote),
    ProfileEntry(icon: Icons.about, title: "关于 Quire", note: "版本 0.1"),
  ]

  if page == "stats" {
    Stats {
      on close { page = "" }
    }
  } else if page == "sync" {
    SyncSettings {
      embedded: true
      on close { page = "" }
    }
  } else {
    Column {
      gap: 18
      padding: lib.sheetPad(top: 20, bottom: 24, side: 20)

      Row {
        gap: 14
        align: .center
        View {
          width: 60
          height: 60
          radius: 999
          align: .center
          justify: .center
          background: .accent
          Symbol(Icons.person) {
            font: .title2
            color: .onAccent
          }
        }
        Column {
          grow: 1
          gap: 3
          Text("Quire 读者") {
            font: .title3.bold()
          }
          Text(if library.davConfigured() { "本机 · 云端已连接" } else { "本机 · 未连接云端" }) {
            font: .footnote
            color: .secondaryLabel
          }
        }
        Button("") {
          icon: Icons.close
          variant: .glass
          on press { dismiss() }
        }
      }

      Column {
        gap: 0
        for entry in entries key entry.title {
          Row {
            gap: 12
            align: .center
            padding: [13, 4]
            on press {
              if entry.title == "同步与备份" {
                page = "sync"
              } else if entry.title == "阅读记录统计" {
                page = "stats"
              } else {
                snackbar("「{entry.title}」即将推出")
              }
            }
            Symbol(entry.icon) {
              font: .body
              color: .accent
              width: 26
            }
            Column {
              grow: 1
              gap: 2
              Text(entry.title) {
                font: .body
              }
              Text(entry.note) {
                font: .caption2
                color: .secondaryLabel
              }
            }
            Symbol(Icons.disclosure) {
              font: .caption2
              color: .tertiaryLabel
            }
          }
        }
      }
    }
  }
}

struct ProfileEntry {
  icon: string
  title: string
  note: string
}

screen Home {
  use library: Library

  /// A book was chosen: the app opens the reader over everything.
  event open(book: lib.Book)

  state showingProfile = false

  title: "首页"
  largeTitle: true

  // 我 sits at the top right of the bar, not in the page's first line.
  toolbar {
    Button("我") {
      icon: Icons.profile
      variant: .glass
      tooltip: "阅读记录、同步与设置"
      on press { showingProfile = true }
    }
  }

  let env = environment()
  let books = library.books()
  let rows = library.readings
  let reading = rows.filter(isReading).sorted(key: r => r.updated, descending: true)
  let done = rows.filter(isDone).sorted(key: r => r.updated, descending: true)
  let thisYearRows = rows.filter(r => yearOf(r.updated) == thisYear()).sorted(key: r => r.updated, descending: true)
  let older = done.filter(r => yearOf(r.updated) != thisYear())
  let doneThisYear = done.count(where: r => yearOf(r.updated) == thisYear())
  let filled = if library.goal > 0 {
    min(1.0, float(doneThisYear) / float(library.goal))
  } else {
    0.0
  }

  // 没有内容的板块不占地方：继续阅读只在有在读的书时出现，之前读过只在
  // 有往年读完的书时出现。
  let sections = [HomeSection.reading, .year, .done].filter(section => match section {
    .reading => !reading.isEmpty()
    .year => true
    .done => !older.isEmpty()
  })

  // iPhone 横屏的左右有安全区，List 直接铺满整屏时行会顶出右边；
  // 只给左右让出安全区。上下留给 List 自己：它会按导航栏和 tab 栏
  // 调整内容，还让内容滚到液态玻璃下面；再包 SafeArea 就会挤成两条。
  View {
    grow: 1
    padding: [0, env.safeLeft, 0, env.safeRight]
    List {
      grow: 1
      appearance: .bare
      for section in sections key section {
        match section {
          .reading => Column {
            gap: 12
            padding: [20, lib.pageKeyline, 0, lib.pageKeyline]
            SectionHead("继续阅读") {
              icon: Icons.reading
            }
            if let r = reading.first() {
              if let b = bookOf(books, r.id) {
                ContinueCard(b, r) { on open { emit open(b) } }
              }
            }
          }
          .year => Column {
            gap: 12
            padding: [20, lib.pageKeyline, 0, lib.pageKeyline]
            SectionHead("今年") {
              icon: Icons.goal
            }
            GoalCard(doneThisYear, library.goal, filled) {
              on goalChange(goal) {
                library.goal = goal
              }
            }
            if !thisYearRows.isEmpty() {
              Column {
                gap: 0
                for r in thisYearRows.prefix(5) key r.id {
                  if let b = bookOf(books, r.id) {
                    YearRow(b, r) { on open { emit open(b) } }
                  }
                }
              }
            }
          }
          .done => Column {
            gap: 12
            padding: [20, lib.pageKeyline, 44, lib.pageKeyline]
            SectionHead("之前读过") {
              icon: Icons.finished
            }
            Scroll {
              width: 100%
              horizontal: true
              Row {
                gap: 16
                for r in older key r.id {
                  if let b = bookOf(books, r.id) {
                    MiniBook(b) { on open { emit open(b) } }
                  }
                }
              }
            }
          }
        }
      }
    }
    // 我只有头像和三行，默认半屏就够；想大可以拖上去。
    Sheet {
      open: showingProfile
      detents: [.medium, .large]
      grabber: true
      on change(open) { showingProfile = open }
      Profile()
    }
  }
}
