// The home page: what is still being read, the year's goal, what was read
// before, and the books this year has had. The avatar at the top is the way
// into the reader's own settings; its entries are placeholders for now.

import std/time

import ./lib

/// The year it is now, and a place's year: a reading row keeps the moment it
/// was last saved as unix seconds, so "this year" is a comparison of clocks.
fn thisYear() -> int = time.now().year()

fn yearOf(seconds: int) -> int {
  if seconds <= 0 { return 0 }
  return time.unix(seconds: seconds).year()
}

/// A saved place as a day: "6月1日" for a row that has one.
fn whenOf(seconds: int) -> string {
  if seconds <= 0 { return "" }
  return time.unix(seconds: seconds).format("M月d日")
}

fn percentText(p: float) -> string = "{(p * 100).int()}%"

/// A title's book, from the shelf's rows the home page already has.
fn bookOf(books: [lib.Book], id: string) -> lib.Book? {
  for b in books {
    if b.id == id { return b }
  }
  return none
}

fn isReading(r: lib.Reading) -> bool = r.percent > 0.001 && r.percent < 0.999

fn isDone(r: lib.Reading) -> bool = r.percent >= 0.999

/// The home page's rows, in the order they show: what to pick up, how the
/// year is going, and what was finished before it.
enum HomeSection {
  reading
  year
  done
}

/// How far a book is read, as the thin bar the page's rows carry.
component ReadingBar(value: float) {
  prop color: Color = .accent

  View {
    height: 4
    radius: 2
    background: .separator
    View {
      width: 100% * value
      height: 4
      radius: 2
      background: color
    }
  }
}

component SectionHead(title: string) {
  prop note = ""
  prop icon = ""

  Row {
    gap: 8
    align: .center
    if !icon.isEmpty() {
      Symbol(icon) {
        font: .footnote
        color: .secondaryLabel
      }
    }
    Text(title) {
      font: .title3.bold()
      grow: 1
    }
    if !note.isEmpty() {
      Text(note) {
        font: .footnote
        color: .secondaryLabel
      }
    }
  }
}

component EmptyNote(text: string) {
  prop icon = "book"

  Row {
    gap: 10
    align: .center
    padding: [14, 16]
    radius: 14
    background: .secondaryBackground
    Symbol(icon) {
      font: .subheadline
      color: .tertiaryLabel
    }
    Text(text) {
      font: .footnote
      color: .secondaryLabel
      grow: 1
    }
  }
}

/// 继续阅读: the one book to pick up again. A card rather than a list, so a
/// reader with ten books open still sees the rest of the page; the shelf is
/// where all of them are. The bar says how far, and is the only thing that
/// does — a number beside it would say the same.
component ContinueCard(book: lib.Book, reading: lib.Reading) {
  event open

  Row {
    gap: 14
    align: .center
    padding: 14
    radius: 18
    background: .secondaryBackground
    on press { emit open }
    Cover(book) { width: 64 }
    Column {
      grow: 1
      gap: 9
      Text(book.title) {
        font: .headline
        lines: 2
      }
      ReadingBar(reading.percent)
    }
  }
}

/// A book in one of the page's sideways strips: a cover and its title, as a
/// shelf of what was finished.
component MiniBook(book: lib.Book) {
  event open

  Column {
    width: 104
    gap: 6
    align: .center
    on press { emit open }
    Cover(book) { width: 104 }
    Text(book.title) {
      font: .subheadline
      lines: 1
      textAlign: .center
    }
  }
}

/// 阅读目标: a ring for the year, and a stepper to change the number.
component GoalCard(done: int, goal: int, filled: float) {
  event goalChange(goal: int)

  Row {
    gap: 16
    align: .center
    padding: 16
    radius: 18
    background: .secondaryBackground
    ProgressRing {
      value: filled
      width: 62
      color: if goal > 0 && done >= goal { .green } else { .accent }
    }
    Column {
      grow: 1
      gap: 4
      Text(if goal > 0 && done >= goal { "今年的目标读完了" } else { "今年读完了 {done} 本" }) {
        font: .headline
      }
      Text(if goal > 0 {
        "目标 {goal} 本 · 还差 {max(0, goal - done)} 本"
      } else {
        "还没有定下目标"
      }) {
        font: .caption
        color: .secondaryLabel
      }
    }
    Stepper {
      value: float(goal)
      min: 1
      max: 200
      on change(v) { emit goalChange(int(v)) }
    }
  }
}

/// 今年读过的书: a log. The date it was last read leads, the title follows;
/// no cover and no bar — those belong to the two sections above it.
component YearRow(book: lib.Book, reading: lib.Reading) {
  event open

  Row {
    gap: 12
    align: .center
    padding: [11, 0]
    on press { emit open }
    Text(whenOf(reading.updated)) {
      font: .caption2
      color: .tertiaryLabel
      width: 52
    }
    Column {
      grow: 1
      gap: 2
      Text(book.title) {
        font: .body
        lines: 1
      }
      if !book.author.isEmpty() {
        Text(book.author) {
          font: .caption2
          color: .secondaryLabel
          lines: 1
        }
      }
    }
    Text(if isDone(reading) { "读完" } else { percentText(reading.percent) }) {
      font: .caption2
      color: if isDone(reading) { .green } else { .secondaryLabel }
    }
  }
}

/// 我：the avatar's page. Every entry is a placeholder for now: the screens
/// behind them come later.
component Profile {
  let entries = [
    ProfileEntry(icon: "chart.bar.doc.horizontal", title: "阅读记录统计", note: "读完的书、读过的日子"),
    ProfileEntry(icon: "externaldrive.badge.icloud", title: "WebDAV 配置", note: "同步书架与进度"),
    ProfileEntry(icon: "target", title: "阅读目标", note: "今年读几本"),
    ProfileEntry(icon: "bell.badge", title: "阅读提醒", note: "每天读一点"),
    ProfileEntry(icon: "paintbrush", title: "外观与排版", note: "纸色、字号、行距"),
    ProfileEntry(icon: "info.circle", title: "关于 Quire", note: "版本 0.1"),
  ]

  Column {
    gap: 18
    padding: [20, 20, 24, 20]

    Row {
      gap: 14
      align: .center
      View {
        width: 60
        height: 60
        radius: 999
        align: .center
        justify: .center
        background: .accent
        Symbol("person.fill") {
          font: .title2
          color: .onAccent
        }
      }
      Column {
        grow: 1
        gap: 3
        Text("Quire 读者") {
          font: .title3.bold()
        }
        Text("本机 · 未登录") {
          font: .footnote
          color: .secondaryLabel
        }
      }
      Button("") {
        icon: "xmark"
        variant: .glass
        on press { dismiss() }
      }
    }

    Column {
      gap: 0
      for entry in entries key entry.title {
        Row {
          gap: 12
          align: .center
          padding: [13, 4]
          on press { snackbar("「{entry.title}」即将推出") }
          Symbol(entry.icon) {
            font: .body
            color: .accent
            width: 26
          }
          Column {
            grow: 1
            gap: 2
            Text(entry.title) {
              font: .body
            }
            Text(entry.note) {
              font: .caption2
              color: .secondaryLabel
            }
          }
          Symbol("chevron.right") {
            font: .caption2
            color: .tertiaryLabel
          }
        }
      }
    }
  }
}

struct ProfileEntry {
  icon: string
  title: string
  note: string
}

screen Home {
  use library: Library

  /// A book was chosen: the app opens the reader over everything.
  event open(book: lib.Book)

  title: "首页"
  largeTitle: true

  // 我 sits at the top right of the bar, as the shelf's import button does,
  // not in the page's first line.
  toolbar {
    Button("") {
      icon: "person.crop.circle"
      variant: .glass
      label: "我"
      tooltip: "阅读记录、WebDAV 与设置"
      on press { present(Profile()) }
    }
  }

  let books = library.books()
  let rows = library.readings
  let reading = rows.filter(isReading).sorted(key: r => r.updated, descending: true)
  let done = rows.filter(isDone).sorted(key: r => r.updated, descending: true)
  let thisYearRows = rows.filter(r => yearOf(r.updated) == thisYear()).sorted(key: r => r.updated, descending: true)
  let older = done.filter(r => yearOf(r.updated) != thisYear())
  let doneThisYear = done.count(where: r => yearOf(r.updated) == thisYear())
  let filled = if library.goal > 0 {
    min(1.0, float(doneThisYear) / float(library.goal))
  } else {
    0.0
  }

  // A List, not a Scroll: it is the list a screen with a large title gives its
  // insets to, so the first row starts under the title, not in the status bar.
  // A List takes its rows from a for, so the page's sections are its items.
  let sections = [HomeSection.reading, .year, .done]

  List {
    appearance: .bare
    for section in sections {
      match section {
        .reading => Column {
          gap: 12
          padding: [20, 20, 0, 20]
          SectionHead("继续阅读") {
            icon: "book"
            note: if reading.isEmpty() { "" } else { "在读 {reading.count()} 本" }
          }
          if reading.isEmpty() {
            EmptyNote("还没有翻开的书。去书架挑一本，从第一页开始。") { icon: "book.closed" }
          } else {
            if let r = reading.first() {
              if let b = bookOf(books, r.id) {
                ContinueCard(b, r) { on open { emit open(b) } }
              }
            }
          }
        }
        .year => Column {
          gap: 12
          padding: [20, 20, 0, 20]
          SectionHead("今年") {
            icon: "target"
            note: if thisYearRows.isEmpty() { "" } else { "{thisYearRows.count()} 本" }
          }
          GoalCard(doneThisYear, library.goal, filled) {
            on goalChange(goal) {
              library.goal = goal
            }
          }
          if thisYearRows.isEmpty() {
            EmptyNote("今年还没有读完的书。翻开一本，这里就会记下。") { icon: "sparkles" }
          } else {
            Column {
              gap: 0
              for r in thisYearRows.prefix(5) key r.id {
                if let b = bookOf(books, r.id) {
                  YearRow(b, r) { on open { emit open(b) } }
                }
              }
            }
            if thisYearRows.count() > 5 {
              Text("只列最近 5 本，今年共 {thisYearRows.count()} 本") {
                font: .caption2
                color: .tertiaryLabel
                padding: [0, 4]
              }
            }
          }
        }
        .done => Column {
          gap: 12
          padding: [20, 20, 44, 20]
          SectionHead("之前读过") {
            icon: "checkmark.circle"
            note: if older.isEmpty() { "" } else { "{older.count()} 本" }
          }
          if older.isEmpty() {
            EmptyNote("往年读完的书会留在这里，想再翻一遍时好找。") { icon: "bookmark" }
          } else {
            Scroll {
              horizontal: true
              Row {
                gap: 16
                for r in older key r.id {
                  if let b = bookOf(books, r.id) {
                    MiniBook(b) { on open { emit open(b) } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
