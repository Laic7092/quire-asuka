// The shelf: books, and where each was left. Kept across launches in each
// platform's own preferences (std/store), plus the server's catalog and sidecars.

import platform/secure
import std/crypto
import std/fs
import std/store
import std/time
import ./engine
import ./lib

/// Where a book's cover image lives: the engine writes its original bytes
/// here, and the shelf shows it. `.img` because the bytes keep their own
/// format (PNG or JPEG) and every platform's image loader sniffs it.
pub fn coverPath(id: string) -> string = fs.join([fs.appDir(), "covers", "{id}.img"])

/// How a row keeps its cover: relative to the app's own directory, not the
/// container that directory is in this launch.
pub fn coverName(id: string) -> string = "covers/{id}.img"

/// 书文件的扩展名：云端 blob 用它保留格式，读的时候由引擎按字节判断。
pub fn bookExt(path: string, id: string) -> string {
  let name = if path.isEmpty() { id } else { lib.fileName(path) }
  return if name.lower().hasSuffix(".epub") { ".epub" } else { ".txt" }
}

/// 一份内容在云端的文件名：`<sha256>.epub`，同一份内容只有一份。
pub fn blobName(hash: string, path: string, id: string) -> string {
  if hash.isEmpty() { return "" }
  return "{hash}{bookExt(path, id)}"
}

/// 书文件在云端的路径。
pub fn blobPathOf(hash: string, path: string, id: string) -> string {
  let name = blobName(hash, path, id)
  return if name.isEmpty() { "" } else { "blobs/{name}" }
}

/// 一本书的 sidecar（书签和每日统计）在云端的路径。id 是书名或文件名，
/// 用 hash 当文件名，省得标题里的空格、斜杠和中文变成 URL 的麻烦。
pub fn docKey(id: string) -> string = crypto.sha256(id.bytes()).hex()

pub fn docPath(id: string) -> string = "meta/{docKey(id)}.json"

/// A file's name as a row keeps it: relative to the app's own directory. iOS
/// doesn't promise a container its name across updates (its UUID can change),
/// so a row that kept the whole path would point into a directory that's gone
/// on the next launch. Rows written before this kept absolute paths; those
/// are cut back to the part under books/ or covers/.
fn keptName(path: string) -> string {
  if path.isEmpty() { return "" }
  let root = fs.appDir()
  if !root.isEmpty() && path.hasPrefix(root) {
    let rest = path.slice(root.count(), path.count())
    // Only the directory itself, or what's under it: "…/Quire2" isn't inside
    // "…/Quire".
    if rest.isEmpty() { return "" }
    if rest.hasPrefix("/") || rest.hasPrefix("\\") {
      return rest.slice(1, rest.count())
    }
  }
  for dir in ["books/", "covers/"] {
    if let at = path.find(dir) {
      return path.byteSlice(at, path.byteCount())
    }
  }
  if path.hasPrefix("/") {
    return path.split("/").last() ?? path
  }
  return path
}

/// The file a kept name is in this launch: under the app's directory.
pub fn fileOf(kept: string) -> string {
  if kept.isEmpty() { return "" }
  if kept.hasPrefix("/") {
    // A row from an older build (or one not migrated yet). If the file is
    // still where the row says, leave it; else find it under the app's own
    // directory, wherever iOS has put that this time.
    if fs.exists(kept) { return kept }
    return fs.join([fs.appDir(), keptName(kept)])
  }
  return fs.join([fs.appDir(), kept])
}

/// Where the account's password goes when the platform has no keychain: a
/// file only the user may read (0600 on Unix). A keyring is better; this is
/// what keeps a keyring-less desktop from asking for the password each launch.
fn passwordFile() -> string = fs.join([fs.appDir(), "sync-password"])

async fn readPasswordFile() -> string {
  let text = try? await spawn { try fs.readText(passwordFile()) }
  return (text ?? "").trim()
}

async fn writePasswordFile(password: string) {
  let path = passwordFile()
  if password.isEmpty() {
    try? await spawn { try fs.remove(path) }
    return
  }
  try? await spawn {
    try fs.mkdirAll(fs.appDir())
    try fs.writeText(path, text: password)
    try fs.chmod(path, 0o600)
  }
}

/// A book's row, with the moment it came onto the shelf: a book put back
/// after being taken off outranks the note that hid it, here and in a sync.
fn rowOf(book: lib.Book) -> lib.Shelf {
  var row = lib.shelfOf(book)
  row.added = time.now().unix()
  return row
}

pub store Library {
  /// The books on the shelf, as the files they're read from: what survives a
  /// launch. A sample brought with the app is seeded into it (once), so it's a
  /// row like any imported book's: taking it off needs no remembering.
  pub state shelf: [lib.Shelf] = store.read("shelf", [])
  /// Whether the samples have been put on the shelf (the first launch did it).
  pub state seeded: bool = store.read("shelf.seeded", false)
  pub state readings: [lib.Reading] = store.read("readings", [])
  /// 阅读统计：每本书每天读了多久。一本书一天一行，阅读页关闭时与
  /// 翻页/滚动时写入。
  pub state readingDays: [lib.ReadingDay] = store.read("stats.days", [])
  /// 书签：一本书里的位置，章内进度加分章，不是页码（换字号也还准）。
  pub state bookmarks: [lib.Bookmark] = store.read("bookmarks", [])
  pub state theme: string = store.read("reader.theme", "paper")
  pub state size: float = store.read("reader.size", 19.0)
  /// 行距，一行的字号的倍数。
  pub state line: float = store.read("reader.line", 1.6)
  /// 页边留白，相对默认留白的比例：0 是默认，-0.3 更窄，+1 是两倍宽。
  /// 相对默认留白的比例。旧版本这里存的是「默认留白的倍数」（默认 1），
  /// 所以换了 key：升级上来的人拿到 0，而不是突然 +100% 的留白。
  pub state margins: float = store.read("reader.marginDelta", 0.0)
  /// 字距，一个字的额外宽度（点），可正可负。
  pub state letter: float = store.read("reader.letter", 0.0)
  /// 词距，词与词之间额外的宽度（点），可正可负。
  pub state word: float = store.read("reader.word", 0.0)
  /// 翻页方式："page"（分页）或 "scroll"（连续滚动）。
  pub state mode: string = store.read("reader.mode", "page")
  /// 今年的阅读目标，读完几本。首页的目标环读它。
  pub state goal: int = store.read("goal.books", 12)
  /// 书架怎么摆："grid"（网格）或 "list"（列表）。
  pub state shelfLayout: string = store.read("shelf.layout", "grid")
  /// 书架的次序："recent"（最近阅读）、"title"、"author" 或 "manual"
  /// （架上原来的顺序）。
  pub state shelfSort: string = store.read("shelf.sort", "recent")

  /// 坚果云 WebDAV：地址、账号、应用密码（不是登录密码）与同步文件夹。
  /// 密码是秘密，放平台的钥匙串（platform/secure），其它几项放偏好设置。
  pub state davServer: string = store.read("sync.server", "https://dav.jianguoyun.com/dav/")
  pub state davAccount: string = store.read("sync.account", "")
  pub state davPassword = ""
  /// 密码在系统钥匙串里（true），还是在应用目录的 sync-password 文件里。
  /// 没有钥匙串的 Linux 桌面会走后者：不然每次启动都要重输。
  pub state passwordSecured = true
  /// 钥匙串为什么没用：给同步页显示。
  pub state passwordProblem = ""
  pub state davFolder: string = store.read("sync.folder", "Quire")
  /// 云端的实现方式："nutstore"（坚果云，默认）或 "webdav"（自填地址）。
  /// 以后接别的服务，换的是这里，不是「同步」这个入口。
  pub state syncProvider: string = store.read("sync.provider", "nutstore")
  /// 启动时自动同步一次。
  pub state syncAuto: bool = store.read("sync.auto", false)
  /// 上次同步成功的时间（unix 秒），0 表示还没同步过。
  pub state syncLast: int = store.read("sync.last", 0)
  /// 上次同步的结果，配置页读它。
  pub state syncMessage: string = store.read("sync.message", "")
  /// 一次同步正在跑：两个按钮、自动同步都不会重入。
  pub state syncBusy = false
  /// 钥匙串读过没有：写回它之前要先读，免得空密码把读到的删掉。
  state credentialsLoaded = false
  /// 取下的书，按 id 记下时间：双向合并时不该被另一台设备带回来。
  pub state removedIds: [string: int] = store.read("sync.removed", [:])
  /// 云端已有的内容 hash：决定一本书是「本机有」还是「云端有」，也是
  /// 下载前的清单；每次同步用 blobs/ 的列表刷新。
  pub state cloudHashes: [string] = store.read("sync.blobs", [])
  /// 每本书的书签/统计文档（meta/<id>.json）在云端的最新版本。
  pub state docRemote: [string: int] = store.read("sync.docs.remote", [:])
  /// 这台设备已经合并进来的 sidecar 版本。
  pub state docKnown: [string: int] = store.read("sync.docs.known", [:])
  /// 本地改过、还没写回云端的 sidecar：id -> 改动时间。
  pub state docDirty: [string: int] = store.read("sync.docs.dirty", [:])
  /// 固定在本机、不被缓存清理掉的书。
  pub state pinned: [string] = store.read("sync.pinned", [])
  /// 上次打开的时间，缓存清理按它从最久没读的书开始。
  pub state lastOpened: [string: int] = store.read("sync.opened", [:])
  /// 新导入的书是否在同步时自动上传正文。默认关闭：书架和进度先走，
  /// 书文件按需上传/下载。
  pub state backupNew: bool = store.read("sync.backupNew", false)
  /// 本地书文件缓存上限（MB）。0 表示不限制。
  pub state cacheLimitMB: int = store.read("sync.cacheMB", 2048)
  /// 一次「备份全部」正在跑时，同步会把这些书都传上去。不落盘。
  state uploadAll = false
  /// 封面/正文文件变过：封面组件靠它重新检查那张图是不是已经下下来了。
  pub state assetsTick = 0

  effect { store.write("readings", readings) }
  effect { store.write("stats.days", readingDays) }
  effect { store.write("bookmarks", bookmarks) }
  effect { store.write("shelf.seeded", seeded) }
  effect { store.write("reader.theme", theme) }
  effect { store.write("reader.size", size) }
  effect { store.write("reader.line", line) }
  effect { store.write("reader.marginDelta", margins) }
  effect { store.write("reader.letter", letter) }
  effect { store.write("reader.word", word) }
  effect { store.write("reader.mode", mode) }
  effect { store.write("goal.books", goal) }
  effect { store.write("shelf.layout", shelfLayout) }
  effect { store.write("shelf.sort", shelfSort) }
  effect { store.write("sync.server", davServer) }
  effect { store.write("sync.account", davAccount) }
  effect { store.write("sync.folder", davFolder) }
  effect { store.write("sync.provider", syncProvider) }
  effect { store.write("sync.auto", syncAuto) }
  effect { store.write("sync.last", syncLast) }
  effect { store.write("sync.message", syncMessage) }
  effect { store.write("sync.removed", removedIds) }
  effect { store.write("sync.blobs", cloudHashes) }
  effect { store.write("sync.docs.remote", docRemote) }
  effect { store.write("sync.docs.known", docKnown) }
  effect { store.write("sync.docs.dirty", docDirty) }
  effect { store.write("sync.pinned", pinned) }
  effect { store.write("sync.opened", lastOpened) }
  effect { store.write("sync.backupNew", backupNew) }
  effect { store.write("sync.cacheMB", cacheLimitMB) }

  /// The keychain is read once, before the first sync: the password isn't in
  /// the preferences the other settings are in.
  task(credentialsLoaded, davPassword) {
    if !credentialsLoaded { return }
    if passwordSecured {
      do {
        if davPassword.isEmpty() {
          try await secure.remove("sync.password")
        } else {
          try await secure.write("sync.password", davPassword)
        }
        await writePasswordFile("")
        return
      } catch e {
        // The keyring went away (or was never there): keep it where the next
        // launch can read it, and say why in the sheet.
        passwordSecured = false
        passwordProblem = e.message
      }
    }
    await writePasswordFile(davPassword)
  }

  /// Every book on the shelf: a row each, the samples' included. A row keeps
  /// where its file is relative to the app's directory; this is where that
  /// is this launch.
  pub fn books() -> [lib.Book] {
    // 正文文件变过（下载/清理）时，书架要重新判断哪些书在本机。
    if assetsTick < 0 { return [] }
    var out: [lib.Book] = []
    for kept in shelf {
      var book = kept.book()
      book.path = fileOf(book.path)
      book.cover = fileOf(book.cover)
      book.backedUp = !book.hash.isEmpty() && cloudHashes.contains(book.hash)
      // 文件不在本机、云端又有：这本书可以按需下载，不是丢了。
      book.remote = !book.path.isEmpty() && !fs.exists(book.path) && book.backedUp
      out.push(book)
    }
    return out
  }

  /// 封面是读的时候才由引擎抽出来的：把它记到书架上，下一次同步才会
  /// 把这张小图传到云端。
  pub fn setCover(id: string, cover: string) {
    if let at = shelf.index(s => s.id == id) {
      var row = shelf[at]
      if row.cover == cover { return }
      row.cover = cover
      shelf[at] = row
      keep()
    }
  }

  /// Rewrites rows written before paths were kept relative: an absolute path
  /// into a container iOS has since renamed works once and then not again.
  /// Runs once at launch; a row already relative is left as it is.
  pub fn migratePaths() {
    var next: [lib.Shelf] = []
    var changed = false
    for kept in shelf {
      var row = kept
      row.path = keptName(row.path)
      row.cover = keptName(row.cover)
      if row.path != kept.path || row.cover != kept.cover { changed = true }
      next.push(row)
    }
    if changed {
      shelf = next
      keep()
    }
  }

  /// Puts the books that came with the app on the shelf, once: their text is
  /// written next to the imported ones, and from then on they're rows like
  /// any other (read, kept, and taken off the same way).
  pub async fn seedSamples() {
    if seeded { return }
    let dir = fs.join([fs.appDir(), "books"])
    try? await spawn { try fs.mkdirAll(dir) }
    for sample in samples() {
      let name = "{sample.id}.txt"
      let target = fs.join([dir, name])
      let raw = sample.raw
      if !raw.isEmpty() && !fs.exists(target) {
        try? await spawn { try fs.writeText(target, text: raw) }
      }
      var book = sample
      // Kept relative: the directory's name is the system's, not the row's.
      book.path = "books/{name}"
      let data = raw.bytes()
      book.hash = crypto.sha256(data).hex()
      book.bytes = data.count()
      shelf.removeWhere(s => s.id == book.id)
      shelf.push(rowOf(book))
    }
    // Last: a launch that dies in the middle seeds again next time, and a row
    // already there is replaced, not doubled.
    seeded = true
    keep()
  }

  /// Takes a book off the shelf: its row, where it was left, its bookmarks,
  /// its statistics, and the local copy of its file and cover when nothing
  /// else on the shelf uses them. The content may still be on the server;
  /// the next sync removes that copy too.
  pub fn forget(id: string) {
    let gone = shelf.find(s => s.id == id)
    shelf.removeWhere(s => s.id == id)
    readings.removeWhere(r => r.id == id)
    readingDays = readingDays.filter(d => d.book != id)
    bookmarks = bookmarks.filter(b => b.book != id)
    pinned = pinned.filter(p => p != id)
    lastOpened.remove(id)
    docKnown.remove(id)
    docRemote.remove(id)
    docDirty.remove(id)
    if let row = gone {
      if !row.path.isEmpty() && !shelf.any(s => s.path == row.path) {
        try? fs.remove(fileOf(row.path))
      }
      if !row.cover.isEmpty() && !shelf.any(s => s.cover == row.cover) {
        try? fs.remove(fileOf(row.cover))
      }
    }
    // The note is what keeps a sync (or another device that hasn't synced
    // yet) from putting the book back. Its files go on the next sync.
    removedIds[id] = time.now().unix()
    keep()
  }

  /// 本地 sidecar 变了：书签或阅读时长一改，下一次同步就把这本书的
  /// meta 文件写回云端。版本必须比已知的云端版本新，哪怕同一秒改了两次。
  fn touchDoc(id: string) {
    let now = time.now().unix()
    var at = if now > 0 { now } else { 1 }
    if let last = docDirty.get(id) {
      if at <= last { at = last + 1 }
    }
    if let known = docKnown.get(id) {
      if at <= known { at = known + 1 }
    }
    docDirty[id] = at
  }

  /// Writes the shelf down now: it changes in two places (an import, and a
  /// book taken off), and the store is what a later launch reads.
  fn keep() {
    store.write("shelf", shelf)
    store.flush()
  }

  /// Takes a .txt or .epub the user picked (the document picker on iOS hands
  /// over a copy in the app's caches), keeps it in the app's directory, and
  /// puts it on the shelf. The engine reads it when the reader opens it.
  ///
  /// A book already there isn't added twice: the same bytes are one book,
  /// whatever the file is called. True when the shelf got a new row.
  pub async fn importFile(path: string) throws -> bool {
    let name = lib.fileName(path)
    let lower = name.lower()
    let isText = lower.hasSuffix(".txt")
    if !isText && !lower.hasSuffix(".epub") {
      throw Error("只支持 .txt 和 .epub")
    }
    let dir = fs.join([fs.appDir(), "books"])
    try await spawn { try fs.mkdirAll(dir) }
    let target = fs.join([dir, name])
    let data = try await spawn { try fs.read(path) }
    let stamp = crypto.sha256(data).hex()
    // The same bytes, under the same name or another one, are one book: keep
    // the row it already has (and where it was left) instead of adding one.
    if let kept = try await rowWithSameBytes(data, stamp: stamp) {
      return false
    }
    if path != target {
      try await spawn { try fs.write(target, data) }
    }
    // A text book also arrives as chapters, so the shelf can count its words
    // and draw its cover before the engine has ever seen it.
    var book = if isText {
      let text = try await spawn { try fs.readText(target) }
      lib.openText(name, text)
    } else {
      lib.Book(id: lib.idOf(name), title: lib.titleOf(name), author: "", chapters: [])
    }
    book.path = "books/{name}"
    book.hash = stamp
    book.bytes = data.count()
    if isText && book.empty() { throw Error("{name} 里没有可读的文字") }
    if !isText {
      // The engine already knows how to find the cover (EPUB3's
      // cover-image, EPUB2's meta name="cover"): ask it once, at import.
      let id = engine.open(target)
      if id > 0 {
        let named = engine.title(id)
        if !named.isEmpty() { book.title = named }
        let cover = coverPath(book.id)
        try await spawn { try fs.mkdirAll(fs.join([fs.appDir(), "covers"])) }
        if engine.writeCover(id, path: cover) { book.cover = coverName(book.id) }
        engine.close(id)
      }
    }
    // What's kept is the row, not the text: the file in the app's directory
    // is the book, and the engine reads that. The row for the same file is
    // replaced, not doubled — and the reading isn't: where a book was left is
    // about the book, not the bytes it came in as.
    shelf.removeWhere(s => s.id == book.id)
    shelf.push(rowOf(book))
    // Importing it again is what puts a book back on a shelf it was taken
    // off: the note that hid it goes, here and on the next sync.
    removedIds.remove(book.id)
    keep()
    evictCache(keep: book.id)
    return true
  }

  /// A row whose file holds the same bytes as `data`, if the shelf has one:
  /// an import of a book that's already there. The stored hash answers it
  /// without reading the file again; a row without one is hashed and the
  /// answer is kept on the row.
  async fn rowWithSameBytes(data: bytes, stamp: string) -> lib.Shelf? {
    let size = data.count()
    for row in shelf {
      if !row.hash.isEmpty() {
        if row.hash == stamp { return row }
        continue
      }
      let file = fileOf(row.path)
      if file.isEmpty() || !fs.exists(file) { continue }
      let info = try? await spawn { try fs.stat(file) }
      if let info = info, info.size != size { continue }
      let other = try? await spawn { try fs.read(file) }
      if let other = other, crypto.sha256(other).hex() == stamp {
        var kept = row
        kept.hash = stamp
        kept.bytes = size
        if let at = shelf.index(s => s.id == row.id) { shelf[at] = kept }
        keep()
        return kept
      }
    }
    return none
  }

  /// A book's bookmarks, in the order they were made.
  pub fn bookmarksOf(book: string) -> [lib.Bookmark] = bookmarks.filter(b => b.book == book)

  /// The bookmark at a place: the same chapter, within a fifth of a percent of
  /// the same fraction (the two modes count a place slightly differently).
  pub fn bookmarkAt(book: string, chapter: int, percent: float) -> lib.Bookmark? {
    for mark in bookmarks {
      if mark.book != book || mark.chapter != chapter { continue }
      if (mark.percent - percent).abs() < 0.002 { return mark }
    }
    return none
  }

  /// Keeps a place. The one already there (if any) stays: a bookmark is a
  /// place, not a count.
  pub fn addBookmark(book: string, chapter: int, percent: float) {
    if bookmarkAt(book, chapter, percent) != none { return }
    var at = percent
    if at < 0 { at = 0 }
    if at > 1 { at = 1 }
    bookmarks.push(lib.Bookmark(
      id: "{book}:{chapter}:{(at * 10000).int()}",
      book: book, chapter: chapter, percent: at,
    ))
    touchDoc(book)
  }

  pub fn removeBookmark(id: string) {
    if let mark = bookmarks.find(b => b.id == id) { touchDoc(mark.book) }
    bookmarks = bookmarks.filter(b => b.id != id)
  }

  /// The bookmark button's one action: keep the place, or take back the one it
  /// finds there. True when it kept one.
  pub fn toggleBookmark(book: string, chapter: int, percent: float) -> bool {
    if let mark = bookmarkAt(book, chapter: chapter, percent: percent) {
      removeBookmark(mark.id)
      return false
    }
    addBookmark(book, chapter: chapter, percent: percent)
    return true
  }

  /// 记下一段阅读时间：由阅读页在关闭、翻页或滚动时写入。负数和空
  /// 片段不记，一本书的一天始终只有一行。
  pub fn recordReading(book: string, seconds: int) {
    if book.isEmpty() || seconds <= 0 { return }
    let now = time.now().unix()
    readingDays = lib.record(readingDays, book: book, day: lib.dayOf(now), seconds: seconds, at: now)
    touchDoc(book)
  }

  pub fn readingOf(id: string) -> lib.Reading {
    for r in readings {
      if r.id == id { return r }
    }
    return lib.Reading(id: id)
  }

  /// The further one reads, the fewer bytes get written: one row a book.
  pub fn save(id: string, chapter: int, percent: float) {
    let row = lib.Reading(id: id, chapter: chapter, percent: percent, updated: time.now().unix())
    var next: [lib.Reading] = []
    var replaced = false
    for old in readings {
      if old.id == id {
        next.push(row)
        replaced = true
      } else {
        next.push(old)
      }
    }
    if !replaced { next.push(row) }
    readings = next
  }

  /// Whether there is an account to sync with: the 我 page's entry and the
  /// launch task both ask before they show a status or touch the network.
  pub fn davConfigured() -> bool = !davAccount.trim().isEmpty() && !davPassword.isEmpty()

  fn davConfig() -> DavConfig = DavConfig(
    server: if syncProvider == "nutstore" { nutstoreServer } else { davServer },
    account: davAccount.trim(),
    password: davPassword,
    folder: davFolder,
  )

  /// Signs in and reads the folder, writing nothing: the 测试连接 button.
  pub async fn testDav() throws -> string {
    if !davConfigured() { throw SyncError.notConfigured }
    let entries = try await davTest(davConfig())
    let files = entries.filter(e => !e.isDir).count()
    return "连接成功 · 云端 {files} 个文件"
  }

  /// Brings the application password back from the keychain. The launch task
  /// runs it before anything reads the account.
  pub async fn loadCredentials() {
    var keychainWorked = true
    do {
      if let saved = try await secure.read("sync.password") {
        if !saved.isEmpty() {
          davPassword = saved
          await writePasswordFile("")
          passwordSecured = true
          credentialsLoaded = true
          return
        }
      }
    } catch e {
      keychainWorked = false
      passwordProblem = e.message
    }
    // No keychain, or nothing in it yet: a password kept beside the app,
    // where the last launch (or a system without a keyring) put it.
    let kept = await readPasswordFile()
    if !kept.isEmpty() { davPassword = kept }
    passwordSecured = keychainWorked
    credentialsLoaded = true
  }

  /// The launch task: a sync only when the reader asked for one.
  pub async fn syncIfAuto() {
    if !syncAuto || !davConfigured() { return }
    try? await syncNow()
  }

  /// A full two-way sync: files, then the state that names them. The message
  /// is what the 我 page and the sheet show; the error is thrown as well, so
  /// a sheet that asked can say what happened.
  pub async fn syncNow() throws -> string {
    if !davConfigured() { throw SyncError.notConfigured }
    if syncBusy { return syncMessage }
    syncBusy = true
    defer { syncBusy = false }
    do {
      let report = try await runSync(davConfig())
      syncLast = time.now().unix()
      syncMessage = report.text()
      return syncMessage
    } catch e {
      syncMessage = "同步失败：{e.message}"
      throw e
    }
  }

  /// 一本书的 sidecar 变了没有：书签、阅读时长写在这里，进度在 catalog。
  async fn pullDocIfNeeded(id: string) {
    if !davConfigured() { return }
    let remote = docRemote.get(id) ?? 0
    let known = docKnown.get(id) ?? 0
    if remote <= known { return }
    let text = try? await davReadText(davConfig(), docPath(id))
    if let text = text, let doc = try? bookDocDecode(text) {
      let (days, _) = mergedDays(readingDays, doc.days, removedIds)
      let (marks, _) = mergedBookmarks(bookmarks, doc.bookmarks, removedIds)
      readingDays = days
      bookmarks = marks
      docKnown[id] = doc.updated
    }
  }

  /// 打开一本书的阅读记录前调用：如果云端有更新的 sidecar，先拉下来。
  pub async fn loadBookDoc(id: string) {
    try? await pullDocIfNeeded(id)
  }

  /// 统计页要把每本书的记录摊开时才调用：把还没拉过的 sidecar 按需
  /// 拉下来。平时同步不碰云端书库里的每本书。
  pub async fn loadAllDocs() {
    if !davConfigured() { return }
    for row in shelf {
      try? await pullDocIfNeeded(row.id)
    }
  }

  /// 打开一本云端书：正文不在本机时只下载这一本，校验 hash 后再交给
  /// 阅读页。这是「书很多、只读一本」的关键路径。
  pub async fn prepare(book: lib.Book) throws -> lib.Book {
    var kept = lib.Shelf(id: book.id, title: book.title, author: book.author, path: "")
    if let row = shelf.find(s => s.id == book.id) { kept = row }
    let local = fileOf(kept.path)
    if local.isEmpty() { throw Error("《{book.title}》没有文件路径") }

    if !fs.exists(local) {
      if kept.hash.isEmpty() || !cloudHashes.contains(kept.hash) {
        throw Error("《{book.title}》的正文还没备份到云端")
      }
      if !davConfigured() { throw SyncError.notConfigured }
      try await spawn { try fs.mkdirAll(fs.join([fs.appDir(), "books"])) }
      try await davDownload(davConfig(), blobPathOf(kept.hash, kept.path, kept.id), into: local)
      let data = try await spawn { try fs.read(local) }
      if crypto.sha256(data).hex() != kept.hash {
        try? await spawn { try fs.remove(local) }
        throw Error("《{book.title}》下载后校验失败")
      }
    }

    lastOpened[book.id] = time.now().unix()
    assetsTick += 1
    try? await pullDocIfNeeded(book.id)
    evictCache(keep: book.id)

    var ready = book
    ready.path = local
    ready.hash = kept.hash
    ready.bytes = kept.bytes
    ready.backedUp = !kept.hash.isEmpty() && cloudHashes.contains(kept.hash)
    ready.remote = false
    return ready
  }

  /// 只把这一本书的正文传到云端（长按「备份到云端」）。书架和进度下次
  /// 同步时再一起走。
  pub async fn backupBook(book: lib.Book) throws -> string {
    if !davConfigured() { throw SyncError.notConfigured }
    if syncBusy { return syncMessage }
    await fillHashes()
    var kept = lib.Shelf(id: book.id, title: book.title, author: book.author, path: "")
    if let row = shelf.find(s => s.id == book.id) { kept = row }
    let local = fileOf(kept.path)
    if local.isEmpty() || !fs.exists(local) {
      throw Error("《{book.title}》不在本机，无法备份")
    }
    if kept.hash.isEmpty() {
      let data = try await spawn { try fs.read(local) }
      kept.hash = crypto.sha256(data).hex()
      kept.bytes = data.count()
      if let at = shelf.index(s => s.id == kept.id) { shelf[at] = kept }
      keep()
    }
    if cloudHashes.contains(kept.hash) { return "《{book.title}》已经在云端" }

    syncBusy = true
    defer { syncBusy = false }
    do {
      try await davEnsure(davConfig())
      try await davPutFile(davConfig(), blobPathOf(kept.hash, kept.path, kept.id), local)
      cloudHashes.push(kept.hash)
      syncMessage = "已备份《{book.title}》"
      return syncMessage
    } catch e {
      syncMessage = "备份失败：{e.message}"
      throw e
    }
  }

  /// 把本机所有书都传上去；正文很多时这会很慢，所以是一个显式动作。
  pub async fn backupAll() throws -> string {
    if !davConfigured() { throw SyncError.notConfigured }
    if syncBusy { return syncMessage }
    uploadAll = true
    defer { uploadAll = false }
    return try await syncNow()
  }

  /// 把一本书的正文从本机删掉，云端那份保留：下次打开会重新下载。
  /// 没有云端备份、或书被固定时不动，返回 false。
  pub fn removeLocalCopy(id: string) -> bool {
    if syncBusy { return false }
    if let row = shelf.find(s => s.id == id) {
      if pinned.contains(id) { return false }
      if row.hash.isEmpty() || !cloudHashes.contains(row.hash) { return false }
      let local = fileOf(row.path)
      if local.isEmpty() || !fs.exists(local) { return false }
      try? fs.remove(local)
      assetsTick += 1
      return true
    }
    return false
  }

  /// 固定/取消固定一本书：固定的书不会被本地缓存清理掉。
  pub fn togglePin(id: string) {
    if pinned.contains(id) {
      pinned = pinned.filter(p => p != id)
    } else {
      pinned.push(id)
    }
    evictCache()
  }

  /// 本机正文一共占了多少字节：同步页显示缓存用。
  pub fn localBytes() -> int {
    var total = 0
    for row in shelf {
      let local = fileOf(row.path)
      if local.isEmpty() || !fs.exists(local) { continue }
      if row.bytes > 0 {
        total += row.bytes
      } else if let info = try? fs.stat(local) {
        total += info.size
      }
    }
    return total
  }

  /// 本地正文缓存超过上限时，按「最久没打开」删掉未固定的书。封面和
  /// 页面图片不删：它们小，而且删了书架会变空。
  pub fn evictCache(keep: string = "") {
    if cacheLimitMB <= 0 { return }
    let limit = cacheLimitMB * 1024 * 1024
    var total = 0
    for row in shelf {
      let local = fileOf(row.path)
      if local.isEmpty() || !fs.exists(local) { continue }
      if row.bytes > 0 {
        total += row.bytes
      } else if let info = try? fs.stat(local) {
        total += info.size
      }
    }
    if total <= limit { return }
    // 只清理云端还有一份的书：没有备份的正文删了就没了。
    let candidates = shelf
      .filter(row => row.id != keep && !pinned.contains(row.id) && !row.hash.isEmpty() && cloudHashes.contains(row.hash) && !row.path.isEmpty() && fs.exists(fileOf(row.path)))
      .sorted(key: row => lastOpened.get(row.id) ?? 0)
    var evicted = false
    for row in candidates {
      if total <= limit { break }
      let local = fileOf(row.path)
      let size = if row.bytes > 0 { row.bytes } else if let info = try? fs.stat(local) { info.size } else { 0 }
      try? fs.remove(local)
      total -= size
      evicted = true
    }
    if evicted { assetsTick += 1 }
  }

  /// 补上旧行没有的 hash：内容地址是云端文件名，第一次同步前必须知道。
  async fn fillHashes() {
    var changed = false
    var next: [lib.Shelf] = []
    for row in shelf {
      var kept = row
      if kept.hash.isEmpty() && !kept.path.isEmpty() {
        let local = fileOf(kept.path)
        if fs.exists(local) {
          let data = try? await spawn { try fs.read(local) }
          if let data = data {
            kept.hash = crypto.sha256(data).hex()
            kept.bytes = data.count()
            changed = true
          }
        }
      }
      next.push(kept)
    }
    if changed { shelf = next; keep() }
  }

  async fn runSync(cfg: DavConfig) throws -> SyncReport {
    try await davEnsure(cfg)
    await fillHashes()

    let serverText = try await davReadText(cfg, "catalog.json")
    var server = SyncSnapshot()
    if let text = serverText {
      server = (try? syncDecode(text)) ?? SyncSnapshot()
    }

    var serverShelf: [lib.Shelf] = []
    for row in server.shelf {
      var kept = row
      kept.path = safeName(row.path)
      kept.cover = safeName(row.cover)
      serverShelf.push(kept)
    }

    let removed = mergedRemoved(removedIds, server.removed)
    let (nextShelf, added) = mergedShelf(shelf, serverShelf, removed)
    let live = prunedRemoved(nextShelf, removed)
    let (_, places) = mergedReadings(readings, server.readings, live)

    // 云端已有的正文和封面。正文按 hash 判断，不按文件名：同一本书
    // 从另一台设备传上来时文件名可能不同，内容却相同。
    let blobEntries = try await davList(cfg, "blobs/")
    let coverEntries = try await davList(cfg, "covers/")
    var serverHashes: [string] = []
    var serverBlobNames: Set<string> = []
    for entry in blobEntries {
      if entry.isDir { continue }
      serverBlobNames.insert(entry.name)
      if entry.name.count() >= 64 {
        let hash = entry.name.slice(0, 64)
        if !serverHashes.contains(hash) { serverHashes.push(hash) }
      }
    }
    var serverCovers: Set<string> = []
    for entry in coverEntries {
      if !entry.isDir { serverCovers.insert(entry.name) }
    }

    var report = SyncReport(added: added, places: places)

    // 取下的书：正文、封面和 sidecar 都删；内容可能被另一行共享，先看
    // 是否还有活着的书用它。
    for row in serverShelf {
      if live.get(row.id) == none { continue }
      if nextShelf.any(kept => kept.id == row.id) { continue }
      do {
        if !row.hash.isEmpty() && !nextShelf.any(k => !k.hash.isEmpty() && k.hash == row.hash) {
          try await davRemove(cfg, blobPathOf(row.hash, row.path, row.id))
          report.deleted += 1
        }
        if !row.cover.isEmpty() && !nextShelf.any(k => k.cover == row.cover) {
          try await davRemove(cfg, row.cover)
          report.deleted += 1
        }
        try await davRemove(cfg, docPath(row.id))
        report.deleted += 1
      } catch { report.failed += 1 }
      docKnown.remove(row.id)
      docRemote.remove(row.id)
      docDirty.remove(row.id)
    }

    let coversDir = fs.join([fs.appDir(), "covers"])
    let uploadWanted = uploadAll || backupNew

    for row in nextShelf {
      if !row.path.isEmpty() {
        let local = fileOf(row.path)
        let here = fs.exists(local)
        let cloudName = blobName(row.hash, row.path, row.id)
        if here && uploadWanted && !cloudName.isEmpty() && !serverBlobNames.contains(cloudName) {
          do {
            try await davPutFile(cfg, blobPathOf(row.hash, row.path, row.id), local)
            report.uploaded += 1
            serverBlobNames.insert(cloudName)
            if !serverHashes.contains(row.hash) { serverHashes.push(row.hash) }
          } catch { report.failed += 1 }
        }
      }
      // 封面始终走：它小，新设备一同步就能看到书架本来的样子。
      if !row.cover.isEmpty() {
        let local = fileOf(row.cover)
        let here = fs.exists(local)
        let name = lib.fileName(row.cover)
        if here && !serverCovers.contains(name) {
          do {
            try await spawn { try fs.mkdirAll(coversDir) }
            try await davPutFile(cfg, row.cover, local)
            report.uploaded += 1
            serverCovers.insert(name)
          } catch { report.failed += 1 }
        } else if !here && serverCovers.contains(name) {
          do {
            try await spawn { try fs.mkdirAll(coversDir) }
            try await davDownload(cfg, row.cover, into: local)
            report.downloaded += 1
          } catch { report.failed += 1 }
        }
      }
    }

    // sidecar：只拉版本变了的，只推本地改过的。bookmarks/days 的合并
    // 和以前一样按书、按天、按位置，不整包覆盖。
    var docs = server.docs
    var known = docKnown
    var nextDays = readingDays
    var nextMarks = bookmarks
    for row in nextShelf {
      let id = row.id
      let remoteRev = docs.get(id) ?? 0
      let knownRev = known.get(id) ?? 0
      let dirtyAt = docDirty.get(id) ?? 0
      let dirty = dirtyAt > knownRev
      // 正文在本机的书才提前拉 sidecar；云端书库里的其它书等到打开
      // 或进统计页时再拉，书多的时候不拿几千个小文件换一个书架。
      let here = !row.path.isEmpty() && fs.exists(fileOf(row.path))
      if remoteRev > knownRev && (here || dirty) {
        do {
          let text = try await davReadText(cfg, docPath(id))
          if let text = text {
            if let doc = try? bookDocDecode(text) {
              let (days, _) = mergedDays(nextDays, doc.days, live)
              let (marks, _) = mergedBookmarks(nextMarks, doc.bookmarks, live)
              nextDays = days
              nextMarks = marks
              if doc.updated > knownRev { known[id] = doc.updated }
              if doc.updated > (docs.get(id) ?? 0) { docs[id] = doc.updated }
            }
          } else {
            // catalog 说有，文件却没了：不要每次同步都重试同一个 404。
            known[id] = remoteRev
          }
        } catch { report.failed += 1 }
      }
      if dirty {
        var at = dirtyAt
        if let r = docs.get(id) { if at <= r { at = r + 1 } }
        if let k = known.get(id) { if at <= k { at = k + 1 } }
        let now = time.now().unix()
        if at < now { at = now }
        let doc = BookDoc(
          updated: at,
          id: id,
          bookmarks: nextMarks.filter(m => m.book == id),
          days: nextDays.filter(d => d.book == id),
        )
        do {
          try await davPutText(cfg, docPath(id), bookDocEncode(doc))
          known[id] = at
          docs[id] = at
          report.docs += 1
          if docDirty.get(id) == dirtyAt { docDirty.remove(id) }
        } catch { report.failed += 1 }
      }
    }

    // 同步过程中可能又翻了一页、加了一个书签：最后以本机现在的状态
    // 为准再合并一次，网络读到的旧快照不会把它盖掉。
    let finalRemoved = mergedRemoved(removedIds, server.removed)
    let (finalShelf, finalAdded) = mergedShelf(shelf, serverShelf, finalRemoved)
    let finalLive = prunedRemoved(finalShelf, finalRemoved)
    let (finalReadings, finalPlaces) = mergedReadings(readings, server.readings, finalLive)
    let finalDays = lib.merge(readingDays, nextDays)
    let (finalMarks, _) = mergedBookmarks(bookmarks, nextMarks, finalLive)
    let beforeMarks = bookmarks.count()

    shelf = finalShelf
    readings = finalReadings
    readingDays = finalDays
    bookmarks = finalMarks
    removedIds = finalLive
    report.added = finalAdded
    report.places = finalPlaces
    report.bookmarks = if finalMarks.count() > beforeMarks { finalMarks.count() - beforeMarks } else { 0 }

    var finalKnown: [string: int] = [:]
    var finalRemote: [string: int] = [:]
    var finalDirty: [string: int] = [:]
    for row in finalShelf {
      if let at = known.get(row.id) { finalKnown[row.id] = at }
      if let at = docs.get(row.id) { finalRemote[row.id] = at }
      if let at = docDirty.get(row.id) { finalDirty[row.id] = at }
    }
    docKnown = finalKnown
    docRemote = finalRemote
    docDirty = finalDirty
    cloudHashes = serverHashes

    // A setting still at its default takes the server's, so a new device
    // gets the old one's type on its first sync. A changed one stays.
    if syncLast == 0 && server.updated > 0 {
      if theme == "paper" { theme = server.theme }
      if size == 19.0 { size = server.size }
      if line == 1.6 { line = server.line }
      if margins == 0.0 { margins = server.margins }
      if letter == 0.0 { letter = server.letter }
      if word == 0.0 { word = server.word }
      if mode == "page" { mode = server.mode }
      if goal == 12 { goal = server.goal }
    }
    keep()
    assetsTick += 1
    evictCache()

    let written = SyncSnapshot(
      updated: time.now().unix(),
      shelf: shelf,
      readings: readings,
      removed: removedIds,
      docs: finalRemote,
      theme: theme,
      size: size,
      line: line,
      margins: margins,
      letter: letter,
      word: word,
      mode: mode,
      goal: goal,
    )
    try await davPutText(cfg, "catalog.json", syncEncode(written))
    return report
  }
}

/// A path the server sent, kept only when it is one of the app's own names:
/// "books/x.txt" or "covers/x.img", without a step out of either folder.
fn safeName(path: string) -> string {
  let kept = keptName(path)
  if kept.isEmpty() || kept.contains("..") { return "" }
  let rest = if kept.hasPrefix("books/") {
    kept.trimPrefix("books/")
  } else if kept.hasPrefix("covers/") {
    kept.trimPrefix("covers/")
  } else {
    return ""
  }
  // One name under one of the two folders, not a path into a folder of its
  // own: the server's list only names children.
  if rest.isEmpty() || rest.contains("/") || rest.contains("\\") { return "" }
  return kept
}
