// The shelf: books, and where each was left. Kept across launches in each
// platform's own preferences (std/store), the way Quire keeps state.json.

import std/fs
import std/store
import ./lib

pub store Library {
  pub state books: [lib.Book] = samples()
  pub state readings: [lib.Reading] = store.read("readings", [])
  pub state theme: string = store.read("reader.theme", "paper")
  pub state size: float = store.read("reader.size", 19.0)
  /// 行距，一行的字号的倍数。
  pub state line: float = store.read("reader.line", 1.6)
  /// 页边留白，按默认留白的倍数。
  pub state margins: float = store.read("reader.margins", 1.0)
  /// 字距，一个字的额外宽度（点）。
  pub state letter: float = store.read("reader.letter", 0.0)

  effect { store.write("readings", readings) }
  effect { store.write("reader.theme", theme) }
  effect { store.write("reader.size", size) }
  effect { store.write("reader.line", line) }
  effect { store.write("reader.margins", margins) }
  effect { store.write("reader.letter", letter) }

  /// Takes a .txt or .epub the user picked (the document picker on iOS hands
  /// over a copy in the app's caches), keeps it in the app's directory, and
  /// puts it on the shelf. The engine reads it when the reader opens it.
  pub async fn importFile(path: string) throws {
    let name = lib.fileName(path)
    let lower = name.lower()
    let isText = lower.hasSuffix(".txt")
    if !isText && !lower.hasSuffix(".epub") {
      throw Error("只支持 .txt 和 .epub")
    }
    let dir = fs.join([fs.appDir(), "books"])
    try await spawn { try fs.mkdirAll(dir) }
    let target = fs.join([dir, name])
    if path != target {
      let data = try await spawn { try fs.read(path) }
      try await spawn { try fs.write(target, data) }
    }
    // A text book also arrives as chapters, so the shelf can count its words
    // and draw its cover before the engine has ever seen it.
    var book = if isText {
      let text = try await spawn { try fs.readText(target) }
      lib.openText(name, text)
    } else {
      lib.Book(id: lib.idOf(name), title: lib.titleOf(name), author: "", chapters: [])
    }
    book.path = target
    if isText && book.empty() { throw Error("{name} 里没有可读的文字") }
    books.removeWhere(b => b.id == book.id)
    books.push(book)
  }

  pub fn readingOf(id: string) -> lib.Reading {
    for r in readings {
      if r.id == id { return r }
    }
    return lib.Reading(id: id)
  }

  /// The further one reads, the fewer bytes get written: one row a book.
  pub fn save(id: string, chapter: int, percent: float) {
    let row = lib.Reading(id: id, chapter: chapter, percent: percent)
    var next: [lib.Reading] = []
    var replaced = false
    for old in readings {
      if old.id == id {
        next.push(row)
        replaced = true
      } else {
        next.push(old)
      }
    }
    if !replaced { next.push(row) }
    readings = next
  }
}
