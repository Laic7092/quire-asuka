// The shelf: books, and where each was left. Kept across launches in each
// platform's own preferences (std/store), the way Quire keeps state.json.

import std/fs
import std/store
import ./engine
import ./lib

/// Where a book's cover image lives: the engine writes its original bytes
/// here, and the shelf shows it. `.img` because the bytes keep their own
/// format (PNG or JPEG) and every platform's image loader sniffs it.
pub fn coverPath(id: string) -> string = fs.join([fs.appDir(), "covers", "{id}.img"])

pub store Library {
  /// The books brought in, as the files they're read from: what survives a
  /// launch. The samples come from the app itself (samples/ is compiled in),
  /// so they're never kept, and they're always on the shelf.
  pub state shelf: [lib.Shelf] = store.read("shelf", [])
  pub state readings: [lib.Reading] = store.read("readings", [])
  pub state theme: string = store.read("reader.theme", "paper")
  pub state size: float = store.read("reader.size", 19.0)
  /// 行距，一行的字号的倍数。
  pub state line: float = store.read("reader.line", 1.6)
  /// 页边留白，相对默认留白的比例：0 是默认，-0.3 更窄，+1 是两倍宽。
  /// 相对默认留白的比例。旧版本这里存的是「默认留白的倍数」（默认 1），
  /// 所以换了 key：升级上来的人拿到 0，而不是突然 +100% 的留白。
  pub state margins: float = store.read("reader.marginDelta", 0.0)
  /// 字距，一个字的额外宽度（点），可正可负。
  pub state letter: float = store.read("reader.letter", 0.0)
  /// 词距，词与词之间额外的宽度（点），可正可负。
  pub state word: float = store.read("reader.word", 0.0)
  /// 翻页方式："page"（分页）或 "scroll"（连续滚动）。
  pub state mode: string = store.read("reader.mode", "page")

  effect { store.write("readings", readings) }
  effect { store.write("reader.theme", theme) }
  effect { store.write("reader.size", size) }
  effect { store.write("reader.line", line) }
  effect { store.write("reader.marginDelta", margins) }
  effect { store.write("reader.letter", letter) }
  effect { store.write("reader.word", word) }
  effect { store.write("reader.mode", mode) }

  /// Every book on the shelf: the samples first, then what was brought in.
  pub fn books() -> [lib.Book] {
    var out = samples()
    for kept in shelf {
      out.push(kept.book())
    }
    return out
  }

  /// Takes a book off the shelf. The file stays: importing it again is free.
  pub fn forget(id: string) {
    shelf.removeWhere(s => s.id == id)
    readings.removeWhere(r => r.id == id)
    keep()
  }

  /// Writes the shelf down now: it changes in two places (an import, and a
  /// book taken off), and the store is what a later launch reads.
  fn keep() {
    store.write("shelf", shelf)
    store.flush()
  }

  /// Takes a .txt or .epub the user picked (the document picker on iOS hands
  /// over a copy in the app's caches), keeps it in the app's directory, and
  /// puts it on the shelf. The engine reads it when the reader opens it.
  pub async fn importFile(path: string) throws {
    let name = lib.fileName(path)
    let lower = name.lower()
    let isText = lower.hasSuffix(".txt")
    if !isText && !lower.hasSuffix(".epub") {
      throw Error("只支持 .txt 和 .epub")
    }
    let dir = fs.join([fs.appDir(), "books"])
    try await spawn { try fs.mkdirAll(dir) }
    let target = fs.join([dir, name])
    if path != target {
      let data = try await spawn { try fs.read(path) }
      try await spawn { try fs.write(target, data) }
    }
    // A text book also arrives as chapters, so the shelf can count its words
    // and draw its cover before the engine has ever seen it.
    var book = if isText {
      let text = try await spawn { try fs.readText(target) }
      lib.openText(name, text)
    } else {
      lib.Book(id: lib.idOf(name), title: lib.titleOf(name), author: "", chapters: [])
    }
    book.path = target
    if isText && book.empty() { throw Error("{name} 里没有可读的文字") }
    if !isText {
      // The engine already knows how to find the cover (EPUB3's
      // cover-image, EPUB2's meta name="cover"): ask it once, at import.
      let id = engine.open(target)
      if id > 0 {
        let named = engine.title(id)
        if !named.isEmpty() { book.title = named }
        let cover = coverPath(book.id)
        try await spawn { try fs.mkdirAll(fs.join([fs.appDir(), "covers"])) }
        if engine.writeCover(id, path: cover) { book.cover = cover }
        engine.close(id)
      }
    }
    // What's kept is the row, not the text: the file in the app's directory
    // is the book, and the engine reads that.
    forget(book.id)
    shelf.push(lib.shelfOf(book))
    keep()
  }

  pub fn readingOf(id: string) -> lib.Reading {
    for r in readings {
      if r.id == id { return r }
    }
    return lib.Reading(id: id)
  }

  /// The further one reads, the fewer bytes get written: one row a book.
  pub fn save(id: string, chapter: int, percent: float) {
    let row = lib.Reading(id: id, chapter: chapter, percent: percent)
    var next: [lib.Reading] = []
    var replaced = false
    for old in readings {
      if old.id == id {
        next.push(row)
        replaced = true
      } else {
        next.push(old)
      }
    }
    if !replaced { next.push(row) }
    readings = next
  }
}
