// The shelf: books, and where each was left. Kept across launches in each
// platform's own preferences (std/store), the way Quire keeps state.json.

import std/crypto
import std/fs
import std/store
import std/time
import ./engine
import ./lib

/// Where a book's cover image lives: the engine writes its original bytes
/// here, and the shelf shows it. `.img` because the bytes keep their own
/// format (PNG or JPEG) and every platform's image loader sniffs it.
pub fn coverPath(id: string) -> string = fs.join([fs.appDir(), "covers", "{id}.img"])

/// How a row keeps its cover: relative to the app's own directory, not the
/// container that directory is in this launch.
pub fn coverName(id: string) -> string = "covers/{id}.img"

/// A file's name as a row keeps it: relative to the app's own directory. iOS
/// doesn't promise a container its name across updates (its UUID can change),
/// so a row that kept the whole path would point into a directory that's gone
/// on the next launch. Rows written before this kept absolute paths; those
/// are cut back to the part under books/ or covers/.
fn keptName(path: string) -> string {
  if path.isEmpty() { return "" }
  let root = fs.appDir()
  if !root.isEmpty() && path.hasPrefix(root) {
    let rest = path.slice(root.count(), path.count())
    // Only the directory itself, or what's under it: "…/Quire2" isn't inside
    // "…/Quire".
    if rest.isEmpty() { return "" }
    if rest.hasPrefix("/") || rest.hasPrefix("\\") {
      return rest.slice(1, rest.count())
    }
  }
  for dir in ["books/", "covers/"] {
    if let at = path.find(dir) {
      return path.byteSlice(at, path.byteCount())
    }
  }
  if path.hasPrefix("/") {
    return path.split("/").last() ?? path
  }
  return path
}

/// The file a kept name is in this launch: under the app's directory.
pub fn fileOf(kept: string) -> string {
  if kept.isEmpty() { return "" }
  if kept.hasPrefix("/") {
    // A row from an older build (or one not migrated yet). If the file is
    // still where the row says, leave it; else find it under the app's own
    // directory, wherever iOS has put that this time.
    if fs.exists(kept) { return kept }
    return fs.join([fs.appDir(), keptName(kept)])
  }
  return fs.join([fs.appDir(), kept])
}

pub store Library {
  /// The books on the shelf, as the files they're read from: what survives a
  /// launch. A sample brought with the app is seeded into it (once), so it's a
  /// row like any imported book's: taking it off needs no remembering.
  pub state shelf: [lib.Shelf] = store.read("shelf", [])
  /// Whether the samples have been put on the shelf (the first launch did it).
  pub state seeded: bool = store.read("shelf.seeded", false)
  pub state readings: [lib.Reading] = store.read("readings", [])
  /// 书签：一本书里的位置，章内进度加分章，不是页码（换字号也还准）。
  pub state bookmarks: [lib.Bookmark] = store.read("bookmarks", [])
  pub state theme: string = store.read("reader.theme", "paper")
  pub state size: float = store.read("reader.size", 19.0)
  /// 行距，一行的字号的倍数。
  pub state line: float = store.read("reader.line", 1.6)
  /// 页边留白，相对默认留白的比例：0 是默认，-0.3 更窄，+1 是两倍宽。
  /// 相对默认留白的比例。旧版本这里存的是「默认留白的倍数」（默认 1），
  /// 所以换了 key：升级上来的人拿到 0，而不是突然 +100% 的留白。
  pub state margins: float = store.read("reader.marginDelta", 0.0)
  /// 字距，一个字的额外宽度（点），可正可负。
  pub state letter: float = store.read("reader.letter", 0.0)
  /// 词距，词与词之间额外的宽度（点），可正可负。
  pub state word: float = store.read("reader.word", 0.0)
  /// 翻页方式："page"（分页）或 "scroll"（连续滚动）。
  pub state mode: string = store.read("reader.mode", "page")
  /// 今年的阅读目标，读完几本。首页的目标环读它。
  pub state goal: int = store.read("goal.books", 12)

  effect { store.write("readings", readings) }
  effect { store.write("bookmarks", bookmarks) }
  effect { store.write("shelf.seeded", seeded) }
  effect { store.write("reader.theme", theme) }
  effect { store.write("reader.size", size) }
  effect { store.write("reader.line", line) }
  effect { store.write("reader.marginDelta", margins) }
  effect { store.write("reader.letter", letter) }
  effect { store.write("reader.word", word) }
  effect { store.write("reader.mode", mode) }
  effect { store.write("goal.books", goal) }

  /// Every book on the shelf: a row each, the samples' included. A row keeps
  /// where its file is relative to the app's directory; this is where that
  /// is this launch.
  pub fn books() -> [lib.Book] {
    var out: [lib.Book] = []
    for kept in shelf {
      var book = kept.book()
      book.path = fileOf(book.path)
      book.cover = fileOf(book.cover)
      out.push(book)
    }
    return out
  }

  /// Rewrites rows written before paths were kept relative: an absolute path
  /// into a container iOS has since renamed works once and then not again.
  /// Runs once at launch; a row already relative is left as it is.
  pub fn migratePaths() {
    var next: [lib.Shelf] = []
    var changed = false
    for kept in shelf {
      var row = kept
      row.path = keptName(row.path)
      row.cover = keptName(row.cover)
      if row.path != kept.path || row.cover != kept.cover { changed = true }
      next.push(row)
    }
    if changed {
      shelf = next
      keep()
    }
  }

  /// Puts the books that came with the app on the shelf, once: their text is
  /// written next to the imported ones, and from then on they're rows like
  /// any other (read, kept, and taken off the same way).
  pub async fn seedSamples() {
    if seeded { return }
    let dir = fs.join([fs.appDir(), "books"])
    try? await spawn { try fs.mkdirAll(dir) }
    for sample in samples() {
      let name = "{sample.id}.txt"
      let target = fs.join([dir, name])
      let raw = sample.raw
      if !raw.isEmpty() && !fs.exists(target) {
        try? await spawn { try fs.writeText(target, text: raw) }
      }
      var book = sample
      // Kept relative: the directory's name is the system's, not the row's.
      book.path = "books/{name}"
      shelf.removeWhere(s => s.id == book.id)
      shelf.push(lib.shelfOf(book))
    }
    // Last: a launch that dies in the middle seeds again next time, and a row
    // already there is replaced, not doubled.
    seeded = true
    keep()
  }

  /// Takes a book off the shelf: its row, where it was left, and its
  /// bookmarks. The file stays, so importing it again is free.
  pub fn forget(id: string) {
    shelf.removeWhere(s => s.id == id)
    readings.removeWhere(r => r.id == id)
    bookmarks = bookmarks.filter(b => b.book != id)
    keep()
  }

  /// Writes the shelf down now: it changes in two places (an import, and a
  /// book taken off), and the store is what a later launch reads.
  fn keep() {
    store.write("shelf", shelf)
    store.flush()
  }

  /// Takes a .txt or .epub the user picked (the document picker on iOS hands
  /// over a copy in the app's caches), keeps it in the app's directory, and
  /// puts it on the shelf. The engine reads it when the reader opens it.
  ///
  /// A book already there isn't added twice: the same bytes are one book,
  /// whatever the file is called. True when the shelf got a new row.
  pub async fn importFile(path: string) throws -> bool {
    let name = lib.fileName(path)
    let lower = name.lower()
    let isText = lower.hasSuffix(".txt")
    if !isText && !lower.hasSuffix(".epub") {
      throw Error("只支持 .txt 和 .epub")
    }
    let dir = fs.join([fs.appDir(), "books"])
    try await spawn { try fs.mkdirAll(dir) }
    let target = fs.join([dir, name])
    let data = try await spawn { try fs.read(path) }
    // The same bytes, under the same name or another one, are one book: keep
    // the row it already has (and where it was left) instead of adding one.
    if let kept = try await rowWithSameBytes(data) {
      return false
    }
    if path != target {
      try await spawn { try fs.write(target, data) }
    }
    // A text book also arrives as chapters, so the shelf can count its words
    // and draw its cover before the engine has ever seen it.
    var book = if isText {
      let text = try await spawn { try fs.readText(target) }
      lib.openText(name, text)
    } else {
      lib.Book(id: lib.idOf(name), title: lib.titleOf(name), author: "", chapters: [])
    }
    book.path = "books/{name}"
    if isText && book.empty() { throw Error("{name} 里没有可读的文字") }
    if !isText {
      // The engine already knows how to find the cover (EPUB3's
      // cover-image, EPUB2's meta name="cover"): ask it once, at import.
      let id = engine.open(target)
      if id > 0 {
        let named = engine.title(id)
        if !named.isEmpty() { book.title = named }
        let cover = coverPath(book.id)
        try await spawn { try fs.mkdirAll(fs.join([fs.appDir(), "covers"])) }
        if engine.writeCover(id, path: cover) { book.cover = coverName(book.id) }
        engine.close(id)
      }
    }
    // What's kept is the row, not the text: the file in the app's directory
    // is the book, and the engine reads that. The row for the same file is
    // replaced, not doubled — and the reading isn't: where a book was left is
    // about the book, not the bytes it came in as.
    shelf.removeWhere(s => s.id == book.id)
    shelf.push(lib.shelfOf(book))
    keep()
    return true
  }

  /// A row whose file holds the same bytes as `data`, if the shelf has one:
  /// an import of a book that's already there. Its size is asked first, so
  /// only a file of the same size is read and hashed.
  async fn rowWithSameBytes(data: bytes) -> lib.Shelf? {
    let size = data.count()
    let stamp = crypto.sha256(data).hex()
    for row in shelf {
      let file = fileOf(row.path)
      if file.isEmpty() || !fs.exists(file) { continue }
      let info = try? await spawn { try fs.stat(file) }
      if let info = info, info.size != size { continue }
      let other = try? await spawn { try fs.read(file) }
      if let other = other, crypto.sha256(other).hex() == stamp { return row }
    }
    return none
  }

  /// A book's bookmarks, in the order they were made.
  pub fn bookmarksOf(book: string) -> [lib.Bookmark] = bookmarks.filter(b => b.book == book)

  /// The bookmark at a place: the same chapter, within a fifth of a percent of
  /// the same fraction (the two modes count a place slightly differently).
  pub fn bookmarkAt(book: string, chapter: int, percent: float) -> lib.Bookmark? {
    for mark in bookmarks {
      if mark.book != book || mark.chapter != chapter { continue }
      if (mark.percent - percent).abs() < 0.002 { return mark }
    }
    return none
  }

  /// Keeps a place. The one already there (if any) stays: a bookmark is a
  /// place, not a count.
  pub fn addBookmark(book: string, chapter: int, percent: float) {
    if bookmarkAt(book, chapter, percent) != none { return }
    var at = percent
    if at < 0 { at = 0 }
    if at > 1 { at = 1 }
    bookmarks.push(lib.Bookmark(
      id: "{book}:{chapter}:{(at * 10000).int()}",
      book: book, chapter: chapter, percent: at,
    ))
  }

  pub fn removeBookmark(id: string) {
    bookmarks = bookmarks.filter(b => b.id != id)
  }

  /// The bookmark button's one action: keep the place, or take back the one it
  /// finds there. True when it kept one.
  pub fn toggleBookmark(book: string, chapter: int, percent: float) -> bool {
    if let mark = bookmarkAt(book, chapter: chapter, percent: percent) {
      removeBookmark(mark.id)
      return false
    }
    addBookmark(book, chapter: chapter, percent: percent)
    return true
  }

  pub fn readingOf(id: string) -> lib.Reading {
    for r in readings {
      if r.id == id { return r }
    }
    return lib.Reading(id: id)
  }

  /// The further one reads, the fewer bytes get written: one row a book.
  pub fn save(id: string, chapter: int, percent: float) {
    let row = lib.Reading(id: id, chapter: chapter, percent: percent, updated: time.now().unix())
    var next: [lib.Reading] = []
    var replaced = false
    for old in readings {
      if old.id == id {
        next.push(row)
        replaced = true
      } else {
        next.push(old)
      }
    }
    if !replaced { next.push(row) }
    readings = next
  }
}
