// 书内搜索：引擎按章建索引，命中带章名、前后文和稳定位置。窗口式阅读时
// 引擎里只有这一窗的章节，结果按 `loaded` 滤掉还没取到正文的占位章。

import ./lib
import ./engine

/// 书内搜索：引擎按章建索引，命中带章名、前后文和稳定位置。窗口式阅读时
/// 引擎里只有这一窗的章节，结果按 `loaded` 滤掉还没取到正文的占位章。
component Find(id: engine.Engine?, windowed: bool = false, base: int = 0, loaded: [int] = [], initial: string = "") {
  /// 选中一条：这次的全部命中、选的是第几条，以及搜的是什么词。阅读页
  /// 把列表留下，翻到上一条、下一条或再打开结果时不用重搜。
  event go(hits: [engine.FindHit], at: int, query: string)
  use library: Library
  let palette = lib.paletteFor(library.theme)
  let env = environment()
  let list = Ref()
  let field = Ref()

  state query = initial
  state hits: [engine.FindHit] = []
  state truncated = false
  state ran = false
  state busy = false
  /// 这批结果是哪个词搜出来的：用户改了输入框但还没再搜时，结果和
  /// 「第几条」仍属于旧词。
  state ranQuery = ""

  async fn run() {
    let text = query.trim()
    if text.isEmpty() || busy { return }
    busy = true
    // 搜索引擎是同步的：先让这一帧把「搜索中…」画出来，再开始扫。
    await sleep(30ms)
    // 窗口式书里还有占位章（「第 N 章的正文正在取…」）：多要一些再滤掉，
    // 免得占位把真正的命中挤出上限。整本打开的书没有占位，够一百条就行。
    let found = engine.search(id, text, if windowed { 1000 } else { 100 })
    var kept: [engine.FindHit] = []
    for hit in found.hits {
      if windowed && !loaded.contains(base + hit.spine) { continue }
      kept.push(hit)
    }
    var cut = found.truncated
    if kept.count() > 100 {
      kept = kept.slice(0, 100)
      cut = true
    }
    hits = kept
    truncated = cut
    ran = true
    ranQuery = text
    busy = false
    // 结果比输入框重要：收起键盘，让出列表的位置；新的一批从头看。
    field.blur()
    list.scrollTo(0, 0, animated: false)
  }

  // 从结果条再打开：带着上次的词，直接列出结果。
  task {
    if !initial.trim().isEmpty() { await run() }
  }

  fn clearQuery() {
    query = ""
    hits = []
    truncated = false
    ran = false
    ranQuery = ""
    field.focus()
  }

  fn nameOf(hit: engine.FindHit) -> string {
    if !hit.chapter.isEmpty() { return hit.chapter }
    return "第 {base + hit.spine + 1} 章"
  }

  /// 前后文里的命中本身画上底色，而不是靠一对「」：一眼看到的是词，
  /// 不是标点。Span 的零字段（字号、颜色）跟着 RichText 的。
  fn contextSpans(hit: engine.FindHit) -> [Span] {
    let mark = if library.theme == "night" { #6ea8fe44 } else { #0a84ff26 }
    var out: [Span] = []
    if hit.ellipsisBefore { out.push(Span(text: "…", color: palette.muted)) }
    if !hit.before.isEmpty() { out.push(Span(text: hit.before)) }
    out.push(Span(text: hit.text, background: mark))
    if !hit.after.isEmpty() { out.push(Span(text: hit.after)) }
    if hit.ellipsisAfter { out.push(Span(text: "…", color: palette.muted)) }
    return out
  }

  let summary = if busy {
    "正在搜索…"
  } else if hits.isEmpty() {
    ""
  } else if truncated {
    "{hits.count()} 条结果（还有更多）"
  } else {
    "{hits.count()} 条结果"
  }
  let hint = if windowed { "这本书按窗加载：只搜索已经取到正文的章节" } else { "" }

  Column {
    grow: 1
    gap: 12
    padding: lib.sheetPad(env, top: 16, bottom: 0, side: 0)
    background: palette.paper
    Row {
      padding: [8, 20]
      gap: 8
      align: .center
      Text("书内搜索") {
        font: .title3
        color: palette.ink
        grow: 1
      }
      Button("") {
        icon: Icons.close
        variant: .glass
        color: palette.ink
        label: "关闭"
        tooltip: "关闭"
        on press { dismiss() }
      }
    }
    Row {
      padding: [0, 20]
      gap: 8
      align: .center
      // 一条搜索框该有的样子：圆角底、放大镜、清空；不是一条裸输入线。
      Row {
        grow: 1
        gap: 6
        align: .center
        padding: [0, 10]
        height: 38
        radius: 10
        background: palette.rule
        Symbol(Icons.search) {
          font: .footnote
          color: palette.muted
        }
        TextField {
          bind text: query
          ref: field
          placeholder: "搜索这本书的正文"
          returnKey: .search
          plain: true
          // 重新打开结果时不用再弹一次键盘。
          autofocus: initial.trim().isEmpty()
          autocapitalize: .off
          autocorrect: .no
          grow: 1
          on submit { await run() }
        }
        if !query.isEmpty() {
          Button("") {
            icon: Icons.close
            variant: .plain
            color: palette.muted
            label: "清空搜索"
            on press { clearQuery() }
          }
        }
      }
      Button("查找") {
        disabled: busy || query.trim().isEmpty()
        on press { await run() }
      }
    }
    if !hint.isEmpty() {
      Text(hint) {
        padding: [0, 20]
        font: .caption
        color: palette.muted
      }
    }
    if !summary.isEmpty() {
      Text(summary) {
        padding: [0, 20]
        font: .caption
        color: palette.muted
      }
    }
    if hits.isEmpty() {
      Column {
        grow: 1
        justify: .center
        align: .center
        gap: 10
        padding: [24, 40]
        if !ran && !busy {
          Symbol(Icons.search) {
            font: .title
            color: palette.muted.opacity(0.35)
          }
        }
        Text(if busy { "正在搜索…" } else if ran { "没有找到「{ranQuery}」" } else { "输入一个词，搜这本书的正文" }) {
          font: .footnote
          color: palette.muted
          textAlign: .center
        }
      }
    } else {
      List {
        ref: list
        grow: 1
        appearance: .bare
        for (i, hit) in hits.enumerated() key "{hit.spine}:{hit.offset}" {
          Column {
            // 明确的细线，颜色跟着纸色走；系统分隔线在纸色上总是偏灰。
            if i > 0 {
              View {
                height: 1
                background: palette.rule
                margin: [0, 20]
              }
            }
            Row {
              padding: [12, 20]
              gap: 10
              align: .center
              on press {
                emit go(hits, i, ranQuery)
                dismiss()
              }
              Column {
                grow: 1
                gap: 4
                Text(nameOf(hit)) {
                  font: .footnote
                  color: palette.muted
                  lines: 1
                }
                RichText(contextSpans(hit)) {
                  color: palette.ink
                  lines: 3
                }
              }
            }
          }
        }
      }
    }
  }
}
