#!/usr/bin/env bash
#
# Runs before every commit in quire-asuka: formats the Asuka sources (asuka fmt
# -w is not lossy: it writes only what differs), then type-checks the app. Both
# are what CI runs, so a red CI here means something real.
#
# Install it once per clone:
#
#   git config core.hooksPath .githooks
#
# Skip it with `git commit --no-verify`.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

asuka="${ASUKA:-$(command -v asuka || echo "$HOME/.asuka/bin/asuka")}"
if [ ! -x "$asuka" ]; then
  echo "pre-commit: no asuka CLI on PATH (or ~/.asuka/bin)" >&2
  exit 1
fi

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if ! printf '%s\n' "$staged" | grep -q '\.asuka$'; then
  exit 0
fi

echo "pre-commit: asuka fmt"
"$asuka" fmt -w . >/dev/null
# Formatting the files under review is the point: put them back in the commit.
for file in $(printf '%s\n' "$staged" | grep '\.asuka$'); do
  [ -f "$file" ] && git add "$file"
done

# An ignored .asuka file is a file CI won't have: lib/ was ignored once and
# the app's own sources under it never reached the runner.
ignored="$(git ls-files --others --ignored --exclude-standard -- '*.asuka')"
if [ -n "$ignored" ]; then
  echo "pre-commit: ignored sources (CI won't have them):" >&2
  printf '  %s\n' "$ignored" >&2
  echo "pre-commit: fix .gitignore, or 'git add -f' them" >&2
  exit 1
fi

echo "pre-commit: asuka check"
"$asuka" check || {
  echo "pre-commit: asuka check failed" >&2
  exit 1
}

echo "pre-commit: asuka test"
"$asuka" test >/dev/null || {
  echo "pre-commit: asuka test failed" >&2
  exit 1
}
# lib/ is a package of its own: its tests don't run as part of the app's.
"$asuka" test lib >/dev/null || {
  echo "pre-commit: asuka test lib failed" >&2
  exit 1
}
